@page "/authsessionuser"
@using SociePolar.WebApp.Components.Pages
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <ModalCargando />
}

@code {
    private string userEmail = "cesaralejandro.garcia@empresaspolar.com";
    string nombre = string.Empty;
    string apellido = string.Empty;
    bool cargando =  false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private string usuario = string.Empty;

    [Inject] private IUsuario repousuario { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        cargando = true;
        if (firstRender)
        {
            var useremailaux = await SessionStorage.GetAsync<string>("UserEmail");
            if (string.IsNullOrEmpty(useremailaux.Value))
            {
                await LoadUserDataAsync();
            }            
        }
        cargando = false;
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            usuario = user.Identity?.Name ?? "Usuario Desconocido";
            userEmail = user.Identity?.Name ?? "Usuario Desconocido";

            var useremailaux = await SessionStorage.GetAsync<string>("UserEmail");
            if (string.IsNullOrEmpty(useremailaux.Value))
            {
                await LoadUserDataAsync();
            }
            else
            {
                await MostrarNotificacion($"Bienvenido {nombre} {apellido}!", esError: false);
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion($"Error al cargar datos del usuario {usuario}. Por favor, inténtalo de nuevo. {ex.Message.ToString()}", esError: true);
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
        cargando = false;
    }

    private async Task LoadUserDataAsync()
    {
        try
        {
            Usuario? usuario = await repousuario.GetByEmailAsync(userEmail);
            if (usuario == null)
            {
                cargando = false;
                StateHasChanged();
                await MostrarNotificacion(mensajeAlerta = $"Usuario con email {userEmail} no encontrado.", esError: true);
                Console.WriteLine($"Usuario con email {userEmail} no encontrado.");
            }
            await SessionStorage.SetAsync("UserEmail", usuario.Email.ToString());
            await SessionStorage.SetAsync("UserId", usuario.Id.ToString());
            await SessionStorage.SetAsync("UserRol", usuario.IdRol.ToString());
            await SessionStorage.SetAsync("UserCedula", usuario.Cedula);
            await SessionStorage.SetAsync("UserNombreCorto", $"{nombre}, {apellido}".ToLower());
            navManager.NavigateTo($"/", forceLoad: true);
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion($"Error al cargar datos del usuario {usuario}. Por favor, inténtalo de nuevo. {ex.Message.ToString()}", esError: true);
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

}
