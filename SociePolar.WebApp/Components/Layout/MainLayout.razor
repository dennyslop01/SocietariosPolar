@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@* El PopoverProvider debe estar en un lugar que alcance el NavMenu interactivo *@
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Style="background: #00338D;">
        <MudImage Src="LogoPolar.png" Alt="Logo" Class="mr-4" />

        @* Aquí insertamos el menú horizontal *@
        <NavMenu />

        <MudSpacer />

        @* <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" /> *@
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

