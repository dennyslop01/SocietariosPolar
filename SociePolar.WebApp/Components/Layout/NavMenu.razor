                        </MudMenuItem>
                        <MudMenuItem href="/administrar/claselibros">
                            <div style="font-size: 0.85rem;">
                                Clase Libros
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/empresas">
                            <div style="font-size: 0.85rem;">
                                Empresas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/estatussociedad">
                            <div style="font-size: 0.85rem;">
                                Estatus Sociedad
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/nombrediarios">
                            <div style="font-size: 0.85rem;">
                                Nombre Diarios
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/regiones">
                            <div style="font-size: 0.85rem;">
                                Regiones
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/registros">
                            <div style="font-size: 0.85rem;">
                                Registros
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/tipoasambleas">
                            <div style="font-size: 0.85rem;">
                                Tipos de Asambleas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/tiporeformas">
                            <div style="font-size: 0.85rem;">
                                Tipos de Reformas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/tiposociedadactiva">
                            <div style="font-size: 0.85rem;">
                                Tipo de Sociedad Activa
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/tipolibros">
                            <div style="font-size: 0.85rem;">
                                Tipo de Libros
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/tipoaccionistas">
                            <div style="font-size: 0.85rem;">
                                Tipo de Accionistas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/estatusaccionistas">
                            <div style="font-size: 0.85rem;">
                                Estatus de Accionistas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/modalidadpago">
                            <div style="font-size: 0.85rem;">
                                Modalidad de Pago
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/tipocuenta">
                            <div style="font-size: 0.85rem;">
                                Tipo de Cuenta
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/banco">
                            <div style="font-size: 0.85rem;">
                                Bancos
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/administrar/dirigidosa">
                            <div style="font-size: 0.85rem;">
