                                Asambleas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/reformasinactivas">
                            <div style="font-size: 0.85rem;">
                                Reformas
                            </div>
                        </MudMenuItem>
                        <MudMenuItem href="/autoridadesinactivas">
                            <div style="font-size: 0.85rem;">
                                Autoridades
                            </div>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </ChildContent>
        </MudMenu>

        <MudMenu Label="Accionistas"
                 Variant="Variant.Text"
                 Dense="true"
                 Padding="false"
                 Style="color: white; text-transform: none;"
                 StartIcon="@Icons.Material.Filled.DeviceHub"
                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                <MudMenuItem href="/accionistassociedad">
                    <div style="font-size: 0.85rem;">
                        Accionistas Activos
                    </div>
                </MudMenuItem>
                <MudMenuItem href="/accionistassociedadinactivas">
                    <div style="font-size: 0.85rem;">
                        Accionistas Inactivos
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Label="Dividendos"
                 Variant="Variant.Text"
                 Dense="true"
                 Padding="false"
                 Style="color: white; text-transform: none;"
                 StartIcon="@Icons.Material.Filled.DeviceHub"
                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                <MudMenuItem href="/dividendospreliminares">
                    <div style="font-size: 0.85rem;">
                        Dividendos Preliminares
                    </div>
                </MudMenuItem>
                <MudMenuItem href="/dividendosdefinitivos">
                    <div style="font-size: 0.85rem;">
                        Dividendos Definitivos
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    }
    <MudSpacer />
    @* Botón alineado a la derecha con el valor de la variable *@
    <MudButton Variant="Variant.Text"
               Style="color: white; text-transform: none;"
               StartIcon="@Icons.Material.Filled.Person">
        @userEmail
    </MudButton>
</MudStack>

@code {
    int userrol = 0;
    string userEmail = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                userrol = int.Parse(userrolaux.Value);
            }

            var useremailaux = await SessionStorage.GetAsync<string>("UserEmail");
            if (!string.IsNullOrEmpty(useremailaux.Value))
            {
                userEmail = useremailaux.Value;
            }
            StateHasChanged();
        }
    }
}

<style>

    /* Esto asegura que los iconos de Bootstrap dentro del botón también sean blancos */
    .mud-button-root {
        color: white !important;
    }
    /* Si el icono EndIcon de MudBlazor no se pone blanco, esto lo fuerza */
    .mud-icon-root.mud-svg-icon {
        fill: white !important;
    }

    /* Forzamos que el texto del botón de administración sea igual al de los items */
    .mud-button-root {
        font-size: 0.875rem !important; /* Esto es Typo.body2 (14px) */
        letter-spacing: normal !important;
    }

    .mud-menu .mud-button-root {
        text-transform: none !important;
    }
    
    /* Ajustamos los items del menú desplegable */
    .item-menu-igual .mud-typography {
        font-size: 0.875rem !important;
        font-weight: 500;
    }

    /* Opcional: Si quieres que el logo también se vea más integrado */
    .navbar-top img {
        height: 30px;
        vertical-align: middle;
    }
</style>