@rendermode InteractiveServer

<MudNavMenu Class="polar-nav-menu" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">
        Inicio
    </MudNavLink>

    @if (userrol == 1 || userrol == 2 || userrol == 3 || userrol == 4 || userrol == 6)
    {
        <MudNavGroup Title="Sociedades Activas" Icon="@Icons.Material.Outlined.CorporateFare" Expanded="true" Class="polar-nav-group">
            <MudNavLink Href="/sociedades" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Business">Ficha Sociedad</MudNavLink>
            <MudNavLink Href="/asambleas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Groups">Asambleas</MudNavLink>
            <MudNavLink Href="/reformas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AutoStories">Reformas Estatutarias</MudNavLink>
            <MudNavLink Href="/autoridades" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Badge">Autoridades</MudNavLink>
            <MudNavLink Href="/certificaciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Verified">Certificaciones</MudNavLink>
            <MudNavLink Href="/librosocietarios" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.MenuBook">Libros Societarios</MudNavLink>
        </MudNavGroup>
    }

    @if (userrol == 1 || userrol == 2 || userrol == 4 || userrol == 6)
    {
        <MudNavGroup Title="Sociedades Inactivas" Icon="@Icons.Material.Outlined.DomainDisabled" Expanded="false" Class="polar-nav-group">
            <MudNavLink Href="/sociedadesinactivas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.BusinessCenter">Ficha Inactivas</MudNavLink>
            <MudNavLink Href="/asambleasinactivas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.GroupOff">Asambleas</MudNavLink>
            <MudNavLink Href="/reformasinactivas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.HistoryEdu">Reformas</MudNavLink>
            <MudNavLink Href="/autoridadesinactivas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.PersonOff">Autoridades</MudNavLink>
            <MudNavLink Href="/certificacionesinactivas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Verified">Certificaciones</MudNavLink>
        </MudNavGroup>
    }

    @if (userrol == 1 || userrol == 3 || userrol == 6)
    {
        <MudNavGroup Title="Accionistas" Icon="@Icons.Material.Outlined.AccountTree" Expanded="false" Class="polar-nav-group">
            <MudNavLink Href="/accionistassociedad" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Group">Accionistas Activos</MudNavLink>
            @if (userrol == 1 || userrol == 6)
            {
                <MudNavLink Href="/accionistassociedadinactivas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.GroupRemove">Accionistas Inactivos</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (userrol == 1 || userrol == 5 || userrol == 6)
    {
        <MudNavGroup Title="Dividendos" Icon="@Icons.Material.Outlined.MonetizationOn" Expanded="false" Class="polar-nav-group">
            <MudNavLink Href="/dividendospreliminares" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.HourglassTop">Dividendos Preliminares</MudNavLink>
            <MudNavLink Href="/dividendosdefinitivos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.CheckCircleOutline">Dividendos Definitivos</MudNavLink>
        </MudNavGroup>
    }

    @if (userrol == 1 || userrol == 6)
    {
        <MudNavGroup Title="Conciliaciones" Icon="@Icons.Material.Outlined.FactCheck" Expanded="false" Class="polar-nav-group">
            <MudNavLink Href="/conciliaciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.CloudUpload">Subir Archivos</MudNavLink>
        </MudNavGroup>
    }

    @if (userrol == 1 || userrol == 2)
    {
        <MudNavGroup Title="Administración" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false" Class="polar-nav-group">
            <MudNavGroup Title="Tablas Maestras" Icon="@Icons.Material.Outlined.TableChart" Expanded="false" Class="polar-nav-subgroup">
                <MudNavLink Href="/administrar/cargos">Cargos</MudNavLink>
                <MudNavLink Href="/administrar/claselibros">Clase Libros</MudNavLink>
                <MudNavLink Href="/administrar/empresas">Empresas</MudNavLink>
                <MudNavLink Href="/administrar/estatussociedad">Estatus Sociedad</MudNavLink>
                <MudNavLink Href="/administrar/nombrediarios">Nombre Diarios</MudNavLink>
                <MudNavLink Href="/administrar/regiones">Regiones</MudNavLink>
                <MudNavLink Href="/administrar/registros">Registros</MudNavLink>
                <MudNavLink Href="/administrar/tipoasambleas">Tipos de Asambleas</MudNavLink>
                <MudNavLink Href="/administrar/tiporeformas">Tipos de Reformas</MudNavLink>
                <MudNavLink Href="/administrar/tiposociedadactiva">Tipo de Sociedad Activa</MudNavLink>
                <MudNavLink Href="/administrar/tipolibros">Tipo de Libros</MudNavLink>
                <MudNavLink Href="/administrar/tipoaccionistas">Tipo de Accionistas</MudNavLink>
                <MudNavLink Href="/administrar/estatusaccionistas">Estatus Accionistas</MudNavLink>
                <MudNavLink Href="/administrar/modalidadpago">Modalidad de Pago</MudNavLink>
                <MudNavLink Href="/administrar/tipocuenta">Tipo de Cuenta</MudNavLink>
                <MudNavLink Href="/administrar/banco">Bancos</MudNavLink>
                <MudNavLink Href="/administrar/dirigidosa">Dirigidos A</MudNavLink>
                <MudNavLink Href="/administrar/estadosciviles">Estados Civiles</MudNavLink>
                <MudNavLink Href="/administrar/condicionesespeciales">Condiciones Especiales</MudNavLink>
                <MudNavLink Href="/administrar/tipodocumento">Tipos de Documentos</MudNavLink>
                <MudNavLink Href="/monedas">Monedas</MudNavLink>
            </MudNavGroup>
            
            <MudNavLink Href="/tipodocumentosoporte" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.FolderCopy">Tipos Doc. Soporte</MudNavLink>
            <MudNavLink Href="/accionistas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ContactPage">Maestro Accionistas</MudNavLink>
            <MudNavLink Href="/usuarios" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ManageAccounts">Usuarios</MudNavLink>
            <MudNavLink Href="/auditorias" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.HistoryEdu">Auditorías</MudNavLink>
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    private int userrol = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                userrol = int.Parse(userrolaux.Value);
            }
            StateHasChanged();
        }
    }
}