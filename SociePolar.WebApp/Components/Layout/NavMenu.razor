                         Padding="false"
                         Style="width: 100%; justify-content: start; font-size: 0.85rem; color: #444; font-weight: 500; padding-left: 12px;"
                         EndIcon="@Icons.Material.Filled.ChevronRight"
                         AnchorOrigin="Origin.TopRight"
                         TransformOrigin="Origin.TopLeft">
                    <ChildContent>
                        <MudMenuItem href="/sociedadesinactivas">
