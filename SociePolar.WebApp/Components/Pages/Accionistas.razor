@page "/accionistas"
@rendermode InteractiveServer
@implements IDisposable

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-person-vcard text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            Administrar Accionistas
                        </h5>
                        @if (totalRegistros > 0)
                        {
                            <small class="text-muted">Total: @totalRegistros.ToString("N0") accionistas registrados</small>
                        }
                    </div>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>

                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="MostrarDescarga"
                            style="height: 32px; font-weight: 500;" title="Generar csv">
                        <i class="bi bi-filetype-csv me-2"></i> Descargar
                    </button>

                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre o cédula/RIF..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="AccionistaMostrarDto"
                                     Items="Listgral"
                                     DefaultPageSize="50"
                                     ServerSide="true"
                                     TotalServerItems="@totalRegistros"
                                     ServerCurrentPage="@paginaActual"
                                     OnPageChanged="CambiarPagina"
                                     OnPageSizeChanged="CambiarTamanoPagina">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <!-- Columna 3: Tipo Accionista -->
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("TipoAccionista")'>
                                Tipo Accionista <i class="bi @ObtenerIconoOrden("TipoAccionista") ms-1 small"></i>
                            </th>
                            <!-- Columna 2: Nombre y Apellido -->
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("Nombre")'>
                                Nombre o Razón Social <i class="bi @ObtenerIconoOrden("Nombre") ms-1 small"></i>
                            </th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tipo Documento</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Documento de Identidad Fiscal</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Teléfono</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="text-start text-secondary small" style="width: 10%;">@p.TipoAccionistaV</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.TipoDocumentoV</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.Documento</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.Telefono</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-secondary p-0  me-2"
                                            @onclick="() => AdminDocumentos(p)" title="Documentos Soporte">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}


@if (mostrarModal)
{
    <AccionistasGuardar id="@idAccionista.ToString()" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (descarga)
{
    <ModalDescarga idModulo="7" idEstado="1" OnFinalizado="ManejarCierreDescarga" />
}

@code {
    private List<AccionistaMostrarDto> Listgral = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private AccionistaMostrarDto? entidadParaEliminar;
    private string claseAlerta = "alert-success";
    private string iconoAlerta = "bi-check-circle-fill";
    int idAccionista = 0;
    private string columnaActual = "Nombre";
    private bool ordenAscendente = true;
    private int idRol = 0;
    private bool descarga = false;

    // Control de paginación en servidor (Lazy Loading)
    private int paginaActual = 1;
    private int tamanoPagina = 50;
    private int totalRegistros = 0;
    private CancellationTokenSource? _searchCts;

    [Inject] private IAccionista repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
            {
                if (int.TryParse(userrolaux.Value, out var rolVal))
                {
                    idRol = rolVal;
                }
            }
        }
        catch
        {
            // Silencioso en prerenderizado SSR: JSInterop (SessionStorage) requiere circuito interactivo
        }
        await LoadGenericDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
                {
                    if (int.TryParse(userrolaux.Value, out var rolVal) && idRol != rolVal)
                    {
                        idRol = rolVal;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error hidratando rol en AfterRender: {ex.Message}");
            }
        }
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            var (items, totalCount) = await repository.GetPagedAsync(paginaActual, tamanoPagina, searchTerm, columnaActual, ordenAscendente);
            Listgral = items;
            totalRegistros = totalCount;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (paginaActual == nuevaPagina) return;
        paginaActual = nuevaPagina;
        await LoadGenericDataAsync();
    }

    private async Task CambiarTamanoPagina(int nuevoTamano)
    {
        tamanoPagina = nuevoTamano;
        paginaActual = 1;
        await LoadGenericDataAsync();
    }

    private void AbrirModalNuevo()
    {
        idAccionista = 0;
        mostrarModal = true;
    }

    private async Task FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        paginaActual = 1;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token); // Debounce de 300ms para evitar saturación de consultas al escribir
            if (!token.IsCancellationRequested)
            {
                await LoadGenericDataAsync();
            }
        }
        catch (TaskCanceledException)
        {
            // Ignorar cancelación por tecleo rápido
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Editar(AccionistaMostrarDto item)
    {
        idAccionista = item.Id;
        mostrarModal = true;
    }

    private void VerificarEliminar(AccionistaMostrarDto item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion("Accionista eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true;
        mostrarModal = false;

        if (guardadoExitoso)
        {
            await LoadGenericDataAsync();
            await MostrarNotificacion("Accionista guardada correctamente");
        }

        cargando = false;
    }

    private async Task OrdenarPor(string columna)
    {
        if (columnaActual == columna)
        {
            ordenAscendente = !ordenAscendente;
        }
        else
        {
            columnaActual = columna;
            ordenAscendente = true;
        }

        paginaActual = 1;
        await LoadGenericDataAsync();
    }

    private string ObtenerIconoOrden(string columna)
    {
        if (columnaActual != columna)
        {
            return "bi-arrow-down-up text-muted opacity-50";
        }
        return ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold";
    }

    private void AdminDocumentos(AccionistaMostrarDto item)
    {
        navManager.NavigateTo($"/documentossoporte/7/{item.Id}");
    }

    private void MostrarDescarga()
    {
        descarga = true;
    }

    private async Task ManejarCierreDescarga(bool guardadoExitoso)
    {
        cargando = true;
        descarga = false;
        cargando = false;

        if (guardadoExitoso)
        {
            await MostrarNotificacion("Archivo generado exitosamente");
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}

