@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                        @(entidadEditando.Id == 0 ? "Agregar Accionista Inactivos" : "Modificar Accionista Inactivos")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Pestañas de Navegación -->
                    <ul class="nav nav-tabs mb-4" id="accionistaTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active btn-sm" id="datos-tab" data-bs-toggle="tab" data-bs-target="#datos" type="button" role="tab">Datos Básicos</button>
                        </li>
                        @if (entidadEditando.TipoAccionistaId != 0)
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm" id="contacto-tab" data-bs-toggle="tab" data-bs-target="#contacto" type="button" role="tab">Contacto y Ubicación</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm" id="conyuge-tab" data-bs-toggle="tab" data-bs-target="#conyuge" type="button" role="tab">@tabConyuge</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm" id="banco-tab" data-bs-toggle="tab" data-bs-target="#banco" type="button" role="tab">Finanzas y Apoderado</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm" id="junta-tab" data-bs-toggle="tab" data-bs-target="#junta" type="button" role="tab">Junta y Otros</button>
                            </li>
                        }
                    </ul>
                    <div class="tab-content" id="accionistaTabsContent">
                        <div class="tab-pane fade show active" id="datos" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-secondary small">Sociedad</label>
                                    <div class="dropdown">
                                        <!-- Removido -sm para igualar el tamaño estándar del label -->
                                        <button class="form-select text-start d-flex justify-content-between align-items-center"
                                                type="button"
                                                style="font-size: 0.8rem;"
                                                @onclick="ToggleDropdown">
                                            <span>@(ObtenerNombreSeleccionado())</span>
                                        </button>

                                        <ul class="dropdown-menu w-100 p-2 @(isDropdownOpen ? "show" : "")"
                                            style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                            <li class="mb-2">
                                                <!-- Cambiado a form-control normal para que la fuente de "Buscar..." coincida en tamaño -->
                                                <input type="text"
                                                       class="form-control"
                                                       placeholder="Buscar..."
                                                       style="font-size: 0.8rem;"
                                                       @bind="textoBusqueda"
                                                       @bind:event="oninput"
                                                       @ref="searchInputRef" />
                                            </li>

                                            <li>
                                                <button type="button"
                                                        class="dropdown-item @(entidadEditando.SociedadId == 0 ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarOpción(0)">
                                                    Seleccione ...
                                                </button>
                                            </li>

                                            <!-- Opciones filtradas dinámicamente -->
                                            @if (listSociedad != null)
                                            {
                                                @foreach (var sociedad in listSociedad.Where(s => string.IsNullOrEmpty(textoBusqueda) || s.Empresa.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <li>
                                                        <!-- Se reemplazó 'small' por 'style="font-size: 0.8rem;"' para forzar la letra más pequeña -->
                                                        <button type="button"
                                                                class="dropdown-item @(entidadEditando.SociedadId == sociedad.Id ? "active bg-primary text-white" : "")"
                                                                style="font-size: 0.8rem;"
                                                                @onclick="() => SeleccionarOpción(sociedad.Id)">
                                                            @sociedad.Empresa.Nombre
                                                        </button>
                                                    </li>
                                                }
                                            }

                                        </ul>
                                    </div>

                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-secondary small">Tipo Accionista</label>
                                    <InputSelect class="form-select form-select-sm"
                                                 ValueExpression="@(() => entidadEditando.TipoAccionistaId)"
                                                 Value="@entidadEditando.TipoAccionistaId"
                                                 ValueChanged="@((int? val) => OnTipoChanged(val))">
                                        <option value="0">Seleccione ...</option>
                                        @if (listTipoAccionista != null)
                                        {
                                            @foreach (var tipo in listTipoAccionista)
                                            {
                                                <option value="@tipo.Id">@tipo.Nombre</option>
                                            }
                                        }
                                    </InputSelect>
                                </div> 
                                @if (entidadEditando.TipoAccionistaId != 0)
                                {
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Estatus Accionista</label>
                                        <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.EstatusAccionistaId">
                                            <option value="0">Seleccione ...</option>
                                            @if (listEstatusAccionista != null)
                                            {
                                                @foreach (var estatus in listEstatusAccionista)
                                                {
                                                    <option value="@estatus.Id">@estatus.Nombre</option>
                                                }
                                            }
                                        </InputSelect>
                                    </div>
                                    @if (entidadEditando.TipoAccionistaId == 1)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Nombre</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.Nombre"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="200" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Tax Id</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.Cedula"
                                                       placeholder="Ingrese número de documento..."
                                                       maxlength="20"
                                                       inputmode="numeric"
                                                       oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Emisión</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaEmision" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaVencimiento" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Otro Documento</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.OtroDocumento"
                                                       placeholder="Ingrese número de documento..."
                                                       maxlength="20"
                                                       inputmode="numeric"
                                                       oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Emisión Otro</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaEmisionOtro" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento Otro</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaVencimientoOtro" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                        </div>
                                    }
                                    @if (entidadEditando.TipoAccionistaId == 3)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Nombre Sucesión</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.NombreSusesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Tax Id Sucesión</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.CedulaSusesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Emisión</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.FechaEmisionSucesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.FechaVencimientoSucesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Otro Documento Sucesión</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.OtroDocumentoSucesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Emisión Otro</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.FechaEmisionOtroSucesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento Otro</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.FechaVencimientoOtroSucesion"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="2000" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                        </div>
                                    }

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Rif</label>
                                        <InputText type="text" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.Rif"
                                                   placeholder="Ingrese número de rif..."
                                                   maxlength="20"
                                                   inputmode="numeric"
                                                   oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Fecha de Emisión Rif</label>
                                        <input type="date" class="form-control form-control-sm small"
                                               @bind="entidadEditando.FechaEmisionRif" @bind:format="yyyy-MM-dd" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento Rif</label>
                                        <input type="date" class="form-control form-control-sm small"
                                               @bind="entidadEditando.FechaVencimientoRif" @bind:format="yyyy-MM-dd" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                    </div>
                                    @if (entidadEditando.TipoAccionistaId == 2)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Nombre del Representante Legal</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.Nombre"
                                                       placeholder="Ingrese nombre..."
                                                       maxlength="200" />
                                            <ValidationMessage For="@(() => entidadEditando.Nombre)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Tax Id del Representante Legal</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.Cedula"
                                                       placeholder="Ingrese número de documento..."
                                                       maxlength="20"
                                                       inputmode="numeric"
                                                       oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                            <ValidationMessage For="@(() => entidadEditando.Cedula)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Emisión</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaEmision" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaVencimiento" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Otro Documento</label>
                                            <InputText type="text" class="form-control form-control-sm small"
                                                       @bind-Value="entidadEditando.OtroDocumento"
                                                       placeholder="Ingrese número de documento..."
                                                       maxlength="20"
                                                       inputmode="numeric"
                                                       oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Emisión Otro</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaEmisionOtro" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento Otro</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaVencimientoOtro" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Años de duración de la compañía</label>
                                            <InputNumber class="form-control form-control-sm small"
                                                         @bind-Value="entidadEditando.AnoDuracion"
                                                         placeholder="Ingrese años de duración..."
                                                         maxlength="3"
                                                         inputmode="numeric"
                                                         oninput="if(this.value.length > 3) this.value = this.value.slice(0, 3);" />
                                        </div>
                                        <div class="col-md-10 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Junta Directiva</label>
                                            <textarea class="form-control form-control-sm small"
                                                      @bind="entidadEditando.JuntaDirectiva"
                                                      @bind:event="oninput"
                                                      rows="4"
                                                      maxlength="4000"
                                                      placeholder="Ingrese la junta directiva (máximo 4,000 caracteres)...">
                                            </textarea>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Años de Vigencia de la Junta</label>
                                            <InputNumber class="form-control form-control-sm small"
                                                         @bind-Value="entidadEditando.VigenciaJunta"
                                                         placeholder="Ingrese años de vigencia..."
                                                         maxlength="2"
                                                         inputmode="numeric"
                                                         oninput="if(this.value.length > 2) this.value = this.value.slice(0, 2);" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento de la Junta</label>
                                            <input type="date" class="form-control form-control-sm small"
                                                   @bind="entidadEditando.FechaVencimientoJunta" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="col-md-10 mb-3">
                                            <label class="form-label fw-bold text-secondary small">Registrada En</label>
                                            <textarea class="form-control form-control-sm small"
                                                      @bind="entidadEditando.JuntaDirectiva"
                                                      @bind:event="oninput"
                                                      rows="4"
                                                      maxlength="2000"
                                                      placeholder="Ingrese donde esta registrada la junta (máximo 2,000 caracteres)...">
                                            </textarea>
                                        </div>
                                    }
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Dirigido A</label>
                                        <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.DirigidoAId">
                                            <option value="0">Seleccione ...</option>
                                            @if (listDirigidoA != null)
                                            {
                                                @foreach (var item in listDirigidoA)
                                                {
                                                    <option value="@item.Id">@item.Nombre</option>
                                                }
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Estado Civil</label>
                                        <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.EstadoCivilId">
                                            <option value="0">Seleccione ...</option>
                                            @if (listEstadoCivil != null)
                                            {
                                                @foreach (var estado in listEstadoCivil)
                                                {
                                                    <option value="@estado.Id">@estado.Nombre</option>
                                                }
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Nacionalidad</label>
                                        <InputText type="text" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.Nacionalidad"
                                                   placeholder="Ingrese la nacionalidad..."
                                                   maxlength="200" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Fecha de Nacimiento</label>
                                        <input type="date" class="form-control form-control-sm small"
                                               @bind="entidadEditando.FechaNacimiento" @bind:format="yyyy-MM-dd" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Fecha de Ingreso</label>
                                        <input type="date" class="form-control form-control-sm small"
                                               @bind="entidadEditando.FechaIngreso" @bind:format="yyyy-MM-dd" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Última Actualización</label>
                                        <input type="date" class="form-control form-control-sm small"
                                               @bind="entidadEditando.UltimaActualizacion" @bind:format="yyyy-MM-dd" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Año Actualización</label>
                                        <InputNumber class="form-control form-control-sm small"
                                                     @bind-Value="entidadEditando.AnoActualizacion"
                                                     placeholder="Ingrese año actualización..."
                                                     maxlength="4"
                                                     inputmode="numeric"
                                                     oninput="if(this.value.length > 4) this.value = this.value.slice(0, 4);" />
                                    </div>
                                    <div class="col-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">¿Hace falta actualizar?</label>
                                        <div class="form-check form-check-inline">
                                            <input type="radio"
                                                   name="faltaGroup"
                                                   id="faltaSi"
                                                   class="form-check-input"
                                                   value="1"
                                                   checked="@(entidadEditando.FaltaActualizar == 1)" />
                                            <label class="form-check-label small text-secondary" for="faltaSi">Sí</label>
                                        </div>

                                        <div class="form-check form-check-inline">
                                            <input type="radio"
                                                   name="faltaGroup"
                                                   id="faltaNo"
                                                   class="form-check-input"
                                                   value="0"
                                                   checked="@(entidadEditando.FaltaActualizar == 0)" />
                                            <label class="form-check-label small text-secondary" for="faltaNo">No</label>
                                        </div>
                                    </div>
                                }
                                @if (mensajeAlerta != string.Empty)
                                {
                                    <div class="col-md-10 mb-3">
                                        @* Se agregó style="white-space: pre-line;" *@
                                        <label class="form-label fw-bold text-danger small" style="white-space: pre-line;">@mensajeAlerta</label>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="tab-pane" id="contacto" role="tabpanel">
                            <div class="row">
                                @if (entidadEditando.TipoAccionistaId != 0)
                                {
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Email 1</label>
                                        <InputText type="email" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.Email1"
                                                   placeholder="ejemplo@correo.com"
                                                   maxlength="100"
                                                   inputmode="email" />

                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Email 2</label>
                                        <InputText type="email" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.Email2"
                                                   placeholder="ejemplo@correo.com"
                                                   maxlength="100"
                                                   inputmode="email" />

                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Email 3</label>
                                        <InputText type="email" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.Email3"
                                                   placeholder="ejemplo@correo.com"
                                                   maxlength="100"
                                                   inputmode="email" />

                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Teléfono Móvil</label>
                                        <InputText type="text" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.TelefonoMovil"
                                                   placeholder="Ingrese número de teléfono móvil..."
                                                   maxlength="20"
                                                   inputmode="numeric"
                                                   oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Teléfono 1</label>
                                        <InputText type="text" class="form-control form-control-sm small"
                                                   @bind-Value="entidadEditando.Telefono1"
                                                   placeholder="Ingrese número de teléfono..."
