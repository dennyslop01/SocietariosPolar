                    FechaEmisionSucesion = entity.FechaEmisionSucesion,
                    FechaVencimientoSucesion = entity.FechaVencimientoSucesion,
                    OtroDocumentoSucesion = entity.OtroDocumentoSucesion,
                    FechaEmisionOtroSucesion = entity.FechaEmisionOtroSucesion,
                    FechaVencimientoOtroSucesion = entity.FechaVencimientoOtroSucesion,
                    CreateDate = entity.CreateDate,
                    CreateUserId = entity.CreateUserId,
                    UpdateDate = entity.UpdateDate,
                    UpdateUserId = entity.UpdateUserId,
                    EstatusAccionistaId = entity.EstatusAccionista?.Id,
                };

                entidadEditando = dto;
                editContext = new EditContext(entidadEditando);
            }
            catch (Exception ex)
            {
                await MostrarNotificacion("No se pudieron cargar los datos", true);
            }
        }
        cargando = false;
    }

    public async Task<List<IBaseEntity>> GetEntityListAsync(string entityName)
    {
        var repo = RepoFactory.GetRepository(entityName);
        var method = repo.GetType().GetMethod("GetAllAsync");

        if (method == null) return new List<IBaseEntity>();

        // Invocamos el método asíncrono
        var task = (Task)method.Invoke(repo, null)!;
        await task;

        // Obtenemos el resultado de la Task dinámica
        var resultProperty = task.GetType().GetProperty("Result");
        var result = (IEnumerable<IBaseEntity>)resultProperty!.GetValue(task)!;

        return result.ToList();
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            listTipoAccionista = await GetEntityListAsync("tipoaccionistas");
            listDirigidoA = await GetEntityListAsync("dirigidosa");
            listEstadoCivil = await GetEntityListAsync("estadosciviles");
            listBanco = await GetEntityListAsync("banco");
            listTipoCuenta = await GetEntityListAsync("tipocuenta");
            listCondicionEspecial = await GetEntityListAsync("condicionesespeciales");
            listEstatusAccionista = await GetEntityListAsync("estatusaccionistas");
            listEstatusAccionista = listEstatusAccionista.Where(x => x.Id != 1).ToList(); // Solo inactivos

            var listSociedades = await reposociedad.GetAllAsync();
            listSociedad = listSociedades.OrderBy(x => x.Empresa.Nombre).ToList();//.Where(x => x.EstatusSociedad.Id == 1)

            listAccionista = await repository.GetAllAsync();
        }
        catch (Exception ex)
