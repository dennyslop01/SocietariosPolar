    private async Task GuardarCambios()
    {
        mensajeAlerta = string.Empty;

        bool formularioValido = editContext.Validate();

        if (!formularioValido)
        {
            StateHasChanged();
            cargando = false;
            return;
        }

        if (entidadEditando.SociedadId == 0)
        {
            mensajeAlerta = "La sociedad es obligatoria \n";
        }
        if (entidadEditando.TipoAccionistaId == 0)
        {
            mensajeAlerta += "El tipo de accionista es obligatorio \n";
        }
        if (entidadEditando.EstatusAccionistaId == 0)
        {
            mensajeAlerta += "El estatus del accionista es obligatorio \n";
        }
        if (entidadEditando.TipoAccionistaId == 1 || entidadEditando.TipoAccionistaId == 2)
        {
            if (string.IsNullOrEmpty(entidadEditando.Nombre))
            {
                mensajeAlerta += "El nombre es obligatorio \n";
            }
            if (string.IsNullOrEmpty(entidadEditando.Cedula))
            {
                mensajeAlerta += "La tax id es obligatoria \n";
            }
        }
        if (entidadEditando.TipoAccionistaId == 3)
        {
            if (string.IsNullOrEmpty(entidadEditando.NombreSusesion))
            {
                mensajeAlerta += "El nombre sucesión es obligatorio \n";
            }
            if (string.IsNullOrEmpty(entidadEditando.CedulaSusesion))
            {
                mensajeAlerta += "La yax id sucesión es obligatoria \n";
            }
        }

        if (!string.IsNullOrEmpty(mensajeAlerta))
        {
            await MostrarNotificacion(mensajeAlerta, true);
            await jsRuntime.InvokeVoidAsync("eval", @"
                                                window.scrollTo({ top: 0, behavior: 'smooth' });
                                                document.querySelector('.main')?.scrollTo({ top: 0, behavior: 'smooth' });
                                                document.querySelector('main')?.scrollTo({ top: 0, behavior: 'smooth' });
                                                document.body.scrollTo({ top: 0, behavior: 'smooth' });
                                            ");
            return;
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    cargando = true;
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Accionista guardada correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
                else
                {
                    cargando = true;
                    repository.Update(entidadEditando);

                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Accionista actualizado correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
            }
        }
        catch (Exception ex)
        {
            // Si hay error en base de datos (ej. nombre duplicado)
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        cargando = false;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

