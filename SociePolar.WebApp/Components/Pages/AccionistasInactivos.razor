@page "/accionistasinactivas"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-person-vcard text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Accionistas Inactivos
                    </h5>
                </div>

                <!-- Parte Derecha: Botón Agregar -->
                <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="AbrirModalNuevo"
                        style="height: 32px; font-weight: 500;">
                    <i class="bi bi-plus-lg me-2"></i> Agregar
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="Accionista" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <!-- Columna 1: Sociedad -->
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("Sociedad")'>
                                Sociedad <i class="bi @ObtenerIconoOrden("Sociedad") ms-1 small"></i>
                            </th>
                            <!-- Columna 2: Nombre y Apellido -->
                            <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("Nombre")'>
                                Nombre y Apellido <i class="bi @ObtenerIconoOrden("Nombre") ms-1 small"></i>
                            </th>
                            <!-- Columna 3: Tipo Accionista -->
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("TipoAccionista")'>
                                Tipo Accionista <i class="bi @ObtenerIconoOrden("TipoAccionista") ms-1 small"></i>
                            </th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nro. Acciones</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">% Participación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        @{
                            var index = Listgral.IndexOf(p);

                            // 1. Ruptura para Sociedad
                            bool esNuevaSociedad = index == 0 ||
                                                   Listgral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;
                        }

                        @if (esNuevaSociedad)
                        {
                            <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                            <tr class="table-secondary fw-bold text-primary border-bottom">
                                <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                    🏢 @p.Sociedad?.Empresa?.Nombre
                                </td>
                            </tr>
                        }

                        <tr class="align-middle border-bottom">
                            <td class="text-muted small ps-3" style="width: 20%;">-</td>
                            <td class="text-start text-secondary small" style="width: 20%;">@p.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.TipoAccionista?.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Cedula</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Telefono1</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                    <i class="bi bi-pencil-square fs-6"></i>
                                </button>
                                <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                    <i class="bi bi-trash3 fs-6"></i>
                                </button>
                                <button class="btn btn-link btn-sm text-secondary p-0 me-2"
                                        @onclick="() => VerificarActivar(p)" title="Activar Sociedad">
                                    <i class="bi bi-check2-circle fs-6"></i>
                                </button>
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}


@if (mostrarModal)
{
    <AccionistasInactivaGuardar id="@idAccionista.ToString()" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Sociedad.Empresa.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalActivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-secondary fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a activar <strong>@entidadParaEliminar?.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalActivar">Cancelar</button>
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="ConfirmarActivar">Activar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Accionista> Listgral = new();
    private List<Accionista> ListgralBuscar = new();
    private string searchTerm = ""; private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private Accionista? entidadParaEliminar;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    int idAccionista = 0;
    private string columnaActual = "";
    private bool ordenAscendente = true;
    private bool mostrarModalActivar = false;

    [Inject] private IAccionista repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var listAaccionista = await repository.GetAllAsync();
            Listgral = listAaccionista.OrderBy(x => x.Sociedad.Empresa.Nombre).Where(x => x.Sociedad.EstatusSociedad.Id == 1 && x.EstatusAccionista.Id != 1).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        idAccionista = 0;
        mostrarModal = true;
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Sociedad.Empresa.Nombre != null && b.Sociedad.Empresa.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (Listgral.Count() == 0)
            {
                Listgral = ListgralBuscar
                .Where(b => b.Nombre != null && b.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
            }
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Editar(Accionista item)
    {
        idAccionista = item.Id;
        mostrarModal = true;
    }

    private void VerificarEliminar(Accionista item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Accionista eliminado correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private void VerificarActivar(Accionista item)
    {
        entidadParaEliminar = item;
        mostrarModalActivar = true;
    }

    private void CerrarModalActivar() => mostrarModalActivar = false;

    private async Task ConfirmarActivar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Activar(entidadParaEliminar.Id, 1); // 1 para activar
            mostrarModalActivar = false;
            await MostrarNotificacion($"");
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Sociedad activada correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al activar: {ex.Message}");
            await MostrarNotificacion("No se pudo activar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Accionista guardada correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    private void OrdenarPor(string columna)
    {
        if (Listgral == null || !Listgral.Any()) return;

        // Si hace clic en la misma columna, invierte el sentido; si es otra, empieza en ascendente
        if (columnaActual == columna)
        {
            ordenAscendente = !ordenAscendente;
        }
        else
        {
            columnaActual = columna;
            ordenAscendente = true;
        }

        // Ejecutar el ordenamiento según la columna seleccionada
        if (columna == "Sociedad")
        {
            Listgral = ordenAscendente
                ? Listgral.OrderBy(x => x.Sociedad?.Empresa?.Nombre ?? "").ToList()
                : Listgral.OrderByDescending(x => x.Sociedad?.Empresa?.Nombre ?? "").ToList();
        }
        else if (columna == "Nombre")
        {
            Listgral = ordenAscendente
                ? Listgral.OrderBy(x => x.Nombre ?? "").ToList()
                : Listgral.OrderByDescending(x => x.Nombre ?? "").ToList();
        }
        else if (columna == "TipoAccionista")
        {
            Listgral = ordenAscendente
                ? Listgral.OrderBy(x => x.TipoAccionista?.Nombre ?? "").ToList()
                : Listgral.OrderByDescending(x => x.TipoAccionista?.Nombre ?? "").ToList();
        }

        StateHasChanged(); // Forzar el refresco visual de la grilla en Blazor
    }

    // Método auxiliar para alternar los íconos de Bootstrap Icons (bi)
    private string ObtenerIconoOrden(string columna)
    {
        if (columnaActual != columna)
        {
            return "bi-arrow-down-up text-muted opacity-50"; // Ícono neutral
        }
        return ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold";
    }
}