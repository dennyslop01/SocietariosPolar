@page "/accionistassociedad"

@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-person-vcard text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Accionistas - Sociedades Activas
                    </h5>
                </div>

                <!-- Parte Derecha: Botón Agregar -->
                <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="AbrirModalNuevo"
                        style="height: 32px; font-weight: 500;">
                    <i class="bi bi-plus-lg me-2"></i> Agregar
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Controles Superiores: Expandir/Colapsar y Buscador -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm me-2 shadow-sm" @onclick="ExpandirTodo" title="Expandir todo en esta página">
                        <i class="bi bi-arrows-angle-expand me-1"></i> Expandir Todo
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ColapsarTodo" title="Colapsar todo en esta página">
                        <i class="bi bi-arrows-angle-contract me-1"></i> Colapsar Todo
                    </button>
                </div>
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponentAccionista TItem="AccionistaSociedadVerDto" 
                                     Items="Listgral" 
                                     DefaultPageSize="50"
                                     IsServerSide="true"
                                     ServerTotalItems="@TotalItems"
                                     OnPageChanged="HandlePageChanged"
                                     OnPageSizeChanged="HandlePageSizeChanged">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <!-- Columna 1: Sociedad -->
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("Sociedad")'>
                                Sociedad <i class="bi @ObtenerIconoOrden("Sociedad") ms-1 small"></i>
                            </th>
                            <!-- Columna 3: Tipo Accionista -->
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("TipoAccionista")'>
                                Tipo Accionista <i class="bi @ObtenerIconoOrden("TipoAccionista") ms-1 small"></i>
                            </th>
                            <!-- Columna 2: Nombre y Apellido -->
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem; cursor: pointer; user-select: none;" @onclick='() => OrdenarPor("Nombre")'>
                                Nombre y Apellido <i class="bi @ObtenerIconoOrden("Nombre") ms-1 small"></i>
                            </th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Nro. Acciones</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">% Participación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        @{
                            var index = Listgral.IndexOf(p);

                            // 1. Ruptura para Sociedad
                            bool esNuevaSociedad = index == 0 ||
                                                   Listgral[index - 1].SociedadNombre != p.SociedadNombre;
                        }

                        @if (esNuevaSociedad)
                        {
                            long granTotalAcciones = totalesGlobalesPorSociedad.ContainsKey(p.SociedadId) ? totalesGlobalesPorSociedad[p.SociedadId] : 0;
                            int granTotalAccionistas = totalAccionistasPorSociedad.ContainsKey(p.SociedadId) ? totalAccionistasPorSociedad[p.SociedadId] : 0;
                            var totalParticipacionVisible = Listgral.Where(x => x.SociedadNombre == p.SociedadNombre).Sum(x => x.Participacion ?? 0);
                            bool colapsado = sociedadesColapsadas.Contains(p.SociedadNombre ?? "");

                            <tr class="align-middle border-bottom" @onclick='() => ToggleSociedad(p.SociedadNombre ?? "")' style="cursor: pointer;" title="Clic para expandir/colapsar">
                                <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace text-secondary" style="text-align: left !important; font-size: 0.9rem; letter-spacing: 0.5px;">
                                    <i class="bi @(colapsado ? "bi-chevron-right" : "bi-chevron-down") me-2 text-primary fw-bold"></i>
                                    🏢 @p.SociedadNombre
                                    <span class="float-end badge bg-white text-dark border shadow-sm me-3 mt-1" style="font-size: 0.75rem;">
                                        Total: @UtilClass.FormatearMiles(granTotalAcciones) acciones y @UtilClass.FormatearMiles(granTotalAccionistas) accionistas
                                    </span>
                                </td>
                            </tr>
                        }
                        
                        @if (!sociedadesColapsadas.Contains(p.SociedadNombre ?? ""))
                        {
                        <tr class="align-middle border-bottom">
                            <td class="text-start text-dark fw-semibold small ps-3" style="width: 15%;">
                                -@* @(p.SociedadNombre ?? "-") *@
                            </td>
                            <td class="text-start text-secondary small" style="width: 15%;">
                                <span class="badge bg-light text-dark border">@(p.TipoAccionistaNombre ?? "-")</span>
                            </td>
                            <td class="text-start text-secondary small" style="width: 15%;">
                                @if (p.EsCustodio)
                                {
                                    <button @onclick="() => ToggleCustodiados(p)" class="btn btn-sm btn-link p-0 text-decoration-none me-2" title="Ver sub-accionistas custodiados">
                                        <i class="bi @(p.MostrarCustodiados ? "bi-dash-square-fill" : "bi-plus-square-fill") text-primary"></i>
                                    </button>
                                }
                                @p.AccionistaNombre
                            </td>
                            <td class="text-start text-secondary small" style="width: 10%;">@UtilClass.FormatearMiles(p.NroAcciones)</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.Participacion</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => VerTitulos(p)" title="Ver Títulos">
                                    <i class="bi bi-file-medical fs-6"></i>
                                </button>
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2"
                                    @onclick="() => VerificarInactivar(p)" title="Inactivar">
                                        <i class="bi bi-x-circle fs-6"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (p.MostrarCustodiados && p.SubCustodiados.Any())
                        {
                            <tr>
                                <td colspan="8" class="p-0 border-0">
                                    <div class="bg-light p-2 shadow-inner">
                                        <table class="table table-sm table-bordered m-0 bg-white" style="font-size: 0.85rem;">
                                            <thead class="table-secondary text-start">
                                                <tr>
                                                    <th class="ps-3" style="width: 40%;">Sub-Accionista</th>
                                                    <th style="width: 30%;">Tipo</th>
                                                    <th style="width: 30%;">Acciones Custodiadas</th>
                                                </tr>
                                            </thead>
                                            <tbody class="text-start">
                                                @foreach (var sub in p.SubCustodiados)
                                                {
                                                    <tr>
                                                        <td class="ps-3"><i class="bi bi-person-badge me-2 text-muted"></i>@sub.AccionistaNombre</td>
                                                        <td>@sub.TipoAccionistaNombre</td>
                                                        <td>@UtilClass.FormatearMiles(sub.NroAcciones ?? 0)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                        }
                    </ChildContentRow>
                </PaginationComponentAccionista>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}


@if (mostrarModal)
{
    <AccionistasSociedadesGuardar id="@idAccionista.ToString()" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.AccionistaNombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalInactivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a inactivar <strong>@entidadParaEliminar?.AccionistaNombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalInactivar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarInactivar">Inactivar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AccionistaSociedadVerDto> Listgral = new();
    private List<AccionistaSociedadVerDto> ListgralBuscar = new();
    private string searchTerm = ""; private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private AccionistaSociedadVerDto? entidadParaEliminar;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    int idAccionista = 0;
    private string columnaActual = "";
    private bool ordenAscendente = true;
    private bool mostrarModalInactivar = false;
    private int idRol = 0;

    // Variables de paginación server-side
    private int TotalItems = 0;
    private int currentPage = 1;
    private int currentSize = 50;
    private HashSet<string> sociedadesColapsadas = new();
    private Dictionary<int, long> totalesGlobalesPorSociedad = new();
    private Dictionary<int, int> totalAccionistasPorSociedad = new();
    private HashSet<int> accionistasQueSonCustodios = new();

    [Inject] private IAccionistaSociedad repository { get; set; } = null!;
    [Inject] private ITitulo repotitulo { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }
        await LoadGenericDataAsync();
    }

    private async Task HandlePageChanged(int newPage)
    {
        currentPage = newPage;
        await LoadGenericDataAsync();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        currentSize = newSize;
        currentPage = 1;
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            List<AccionistaSociedadVerDto> listNewAccionista = new();
            var paginatedResult = await repository.GetPaginatedAsync(1, currentPage, currentSize, searchTerm);
            TotalItems = paginatedResult.TotalCount;
            var listAaccionista = paginatedResult.Items;
            
            var listTitulos = await repotitulo.GetAllAsync(); // Idealmente esto también debería optimizarse, pero por ahora se mantiene

            foreach (var item in listAaccionista)
            {
                Int64 nroacciones = 0;
                decimal porcparticipa = 0;
                Int64 accionesaux = 0;
                if (item.NroAcciones != null)
                {
                    accionesaux = (Int64)item.NroAcciones;
                }

                var titulos = listTitulos.Where(x => x.AccionistaSociedad.Id == item.Id);
                if (titulos != null && titulos.Count() > 0)
                {
                    nroacciones = (Int64) titulos.Where(x => x.Anulado != 1).Sum(x => x.Acciones);

                    if(nroacciones > 0)
                    {
                        if (nroacciones != accionesaux)
                        {
                            await repository.UpdateNroAccionesAsync(item.Accionista.Id, item.Sociedad.Id, nroacciones, item.UpdateUserId, 0);
                        }
                    }
                }                

                if (item.Sociedad != null)
                {
                    if (item.Sociedad.NumeroAcciones != null)
                    {
                        porcparticipa = Math.Round((decimal)((nroacciones != 0) ? nroacciones : accionesaux) / Int64.Parse(item.Sociedad.NumeroAcciones) * 100, 8);
                    }
                }

                AccionistaSociedadVerDto accionista = new()
                {
                    Id = item.Id,
                    SociedadId = item.Sociedad.Id, // <- Modificamos esto en el DTO en un paso anterior o usaremos item.Sociedad.Id? No, el Dto no tiene SociedadId, usaremos otra forma.
                    AccionistaId = item.Accionista.Id,
                    SociedadNombre = item.Sociedad?.Empresa?.Nombre,
                    TipoAccionistaNombre = item.Accionista?.TipoAccionista?.Nombre,
                    AccionistaNombre = (item.Accionista?.TipoAccionista?.Id != 3) ? item.Accionista?.Nombre : (item.Accionista?.NombreSusesion?.Length > 50) ? item.Accionista.NombreSusesion.Substring(0, 50) : item.Accionista?.NombreSusesion,
                    NroAcciones = (nroacciones != 0) ? nroacciones : accionesaux,
                    Participacion = porcparticipa,
                    CreateDate = item.CreateDate,
                    UpdateDate = item.UpdateDate
                };

                listNewAccionista.Add(accionista);
            }

            // Precargar el Gran Total desde BD para cada sociedad en pantalla
            var sociedadesUnicasEnPantalla = listAaccionista.Select(x => x.Sociedad).Where(s => s != null).DistinctBy(s => s.Id).ToList();
            accionistasQueSonCustodios.Clear();
            foreach(var s in sociedadesUnicasEnPantalla)
            {
                if(!totalesGlobalesPorSociedad.ContainsKey(s.Id))
                {
                    long totalReal = await repository.GetTotalAccionesBySociedadIdAsync(s.Id);
                    totalesGlobalesPorSociedad[s.Id] = totalReal;
                    int totalAccionistas = await repository.GetTotalAccionistasBySociedadIdAsync(s.Id);
                    totalAccionistasPorSociedad[s.Id] = totalAccionistas;
                }

                var custodiosId = await repository.GetCustodiosIdBySociedadAsync(s.Id);
                foreach (var cid in custodiosId) accionistasQueSonCustodios.Add(cid);
            }

            foreach(var dto in listNewAccionista)
            {
                // CustodioId guarda el Id de la relación (AccionistaSociedad.Id), NO el del Accionista
                if (accionistasQueSonCustodios.Contains(dto.Id))
                {
                    dto.EsCustodio = true;
                }
            }

            // Ya no hacemos OrderBy en memoria porque el repositorio lo trae ordenado
            Listgral = listNewAccionista;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        idAccionista = 0;
        mostrarModal = true;
    }

    private async Task FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadGenericDataAsync();
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Editar(AccionistaSociedadVerDto item)
    {
        idAccionista = item.Id;
        mostrarModal = true;
    }

    private void VerTitulos(AccionistaSociedadVerDto item)
    {
        navManager.NavigateTo($"/vertitulos/{item.Id}");
    }
    
    private void VerificarEliminar(AccionistaSociedadVerDto item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Accionista - Sociedad eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private void VerificarInactivar(AccionistaSociedadVerDto item)
    {
        entidadParaEliminar = item;
        mostrarModalInactivar = true;
    }

    private void CerrarModalInactivar() => mostrarModalInactivar = false;

    private async Task ConfirmarInactivar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Activar(entidadParaEliminar.Id, 2); // 2 para inactivar
            mostrarModalInactivar = false;
            await MostrarNotificacion($"");
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Accionista - Sociedad inactivado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al inactivar: {ex.Message}");
            await MostrarNotificacion("No se pudo inactivar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Accionista - Sociedad guardada correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    private async Task ToggleCustodiados(AccionistaSociedadVerDto p)
    {
        p.MostrarCustodiados = !p.MostrarCustodiados;

        if (p.MostrarCustodiados && !p.SubCustodiados.Any())
        {
            var custodiadosDb = await repository.GetCustodiadosAsync(p.SociedadId, p.Id);
            p.SubCustodiados = custodiadosDb.Select(x => new AccionistaSociedadVerDto
            {
                Id = x.Id,
                AccionistaId = x.Accionista?.Id ?? 0,
                AccionistaNombre = (x.Accionista?.TipoAccionista?.Id != 3) ? x.Accionista?.Nombre : x.Accionista?.NombreSusesion,
                TipoAccionistaNombre = x.Accionista?.TipoAccionista?.Nombre,
                NroAcciones = x.NroAcciones
            }).ToList();
        }
    }

    private void ToggleSociedad(string nombreSociedad)
    {
        if (sociedadesColapsadas.Contains(nombreSociedad))
        {
            sociedadesColapsadas.Remove(nombreSociedad);
        }
        else
        {
            sociedadesColapsadas.Add(nombreSociedad);
        }
        StateHasChanged();
    }

    private void ExpandirTodo()
    {
        sociedadesColapsadas.Clear();
        StateHasChanged();
    }

    private void ColapsarTodo()
    {
        foreach (var item in Listgral)
        {
            if (!string.IsNullOrEmpty(item.SociedadNombre))
            {
                sociedadesColapsadas.Add(item.SociedadNombre);
            }
        }
        StateHasChanged();
    }

    private void OrdenarPor(string columna)
    {
        if (Listgral == null || !Listgral.Any()) return;

        // Si hace clic en la misma columna, invierte el sentido; si es otra, empieza en ascendente
        if (columnaActual == columna)
        {
            ordenAscendente = !ordenAscendente;
        }
        else
        {
            columnaActual = columna;
            ordenAscendente = true;
        }

        // Ejecutar el ordenamiento según la columna seleccionada
        if (columna == "Sociedad")
        {
            Listgral = ordenAscendente
                ? Listgral.OrderBy(x => x.SociedadNombre ?? "").ToList()
                : Listgral.OrderByDescending(x => x.SociedadNombre ?? "").ToList();
        }
        else if (columna == "Nombre")
        {
            Listgral = ordenAscendente
                ? Listgral.OrderBy(x => x.AccionistaNombre ?? "").ToList()
                : Listgral.OrderByDescending(x => x.AccionistaNombre ?? "").ToList();
        }
        else if (columna == "TipoAccionista")
        {
            Listgral = ordenAscendente
                ? Listgral.OrderBy(x => x.TipoAccionistaNombre ?? "").ToList()
                : Listgral.OrderByDescending(x => x.TipoAccionistaNombre ?? "").ToList();
        }

        StateHasChanged(); // Forzar el refresco visual de la grilla en Blazor
    }

    // Método auxiliar para alternar los íconos de Bootstrap Icons (bi)
    private string ObtenerIconoOrden(string columna)
    {
        if (columnaActual != columna)
        {
            return "bi-arrow-down-up text-muted opacity-50"; // Ícono neutral
        }
        return ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold";
    }
} 
