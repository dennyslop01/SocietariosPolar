@page "/accionistassociedad"

@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-person-vcard text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            Accionistas - Sociedades Activas
                        </h5>
                        <small class="text-muted">Vista agrupada estilo Lotus Notes (@gruposFiltrados.Count sociedades)</small>
                    </div>
                </div>

                <!-- Parte Derecha: Botón Agregar -->
                <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="AbrirModalNuevo"
                        style="height: 32px; font-weight: 500;">
                    <i class="bi bi-plus-lg me-2"></i> Agregar
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Controles Superiores: Expandir/Colapsar y Buscador -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6 d-flex align-items-center">
                    <button class="btn btn-outline-secondary btn-sm me-2 shadow-sm" @onclick="ExpandirTodo" title="Expandir todas las sociedades">
                        <i class="bi bi-arrows-angle-expand me-1"></i> Expandir Todo
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ColapsarTodo" title="Colapsar todas las sociedades">
                        <i class="bi bi-arrows-angle-contract me-1"></i> Colapsar Todo
                    </button>
                </div>
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por accionista o sociedad..."
                               @bind="searchTerm"
                               @bind:event="oninput"
                               @bind:after="FiltrarGrupos" />
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <button class="btn btn-outline-secondary border-start-0 bg-white" @onclick="LimpiarBusqueda">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Tabla Agrupada Estilo Lotus Notes -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 border">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Tipo Accionista</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Nombre y Apellido</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 12%; font-size: 0.85rem;">Nro. Acciones</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 8%; font-size: 0.85rem;">% Part.</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 8%; font-size: 0.85rem;">Fecha Creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 8%; font-size: 0.85rem;">Modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 9%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="spinner-border text-primary me-2" role="status"></div>
                                    <span class="text-muted">Cargando sociedades y accionistas...</span>
                                </td>
                            </tr>
                        }
                        else if (!gruposFiltrados.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No se encontraron sociedades ni accionistas con el término de búsqueda.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var grupo in gruposFiltrados)
                            {
                                <!-- Fila Cabecera de la Sociedad (Categoría Lotus Notes) -->
                                <tr class="table-group-header border-bottom"
                                    @onclick="() => ToggleSociedad(grupo)"
                                    style="cursor: pointer; background-color: #f8f9fa;">
                                    <td colspan="8" class="ps-3 py-2 text-uppercase font-monospace text-dark" style="text-align: left !important; font-size: 0.9rem; letter-spacing: 0.5px;">
                                        <i class="bi @(grupo.IsExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2 text-primary fw-bold"></i>
                                        <strong>🏢 @grupo.SociedadNombre</strong>
                                        <span class="float-end badge bg-white text-dark border shadow-sm me-3 mt-1" style="font-size: 0.75rem;">
                                            Gran Total Empresa: @UtilClass.FormatearMiles(grupo.GranTotalAcciones) acciones y @UtilClass.FormatearMiles(grupo.GranTotalAccionistas) accionistas
                                        </span>
                                    </td>
                                </tr>

                                <!-- Filas de Accionistas de esta Sociedad cuando está Expandida -->
                                @if (grupo.IsExpanded)
                                {
                                    @if (grupo.IsLoading)
                                    {
                                        <tr>
                                            <td colspan="8" class="ps-5 py-3 text-muted bg-white">
                                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                                Cargando nómina de accionistas...
                                            </td>
                                        </tr>
                                    }
                                    else if (!grupo.AccionistasFiltrados.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="ps-5 py-2 text-muted fst-italic small bg-white">
                                                No hay accionistas que coincidan con la búsqueda en esta sociedad.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var p in grupo.AccionistasPaginados)
                                        {
                                            <tr class="align-middle border-bottom bg-white">
                                                <td class="text-start text-dark fw-semibold small ps-4" style="width: 20%;">
                                                    <span class="text-muted small">↳</span>
                                                </td>
                                                <td class="text-start text-secondary small" style="width: 15%;">
                                                    <span class="badge bg-light text-dark border">@(p.TipoAccionistaNombre ?? "-")</span>
                                                </td>
                                                <td class="text-start text-secondary small" style="width: 20%;">
                                                    @if (p.EsCustodio)
                                                    {
                                                        <button @onclick="() => ToggleCustodiados(p)" class="btn btn-sm btn-link p-0 text-decoration-none me-2" title="Ver sub-accionistas custodiados">
                                                            <i class="bi @(p.MostrarCustodiados ? "bi-dash-square-fill" : "bi-plus-square-fill") text-primary"></i>
                                                        </button>
                                                    }
                                                    <span class="text-dark fw-medium">@p.AccionistaNombre</span>
                                                </td>
                                                <td class="text-start text-secondary small" style="width: 12%;">@UtilClass.FormatearMiles(p.NroAcciones)</td>
                                                <td class="text-start text-secondary small" style="width: 8%;">@p.Participacion%</td>
                                                <td class="text-center text-secondary small" style="width: 8%;">@p.CreateDate.ToShortDateString()</td>
                                                <td class="text-center text-secondary small" style="width: 8%;">@p.UpdateDate.ToShortDateString()</td>
                                                <td class="text-end pe-3" style="width: 9%;">
                                                    <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => VerTitulos(p)" title="Ver Títulos">
                                                        <i class="bi bi-file-medical fs-6"></i>
                                                    </button>
                                                    @if (idRol == 1 || idRol == 2)
                                                    {
                                                        <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                                            <i class="bi bi-trash3 fs-6"></i>
                                                        </button>
                                                        <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarInactivar(p)" title="Inactivar">
                                                            <i class="bi bi-x-circle fs-6"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>

                                            @if (p.MostrarCustodiados && p.SubCustodiados.Any())
                                            {
                                                <tr>
                                                    <td colspan="8" class="p-0 border-0">
                                                        <div class="bg-light p-2 ps-5 shadow-inner">
                                                            <table class="table table-sm table-bordered m-0 bg-white" style="font-size: 0.85rem;">
                                                                <thead class="table-secondary text-start">
                                                                    <tr>
                                                                        <th class="ps-3" style="width: 40%;">Sub-Accionista</th>
                                                                        <th style="width: 30%;">Tipo</th>
                                                                        <th style="width: 30%;">Acciones Custodiadas</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody class="text-start">
                                                                    @foreach (var sub in p.SubCustodiados)
                                                                    {
                                                                        <tr>
                                                                            <td class="ps-3"><i class="bi bi-person-badge me-2 text-muted"></i>@sub.AccionistaNombre</td>
                                                                            <td>@sub.TipoAccionistaNombre</td>
                                                                            <td>@UtilClass.FormatearMiles(sub.NroAcciones ?? 0)</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- Paginador Interno por Sociedad si supera 50 accionistas -->
                                        @if (grupo.TotalPages > 1)
                                        {
                                            <tr class="bg-light border-bottom">
                                                <td colspan="8" class="py-2 px-4">
                                                    <div class="d-flex align-items-center justify-content-between small text-muted">
                                                        <span>
                                                            Mostrando @((grupo.CurrentPage - 1) * grupo.PageSize + 1) - @Math.Min(grupo.CurrentPage * grupo.PageSize, grupo.AccionistasFiltrados.Count) de @grupo.AccionistasFiltrados.Count accionistas
                                                        </span>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                                                    disabled="@(grupo.CurrentPage <= 1)"
                                                                    @onclick="() => grupo.CurrentPage--">
                                                                <i class="bi bi-chevron-left"></i>
                                                            </button>
                                                            <span class="mx-2">Página @grupo.CurrentPage de @grupo.TotalPages</span>
                                                            <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                                                    disabled="@(grupo.CurrentPage >= grupo.TotalPages)"
                                                                    @onclick="() => grupo.CurrentPage++">
                                                                <i class="bi bi-chevron-right"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (mostrarModal)
{
    <AccionistasSociedadesGuardar id="@idAccionista.ToString()" OnFinalizado="ManejarCierreModal" />
}

@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.AccionistaNombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalInactivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a inactivar <strong>@entidadParaEliminar?.AccionistaNombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalInactivar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarInactivar">Inactivar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class SociedadGrupoModel
    {
        public int SociedadId { get; set; }
        public string SociedadNombre { get; set; } = "";
        public string? NumeroAccionesSociedad { get; set; }
        public long GranTotalAcciones { get; set; }
        public int GranTotalAccionistas { get; set; }
        public bool IsExpanded { get; set; } = false;
        public bool IsLoading { get; set; } = false;
        public int CurrentPage { get; set; } = 1;
        public int PageSize { get; set; } = 50;
        public List<AccionistaSociedadVerDto> Accionistas { get; set; } = new();
        public List<AccionistaSociedadVerDto> AccionistasFiltrados { get; set; } = new();

        public int TotalPages => (int)Math.Ceiling((double)AccionistasFiltrados.Count / PageSize);

        public IEnumerable<AccionistaSociedadVerDto> AccionistasPaginados =>
            AccionistasFiltrados.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    }

    private List<SociedadGrupoModel> gruposSociedades = new();
    private List<SociedadGrupoModel> gruposFiltrados = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private bool mostrarModalInactivar = false;
    private AccionistaSociedadVerDto? entidadParaEliminar;
    private string claseAlerta = "alert-success";
    private string iconoAlerta = "bi-check-circle-fill";
    private int idAccionista = 0;
    private int idRol = 0;

    [Inject] private ISociedad repoSociedad { get; set; } = null!;
    [Inject] private IAccionistaSociedad repository { get; set; } = null!;
    [Inject] private ITitulo repotitulo { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }

        await CargarGruposSociedadesAsync();
    }

    private async Task CargarGruposSociedadesAsync()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            var todasSociedades = await repoSociedad.GetAllAsync();
            var activas = todasSociedades
                .Where(s => s.EstatusSociedad?.Id == 1 && s.Empresa != null)
                .OrderBy(s => s.Empresa!.Nombre)
                .ToList();

            List<SociedadGrupoModel> lista = new();

            foreach (var soc in activas)
            {
                int totalAccionistas = await repository.GetTotalAccionistasBySociedadIdAsync(soc.Id);
                if (totalAccionistas > 0)
                {
                    long totalAcciones = await repository.GetTotalAccionesBySociedadIdAsync(soc.Id);
                    lista.Add(new SociedadGrupoModel
                    {
                        SociedadId = soc.Id,
                        SociedadNombre = soc.Empresa?.Nombre ?? $"Sociedad #{soc.Id}",
                        NumeroAccionesSociedad = soc.NumeroAcciones,
                        GranTotalAcciones = totalAcciones,
                        GranTotalAccionistas = totalAccionistas,
                        IsExpanded = false
                    });
                }
            }

            gruposSociedades = lista;
            FiltrarGrupos();
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar sociedades: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSociedad(SociedadGrupoModel grupo)
    {
        grupo.IsExpanded = !grupo.IsExpanded;

        if (grupo.IsExpanded && !grupo.Accionistas.Any())
        {
            await CargarAccionistasDeGrupoAsync(grupo);
        }

        FiltrarAccionistasEnGrupo(grupo);
        StateHasChanged();
    }

    private async Task CargarAccionistasDeGrupoAsync(SociedadGrupoModel grupo)
    {
        grupo.IsLoading = true;
        StateHasChanged();
        try
        {
            var accionistasDb = await repository.GetBySociedadIdAsync(grupo.SociedadId);
            var activos = accionistasDb
                .Where(x => x.EstatusAccionista?.Id == 1 && x.CustodioId == null)
                .ToList();

            var custodiosIds = await repository.GetCustodiosIdBySociedadAsync(grupo.SociedadId);
            var custodiosSet = new HashSet<int>(custodiosIds);

            List<AccionistaSociedadVerDto> listaDto = new();

            foreach (var item in activos)
            {
                long nroAcciones = item.NroAcciones ?? 0;
                decimal porcParticipa = 0;

                if (!string.IsNullOrEmpty(grupo.NumeroAccionesSociedad) && long.TryParse(grupo.NumeroAccionesSociedad, out long numTotalSociedad) && numTotalSociedad > 0)
                {
                    porcParticipa = Math.Round((decimal)nroAcciones / numTotalSociedad * 100, 6);
                }

                var dto = new AccionistaSociedadVerDto
                {
                    Id = item.Id,
                    SociedadId = grupo.SociedadId,
                    AccionistaId = item.Accionista?.Id ?? 0,
                    SociedadNombre = grupo.SociedadNombre,
                    TipoAccionistaNombre = item.Accionista?.TipoAccionista?.Nombre,
                    AccionistaNombre = (item.Accionista?.TipoAccionista?.Id != 3)
                        ? item.Accionista?.Nombre
                        : ((item.Accionista?.NombreSusesion?.Length > 50) ? item.Accionista.NombreSusesion.Substring(0, 50) : item.Accionista?.NombreSusesion),
                    NroAcciones = nroAcciones,
                    Participacion = porcParticipa,
                    EsCustodio = custodiosSet.Contains(item.Id),
                    CreateDate = item.CreateDate,
                    UpdateDate = item.UpdateDate
                };

                listaDto.Add(dto);
            }

            grupo.Accionistas = listaDto.OrderByDescending(x => x.NroAcciones).ToList();
            FiltrarAccionistasEnGrupo(grupo);
        }
        catch (Exception ex)
        {
            await MostrarNotificacion($"Error cargando accionistas de {grupo.SociedadNombre}: {ex.Message}", true);
        }
        finally
        {
            grupo.IsLoading = false;
        }
    }

    private void FiltrarGrupos()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            gruposFiltrados = gruposSociedades;
            foreach (var g in gruposFiltrados)
            {
                g.AccionistasFiltrados = g.Accionistas;
                g.CurrentPage = 1;
            }
        }
        else
        {
            var term = searchTerm.Trim().ToLowerInvariant();
            gruposFiltrados = gruposSociedades.Where(g =>
                g.SociedadNombre.ToLowerInvariant().Contains(term) ||
                g.Accionistas.Any(a => (a.AccionistaNombre ?? "").ToLowerInvariant().Contains(term))
            ).ToList();

            foreach (var g in gruposFiltrados)
            {
                if (g.Accionistas.Any())
                {
                    FiltrarAccionistasEnGrupo(g);
                }
                g.IsExpanded = true; // Auto-expandir cuando hay búsqueda activa
            }
        }
        StateHasChanged();
    }

    private void FiltrarAccionistasEnGrupo(SociedadGrupoModel grupo)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            grupo.AccionistasFiltrados = grupo.Accionistas;
        }
        else
        {
            var term = searchTerm.Trim().ToLowerInvariant();
            // Si la búsqueda coincide con la sociedad, mostramos todos; si no, filtramos por nombre de accionista
            if (grupo.SociedadNombre.ToLowerInvariant().Contains(term))
            {
                grupo.AccionistasFiltrados = grupo.Accionistas;
            }
            else
            {
                grupo.AccionistasFiltrados = grupo.Accionistas
                    .Where(a => (a.AccionistaNombre ?? "").ToLowerInvariant().Contains(term))
                    .ToList();
            }
        }
        grupo.CurrentPage = 1;
    }

    private void LimpiarBusqueda()
    {
        searchTerm = "";
        FiltrarGrupos();
    }

    private async Task ExpandirTodo()
    {
        cargando = true;
        StateHasChanged();

        foreach (var grupo in gruposFiltrados)
        {
            grupo.IsExpanded = true;
            if (!grupo.Accionistas.Any())
            {
                await CargarAccionistasDeGrupoAsync(grupo);
            }
            FiltrarAccionistasEnGrupo(grupo);
        }

        cargando = false;
        StateHasChanged();
    }

    private void ColapsarTodo()
    {
        foreach (var grupo in gruposFiltrados)
        {
            grupo.IsExpanded = false;
        }
        StateHasChanged();
    }

    private async Task ToggleCustodiados(AccionistaSociedadVerDto p)
    {
        p.MostrarCustodiados = !p.MostrarCustodiados;

        if (p.MostrarCustodiados && !p.SubCustodiados.Any())
        {
            var custodiadosDb = await repository.GetCustodiadosAsync(p.SociedadId, p.Id);
            p.SubCustodiados = custodiadosDb.Select(x => new AccionistaSociedadVerDto
            {
                Id = x.Id,
                AccionistaId = x.Accionista?.Id ?? 0,
                AccionistaNombre = (x.Accionista?.TipoAccionista?.Id != 3) ? x.Accionista?.Nombre : x.Accionista?.NombreSusesion,
                TipoAccionistaNombre = x.Accionista?.TipoAccionista?.Nombre,
                NroAcciones = x.NroAcciones
            }).ToList();
        }
        StateHasChanged();
    }

    private void AbrirModalNuevo()
    {
        idAccionista = 0;
        mostrarModal = true;
    }

    private void VerTitulos(AccionistaSociedadVerDto item)
    {
        navManager.NavigateTo($"/vertitulos/{item.Id}");
    }

    private void VerificarEliminar(AccionistaSociedadVerDto item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await CargarGruposSociedadesAsync();
            await MostrarNotificacion("Accionista - Sociedad eliminado correctamente");
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudo eliminar el registro: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private void VerificarInactivar(AccionistaSociedadVerDto item)
    {
        entidadParaEliminar = item;
        mostrarModalInactivar = true;
    }

    private void CerrarModalInactivar() => mostrarModalInactivar = false;

    private async Task ConfirmarInactivar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Activar(entidadParaEliminar.Id, 2);
            mostrarModalInactivar = false;
            await CargarGruposSociedadesAsync();
            await MostrarNotificacion("Accionista - Sociedad inactivado correctamente");
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudo inactivar el registro: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        mostrarModal = false;
        if (guardadoExitoso)
        {
            await CargarGruposSociedadesAsync();
            await MostrarNotificacion("Accionista - Sociedad guardado correctamente");
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }
}
