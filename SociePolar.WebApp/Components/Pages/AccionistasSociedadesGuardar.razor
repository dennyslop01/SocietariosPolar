<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @( (int.TryParse(id, out var parsedId) && parsedId > 0) ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @( (int.TryParse(id, out var pId) && pId > 0) ? "Modificar Accionista - Sociedad" : "Agregar Accionista - Sociedad")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Iniciamos la grilla de filas y columnas -->
                    <div class="row">
                    <!-- COMBO SOCIEDAD -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary small">Sociedad</label>
                        <div class="dropdown">
                            <button class="form-select text-start d-flex justify-content-between align-items-center" type="button" style="font-size: 0.8rem;" @onclick="ToggleSociedadDropdown">
                                <span>@(ObtenerSociedadSeleccionada())</span>
                            </button>
                            <ul class="dropdown-menu w-100 p-2 @(isSociedadDropdownOpen ? "show" : "")" style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                <li class="mb-2">
                                    <input type="text" class="form-control" placeholder="Buscar..." style="font-size: 0.8rem;" @bind="textoBusquedaSociedad" @bind:event="oninput" />
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item @(entidadEditando.SociedadId == 0 ? "active bg-primary text-white" : "")" style="font-size: 0.8rem;" @onclick="() => SeleccionarSociedad(0)">
                                        Seleccione ...
                                    </button>
                                </li>
                                @if (listSociedad != null)
                                {
                                    @foreach (var sociedad in listSociedad.Where(s => string.IsNullOrEmpty(textoBusquedaSociedad) || s.Empresa.Nombre.Contains(textoBusquedaSociedad, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item @(entidadEditando.SociedadId == sociedad.Id ? "active bg-primary text-white" : "")" style="font-size: 0.8rem;" @onclick="() => SeleccionarSociedad(sociedad.Id)">
                                                @sociedad.Empresa.Nombre
                                            </button>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        <ValidationMessage For="@(() => entidadEditando.SociedadId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                    </div>

                    <!-- COMBO ACCIONISTA -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary small">Accionista</label>
                        <div class="dropdown">
                            <button class="form-select text-start d-flex justify-content-between align-items-center" type="button" style="font-size: 0.8rem;" @onclick="ToggleAccionistaDropdown">
                                <span>@(ObtenerAccionistaSeleccionado())</span>
                            </button>
                            <ul class="dropdown-menu w-100 p-2 @(isAccionistaDropdownOpen ? "show" : "")" style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                <li class="mb-2">
                                    <input type="text" class="form-control" placeholder="Buscar..." style="font-size: 0.8rem;" @bind="textoBusquedaAccionista" @bind:event="oninput" />
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item @(entidadEditando.AccionistaId == 0 ? "active bg-primary text-white" : "")" style="font-size: 0.8rem;" @onclick="() => SeleccionarAccionista(0)">
                                        Seleccione ...
                                    </button>
                                </li>
                                @if (listAccionista != null)
                                {
                                    @foreach (var accionista in listAccionista.Where(a => string.IsNullOrEmpty(textoBusquedaAccionista) || a.Nombre.Contains(textoBusquedaAccionista, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item @(entidadEditando.AccionistaId == accionista.Id ? "active bg-primary text-white" : "")" style="font-size: 0.8rem;" @onclick="() => SeleccionarAccionista(accionista.Id)">
                                                @accionista.Nombre
                                            </button>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        <ValidationMessage For="@(() => entidadEditando.AccionistaId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary small">Estatus</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.EstatusAccionistaId">
                            <option value="0" selected>Seleccione ...</option>
                            @if (listEstatus != null)
                            {
                                @foreach (var estatus in listEstatus)
                                {
                                    <option value="@estatus.Id">@estatus.Nombre</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => entidadEditando.EstatusAccionistaId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                    </div>
                    <div class="col-md-6 mb-3">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-danger small">@mensajeAlerta</label>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-save me-1"></i>
                        <span>Guardar</span>
                    }
                </button>
            </div>
        </div>
    </EditForm>
</div>
</div>

@if (cargando || guardando)
{
    <ModalCargando />
}

@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = true;
    private bool guardando = false;

    private AccionistaSociedadDto entidadEditando = new();

    private List<Sociedad> listSociedad = new();
    private List<AccionistaMostrarDto> listAccionista = new();
    private List<AccionistaSociedad> listEntidades = new();

    private List<IBaseEntity> listEstatus = new();

    private EditContext editContext = new(new AccionistaSociedadDto());
    private ValidationMessageStore? mensajeStore;

    [Inject] private ISociedad reposociedad { get; set; } = null!;
    [Inject] private IAccionista repoaccionista { get; set; } = null!;
    [Inject] private IAccionistaSociedad repository { get; set; } = null!;

    // Variables de estado para Sociedad
    private bool isSociedadDropdownOpen = false;
    private string textoBusquedaSociedad = "";

    // Variables de estado para Accionista
    private bool isAccionistaDropdownOpen = false;
    private string textoBusquedaAccionista = "";

    private ElementReference searchInputRef;


    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            await LoadGenericDataAsync();

            if (id == "0" || string.IsNullOrEmpty(id))
            {
                entidadEditando = new()
                {
                    SociedadId = 0,
                    AccionistaId = 0,
                    EstatusAccionistaId = 0,
                    CreateDate = DateTime.Now,
                    UpdateDate = DateTime.Now
                };
            }
            else
            {
                var item = await repository.GetByIdAsync(int.Parse(id));
                if (item != null)
                {
                    entidadEditando = new()
                    {
                        Id = item.Id,
                        SociedadId = item.Sociedad?.Id ?? 0,
                        AccionistaId = item.Accionista?.Id ?? 0,
                        EstatusAccionistaId = item.EstatusAccionista?.Id ?? 0,
                        CreateDate = item.CreateDate,
                        CreateUserId = item.CreateUserId,
                        UpdateDate = item.UpdateDate,
                        UpdateUserId = item.UpdateUserId
                    };
                }
            }

            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar formulario de accionista sociedad: {ex.Message}");
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    public async Task<List<IBaseEntity>> GetEntityListAsync(string entityName)
    {
        var repo = RepoFactory.GetRepository(entityName);
        var method = repo.GetType().GetMethod("GetAllAsync");

        if (method == null) return new List<IBaseEntity>();

        // Invocamos el método asíncrono
        var task = (Task)method.Invoke(repo, null)!;
        await task;

        // Obtenemos el resultado de la Task dinámica
        var resultProperty = task.GetType().GetProperty("Result");
        var result = (IEnumerable<IBaseEntity>)resultProperty!.GetValue(task)!;

        return result.ToList();
    }

    private async Task LoadGenericDataAsync()
    {
        listEstatus = await GetEntityListAsync("estatusaccionistas");
        listEntidades = await repository.GetAllAsync();

        var listSociedades = await reposociedad.GetAllAsync();
        listSociedad = listSociedades.OrderBy(x => x.Empresa?.Nombre).Where(x => x.EstatusSociedad?.Id == 1).ToList();

        var listAaccionista = await repoaccionista.GetAllAsync();
        List<AccionistaMostrarDto> accionistas = new();

        foreach (var item in listAaccionista)
        {
            accionistas.Add(new AccionistaMostrarDto
            {
                Id = item.Id,
                TipoAccionistaV = item.TipoAccionista?.Nombre,
                Nombre = (item.TipoAccionista?.Id != 3) ? item.Nombre : (item.NombreSusesion?.Length > 50) ? item.NombreSusesion?.Substring(0, 50) : item.NombreSusesion,
                TipoDocumentoV = item.TipoDocumento1?.Nombre,
                Documento = item.Documento1,
                Telefono = item.Telefono1,
                CreateDate = item.CreateDate,
                UpdateDate = item.UpdateDate
            });
        }

        listAccionista = accionistas.OrderBy(x => x.Nombre).ToList();
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task GuardarCambios()
    {
        if (guardando) return;
        mensajeAlerta = string.Empty;
        guardando = true;
        StateHasChanged();

        bool formularioValido = editContext.Validate();

        if (!formularioValido)
        {
            guardando = false;
            StateHasChanged();
            await MostrarNotificacion("Por favor complete los campos requeridos marcados en rojo", true);
            await jsRuntime.InvokeVoidAsync("eval", @"
                var m = document.querySelector('.modal-body') || document.querySelector('.modal');
                if (m) {
                    m.scrollTop = 0;
                    try { m.scrollTo({ top: 0, behavior: 'smooth' }); } catch(e) {}
                }
                var firstInput = document.querySelector('.modal select, .modal input');
                if (firstInput) {
                    try { firstInput.focus(); } catch(e) {}
                    firstInput.classList.remove('pulse-invalid-field');
                    void firstInput.offsetWidth;
                    firstInput.classList.add('pulse-invalid-field');
                }
            ");
            return;
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    var existeAutoSociedad = listEntidades.Any(x => x.Sociedad.Id == entidadEditando.SociedadId && x.Accionista.Id == entidadEditando.AccionistaId);
                    if (existeAutoSociedad)
                    {
                        mensajeAlerta = "Ya existe esta combinacion de Accionista - Sociedad";
                        await MostrarNotificacion("Ya existe esta autoridad para esta sociedad", true);
                        return;
                    }
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;
                    entidadEditando.NroAcciones = 0;

                    await repository.AddAsync(entidadEditando);

                    await MostrarNotificacion($"Accionista - Sociedad guardada correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
                else
                {
                    repository.Update(entidadEditando);

                    await MostrarNotificacion($"Accionista - Sociedad actualizado correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void ToggleSociedadDropdown()
    {
        isSociedadDropdownOpen = !isSociedadDropdownOpen;
        if (!isSociedadDropdownOpen)
        {
            textoBusquedaSociedad = "";
        }
    }

    private string ObtenerSociedadSeleccionada()
    {
        if (entidadEditando?.SociedadId == 0 || listSociedad == null)
        {
            return "Seleccione ...";
        }

        var seleccionado = listSociedad.FirstOrDefault(s => s.Id == entidadEditando.SociedadId);
        return seleccionado?.Empresa?.Nombre ?? "Seleccione ...";
    }

    private void SeleccionarSociedad(int id)
    {
        entidadEditando.SociedadId = id;
        isSociedadDropdownOpen = false;
        textoBusquedaSociedad = "";
    }

    // --- MÉTODOS PARA ACCIONISTA ---

    private void ToggleAccionistaDropdown()
    {
        isAccionistaDropdownOpen = !isAccionistaDropdownOpen;
        if (!isAccionistaDropdownOpen)
        {
            textoBusquedaAccionista = "";
        }
    }

    private string ObtenerAccionistaSeleccionado()
    {
        if (entidadEditando?.AccionistaId == 0 || listAccionista == null)
        {
            return "Seleccione ...";
        }

        var seleccionado = listAccionista.FirstOrDefault(a => a.Id == entidadEditando.AccionistaId);
        return seleccionado?.Nombre ?? "Seleccione ...";
    }

    private void SeleccionarAccionista(int id)
    {
        entidadEditando.AccionistaId = id;
        isAccionistaDropdownOpen = false;
        textoBusquedaAccionista = "";
    }
}
