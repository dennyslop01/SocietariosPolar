@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                        @tituloventana
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Iniciamos la grilla de filas y columnas -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Sociedad</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.Sociedad?.Empresa.Nombre</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tipo de Asamblea</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.TipoAsamblea?.Nombre</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Fecha de Celebración</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.FechaCelebracion?.ToString("dd/MM/yyyy")</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Número de Acta</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.NumeroActa</label>
                        </div>
                        <div class="col-md-12 mb-0">
                            <hr />
                            <label class="form-label fw-bold text-primary small">Datos del Registro</label>
                            <hr />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Registro</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.Registro?.Nombre</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Fecha de Registro</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.FechaRegistro?.ToString("dd/MM/yyyy")</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Número de Registro</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.NumeroRegistro</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tomo</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.Tomo</label>
                        </div>
                        <div class="col-md-12 mb-0">
                            <hr />
                            <label class="form-label fw-bold text-primary small">Datos de Publicación</label>
                            <hr />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Año de Publicación</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.AnoPublicacion</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Fecha de Publicación</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.FechaPublicacion?.ToString("dd/MM/yyyy")</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Número de Publicación</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.NumeroPublicacion</label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Nombre del Diario</label>
                            <label class="form-label text-secondary small text-break">@entidadEditando.NombreDiario?.Nombre</label>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold text-secondary small d-block">¿Aplica Reforma?</label>

                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       name="aplicaReformaGroup"
                                       id="reformaSi"
                                       class="form-check-input"
                                       value="1"
                                       disabled
                                       checked="@(entidadEditando.AplicaReforma == 1)" />
                                <label class="form-check-label small text-secondary" for="reformaSi">Sí</label>
                            </div>

                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       name="aplicaReformaGroup"
                                       id="reformaNo"
                                       class="form-check-input"
                                       value="0"
                                       disabled
                                       checked="@(entidadEditando.AplicaReforma == 0)" />
                                <label class="form-check-label small text-secondary" for="reformaNo">No</label>
                            </div>
                        </div>

                        @if (entidadEditando.AplicaReforma == 1)
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Tipo Reforma</label>
                                <label class="form-label text-secondary small text-break">@entidadEditando.TipoReforma?.Nombre</label>
                            </div>
                        }

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-danger small">@mensajeAlerta</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal">Cancelar</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;
    private string tituloventana = string.Empty;

    private Asamblea entidadEditando = new();

    private List<Sociedad> listSociedad = new();
    private List<Asamblea> listAsamblea = new();

    private List<IBaseEntity> listTipoAsamblea = new();
    private List<IBaseEntity> listRegistro = new();
    private List<IBaseEntity> listNombreDiario = new();
    private List<IBaseEntity> listTipoReforma = new();

    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    [Inject] private ISociedad reposociedad { get; set; } = null!;
    [Inject] private IAsamblea repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }

        try
        {
            entidadEditando = await repository.GetByIdAsync(int.Parse(id));
            if (entidadEditando.IndicadorAsamblea == 1)
                tituloventana = "Asamblea";
            else
                tituloventana = "Reforma";
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        cargando = false;
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }
}

