@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                        @(entidadEditando.Id == 0 ? "Agregar Autoridad" : "Modificar Autoridad")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Iniciamos la grilla de filas y columnas -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Sociedad</label>
                            <div class="dropdown">
                                <!-- Removido -sm para igualar el tamaño estándar del label -->
                                <button class="form-select text-start d-flex justify-content-between align-items-center"
                                        type="button"
                                        style="font-size: 0.8rem;"
                                        @onclick="ToggleDropdown">
                                    <span>@(ObtenerNombreSeleccionado())</span>
                                </button>

                                <ul class="dropdown-menu w-100 p-2 @(isDropdownOpen ? "show" : "")"
                                    style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                    <li class="mb-2">
                                        <!-- Cambiado a form-control normal para que la fuente de "Buscar..." coincida en tamaño -->
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Buscar..."
                                               style="font-size: 0.8rem;"
                                               @bind="textoBusqueda"
                                               @bind:event="oninput"
                                               @ref="searchInputRef" />
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item @(entidadEditando.SociedadId == 0 ? "active bg-primary text-white" : "")"
                                                style="font-size: 0.8rem;"
                                                @onclick="() => SeleccionarOpcion(0)">
                                            Seleccione ...
                                        </button>
                                    </li>

                                    <!-- Opciones filtradas dinámicamente -->
                                    @if (listSociedad != null)
                                    {
                                        @foreach (var sociedad in listSociedad.Where(s => string.IsNullOrEmpty(textoBusqueda) || s.Empresa.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <li>
                                                <!-- Se reemplazó 'small' por 'style="font-size: 0.8rem;"' para forzar la letra más pequeña -->
                                                <button type="button"
                                                        class="dropdown-item @(entidadEditando.SociedadId == sociedad.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarOpcion(sociedad.Id)">
                                                    @sociedad.Empresa.Nombre
                                                </button>
                                            </li>
                                        }
                                    }

                                </ul>
                            </div>

                            <ValidationMessage For="@(() => entidadEditando.SociedadId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Cargo</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.CargoId">
                                <option value="0" selected>Seleccione ...</option>
                                @if (listCargos != null)
                                {
                                    @foreach (var cargo in listCargos)
                                    {
                                        <option value="@cargo.Id">@cargo.Nombre</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => entidadEditando.CargoId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Duración</label>
                            <InputText class="form-control form-control-sm small"
                                         @bind-Value="entidadEditando.Duracion"
                                         placeholder="Ingrese la duración..."
                                         maxlength="15" />
                            <ValidationMessage For="@(() => entidadEditando.Duracion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Nombre</label>
                            <InputText type="text" class="form-control form-control-sm small"
                                   @bind-Value="entidadEditando.Nombre"
                                   placeholder="Ingrese nombre..."
                                   maxlength="150" />
                            <ValidationMessage For="@(() => entidadEditando.Nombre)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tipo Documento</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.TipoDocumento1Id">
                                <option value="0">Seleccione ...</option>
                                @if (listTipoDoc != null)
                                {
                                    @foreach (var tipo in listTipoDoc)
                                    {
                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                    }
                                }
                            </InputSelect>
                            @* <ValidationMessage For="@(() => entidadEditando.TipoDocumento1Id)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" /> *@
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Documento de Identidad Fiscal</label>
                            <InputText type="text" class="form-control form-control-sm small"
                                       @bind-Value="entidadEditando.Documento1"
                                       placeholder="Ingrese número de documento..."
                                       maxlength="20"
                                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9.-]/g, '');" />
                          @*   <ValidationMessage For="@(() => entidadEditando.Documento1)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" /> *@
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tipo Documento</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.TipoDocumento2Id">
                                <option value="0">Seleccione ...</option>
                                @if (listTipoDoc != null)
                                {
                                    @foreach (var tipo in listTipoDoc)
                                    {
                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Documento de Identidad Fiscal 2</label>
                            <InputText type="text" class="form-control form-control-sm small"
                                       @bind-Value="entidadEditando.Documento2"
                                       placeholder="Ingrese número de documento..."
                                       maxlength="20"
                                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9.-]/g, '');" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-danger small">@mensajeAlerta</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando)
{
    <ModalCargando />
}
@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;

    private AutoridadDto entidadEditando = new();

    private List<Sociedad> listSociedad = new();
    private List<Autoridad> listAutoridad = new();

    private List<IBaseEntity> listCargos = new();
    private List<IBaseEntity> listCargosFiltrado = new();
    private List<IBaseEntity> listTipoDoc = new();

    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    [Inject] private ISociedad reposociedad { get; set; } = null!;
    [Inject] private IAutoridad repository { get; set; } = null!;

    private bool isDropdownOpen = false;
    private string textoBusqueda = "";
    private ElementReference searchInputRef;


    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }

        await LoadGenericDataAsync();

        if (id == "0")
        {
            entidadEditando = new();
            entidadEditando.SociedadId = 0;
            entidadEditando.CargoId = 0;
            entidadEditando.CreateDate = DateTime.Now;
            entidadEditando.UpdateDate = DateTime.Now;
            editContext = new EditContext(entidadEditando);
        }
        else
        {
            try
            {
                var item = await repository.GetByIdAsync(int.Parse(id));
                AutoridadDto dto = new()
                {
                    Id = item.Id,
                    SociedadId = item.Sociedad.Id,
                    CargoId = item.Cargo.Id,
                    Nombre = item.Nombre,
                    TipoDocumento1Id = item.TipoDocumento1?.Id,
                    TipoDocumento2Id = item.TipoDocumento2?.Id,
                    Documento1 = item.Documento1,
                    Documento2 = item.Documento2,
                    Duracion = item.Duracion,
                    CreateDate = item.CreateDate,
                    CreateUserId = item.CreateUserId,
                    UpdateDate = item.UpdateDate,
                    UpdateUserId = item.UpdateUserId
                };

                entidadEditando = dto;
                editContext = new EditContext(entidadEditando);
            }
            catch (Exception ex)
            {
                cargando = false;
                StateHasChanged();
                await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
            }
        }
        cargando = false;
    }

    public async Task<List<IBaseEntity>> GetEntityListAsync(string entityName)
    {
        var repo = RepoFactory.GetRepository(entityName);
        var method = repo.GetType().GetMethod("GetAllAsync");

        if (method == null) return new List<IBaseEntity>();

        // Invocamos el método asíncrono
        var task = (Task)method.Invoke(repo, null)!;
        await task;

        // Obtenemos el resultado de la Task dinámica
        var resultProperty = task.GetType().GetProperty("Result");
        var result = (IEnumerable<IBaseEntity>)resultProperty!.GetValue(task)!;

        return result.ToList();
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            listCargos = await GetEntityListAsync("cargos");
            listTipoDoc = await GetEntityListAsync("tipodocumento");

            var listSociedades = await reposociedad.GetAllAsync();
            listSociedad = listSociedades.OrderBy(x=> x.Empresa.Nombre).Where(x => x.EstatusSociedad.Id == 1).ToList();

            listAutoridad = await repository.GetAllAsync();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task GuardarCambios()
    {
        mensajeAlerta = string.Empty;

        bool formularioValido = editContext.Validate();

        if (!formularioValido)
        {
            StateHasChanged();
            cargando = false;
            return;
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    // var existeAutoSociedad = listAutoridad.Any(x => x.Cargo.Id == entidadEditando.CargoId && x.Sociedad.Id == entidadEditando.SociedadId);
                    // if (existeAutoSociedad)
                    // {
                    //     mensajeAlerta = "Ya existe esta autoridad para esta sociedad";
                    //     await MostrarNotificacion("Ya existe esta autoridad para esta sociedad", true);
                    //     return;
                    // }
                    cargando = true;
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Autoridad guardada correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
                else
                {
                    cargando = true;
                    repository.Update(entidadEditando);

                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Autoridad actualizado correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            // Si hay error en base de datos (ej. nombre duplicado)
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        cargando = false;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    // Alternar la apertura del menú desplegable
    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
        if (!isDropdownOpen)
        {
            textoBusqueda = ""; // Limpia la búsqueda al cerrar
        }
    }

    // Devuelve el texto del elemento seleccionado en el botón principal
    private string ObtenerNombreSeleccionado()
    {
        if (entidadEditando?.SociedadId == 0 || listSociedad == null)
        {
            return "Seleccione ...";
        }

        var seleccionado = listSociedad.FirstOrDefault(s => s.Id == entidadEditando.SociedadId);
        return seleccionado?.Empresa?.Nombre ?? "Seleccione ...";
    }

    // Asigna el ID real a tu modelo y cierra el menú
    private void SeleccionarOpcion(int id)
    {
        entidadEditando.SociedadId = id;
        isDropdownOpen = false;
        textoBusqueda = ""; // Reinicia el filtro
    }
}
