@page "/autoridadesinactivas"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-person-vcard text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Autoridades
                    </h5>
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="Autoridad" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Cargo</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nombre</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Documento</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Duración</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        @{
                            var index = Listgral.IndexOf(p);

                            // 1. Ruptura para Sociedad
                            bool esNuevaSociedad = index == 0 ||
                            Listgral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;

                            // 2. Ruptura para Cargo (Se dispara si es una nueva sociedad O si dentro de la misma sociedad cambia el cargo)
                            bool esNuevoCargo = index == 0 ||
                            esNuevaSociedad ||
                            Listgral[index - 1].Cargo?.Nombre != p.Cargo?.Nombre;
                        }

                        @if (esNuevaSociedad)
                        {
                            <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                            <tr class="table-secondary fw-bold text-primary border-bottom">
                                <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                    🏢 @p.Sociedad?.Empresa?.Nombre
                                </td>
                            </tr>
                        }

                        @if (esNuevoCargo)
                        {
                            <!-- Fila divisoria de Cargo alineada estrictamente en su columna -->
                            <tr class="align-middle border-bottom fw-bold" style="background-color: #fcfcfc;">
                                <!-- Celda vacía para mantener el espacio de la columna Sociedad -->
                                <td style="width: 20%;"></td>

                                <!-- Celda del cargo que hereda el ancho exacto (15%) y se resalta -->
                                <td class="text-start text-dark py-2" style="width: 15%; font-size: 0.85rem; letter-spacing: 0.3px;">
                                    📌 @p.Cargo?.Nombre
                                </td>

                                <!-- Celdas vacías para rellenar las 6 columnas restantes de la cuadrícula -->
                                <td colspan="6"></td>
                            </tr>
                        }

                        <tr class="align-middle border-bottom">
                            <td class="text-muted small ps-3" style="width: 20%;">-</td>
                            <!-- Dejamos la celda del registro vacía o con una marca suave ya que el título del cargo se muestra arriba -->
                            <td class="text-start text-muted small" style="width: 15%; font-style: italic;">↳</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Documento</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@(p.Duracion != null ? $"{p.Duracion} años" : "")</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Autoridad> Listgral = new();
    private List<Autoridad> ListgralBuscar = new();
    private string searchTerm = ""; private bool cargando = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private Autoridad? entidadParaEliminar;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";

    [Inject] private IAutoridad repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var listAutoridad = await repository.GetAllAsync();
            Listgral = listAutoridad.OrderBy(x => x.Sociedad.Empresa.Id).Where(x => x.Sociedad.EstatusSociedad.Id == 2).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Sociedad.Empresa.Nombre != null && b.Sociedad.Empresa.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (Listgral.Count() == 0)
            {
                Listgral = ListgralBuscar
                .Where(b => b.Nombre != null && b.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
            }
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }
}
