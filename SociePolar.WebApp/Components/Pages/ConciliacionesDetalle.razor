@page "/conciliacionesdetalle/{id:int}"
@rendermode InteractiveServer
@inject IJSRuntime jsRuntime

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm" style="background-color: #00338D !important;">
                        <i class="bi bi-calculator text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            Detalle de Conciliación
                        </h5>
                        <small class="text-muted">Resumen comparativo de acciones y estado de accionistas</small>
                    </div>
                </div>

                <!-- Botón Regresar -->
                <button class="btn btn-outline-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="Regresar"
                        style="height: 36px; font-weight: 500; border-radius: 8px;">
                    <i class="bi bi-arrow-left me-2"></i> Regresar
                </button>
            </div>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <!-- KPIs de Resumen -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border-radius: 10px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-3 bg-primary-subtle text-primary">
                                <i class="bi bi-pie-chart fs-4" style="color: #00338D;"></i>
                            </div>
                            <div>
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Cantidad Total de Acciones</small>
                                <h4 class="mb-0 fw-bold text-primary" style="color: #00338D !important;">
                                    @UtilClass.FormatearMiles(CantidadAcciones)
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border-radius: 10px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-3 bg-info-subtle text-info-emphasis">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Total de Accionistas Conciliados</small>
                                <h4 class="mb-0 fw-bold text-dark">
                                    @UtilClass.FormatearMiles(TotalAccionista)
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pestañas de Secciones -->
            <ul class="nav nav-pills mb-3 gap-2 border-bottom pb-3" id="conciliacionTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active px-3 py-2 fw-medium shadow-sm d-flex align-items-center gap-2" id="nuevos-tab" data-bs-toggle="pill" data-bs-target="#nuevos" type="button" role="tab">
                        <i class="bi bi-person-plus text-success"></i> Accionistas Nuevos <span class="badge bg-success rounded-pill">@ListgralNuevos.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-3 py-2 fw-medium shadow-sm d-flex align-items-center gap-2" id="actualizados-tab" data-bs-toggle="pill" data-bs-target="#actualizados" type="button" role="tab">
                        <i class="bi bi-person-gear text-primary"></i> Accionistas Actualizados <span class="badge bg-primary rounded-pill">@ListgralActualizados.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-3 py-2 fw-medium shadow-sm d-flex align-items-center gap-2" id="inactivos-tab" data-bs-toggle="pill" data-bs-target="#inactivos" type="button" role="tab">
                        <i class="bi bi-person-x text-danger"></i> Accionistas Inhabilitados <span class="badge bg-danger rounded-pill">@ListgralInactivos.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="conciliacionTabContent">
                <!-- 1. Nuevos -->
                <div class="tab-pane fade show active" id="nuevos" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                        <div class="table-responsive">
                            <PaginationComponent TItem="ConciliacionDetalleDto" Items="ListgralNuevos" DefaultPageSize="10">
                                <ChildContentHeader>
                                    <tr class="table-light border-bottom">
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Acción</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Tipo Documento</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nro. Documento</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 35%; font-size: 0.85rem;">Nombre Accionista</th>
                                        <th class="py-3 text-secondary fw-bold text-end" style="width: 20%; font-size: 0.85rem;">Total Acciones</th>
                                    </tr>
                                </ChildContentHeader>
                                <ChildContentRow Context="p">
                                    <tr class="align-middle border-bottom">
                                        <td class="text-start" style="width: 15%;">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-plus-circle me-1"></i> @p.Accion
                                            </span>
                                        </td>
                                        <td class="text-start text-secondary small" style="width: 15%;">@p.Documento</td>
                                        <td class="text-start text-secondary small" style="width: 15%;">@p.NroDocumento</td>
                                        <td class="text-start fw-medium text-dark" style="width: 35%;">@p.Nombre</td>
                                        <td class="text-end fw-bold text-primary" style="width: 20%; color: #00338D !important;">@UtilClass.FormatearMiles(p.TotalAcciones)</td>
                                    </tr>
                                </ChildContentRow>
                            </PaginationComponent>
                        </div>
                    </div>
                </div>

                <!-- 2. Actualizados -->
                <div class="tab-pane fade" id="actualizados" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                        <div class="table-responsive">
                            <PaginationComponent TItem="ConciliacionDetalleDto" Items="ListgralActualizados" DefaultPageSize="10">
                                <ChildContentHeader>
                                    <tr class="table-light border-bottom">
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Acción</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Tipo Documento</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nro. Documento</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 35%; font-size: 0.85rem;">Nombre Accionista</th>
                                        <th class="py-3 text-secondary fw-bold text-end" style="width: 20%; font-size: 0.85rem;">Total Acciones</th>
                                    </tr>
                                </ChildContentHeader>
                                <ChildContentRow Context="p">
                                    <tr class="align-middle border-bottom">
                                        <td class="text-start" style="width: 15%;">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-arrow-repeat me-1"></i> @p.Accion
                                            </span>
                                        </td>
                                        <td class="text-start text-secondary small" style="width: 15%;">@p.Documento</td>
                                        <td class="text-start text-secondary small" style="width: 15%;">@p.NroDocumento</td>
                                        <td class="text-start fw-medium text-dark" style="width: 35%;">@p.Nombre</td>
                                        <td class="text-end fw-bold text-primary" style="width: 20%; color: #00338D !important;">@UtilClass.FormatearMiles(p.TotalAcciones)</td>
                                    </tr>
                                </ChildContentRow>
                            </PaginationComponent>
                        </div>
                    </div>
                </div>

                <!-- 3. Inhabilitados -->
                <div class="tab-pane fade" id="inactivos" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                        <div class="table-responsive">
                            <PaginationComponent TItem="ConciliacionDetalleDto" Items="ListgralInactivos" DefaultPageSize="10">
                                <ChildContentHeader>
                                    <tr class="table-light border-bottom">
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Acción</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Tipo Documento</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nro. Documento</th>
                                        <th class="py-3 text-secondary fw-bold" style="width: 35%; font-size: 0.85rem;">Nombre Accionista</th>
                                        <th class="py-3 text-secondary fw-bold text-end" style="width: 20%; font-size: 0.85rem;">Total Acciones</th>
                                    </tr>
                                </ChildContentHeader>
                                <ChildContentRow Context="p">
                                    <tr class="align-middle border-bottom">
                                        <td class="text-start" style="width: 15%;">
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i> @p.Accion
                                            </span>
                                        </td>
                                        <td class="text-start text-secondary small" style="width: 15%;">@p.Documento</td>
                                        <td class="text-start text-secondary small" style="width: 15%;">@p.NroDocumento</td>
                                        <td class="text-start fw-medium text-dark" style="width: 35%;">@p.Nombre</td>
                                        <td class="text-end fw-bold text-secondary" style="width: 20%;">@UtilClass.FormatearMiles(p.TotalAcciones)</td>
                                    </tr>
                                </ChildContentRow>
                            </PaginationComponent>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <ModalCargando />
}

@code {
    [Parameter] public Int32 id { get; set; } = 0;

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;
    private int idRol = 0;
    private Int64 CantidadAcciones = 0;
    private Int64 TotalAccionista = 0;

    private List<ConciliacionDetalleDto> ListgralNuevos = new();
    private List<ConciliacionDetalleDto> ListgralActualizados = new();
    private List<ConciliacionDetalleDto> ListgralInactivos = new();

    [Inject] private IConciliacion repository { get; set; } = null!;
    [Inject] private IAccionista repoaccionista { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoaccionistasocie { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }
        await LoadGenericDataAsync();

        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            var conciliacion = await repository.GetByIdAsync(id);
            var listaDetalle = await repository.GetDetalleByIdAsync(id);
            var listaAccionistas = await repoaccionistasocie.GetBySociedadIdAsync((int)conciliacion?.Sociedad?.Id);
            var listaHistorico = await repoaccionistasocie.GetHistoricoBySociedadIdRangeDateAsync((int)conciliacion?.Sociedad?.Id, conciliacion.CreateDate);

            foreach (var item in listaDetalle)
            {
                var accionista = await repoaccionista.GetByIdAsync(item.AccionistaId);
                if (accionista != null)
                {
                    if (item.Accion == "Creado")
                    {
                        ListgralNuevos.Add(new ConciliacionDetalleDto
                        {
                            Id = item.Id,
                            Accion = item.Accion,
                            Documento = accionista.TipoDocumento1?.Nombre,
                            NroDocumento = accionista.Documento1,
                            Nombre = accionista.Nombre,
                            TotalAcciones = item.TotalAcciones
                        });
                    }
                    else if (item.Accion == "Actualizado")
                    {
                        ListgralActualizados.Add(new ConciliacionDetalleDto
                        {
                            Id = item.Id,
                            Accion = item.Accion,
                            Documento = accionista.TipoDocumento1?.Nombre,
                            NroDocumento = accionista.Documento1,
                            Nombre = accionista.Nombre,
                            TotalAcciones = item.TotalAcciones
                        });
                    }
                }
            }

            CantidadAcciones = listaDetalle.Sum(x => x.TotalAcciones);
            TotalAccionista = listaDetalle.Count();

            foreach (var item in listaAccionistas.Where(a => a.EstatusAccionista?.Id == 2))
            {
                var accionista = await repoaccionista.GetByIdAsync((int)item.Accionista?.Id);
                if (accionista != null)
                {
                    ListgralInactivos.Add(new ConciliacionDetalleDto
                    {
                        Id = item.Id,
                        Accion = "Inactivado",
                        Documento = accionista.TipoDocumento1?.Nombre,
                        NroDocumento = accionista.Documento1,
                        Nombre = accionista.Nombre,
                        TotalAcciones = item.NroAcciones
                    });
                }
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }

    private async Task Regresar()
    {
        await jsRuntime.InvokeVoidAsync("history.back");
    }
}