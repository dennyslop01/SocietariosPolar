@using ExcelDataReader
@using SociePolar.Domain.Utils
@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnValidSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @( (int.TryParse(id, out var parsedId) && parsedId > 0) ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @( (int.TryParse(id, out var pId) && pId > 0) ? "Modificar Conciliación" : "Agregar Conciliación")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Iniciamos la grilla de filas y columnas -->
                    <div class="row">
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Sociedad</label>
                            <div class="dropdown">
                                <button class="form-select text-start d-flex justify-content-between align-items-center"
                                        type="button"
                                        style="font-size: 0.8rem;"
                                        @onclick="ToggleDropdown">
                                    <span>@(ObtenerNombreSeleccionado())</span>
                                </button>

                                <ul class="dropdown-menu w-100 p-2 @(isDropdownOpen ? "show" : "")"
                                    style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                    <li class="mb-2">
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Buscar..."
                                               style="font-size: 0.8rem;"
                                               @bind="textoBusqueda"
                                               @bind:event="oninput"
                                               @ref="searchInputRef" />
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item @(entidadEditando.SociedadId == 0 ? "active bg-primary text-white" : "")"
                                                style="font-size: 0.8rem;"
                                                @onclick="() => SeleccionarOpcion(0)">
                                            Seleccione ...
                                        </button>
                                    </li>

                                    @if (listSociedad != null)
                                    {
                                        @foreach (var sociedad in listSociedad.Where(s => string.IsNullOrEmpty(textoBusqueda) || s.Empresa.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item @(entidadEditando.SociedadId == sociedad.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarOpcion(sociedad.Id)">
                                                    @sociedad.Empresa.Nombre
                                                </button>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.SociedadId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="flexSwitchCustodia" @bind="isCustodia">
                                <label class="form-check-label fw-bold small text-secondary" for="flexSwitchCustodia">¿Es un archivo de Custodia?</label>
                            </div>

                            @if (isCustodia)
                            {
                                <label class="form-label fw-bold text-secondary small">Seleccione Custodio (Macro-accionista)</label>
                                <div class="dropdown">
                                    <button class="form-select text-start d-flex justify-content-between align-items-center"
                                            type="button"
                                            style="font-size: 0.8rem;"
                                            @onclick="ToggleDropdownCustodio">
                                        <span>@(ObtenerNombreCustodioSeleccionado())</span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-2 @(isDropdownCustodioOpen ? "show" : "")"
                                        style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                        <li class="mb-2">
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Buscar custodio..."
                                                   style="font-size: 0.8rem;"
                                                   @bind="textoBusquedaCustodio"
                                                   @bind:event="oninput" />
                                        </li>
                                        <li>
                                            <button type="button"
                                                    class="dropdown-item @(custodioId == 0 ? "active bg-primary text-white" : "")"
                                                    style="font-size: 0.8rem;"
                                                    @onclick="() => SeleccionarCustodio(0)">
                                                Seleccione Custodio ...
                                            </button>
                                        </li>
                                        @if (listaCustodios != null)
                                        {
                                            @foreach (var custodio in listaCustodios.Where(c => string.IsNullOrEmpty(textoBusquedaCustodio) || (c.Accionista?.Nombre != null && c.Accionista.Nombre.Contains(textoBusquedaCustodio, StringComparison.OrdinalIgnoreCase))))
                                            {
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item @(custodioId == custodio.Id ? "active bg-primary text-white" : "")"
                                                            style="font-size: 0.8rem;"
                                                            @onclick="() => SeleccionarCustodio(custodio.Id)">
                                                        @(custodio.Accionista?.Nombre) - (Acciones: @(custodio.NroAcciones?.ToString("N0") ?? "0"))
                                                    </button>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tipo Archivo</label>
                            <input type="text" class="form-control form-control-sm small"
                                   @bind="entidadEditando.TipoArchivo"
                                   placeholder="Ingrese tipo de archivo..."
                                   maxlength="200" />
                            <ValidationMessage For="@(() => entidadEditando.TipoArchivo)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Fecha del Archivo</label>
                            <input type="date" class="form-control form-control-sm small"
                                   @bind="entidadEditando.FechaArchivo" @bind:format="yyyy-MM-dd" />
                            <ValidationMessage For="@(() => entidadEditando.FechaArchivo)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <label for="fileInputExcel"
                                   class="form-label fw-bold btn btn-primary btn-sm"
                                   style="font-size: 12px; cursor: @(esInvalido ? "not-allowed" : "pointer"); pointer-events: @(esInvalido ? "none" : "auto");">
                                Seleccionar archivo Conciliaciones
                            </label>

                            <InputFile id="fileInputExcel"
                                       class="small"
                                       OnChange="@(async (InputFileChangeEventArgs args) => await UploadFile(args))"
                                       accept=".xlsx,.xls"
                                       capture="camera"
                                       style="display:none;" />

                            <label class="form-label fw-bold text-secondary small">@fileNameConciliacion</label>
                            <ValidationMessage For="@(() => entidadEditando.RutaConciliaciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Comentarios</label>
                            <textarea class="form-control form-control-sm small"
                                      @bind="entidadEditando.Observaciones"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Ingrese los comentarios (máximo 2,000 caracteres)...">
                                </textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(mensajeAlerta))
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-danger small">@mensajeAlerta</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>Guardar</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando || guardando)
{
    <ModalCargando Mensaje="@(guardando ? mensajeProgreso : "Cargando...")" />
}

@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = true;
    private bool guardando = false;
    private string mensajeProgreso = "Procesando...";
    bool esInvalido = false;
    private string? fileNameConciliacion = null;

    private ConciliacionDto entidadEditando = new();
    private List<Sociedad> listSociedad = new();

    private EditContext editContext = new(new ConciliacionDto());
    private ValidationMessageStore? mensajeStore;
    private Stream streamToUploadConciliacion;
    private Stream streamExcelread;
    private string contentTypeConciliacion = string.Empty;

    private List<ConciliacionDetalle> listaConciliaciones = new();
    private List<ConciliacionArchivo> listaArchivo = new();
    private List<IBaseEntity> listTipoDoc = new();


    [Inject] private ISociedad repoSociedades { get; set; } = null!;
    [Inject] private IAccionista repoAccionistas { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoaccionistasocie { get; set; } = null!;

    [Inject] private IConciliacion repository { get; set; } = null!;

    private bool isDropdownOpen = false;
    private string textoBusqueda = "";
    private ElementReference searchInputRef;

    private bool isCustodia = false;
    private int custodioId = 0;
    private List<AccionistaSociedad> listaCustodios = new();
    private bool isDropdownCustodioOpen = false;
    private string textoBusquedaCustodio = "";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            await LoadGenericDataAsync();

            if (id == "0" || string.IsNullOrEmpty(id))
            {
                entidadEditando = new()
                {
                    SociedadId = 0,
                    RutaConciliaciones = string.Empty,
                    CreateDate = DateTime.Now
                };
            }

            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar conciliación: {ex.Message}");
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LoadGenericDataAsync()
    {
        listTipoDoc = await GetEntityListAsync("tipodocumento");
        listSociedad = await repoSociedades.GetAllAsync();
    }

    public async Task<List<IBaseEntity>> GetEntityListAsync(string entityName)
    {
        var repo = RepoFactory.GetRepository(entityName);
        var method = repo.GetType().GetMethod("GetAllAsync");

        if (method == null) return new List<IBaseEntity>();

        // Invocamos el método asíncrono
        var task = (Task)method.Invoke(repo, null)!;
        await task;

        // Obtenemos el resultado de la Task dinámica
        var resultProperty = task.GetType().GetProperty("Result");
        var result = (IEnumerable<IBaseEntity>)resultProperty!.GetValue(task)!;

        return result.ToList();
    }


    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        mensajeAlerta = string.Empty;
        mostrarAlerta = false;

        fileNameConciliacion = string.Empty;
        entidadEditando.NombreConciliaciones = null;
        entidadEditando.RutaConciliaciones = null;

        var file = e.File;
        if (file == null) return;

        try
        {
            contentTypeConciliacion = file.ContentType;
            if (contentTypeConciliacion == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" || // .xlsx
                contentTypeConciliacion == "application/vnd.ms-excel")
            {
                var memoryStream = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
                var fileBytes = memoryStream.ToArray();
                memoryStream.Position = 0;
                streamToUploadConciliacion = memoryStream;

                var memoryStreamRead = new MemoryStream(fileBytes);
                streamExcelread = memoryStreamRead;

                fileNameConciliacion = e.File.Name;
                entidadEditando.RutaConciliaciones = e.File.Name;
                entidadEditando.NombreConciliaciones = e.File.Name;

                cargando = true;
                StateHasChanged();

                await CargarExcelConciliaciones();

                cargando = false;
                StateHasChanged();
            }
            else
            {
                mensajeAlerta = "Formato no soportado. Solo Excel.";/* imágenes y  */
                mostrarAlerta = true;
                cargando = false;
                StateHasChanged();
                await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo
                return;
            }

            if (listaArchivo.Count == 0)
            {
                fileNameConciliacion = string.Empty;
                entidadEditando.NombreConciliaciones = null;
                entidadEditando.RutaConciliaciones = null;

                mensajeAlerta = "El archivo Excel no contiene datos válidos.";
                mostrarAlerta = true;
                cargando = false;
                StateHasChanged();
                await MostrarNotificacion($"El archivo Excel no contiene datos válidos.", true);
                await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo
                return;
            }
        }
        catch (Exception ex)
        {
            fileNameConciliacion = string.Empty;
            entidadEditando.NombreConciliaciones = null;
            entidadEditando.RutaConciliaciones = null;

            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            mostrarAlerta = true;
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion($"Error al procesar el archivo: {ex.Message}", true);
        }
    }

    private async Task GuardarCambios()
    {
        if (guardando) return;
        mensajeAlerta = string.Empty;
        guardando = true;
        StateHasChanged();

        bool formularioValido = editContext.Validate();
        if (!formularioValido)
        {
            guardando = false;
            StateHasChanged();
            await MostrarNotificacion("Por favor complete los campos requeridos marcados en rojo", true);
            await jsRuntime.InvokeVoidAsync("eval", @"
                var m = document.querySelector('.modal-body') || document.querySelector('.modal');
                if (m) {
                    m.scrollTop = 0;
                    try { m.scrollTo({ top: 0, behavior: 'smooth' }); } catch(e) {}
                }
                var firstInput = document.querySelector('.modal select, .modal input');
                if (firstInput) {
                    try { firstInput.focus(); } catch(e) {}
                    firstInput.classList.remove('pulse-invalid-field');
                    void firstInput.offsetWidth;
                    firstInput.classList.add('pulse-invalid-field');
                }
            ");
            return;
        }

        // Validación previa para evitar que el stream falle
        if (streamToUploadConciliacion == null)
        {
            mensajeAlerta = "Debe seleccionar un archivo Excel válido antes de guardar.";
            mostrarAlerta = true;
            await MostrarNotificacion("Debe seleccionar un archivo Excel válido antes de guardar.", true);
            guardando = false;
            StateHasChanged();
            return;
        }

        if (listaArchivo.Count == 0)
        {
            fileNameConciliacion = string.Empty;
            entidadEditando.NombreConciliaciones = null;
            entidadEditando.RutaConciliaciones = null;

            mensajeAlerta = "El archivo Excel no contiene datos válidos.";
            mostrarAlerta = true;
            guardando = false;
            StateHasChanged();
            await MostrarNotificacion($"El archivo Excel no contiene datos válidos.", true);
            await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo
            return;
        }

        mensajeProgreso = "1/4 Subiendo respaldo a Google Drive...";
        StateHasChanged();
        await Task.Yield();

        if (!await SubirDocumentosDrive(streamToUploadConciliacion, contentTypeConciliacion))
        {
            guardando = false;
            StateHasChanged();
            return;
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (useridaux.Success && !string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);
                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    Int32 idNew = await repository.AddAsync(entidadEditando);
                    listaArchivo.ForEach(x => x.ConciliacionId = idNew);

                    mensajeProgreso = "2/4 Analizando padrón de accionistas en memoria...";
                    StateHasChanged();
                    await Task.Yield();

                    // Pre-carga en memoria de relaciones Accionista-Sociedad para esta sociedad
                    int sociedadId = (int)entidadEditando.SociedadId;
                    int? custodioOperacion = (isCustodia && custodioId > 0) ? custodioId : null;

                    var relacionesExistentes = await repoaccionistasocie.GetResumenBySociedadIdAsync(sociedadId);
                    var setRelaciones = new HashSet<(int AccionistaId, int? CustodioId)>();
                    var setAccionistasConRelacionActiva = new HashSet<int>();

                    foreach (var r in relacionesExistentes)
                    {
                        setRelaciones.Add((r.AccionistaId, r.CustodioId));
                        if (r.CustodioId == custodioOperacion && r.EstatusAccionistaId == 1)
                        {
                            setAccionistasConRelacionActiva.Add(r.AccionistaId);
                        }
                    }

                    // Pre-carga en memoria de todos los accionistas existentes (Id, Documento, Nombre)
                    var accionistasResumen = await repoAccionistas.GetResumenListAsync();
                    var dictAccionistasPorDoc = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                    var dictAccionistasPorNombre = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

                    // Priorizar accionistas con custodia activa en esta sociedad, luego por Id ascendente histórico
                    var accionistasOrdenados = accionistasResumen
                        .OrderByDescending(a => setAccionistasConRelacionActiva.Contains(a.Id))
                        .ThenBy(a => a.Id);

                    foreach (var a in accionistasOrdenados)
                    {
                        if (!string.IsNullOrWhiteSpace(a.Documento1))
                        {
                            var (td, np) = DocumentoNormalizer.Normalizar(a.Documento1);
                            if (!string.IsNullOrEmpty(np))
                            {
                                dictAccionistasPorDoc.TryAdd(np, a.Id);
                                dictAccionistasPorDoc.TryAdd($"{td}{np}", a.Id);
                                dictAccionistasPorDoc.TryAdd($"{td}-{np}", a.Id);
                            }
                            dictAccionistasPorDoc.TryAdd(a.Documento1.Trim(), a.Id);
                        }

                        if (!string.IsNullOrWhiteSpace(a.Nombre))
                        {
                            string nomNorm = a.Nombre.Trim();
                            if (!dictAccionistasPorNombre.ContainsKey(nomNorm))
                            {
                                dictAccionistasPorNombre[nomNorm] = a.Id;
                            }
                            else
                            {
                                dictAccionistasPorNombre[nomNorm] = -1; // No es único, no usar fallback
                            }
                        }
                    }

                    listaConciliaciones.Clear();
                    int totalFilas = listaArchivo.Count;
                    int contadorFilas = 0;

                    foreach (var item in listaArchivo)
                    {
                        contadorFilas++;
                        if (contadorFilas % 2000 == 0)
                        {
                            mensajeProgreso = $"2/4 Comparando accionistas ({contadorFilas:N0} de {totalFilas:N0})...";
                            StateHasChanged();
                            await Task.Yield();
                        }

                        var (tipoDoc, rif) = DocumentoNormalizer.Normalizar(item.Rif);
                        string accionreal = "Actualizado";
                        int accionistaId = 0;

                        // 1. Buscar en diccionario por documento / RIF normalizado
                        if (!string.IsNullOrEmpty(rif))
                        {
                            if (dictAccionistasPorDoc.TryGetValue($"{tipoDoc}{rif}", out int idEncontrado) && idEncontrado > 0)
                            {
                                accionistaId = idEncontrado;
                            }
                            else if (dictAccionistasPorDoc.TryGetValue(rif, out idEncontrado) && idEncontrado > 0)
                            {
                                accionistaId = idEncontrado;
                            }
                            else if (!string.IsNullOrWhiteSpace(item.Rif) && dictAccionistasPorDoc.TryGetValue(item.Rif.Trim(), out idEncontrado) && idEncontrado > 0)
                            {
                                accionistaId = idEncontrado;
                            }
                        }

                        // 2. Fallback por nombre exacto si no se encontró por documento
                        if (accionistaId == 0 && !string.IsNullOrWhiteSpace(item.NombreAccionista))
                        {
                            string nom = item.NombreAccionista.Trim();
                            if (dictAccionistasPorNombre.TryGetValue(nom, out int idNom) && idNom > 0)
                            {
                                accionistaId = idNom;
                            }
                        }

                        // 3. Si no existe en el padrón, crear el accionista nuevo
                        if (accionistaId == 0)
                        {
                            string docFinal = (tipoDoc == "V" || tipoDoc == "E") ? rif : $"{tipoDoc}{rif}";
                            AccionistaDto accionistaDto = new()
                            {
                                TipoDocumento1Id = listTipoDoc.Where(x => x.Nombre == tipoDoc).Select(x => x.Id).FirstOrDefault(),
                                Documento1 = docFinal,
                                Nombre = item.NombreAccionista,
                                CreateDate = DateTime.Now,
                                CreateUserId = userid,
                                UpdateDate = DateTime.Now,
                                UpdateUserId = userid
                            };
                            var nuevoAccionista = await repoAccionistas.AddReturnEntidadAsync(accionistaDto);
                            accionistaId = nuevoAccionista.Id;
                            accionreal = "Creado";

                            if (!string.IsNullOrEmpty(rif))
                            {
                                dictAccionistasPorDoc[rif] = accionistaId;
                                dictAccionistasPorDoc[$"{tipoDoc}{rif}"] = accionistaId;
                            }
                            if (!string.IsNullOrWhiteSpace(item.NombreAccionista))
                            {
                                dictAccionistasPorNombre[item.NombreAccionista.Trim()] = accionistaId;
                            }
                        }

                        // 4. Verificar relación AccionistaSociedad
                        if (accionistaId > 0)
                        {
                            var claveRelacion = (accionistaId, custodioOperacion);
                            if (!setRelaciones.Contains(claveRelacion))
                            {
                                AccionistaSociedadDto accionistaSociedadDto = new()
                                {
                                    AccionistaId = accionistaId,
                                    SociedadId = sociedadId,
                                    EstatusAccionistaId = 1,
                                    CustodioId = custodioOperacion,
                                    NroAcciones = item.TotalAcciones,
                                    CreateDate = DateTime.Now,
                                    CreateUserId = userid,
                                    UpdateDate = DateTime.Now,
                                    UpdateUserId = userid
                                };
                                await repoaccionistasocie.AddReturnEntidadAsync(accionistaSociedadDto);
                                setRelaciones.Add(claveRelacion);
                                accionreal = "Creado";
                            }
                            else
                            {
                                accionreal = "Actualizado";
                            }

                            ConciliacionDetalle detalle = new()
                            {
                                ConciliacionId = idNew,
                                AccionistaId = accionistaId,
                                TotalAcciones = item.TotalAcciones,
                                Accion = accionreal,
                                CreateDate = DateTime.Now,
                                CreateUserId = userid
                            };
                            listaConciliaciones.Add(detalle);
                        }
                    }

                    mensajeProgreso = "3/4 Guardando registros de conciliación...";
                    StateHasChanged();
                    await Task.Yield();

                    // Inserción en bloques de 1,000 en ConciliacionesDetalles
                    await repository.AddDetalleAsync(listaConciliaciones);

                    mensajeProgreso = "4/4 Aplicando saldos, auditoría e inactivaciones...";
                    StateHasChanged();
                    await Task.Yield();

                    // Actualización masiva de saldos y generación de auditoría en 1 solo paso SQL
                    await repoaccionistasocie.ActualizarSaldosYAuditoriaConciliacionLoteAsync(
                        idNew, 
                        sociedadId, 
                        custodioOperacion, 
                        userid);

                    // Inactivar accionistas ausentes vía SP
                    await repoaccionistasocie.AccionistasSociedadInactivar(idNew, custodioOperacion);

                    // Liberar el stream de forma segura ahora que el proceso completo terminó bien
                    await streamToUploadConciliacion.DisposeAsync();
                    await streamExcelread.DisposeAsync();
                    await OnFinalizado.InvokeAsync(true);
                }
            }
            else
            {
                // Corrección: Si no encuentra el usuario, debe apagar el cargando para no congelar la pantalla
                await MostrarNotificacion("Error: No se pudo identificar la sesión del usuario.", true);
                guardando = false;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            guardando = false;
            StateHasChanged();
            Console.WriteLine($"Error en Base de Datos: {ex.Message}");
            await MostrarNotificacion("Error al guardar en la base de datos: " + ex.Message, true);
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task CargarExcelConciliaciones()
    {
        listaArchivo.Clear();
        if (streamExcelread.CanSeek)
        {
            streamExcelread.Position = 0;
        }
        var useridaux = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(useridaux.Value))
        {
            int userid = int.Parse(useridaux.Value);
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);

            using (var reader = ExcelReaderFactory.CreateReader(streamExcelread))
            {
                int fila = 1;
                int vacios = 0;
                try
                {
                    while (reader.Read())
                    {
                        // Omitir únicamente la primera fila (Cabecera)
                        if (fila == 1)
                        {
                            fila++;
                            continue;
                        }

                        if (vacios > 5) return;

                        if (reader.GetValue(0) == null)
                        {
                            vacios++;
                            continue;
                        }

                        if (GetString(reader.GetValue(0)).Contains("Total"))
                        {
                            vacios++;
                            continue;
                        }

                        var nuevo = new ConciliacionArchivo()
                        {
                            ConciliacionId = 0,
                            Rif = GetString(reader.GetValue(0)),
                            NombreAccionista = GetString(reader.GetValue(1)),
                            TotalAcciones = GetInt(reader.GetValue(2)),
                            CreateDate = DateTime.Now,
                            CreateUserId = userid,
                        };

                        listaArchivo.Add(nuevo);
                        fila++;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error al cargar el archivo Excel: {ex.Message}");
                    await MostrarNotificacion($"Error al cargar el archivo Excel en la Fila {fila}: {ex.Message}", true);
                    listaArchivo.Clear(); // Limpiar la lista si hay error
                }
            }
        }
    }

    private async Task<bool> SubirDocumentosDrive(Stream streamToUpload, string tipodoc)
    {
        try
        {
            string folderName = $"Conciliaciones_Sociedad_ID_{entidadEditando.SociedadId}";
            string nombreLimpio = string.Empty;
            nombreLimpio = entidadEditando.NombreConciliaciones.Replace(" ", "_").Replace("/", "_").Replace("\\", "_");
            // if (!nombreLimpio.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            // {
            //     nombreLimpio = nombreLimpio + $"_{DateTime.Now:yyyyMMdd}.xlsx";
            // }
            entidadEditando.NombreConciliaciones = nombreLimpio;

            if (!string.IsNullOrEmpty(folderName))
            {
                string folderId = await DriveService.CreateFolderAsync(folderName);

                // IMPORTANTE: NO uses 'using(streamToUpload)'. Deja que Blazor maneje el ciclo de vida
                // o ciérralo manualmente AL FINAL de todo el proceso exitoso.
                string fileIdResult = await DriveService.UploadFileAsync(streamToUpload, nombreLimpio, tipodoc, folderId);
                entidadEditando.RutaConciliaciones = $"{folderId}/{fileIdResult}";
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Error al subir a Google Drive: " + ex.Message, true);
            return false;
        }

        if (string.IsNullOrEmpty(entidadEditando.RutaConciliaciones))
        {
            await MostrarNotificacion("No se pudo obtener la ruta de Google Drive para el archivo de Conciliaciones.", true);
            cargando = false;
            StateHasChanged();
            return false;
        }

        return true;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    // Alternar la apertura del menú desplegable
    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
        if (!isDropdownOpen)
        {
            textoBusqueda = ""; // Limpia la búsqueda al cerrar
        }
    }

    // Devuelve el texto del elemento seleccionado en el botón principal
    private string ObtenerNombreSeleccionado()
    {
        if (entidadEditando?.SociedadId == 0 || listSociedad == null)
        {
            return "Seleccione ...";
        }

        var seleccionado = listSociedad.FirstOrDefault(s => s.Id == entidadEditando.SociedadId);
        return seleccionado?.Empresa?.Nombre ?? "Seleccione ...";
    }

    // Asigna el ID real a tu modelo y cierra el menú
    private async Task SeleccionarOpcion(int id)
    {
        entidadEditando.SociedadId = id;
        isDropdownOpen = false;
        textoBusqueda = ""; // Reinicia el filtro

        if (id > 0)
        {
            var accionistas = await repoaccionistasocie.GetBySociedadIdAsync(id);
            listaCustodios = accionistas
                .Where(x => (x.EstatusAccionista?.Id == 1)
                         && (x.NroAcciones ?? 0) > 0
                         && x.CustodioId == null)
                .OrderBy(x => x.Accionista?.Nombre)
                .ToList();
        }
        else
        {
            listaCustodios.Clear();
        }
        custodioId = 0;
    }

    private void ToggleDropdownCustodio()
    {
        isDropdownCustodioOpen = !isDropdownCustodioOpen;
        if (!isDropdownCustodioOpen) textoBusquedaCustodio = "";
    }

    private string ObtenerNombreCustodioSeleccionado()
    {
        if (custodioId == 0 || listaCustodios == null) return "Seleccione Custodio ...";
        var seleccionado = listaCustodios.FirstOrDefault(s => s.Id == custodioId);
        return seleccionado?.Accionista?.Nombre ?? "Seleccione Custodio ...";
    }

    private void SeleccionarCustodio(int id)
    {
        custodioId = id;
        isDropdownCustodioOpen = false;
        textoBusquedaCustodio = "";
    }

    static string GetString(object val)
    {
        var texto = val?.ToString()?.Trim();
        return (texto == "-" || string.IsNullOrEmpty(texto)) ? string.Empty : texto;
    }

    static int GetInt(object val)
    {
        var texto = val?.ToString()?.Trim();
        if (texto == "-" || string.IsNullOrEmpty(texto)) return 0;

        return int.TryParse(texto, out int res) ? res : 0;
    }
