@page "/detalleaccionista/{id}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-person-vcard text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            @NombreMostrar
                        </h5>
                        <span class="text-secondary small fw-semibold">
                            @(string.IsNullOrEmpty(entidadActual.TipoAccionista?.Nombre) ? "Detalle de Accionista" : $"Detalle de Accionista ({entidadActual.TipoAccionista.Nombre})")
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-danger btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="ExportarAPdf"
                            disabled="@cargando"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-file-earmark-pdf me-2"></i> Exportar PDF
                    </button>

                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>
                </div>
            </div>
        </div>

        @if (mostrarAlerta)
        {
            <div class="alert @claseAlerta d-flex align-items-center justify-content-between m-3 mb-0 py-2 px-3 border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi @iconoAlerta me-2 fs-5"></i>
                    <div class="small fw-semibold">
                        @mensajeAlerta
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(urlPdfGenerado))
                {
                    <a href="@urlPdfGenerado" target="_blank" class="btn btn-sm btn-outline-primary ms-3 fw-semibold">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Abrir PDF en pantalla
                    </a>
                }
            </div>
        }

        <div class="card-body">
            <!-- Navegación de Pestañas Estilizada -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill" id="accionistaDetailTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill active"
                            id="tab-1" data-bs-toggle="tab" data-bs-target="#panel-1"
                            type="button" role="tab">
                        <span class="fw-semibold">Datos Básicos</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-2" data-bs-toggle="tab" data-bs-target="#panel-2"
                            type="button" role="tab">
                        <span class="fw-semibold">Contacto y Ubicación</span>
                    </button>
                </li>
                @if (entidadActual.TipoAccionista?.Id == 1)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill"
                                id="tab-3" data-bs-toggle="tab" data-bs-target="#panel-3"
                                type="button" role="tab">
                            <span class="fw-semibold">Cónyuge</span>
                        </button>
                    </li>
                }
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-4" data-bs-toggle="tab" data-bs-target="#panel-4"
                            type="button" role="tab">
                        <span class="fw-semibold">Finanzas y Apoderado</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-5" data-bs-toggle="tab" data-bs-target="#panel-5"
                            type="button" role="tab">
                        <span class="fw-semibold">Junta y Otros</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-6" data-bs-toggle="tab" data-bs-target="#panel-6"
                            type="button" role="tab">
                        <span class="fw-semibold">Sociedades</span>
                    </button>
                </li>
            </ul>

            <!-- Contenido de las Pestañas -->
            <div class="tab-content" id="accionistaDetailTabsContent">
                <!-- Panel 1: Datos Básicos -->
                <div class="tab-pane fade show active" id="panel-1" role="tabpanel">
                    <div class="table-responsive">
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-10 col-md-12">
                                <div class="row">
                                    <!-- Tipo Accionista -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Accionista</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(entidadActual.TipoAccionista?.Nombre)</label>
                                    </div>

                                    @if (entidadActual.TipoAccionista?.Id != 3)
                                    {
                                        <!-- Nombre o Razón Social -->
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Nombre o Razón Social</label>
                                            <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.Nombre)</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Nombre o Razón Social (Sucesión) -->
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Nombre o Razón Social (Sucesión)</label>
                                            <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.NombreSusesion ?? entidadActual.Nombre)</label>
                                        </div>
                                    }

                                    <div class="col-12"><hr /></div>

                                    <!-- Documento 1 -->
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento 1</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(entidadActual.TipoDocumento1?.Nombre)</label>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 1</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento1?.Nombre, entidadActual.Documento1))</label>
                                    </div>

                                    @if (entidadActual.TipoAccionista?.Id != 3)
                                    {
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Fecha de Emisión 1</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision1?.ToString("yyyy-MM-dd"))</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 1</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento1?.ToString("yyyy-MM-dd"))</label>
                                        </div>

                                        <!-- Documento 2 -->
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Tipo Documento 2</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.TipoDocumento2?.Nombre)</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 2</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento2?.Nombre, entidadActual.Documento2))</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Fecha de Emisión 2</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision2?.ToString("yyyy-MM-dd"))</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 2</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento2?.ToString("yyyy-MM-dd"))</label>
                                        </div>

                                        <!-- Documento 3 -->
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Tipo Documento 3</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.TipoDocumento3?.Nombre)</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 3</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento3?.Nombre, entidadActual.Documento3))</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Fecha de Emisión 3</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision3?.ToString("yyyy-MM-dd"))</label>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 3</label>
                                            <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento3?.ToString("yyyy-MM-dd"))</label>
                                        </div>

                                        @if (entidadActual.TipoAccionista?.Id == 1)
                                        {
                                            <!-- Documento 4 -->
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Tipo Documento 4</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.TipoDocumento4?.Nombre)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 4</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento4?.Nombre, entidadActual.Documento4))</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha de Emisión 4</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision4?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 4</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento4?.ToString("yyyy-MM-dd"))</label>
                                            </div>

                                            <div class="col-12"><hr /></div>

                                            <!-- Campos Persona Natural -->
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Estado Civil</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.EstadoCivil?.Nombre)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Nacionalidad</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.Nacionalidad)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha de Nacimiento</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaNacimiento?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                        }

                                        @if (entidadActual.TipoAccionista?.Id == 2)
                                        {
                                            <div class="col-12">
                                                <hr />
                                                <label class="form-label fw-bold text-primary small">Representante Legal y Datos Corporativos</label>
                                                <hr />
                                            </div>

                                            <div class="col-md-12 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Nombre Representante Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.RepresentanteLegal)</label>
                                            </div>

                                            <!-- Doc 1 Rep Legal -->
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Tipo Doc. 1 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ObtenerNombreTipoDoc(entidadActual.TipoDocumento1IdLegal)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Documento 1 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.Documento1Legal)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Emisión 1 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision1Legal?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Vencimiento 1 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento1Legal?.ToString("yyyy-MM-dd"))</label>
                                            </div>

                                            <!-- Doc 2 Rep Legal -->
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Tipo Doc. 2 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ObtenerNombreTipoDoc(entidadActual.TipoDocumento2IdLegal)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Documento 2 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.Documento2Legal)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Emisión 2 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision2Legal?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Vencimiento 2 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento2Legal?.ToString("yyyy-MM-dd"))</label>
                                            </div>

                                            <!-- Doc 3 Rep Legal -->
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Tipo Doc. 3 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ObtenerNombreTipoDoc(entidadActual.TipoDocumento3IdLegal)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Documento 3 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.Documento3Legal)</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Emisión 3 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaEmision3Legal?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Vencimiento 3 Rep. Legal</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimiento3Legal?.ToString("yyyy-MM-dd"))</label>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Años de Duración de la Compañía</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.AnoDuracion)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Años de Vigencia de la Junta</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.VigenciaJunta?.ToString())</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento de la Junta</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaVencimientoJunta?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Año Emisión JD</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.AnoEmisionJD)</label>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Junta Directiva</label>
                                                <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.JuntaDirectiva)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">¿Documento Constitutivo?</label>
                                                <label class="form-label text-secondary small">@SiNoGuion(entidadActual.DocumentoConstitutivo)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Datos Documento Constitutivo</label>
                                                <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.DatosDocumentoConstitutivo)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Inscrito En</label>
                                                <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.InscritoEn)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Publicación</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.Publicacion)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Datos Publicación</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.DatosPublicacion)</label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <!-- Campos Sucesión (Tipo 3) -->
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal (Sucesión)</label>
                                            <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.CedulaSusesion)</label>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">¿Difunto?</label>
                                            <label class="form-label text-secondary small">@SiNoGuion(entidadActual.Difunto)</label>
                                        </div>
                                        @if (entidadActual.Difunto == 1)
                                        {
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Fecha Defunción</label>
                                                <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaDefuncion?.ToString("yyyy-MM-dd"))</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Datos Acta Defunción</label>
                                                <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.DatosActaDefuncion)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Declaración</label>
                                                <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.Declaracion)</label>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-secondary small d-block">Datos Declaración</label>
                                                <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.DatosDeclaracion)</label>
                                            </div>
                                        }
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Miembros Sucesión</label>
                                            <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.MiembrosSucesion)</label>
                                        </div>
                                    }

                                    <div class="col-12"><hr /></div>

                                    <!-- Campos Comunes -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Dirigido A</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(entidadActual.DirigidoA?.Nombre)</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Ingreso</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(entidadActual.FechaIngreso?.ToString("yyyy-MM-dd"))</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Última Actualización</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(entidadActual.UltimaActualizacion?.ToString("yyyy-MM-dd"))</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Año Actualización</label>
                                        <label class="form-label text-secondary small">@ValorOGuion(entidadActual.AnoActualizacion?.ToString())</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">¿Hace falta actualizar?</label>
                                        <label class="form-label text-secondary small">@SiNoGuion(entidadActual.FaltaActualizar)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel 2: Contacto y Ubicación -->
                <div class="tab-pane fade" id="panel-2" role="tabpanel">
                    <div class="table-responsive">
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-10 col-md-12">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Email 1</label>
                                        <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.Email1)</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Email 2</label>
                                        <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.Email2)</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Email 3</label>
                                        <label class="form-label text-secondary small text-break">@ValorOGuion(entidadActual.Email3)</label>
                                    </div>

                                    <div class="col-md-4 mb-3">
