@code {
    [Parameter] public string id { get; set; } = "";

    private bool cargando = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string urlPdfGenerado = "";
    private string claseAlerta = "alert-success";
    private string iconoAlerta = "bi-check-circle-fill";
    private Accionista entidadActual = new();
    private List<AccionistaSociedadVerDto> ListSociedadesAccionista = new();
    private Dictionary<int, string> tiposDocDict = new();
    private int idSociedadPopup = 0;
    private bool mostrarModalSociedad = false;

    private void AbrirModalSociedad(int sociedadId)
    {
        if (sociedadId <= 0) return;
        idSociedadPopup = sociedadId;
        mostrarModalSociedad = true;
    }

    [Inject] private IAccionista repository { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoAccionistaSociedad { get; set; } = null!;

    private string NombreMostrar =>
        entidadActual.TipoAccionista?.Id == 3
            ? (!string.IsNullOrWhiteSpace(entidadActual.NombreSusesion) ? entidadActual.NombreSusesion : (entidadActual.Nombre ?? "Detalle Accionista"))
            : (!string.IsNullOrWhiteSpace(entidadActual.Nombre) ? entidadActual.Nombre : "Detalle Accionista");

    private static string ValorOGuion(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "-" : valor;

    private static string SiNoGuion(int? valor) =>
        valor == 1 ? "Sí" : (valor == 0 ? "No" : "-");

    private string ObtenerNombreTipoDoc(int? idDoc)
    {
        if (idDoc.HasValue && idDoc.Value > 0 && tiposDocDict.TryGetValue(idDoc.Value, out var nombre))
        {
            return nombre;
        }
        return "-";
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        if (!string.IsNullOrWhiteSpace(id) && id != "0" && int.TryParse(id, out _))
        {
            await LoadGenericDataAsync();
        }
        else
        {
            await MostrarNotificacion("No se proporcionó un ID válido", true);
        }
        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            int accionistaId = int.Parse(id);
            var resultado = await repository.GetByIdAsync(accionistaId);
            if (resultado == null)
            {
                await MostrarNotificacion("El accionista seleccionado no existe.", true);
                return;
            }
            entidadActual = resultado;

            // Cargar catálogo de tipos de documento para resolver IDs de Cónyuge, Apoderado y Rep. Legal
            try
            {
                var repoTipoDoc = RepoFactory.GetRepository("tipodocumento");
                var method = repoTipoDoc.GetType().GetMethod("GetAllAsync");
                if (method != null)
                {
                    var task = (Task)method.Invoke(repoTipoDoc, null)!;
                    await task;
                    var resultProperty = task.GetType().GetProperty("Result");
                    if (resultProperty?.GetValue(task) is IEnumerable<IBaseEntity> listaTipos)
                    {
                        tiposDocDict = listaTipos.ToDictionary(k => k.Id, v => v.Nombre ?? "");
                    }
                }
            }
            catch
            {
                // Ignorar si falla carga de catálogo auxiliar
            }

            // Cargar las sociedades donde participa este accionista
            var relaciones = await repoAccionistaSociedad.GetByAccionistaIdAsync(accionistaId);
            List<AccionistaSociedadVerDto> listaSociedades = new();
            foreach (var item in relaciones.OrderBy(x => x.Sociedad?.Empresa?.Nombre ?? ""))
            {
                long nroAcciones = item.NroAcciones ?? 0;
                decimal porcParticipa = 0;

                if (item.Sociedad != null && !string.IsNullOrWhiteSpace(item.Sociedad.NumeroAcciones) &&
                    long.TryParse(item.Sociedad.NumeroAcciones, out long totalAccionesSoc) && totalAccionesSoc > 0 && nroAcciones > 0)
                {
                    porcParticipa = Math.Round((decimal)nroAcciones / totalAccionesSoc * 100, 6);
                }

                listaSociedades.Add(new AccionistaSociedadVerDto
                {
                    Id = item.Id,
                    SociedadId = item.Sociedad?.Id ?? 0,
                    SociedadNombre = item.Sociedad?.Empresa?.Nombre ?? "-",
                    DocumentoIdentidad = UtilClass.ObtenerDocumentoCompleto(item.Sociedad?.TipoDocumento1?.Nombre, item.Sociedad?.Documento1),
                    EstatusSociedadNombre = item.Sociedad?.EstatusSociedad?.Nombre ?? "-",
                    TipoAccionistaNombre = item.EstatusAccionista?.Nombre ?? "-",
                    NroAcciones = nroAcciones,
                    Participacion = porcParticipa,
                    CreateDate = item.CreateDate,
                    UpdateDate = item.UpdateDate
                });
            }
            ListSociedadesAccionista = listaSociedades;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Regresar()
    {
        navManager.NavigateTo("/accionistas");
    }

    private async Task ExportarAPdf()
    {
        try
        {
            cargando = true;
            urlPdfGenerado = "";
            StateHasChanged();

            urlPdfGenerado = await ReportService.GenerarYDescargarReporteAccionistaAsync(int.Parse(id));

            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Reporte PDF generado exitosamente.");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion($"Error al exportar PDF: {ex.Message}", true);
        }
    }
}

