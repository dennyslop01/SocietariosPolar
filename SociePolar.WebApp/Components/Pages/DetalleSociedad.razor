@if (mostrarModalAccionista && idAccionistaPopup > 0)
{
    <ModalDetalleAccionista AccionistaId="@idAccionistaPopup" OnCerrar="() => mostrarModalAccionista = false" />
}

@code {
    [Parameter] public string id { get; set; } = "";

    private bool cargando = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string urlPdfGenerado = "";
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private Sociedad entidadActual = new();
    private List<Autoridad> ListAutoridadGral = new();
    private List<Asamblea> ListAsambleaGral = new();
    private List<Asamblea> ListReformaGral = new();
    private List<Certificacion> ListCertificacionGral = new();
    private List<LibroSocietario> ListLibrosgral = new();
    private List<AccionistaSociedadVerDto> ListAccionistasGral = new();

    int idAsamblea = 0;
    private bool mostrarModal = false;
    private int idAccionistaPopup = 0;
    private bool mostrarModalAccionista = false;
    private int? _ultimoCargoId;

    private void AbrirModalAccionista(int accionistaId)
    {
        if (accionistaId <= 0) return;
        idAccionistaPopup = accionistaId;
        mostrarModalAccionista = true;
    }

    [Inject] private ISociedad repository { get; set; } = null!;
    [Inject] private IAutoridad repoAutoridad { get; set; } = null!;
    [Inject] private IAsamblea repoAsamblea { get; set; } = null!;
    [Inject] private ICertificacion repoCertificacion { get; set; } = null!;
    [Inject] private ILibroSocietario repoLibros { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoaccionista { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        if (id != "0")
        {
            await LoadGenericDataAsync();
        }
        else
        {
            await MostrarNotificacion("No se proporcionó un ID válido", true);
        }
        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            entidadActual = await repository.GetByIdAsync(int.Parse(id));

            if(entidadActual.EstatusSociedad?.Id != 1)
            {
                await MostrarNotificacion("La sociedad seleccionada no está activa o no existe.", true);
                return;
            }

            var listAutoridad = await repoAutoridad.GetBySociedadIdAsync(int.Parse(id));
            ListAutoridadGral = listAutoridad.Where(x => !string.IsNullOrWhiteSpace(x.Nombre))
                .OrderBy(x => x.Cargo?.Orden ?? 999)
                .ThenBy(x => x.Cargo?.Nombre ?? "")
                .ThenBy(x => x.Nombre ?? "")
                .ToList();

            var listAsamblea = await repoAsamblea.GetBySociedadIdAsync(int.Parse(id));
            ListAsambleaGral = listAsamblea
                .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1 && x.IndicadorAsamblea == 1)
                .OrderBy(x => x.FechaCelebracion)
                .ToList();
        
            ListReformaGral = listAsamblea
                .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1 && (x.IndicadorAsamblea == 0 || x.TipoReforma != null))
                .OrderBy(x => x.FechaCelebracion)
                .ToList();
        
            var listCertificaciones = await repoCertificacion.GetBySociedadIdAsync(int.Parse(id));
            ListCertificacionGral = listCertificaciones
                .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1)
                .OrderByDescending(x => x.Fecha)
                .ToList();

            var listLibros = await repoLibros.GetBySociedadIdAsync(int.Parse(id));
            ListLibrosgral = listLibros
                .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1)
                .OrderBy(x => x.FechaDesde)
                .ToList();

            List<AccionistaSociedadVerDto> listNewAccionista = new();

            int sociedadId = int.Parse(id);
            var listAaccionista = await repoaccionista.GetBySociedadIdAsync(sociedadId);
            var activosDirectos = listAaccionista
                .Where(x => (x.EstatusAccionista == null || x.EstatusAccionista.Id == 1) && x.CustodioId == null)
                .ToList();

            var custodiosSet = listAaccionista
                .Where(x => (x.EstatusAccionista == null || x.EstatusAccionista.Id == 1) && x.CustodioId != null)
                .Select(x => x.CustodioId!.Value)
                .ToHashSet();

            long totalAccionesSociedad = 0;
            if (!string.IsNullOrWhiteSpace(entidadActual.NumeroAcciones))
            {
                long.TryParse(entidadActual.NumeroAcciones, out totalAccionesSociedad);
            }

            foreach (var item in activosDirectos)
            {
                long nroacciones = item.NroAcciones ?? 0;
                decimal porcparticipa = 0;

                if (totalAccionesSociedad > 0 && nroacciones > 0)
                {
                    porcparticipa = Math.Round((decimal)nroacciones / totalAccionesSociedad * 100, 6);
                }

                AccionistaSociedadVerDto accionista = new()
                {
                    Id = item.Id,
                    SociedadId = sociedadId,
                    AccionistaId = item.Accionista?.Id ?? 0,
                    SociedadNombre = item.Sociedad?.Empresa?.Nombre,
                    DocumentoIdentidad = UtilClass.ObtenerDocumentoCompleto(item.Accionista?.TipoDocumento1?.Nombre, item.Accionista?.Documento1),
                    TipoAccionistaNombre = item.Accionista?.TipoAccionista?.Nombre,
                    AccionistaNombre = (item.Accionista?.TipoAccionista?.Id != 3)
                        ? item.Accionista?.Nombre
                        : ((item.Accionista?.NombreSusesion?.Length > 50) ? item.Accionista.NombreSusesion.Substring(0, 50) : item.Accionista?.NombreSusesion),
                    NroAcciones = nroacciones,
                    Participacion = porcparticipa,
                    EsCustodio = custodiosSet.Contains(item.Id),
                    CreateDate = item.CreateDate,
                    UpdateDate = item.UpdateDate
                };

                listNewAccionista.Add(accionista);
            }
            ListAccionistasGral = listNewAccionista.OrderByDescending(x => x.NroAcciones).ToList();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task ToggleCustodiados(AccionistaSociedadVerDto p)
    {
        p.MostrarCustodiados = !p.MostrarCustodiados;

        if (p.MostrarCustodiados && !p.SubCustodiados.Any())
        {
            var custodiadosDb = await repoaccionista.GetCustodiadosAsync(p.SociedadId, p.Id, 1);
            long numTotalSociedad = 0;
            if (!string.IsNullOrWhiteSpace(entidadActual.NumeroAcciones))
            {
                long.TryParse(entidadActual.NumeroAcciones, out numTotalSociedad);
            }

            p.SubCustodiados = custodiadosDb.Select(x => new AccionistaSociedadVerDto
            {
                Id = x.Id,
                SociedadId = p.SociedadId,
                SociedadNombre = p.SociedadNombre,
                AccionistaId = x.Accionista?.Id ?? 0,
                DocumentoIdentidad = UtilClass.ObtenerDocumentoCompleto(x.Accionista?.TipoDocumento1?.Nombre, x.Accionista?.Documento1),
                AccionistaNombre = (x.Accionista?.TipoAccionista?.Id != 3) ? x.Accionista?.Nombre : x.Accionista?.NombreSusesion,
                TipoAccionistaNombre = x.Accionista?.TipoAccionista?.Nombre,
                NroAcciones = x.NroAcciones,
                Participacion = (numTotalSociedad > 0 && (x.NroAcciones ?? 0) > 0)
                    ? Math.Round((decimal)x.NroAcciones!.Value / numTotalSociedad * 100, 6)
                    : 0,
                CreateDate = x.CreateDate,
                UpdateDate = x.UpdateDate
            }).ToList();
        }
        p.SubCurrentPage = 1;
        StateHasChanged();
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

