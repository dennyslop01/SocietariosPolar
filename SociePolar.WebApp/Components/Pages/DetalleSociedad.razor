    private async Task ExportarAPdf()
    {
        try
        {
            cargando = true;
            urlPdfGenerado = "";
            StateHasChanged();

            urlPdfGenerado = await ReportService.GenerarYDescargarReporteSociedadAsync(int.Parse(id));

            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Reporte PDF generado exitosamente.");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion($"Error al exportar PDF: {ex.Message}", true);
        }
    }

