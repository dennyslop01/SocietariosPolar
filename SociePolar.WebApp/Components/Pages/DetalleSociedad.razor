@page "/detallesociedad/{id}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-bezier text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            @(string.IsNullOrEmpty(entidadActual.Empresa?.Nombre) ? "Detalle Sociedad" : entidadActual.Empresa.Nombre)
                        </h5>
                        <span class="text-secondary small fw-semibold">
                            @(string.IsNullOrEmpty(entidadActual.Empresa?.Nombre) ? "Ficha informativa" : "Detalle de Sociedad Activa")
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-danger btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="ExportarAPdf"
                            disabled="@cargando"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-file-earmark-pdf me-2"></i> Exportar PDF
                    </button>

                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>
                </div>
            </div>
        </div>

        @if (mostrarAlerta)
        {
            <div class="alert @claseAlerta d-flex align-items-center justify-content-between m-3 mb-0 py-2 px-3 border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi @iconoAlerta me-2 fs-5"></i>
                    <div class="small fw-semibold">
                        @mensajeAlerta
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(urlPdfGenerado))
                {
                    <a href="@urlPdfGenerado" target="_blank" class="btn btn-sm btn-outline-primary ms-3 fw-semibold">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Abrir PDF en pantalla
                    </a>
                }
            </div>
        }

        <div class="card-body">
            <!-- Navegación de Pestañas Estilizada -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill" id="talentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill active"
                            id="tab-1" data-bs-toggle="tab" data-bs-target="#panel-1"
                            type="button" role="tab">
                        <span class="fw-semibold">General</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-2" data-bs-toggle="tab" data-bs-target="#panel-2"
                            type="button" role="tab">
                        <span class="fw-semibold">Autoridades</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-3" data-bs-toggle="tab" data-bs-target="#panel-3"
                            type="button" role="tab">
                        <span class="fw-semibold">Asambleas</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-4" data-bs-toggle="tab" data-bs-target="#panel-4"
                            type="button" role="tab">
                        <span class="fw-semibold">Reformas</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-5" data-bs-toggle="tab" data-bs-target="#panel-5"
                            type="button" role="tab">
                        <span class="fw-semibold">Certificaciones</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-6" data-bs-toggle="tab" data-bs-target="#panel-6"
                            type="button" role="tab">
                        <span class="fw-semibold">Libros Societarios</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-7" data-bs-toggle="tab" data-bs-target="#panel-7"
                            type="button" role="tab">
                        <span class="fw-semibold">Accionistas</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
            </ul>

            <!-- Contenido de las Pestañas -->
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade show active" id="panel-1" role="tabpanel">
                    <div class="table-responsive">
                        <!-- Contenedor principal centrado que limita el ancho máximo en pantallas grandes -->
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-10 col-md-12">
                                <div class="row">
                                    <!-- Región -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Región</label>
                                        <label class="form-label text-secondary small">@entidadActual.Region?.Nombre</label>
                                    </div>

                                    <!-- Unidad de Negocio -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Unidad de Negocio</label>
                                        <label class="form-label text-secondary small">@entidadActual.UnidadNegocio?.Nombre</label>
                                    </div>

                                    <!-- Nombre de Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nombre de Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.Empresa?.Nombre</label>
                                    </div>

                                    <!-- Moneda de la Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Moneda de la Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.Moneda?.Nombre</label>
                                    </div>

                                    <!-- Número SAP -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número SAP</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroSap</label>
                                    </div>

                                    <!-- Tipo de Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo de Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoSociedad?.Nombre</label>
                                    </div>

                                    <!-- Estatus de la Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Estatus de la Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.EstatusSociedad?.Nombre</label>
                                    </div>

                                    @if (entidadActual.EstatusSociedad?.Id == 1)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Tipo de Sociedad Activa</label>
                                            <label class="form-label text-secondary small">@entidadActual.TipoSociedadActiva?.Nombre</label>
                                        </div>
                                    }

                                    <div class="col-12"><hr /></div>

                                    <!-- Objeto de la Sociedad (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Objeto de la Sociedad</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Objeto</label>
                                    </div>

                                    <div class="col-12"><hr /></div>

                                    <!-- Domicilio (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Domicilio</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Domicilio</label>
                                    </div>

                                    <!-- Dirección Fiscal (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Dirección Fiscal</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.DireccionFiscal</label>
                                    </div>

                                    <!-- Datos de constitución (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Datos de constitución</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.DatosConstitucion</label>
                                    </div>

                                    <!-- Fecha de Constitución -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Constitución</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaConstitucion?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Fecha de Vencimiento -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaVencimiento?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Duración -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Duración</label>
                                        <label class="form-label text-secondary small">@entidadActual.Duracion</label>
                                    </div>

                                    <!-- Número Acciones -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número Acciones</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearStringMiles(entidadActual.NumeroAcciones)</label>
                                    </div>

                                    <!-- ¿Aplica Capital? -->
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">¿Aplica Capital?</label>
                                        <label class="form-label text-secondary small">@((entidadActual.AplicaCapital == 1) ? "Sí aplica" : "No aplica")</label>
                                    </div>

                                    @if (entidadActual.AplicaCapital == 1)
                                    {
                                        <!-- Capital Suscrito -->
                                        <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                            <label class="form-label fw-bold text-secondary small d-block">Capital Suscrito</label>
                                            <label class="form-label text-secondary small">@UtilClass.FormatearNumero(entidadActual.CapitalSuscrito)</label>
                                        </div>

                                        <!-- Capital Pagado -->
                                        <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                            <label class="form-label fw-bold text-secondary small d-block">Capital Pagado</label>
                                            <label class="form-label text-secondary small">@UtilClass.FormatearNumero(entidadActual.CapitalPagado)</label>
                                        </div>
                                    }

                                    <!-- Clase de Acciones -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Clase de Acciones</label>
                                        <label class="form-label text-secondary small">@entidadActual.ClaseAcciones</label>
                                    </div>

                                    <!-- Valor Nominal -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Valor Nominal</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearNumero(entidadActual.ValorAccion, 10)</label>
                                    </div>

                                    <!-- Valor Patrimonial -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Valor Patrimonial</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearNumero(entidadActual.ValorPatrimonial, 10)</label>
                                    </div>
                                    
                                    <!-- Forma de Administración -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Forma de Administración</label>
                                        <label class="form-label text-secondary small">@entidadActual.FormaAdministracion</label>
                                    </div>

                                    <!-- Ejercicio Económico -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Ejercicio Económico</label>
                                        <label class="form-label text-secondary small">@entidadActual.EjercicioEconomico</label>
                                    </div>

                                    <!-- Número de Expediente -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número de Expediente</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroExpediente</label>
                                    </div>

                                    <!-- Observaciones (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Observaciones</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Observaciones</label>
                                    </div>

                                    <!-- Documentos de Identidad Fiscal -->
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento de Identidad Fiscal 1</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoDocumento1?.Nombre</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 1</label>
                                        <label class="form-label text-secondary small">@UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento1?.Nombre, entidadActual.Documento1)</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 1</label>
                                        <label class="form-label text-secondary small">@entidadActual.VencimientoDocumento1?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento de Identidad Fiscal 2</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoDocumento2?.Nombre</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 2</label>
                                        <label class="form-label text-secondary small">@UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento2?.Nombre, entidadActual.Documento2)</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 2</label>
                                        <label class="form-label text-secondary small">@entidadActual.VencimientoDocumento2?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento de Identidad Fiscal 3</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoDocumento3?.Nombre</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 3</label>
                                        <label class="form-label text-secondary small">@UtilClass.ObtenerNumeroDocumentoLimpio(entidadActual.TipoDocumento3?.Nombre, entidadActual.Documento3)</label>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento 3</label>
                                        <label class="form-label text-secondary small">@entidadActual.VencimientoDocumento3?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Nit -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nit</label>
                                        <label class="form-label text-secondary small">@entidadActual.Nit</label>
                                    </div>

                                    <!-- Empresa Fusión -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Empresa Fusión</label>
                                        <label class="form-label text-secondary small">@entidadActual.EmpresaFusion</label>
                                    </div>

                                    <!-- Fecha de Fusión -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Fusión</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaFusion?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <hr />
                                        <label class="form-label fw-bold text-primary small">Datos de Publicación</label>
                                        <hr />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Año</label>
                                        <label class="form-label text-secondary small">@entidadActual.AnoPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaPublicacion?.ToString("yyyy-MM-dd")</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nombre Diario</label>
                                        <label class="form-label text-secondary small">@entidadActual.NombreDiario?.Nombre</label>
                                    </div>

                                    <div class="col-12"><hr /></div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Creación</label>
                                        <label class="form-label text-secondary small">@entidadActual.CreateDate.ToString("yyyy-MM-dd")</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Última Modificación</label>
                                        <label class="form-label text-secondary small">@entidadActual.UpdateDate.ToString("yyyy-MM-dd")</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel 2: Autoridades -->
                <div class="tab-pane fade" id="panel-2" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Autoridad" Items="ListAutoridadGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 160px;">Cargo</th>
                                    <th class="text-start" style="min-width: 220px;">Nombre</th>
                                    <th class="text-start" style="min-width: 100px;">Duración</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Duración</th>
                                    <th class="text-start" style="min-width: 140px;">Documento 1</th>
                                    <th class="polar-date" style="min-width: 120px;">Vencimiento Doc. 1</th>
                                    <th class="text-start" style="min-width: 140px;">Documento 2</th>
                                    <th class="polar-date" style="min-width: 120px;">Vencimiento Doc. 2</th>
                                    <th class="polar-date" style="min-width: 110px;">Fecha creación</th>
                                    <th class="polar-date pe-3" style="min-width: 110px;">Última modificación</th>
                                </tr>
                                @{
                                    _ultimoCargoId = null;
                                }
                                @* Reiniciamos la variable al renderizar la cabecera o antes de las filas *@
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start">
                                        @if (_ultimoCargoId != p.Cargo?.Id)
                                        {
                                            <span class="badge bg-light text-dark border">@(p.Cargo?.Nombre ?? "-")</span>
                                            _ultimoCargoId = p.Cargo?.Id;
                                            @* Actualizamos el último ID procesado *@
                                        }
                                    </td>
                                    <td class="text-start fw-semibold text-dark">@p.Nombre</td>
                                    <td class="text-start text-secondary">@(string.IsNullOrWhiteSpace(p.Duracion) ? "-" : p.Duracion)</td>
                                    <td class="polar-date text-secondary">@(p.FechaDuracion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="text-start text-secondary">@UtilClass.ObtenerDocumentoCompleto(p.TipoDocumento1?.Nombre, p.Documento1)</td>
                                    <td class="polar-date text-secondary">@(p.VencimientoDocumento1?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="text-start text-secondary">@UtilClass.ObtenerDocumentoCompleto(p.TipoDocumento2?.Nombre, p.Documento2)</td>
                                    <td class="polar-date text-secondary">@(p.VencimientoDocumento2?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="polar-date text-secondary">@p.CreateDate.ToShortDateString()</td>
                                    <td class="polar-date pe-3 text-secondary">@p.UpdateDate.ToShortDateString()</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>

                <!-- Panel 3: Asambleas -->
                <div class="tab-pane fade" id="panel-3" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Asamblea" Items="ListAsambleaGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 150px;">Tipo Asamblea</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Celebración</th>
                                    <th class="text-start" style="min-width: 90px;">Nro. Acta</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Registro</th>
                                    <th class="text-start" style="min-width: 180px;">Registro</th>
                                    <th class="text-start" style="min-width: 90px;">Número</th>
                                    <th class="text-start" style="min-width: 80px;">Tomo</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Publicación</th>
                                    <th class="text-start" style="min-width: 100px;">Nro. Publicación</th>
                                    <th class="text-start" style="min-width: 130px;">Diario</th>
                                    <th class="text-start" style="min-width: 130px;">Tipo Reforma</th>
                                    <th class="text-start" style="min-width: 160px;">Observaciones</th>
                                    <th class="text-end pe-3" style="min-width: 80px;">Acciones</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start">
                                        <span class="badge bg-light text-dark border">@(p.TipoAsamblea?.Nombre ?? "-")</span>
                                    </td>
                                    <td class="polar-date text-secondary">@(p.FechaCelebracion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="text-start text-secondary">@(string.IsNullOrWhiteSpace(p.NumeroActa) ? "-" : p.NumeroActa)</td>
                                    <td class="polar-date text-secondary">@(p.FechaRegistro?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="text-start text-secondary">@(p.Registro?.Nombre ?? "-")</td>
                                    <td class="text-start text-secondary">@(string.IsNullOrWhiteSpace(p.NumeroRegistro) ? "-" : p.NumeroRegistro)</td>
