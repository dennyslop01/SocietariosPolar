@page "/detallesociedad/{id}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-bezier text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Detalle Sociedad
                    </h5>
                </div>

                <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="Regresar"
                        style="height: 32px; font-weight: 500;">
                    <i class="bi bi-arrow-return-left me-2"></i> Regresar
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Navegación de Pestañas Estilizada -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill" id="talentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill active"
                            id="tab-1" data-bs-toggle="tab" data-bs-target="#panel-1"
                            type="button" role="tab">
                        <span class="fw-semibold">General</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-2" data-bs-toggle="tab" data-bs-target="#panel-2"
                            type="button" role="tab">
                        <span class="fw-semibold">Autoridades</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-3" data-bs-toggle="tab" data-bs-target="#panel-3"
                            type="button" role="tab">
                        <span class="fw-semibold">Asambleas</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-4" data-bs-toggle="tab" data-bs-target="#panel-4"
                            type="button" role="tab">
                        <span class="fw-semibold">Reformas</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-5" data-bs-toggle="tab" data-bs-target="#panel-5"
                            type="button" role="tab">
                        <span class="fw-semibold">Certificaciones</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-6" data-bs-toggle="tab" data-bs-target="#panel-6"
                            type="button" role="tab">
                        <span class="fw-semibold">Libros Societarios</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
            </ul>

            <!-- Contenido de las Pestañas -->
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade show active" id="panel-1" role="tabpanel">
                    <div class="table-responsive">
                        <!-- Contenedor principal centrado que limita el ancho máximo en pantallas grandes -->
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-10 col-md-12">
                                <div class="row">
                                    <!-- Región -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Región</label>
                                        <label class="form-label text-secondary small">@entidadActual.Region?.Nombre</label>
                                    </div>

                                    <!-- Unidad de Negocio -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Unidad de Negocio</label>
                                        <label class="form-label text-secondary small">@entidadActual.UnidadNegocio?.Nombre</label>
                                    </div>

                                    <!-- Nombre de Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nombre de Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.Empresa?.Nombre</label>
                                    </div>

                                    <!-- Moneda de la Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Moneda de la Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.Moneda?.Nombre</label>
                                    </div>

                                    <!-- Número SAP -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número SAP</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroSap</label>
                                    </div>

                                    <!-- Sociedad -->
                                    @* <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoSociedad?.Nombre</label>
                                    </div> *@

                                    <!-- Estatus de la Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Estatus de la Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.EstatusSociedad?.Nombre</label>
                                    </div>

                                    @if (entidadActual.EstatusSociedad?.Id == 1)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Tipo de Sociedad Activa</label>
                                            <label class="form-label text-secondary small">@entidadActual.TipoSociedadActiva?.Nombre</label>
                                        </div>
                                    }

                                    <div class="col-12"><hr /></div>

                                    <!-- Objeto de la Sociedad (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Objeto de la Sociedad</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Objeto</label>
                                    </div>

                                    <div class="col-12"><hr /></div>

                                    <!-- Domicilio (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Domicilio</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Domicilio</label>
                                    </div>

                                    <!-- Dirección Fiscal (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Dirección Fiscal</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.DireccionFiscal</label>
                                    </div>

                                    <!-- Datos de constitución (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Datos de constitución</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.DatosConstitucion</label>
                                    </div>

                                    <!-- Fecha de Constitución -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Constitución</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaConstitucion?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Fecha de Vencimiento -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaVencimiento?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Duración -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Duración</label>
                                        <label class="form-label text-secondary small">@entidadActual.Duracion</label>
                                    </div>

                                    <!-- Número Acciones -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número Acciones</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroAcciones</label>
                                    </div>

                                    <!-- ¿Aplica Capital? -->
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">¿Aplica Capital?</label>
                                        <label class="form-label text-secondary small">@((entidadActual.AplicaCapital == 1) ? "Sí aplica" : "No aplica")</label>
                                    </div>

                                    @if (entidadActual.AplicaCapital == 1)
                                    {
                                        <!-- Capital Suscrito -->
                                        <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                            <label class="form-label fw-bold text-secondary small d-block">Capital Suscrito</label>
                                            <label class="form-label text-secondary small">@entidadActual.CapitalSuscrito</label>
                                        </div>

                                        <!-- Capital Pagado -->
                                        <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                            <label class="form-label fw-bold text-secondary small d-block">Capital Pagado</label>
                                            <label class="form-label text-secondary small">@entidadActual.CapitalPagado</label>
                                        </div>
                                    }

                                    <!-- Clase de Acciones -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Clase de Acciones</label>
                                        <label class="form-label text-secondary small">@entidadActual.ClaseAcciones</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Valor Nominal</label>
                                        <label class="form-label text-secondary small">@entidadActual.ValorAccion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small">Valor Patrimonial</label>
                                        <label class="form-label text-secondary small">@entidadActual.ValorPatrimonial</label>
                                    </div>
                                    <!-- Forma de Administración -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Forma de Administración</label>
                                        <label class="form-label text-secondary small">@entidadActual.FormaAdministracion</label>
                                    </div>

                                    <!-- Ejercicio Económico -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Ejercicio Económico</label>
                                        <label class="form-label text-secondary small">@entidadActual.EjercicioEconomico</label>
                                    </div>

                                    <!-- Número de Expediente -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número de Expediente</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroExpediente</label>
                                    </div>

                                    <!-- Observaciones (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Observaciones</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Observaciones</label>
                                    </div>

                                    <!-- Rif -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Rif</label>
                                        <label class="form-label text-secondary small">@entidadActual.Rif</label>
                                    </div>

                                    <!-- Nit -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nit</label>
                                        <label class="form-label text-secondary small">@entidadActual.Nit</label>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <hr />
                                        <label class="form-label fw-bold text-primary small">Datos de Publicación</label>
                                        <hr />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Año</label>
                                        <label class="form-label text-secondary small">@entidadActual.AnoPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nombre Diario</label>
                                        <label class="form-label text-secondary small">@entidadActual.NombreDiario?.Nombre</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade" id="panel-2" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Autoridad" Items="ListAutoridadGral" DefaultPageSize="10">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Cargo</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nombre</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Documento</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Duración</th>
                                    <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                                    <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                @{
                                    var index = ListAutoridadGral.IndexOf(p);

                                    // 1. Ruptura para Sociedad
                                    bool esNuevaSociedad = index == 0 ||
                                    ListAutoridadGral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;

                                    // 2. Ruptura para Cargo (Se dispara si es una nueva sociedad O si dentro de la misma sociedad cambia el cargo)
                                    bool esNuevoCargo = index == 0 ||
                                    esNuevaSociedad ||
                                    ListAutoridadGral[index - 1].Cargo?.Nombre != p.Cargo?.Nombre;
                                }

                                @if (esNuevaSociedad)
                                {
                                    <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                                    <tr class="table-secondary fw-bold text-primary border-bottom">
                                        <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                            🏢 @p.Sociedad?.Empresa?.Nombre
                                        </td>
                                    </tr>
                                }

                                @if (esNuevoCargo)
                                {
                                    <!-- Fila divisoria de Cargo alineada estrictamente en su columna -->
                                    <tr class="align-middle border-bottom fw-bold" style="background-color: #fcfcfc;">
                                        <!-- Celda vacía para mantener el espacio de la columna Sociedad -->
                                        <td style="width: 20%;"></td>

                                        <!-- Celda del cargo que hereda el ancho exacto (15%) y se resalta -->
                                        <td class="text-start text-dark py-2" style="width: 15%; font-size: 0.85rem; letter-spacing: 0.3px;">
                                            📌 @p.Cargo?.Nombre
                                        </td>

                                        <!-- Celdas vacías para rellenar las 6 columnas restantes de la cuadrícula -->
                                        <td colspan="6"></td>
                                    </tr>
                                }

                                <tr class="align-middle border-bottom">
                                    <td class="text-muted small ps-3" style="width: 20%;">-</td>
                                    <!-- Dejamos la celda del registro vacía o con una marca suave ya que el título del cargo se muestra arriba -->
                                    <td class="text-start text-muted small" style="width: 15%; font-style: italic;">↳</td>
                                    <td class="text-start text-secondary small" style="width: 15%;">@p.Nombre</td>
                                    <td class="text-start text-secondary small" style="width: 15%;">@p.Documento</td>
                                    <td class="text-start text-secondary small" style="width: 5%;">@(p.Duracion != null ? $"{p.Duracion} años" : "")</td>
                                    <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                                    <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>
            </div>
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade" id="panel-3" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Asamblea" Items="ListAsambleaGral" DefaultPageSize="10">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tipo Asamblea</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Fecha Celebración</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Fecha Registro</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Registro</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Número</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tomo</th>
                                    <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                @{
                                    var index = ListAsambleaGral.IndexOf(p);

                                    // 1. Ruptura para Sociedad
                                    bool esNuevaSociedad = index == 0 ||
                                    ListAsambleaGral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;

                                    // 2. Ruptura para Cargo (Se dispara si es una nueva sociedad O si dentro de la misma sociedad cambia el cargo)
                                    bool esNuevoCargo = index == 0 ||
                                    esNuevaSociedad ||
                                    ListAsambleaGral[index - 1].TipoAsamblea?.Nombre != p.TipoAsamblea?.Nombre;
                                }

                                @if (esNuevaSociedad)
                                {
                                    <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                                    <tr class="table-secondary fw-bold text-primary border-bottom">
                                        <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                            🏢 @p.Sociedad?.Empresa?.Nombre
                                        </td>
                                    </tr>
                                }

                                @if (esNuevoCargo)
                                {
                                    <!-- Fila divisoria de Cargo alineada estrictamente en su columna -->
                                    <tr class="align-middle border-bottom fw-bold" style="background-color: #fcfcfc;">
                                        <!-- Celda vacía para mantener el espacio de la columna Sociedad -->
                                        <td style="width: 20%;"></td>

                                        <!-- Celda del cargo que hereda el ancho exacto (15%) y se resalta -->
                                        <td class="text-start text-dark py-2" style="width: 15%; font-size: 0.85rem; letter-spacing: 0.3px;">
                                            📌 @p.TipoAsamblea?.Nombre
                                        </td>

                                        <!-- Celdas vacías para rellenar las 6 columnas restantes de la cuadrícula -->
                                        <td colspan="6"></td>
                                    </tr>
                                }

                                <tr class="align-middle border-bottom">
                                    <td class="text-muted small ps-3" style="width: 20%;">-</td>
                                    <!-- Dejamos la celda del registro vacía o con una marca suave ya que el título del cargo se muestra arriba -->
                                    <td class="text-start text-muted small" style="width: 10%; font-style: italic;">↳</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.FechaCelebracion?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary small" style="width: 20%;">@p.Registro.Nombre</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.NumeroRegistro</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.Tomo</td>
                                    <td class="text-end pe-3" style="width: 10%;">
                                        <button class="btn btn-link btn-sm text-secondary p-0 ms-2"
                                                @onclick="() => Detalle(p)" title="Detalle Asamblea">
                                            <i class="bi bi-eye fs-6"></i>
                                        </button>
                                    </td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>
            </div>
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade" id="panel-4" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Asamblea" Items="ListReformaGral" DefaultPageSize="10">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tipo Reforma</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Fecha Celebración</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Fecha Registro</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Registro</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Número</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tomo</th>
                                    <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                @{
                                    var index = ListReformaGral.IndexOf(p);

                                    // 1. Ruptura para Sociedad
                                    bool esNuevaSociedad = index == 0 ||
                                    ListReformaGral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;

                                    // 2. Ruptura para Cargo (Se dispara si es una nueva sociedad O si dentro de la misma sociedad cambia el cargo)
                                    bool esNuevoCargo = index == 0 ||
                                    esNuevaSociedad ||
                                    ListReformaGral[index - 1].TipoReforma?.Nombre != p.TipoReforma?.Nombre;
                                }

                                @if (esNuevaSociedad)
                                {
                                    <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                                    <tr class="table-secondary fw-bold text-primary border-bottom">
                                        <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                            🏢 @p.Sociedad?.Empresa?.Nombre
                                        </td>
                                    </tr>
                                }

                                @if (esNuevoCargo)
                                {
                                    <!-- Fila divisoria de Cargo alineada estrictamente en su columna -->
                                    <tr class="align-middle border-bottom fw-bold" style="background-color: #fcfcfc;">
                                        <!-- Celda vacía para mantener el espacio de la columna Sociedad -->
                                        <td style="width: 20%;"></td>

                                        <!-- Celda del cargo que hereda el ancho exacto (15%) y se resalta -->
                                        <td class="text-start text-dark py-2" style="width: 15%; font-size: 0.85rem; letter-spacing: 0.3px;">
                                            📌 @p.TipoReforma?.Nombre
                                        </td>

                                        <!-- Celdas vacías para rellenar las 6 columnas restantes de la cuadrícula -->
                                        <td colspan="6"></td>
                                    </tr>
                                }

                                <tr class="align-middle border-bottom">
                                    <td class="text-muted small ps-3" style="width: 20%;">-</td>
                                    <!-- Dejamos la celda del registro vacía o con una marca suave ya que el título del cargo se muestra arriba -->
                                    <td class="text-start text-muted small" style="width: 10%; font-style: italic;">↳</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.FechaCelebracion?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary small" style="width: 20%;">@p.Registro.Nombre</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.NumeroRegistro</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.Tomo</td>
                                    <td class="text-end pe-3" style="width: 10%;">
                                        <button class="btn btn-link btn-sm text-secondary p-0 ms-2"
                                                @onclick="() => Detalle(p)" title="Detalle Reforma">
                                            <i class="bi bi-eye fs-6"></i>
                                        </button>
                                    </td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>

                </div>
            </div>
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade" id="panel-5" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Certificacion" Items="ListCertificacionGral" DefaultPageSize="10">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Ejercicio</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Fecha</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Cargo</th>
                                    <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                                    <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                @{
                                    var index = ListCertificacionGral.IndexOf(p);

                                    // 1. Ruptura para Sociedad
                                    bool esNuevaSociedad = index == 0 ||
                                    ListCertificacionGral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;
                                }

                                @if (esNuevaSociedad)
                                {
                                    <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                                    <tr class="table-secondary fw-bold text-primary border-bottom">
                                        <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                            🏢 @p.Sociedad?.Empresa?.Nombre
                                        </td>
                                    </tr>
                                }

                                <tr class="align-middle border-bottom">
                                    <td class="text-muted small ps-3" style="width: 20%;">-</td>
                                    <!-- Dejamos la celda del registro vacía o con una marca suave ya que el título del cargo se muestra arriba -->
                                    <td class="text-start text-secondary small" style="width: 15%;">@p.Sociedad.EjercicioEconomico</td>
                                    <td class="text-start text-secondary small" style="width: 15%;">@p.Fecha?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary small" style="width: 15%;">@p.Cargo?.Nombre</td>
                                    <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                                    <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>
            </div>
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade" id="panel-6" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="LibroSocietario" Items="ListLibrosgral" DefaultPageSize="10">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="py-3 ps-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Clase</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tipo</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tomo en Uso</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Folio</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Último Asiento</th>
                                    <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Libros Sellados</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                @{
                                    var index = ListLibrosgral.IndexOf(p);

                                    // 1. Ruptura para Sociedad
                                    bool esNuevaSociedad = index == 0 ||
                                    ListLibrosgral[index - 1].Sociedad?.Empresa?.Nombre != p.Sociedad?.Empresa?.Nombre;
                                }

                                @if (esNuevaSociedad)
                                {
                                    <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                                    <tr class="table-secondary fw-bold text-primary border-bottom">
                                        <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                            🏢 @p.Sociedad?.Empresa?.Nombre
                                        </td>
                                    </tr>
                                }

                                <tr class="align-middle border-bottom">
                                    <td class="text-muted small ps-3" style="width: 20%;">-</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.ClaseLibro.Nombre</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.TipoLibro.Nombre</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.TomoUso</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.Folios</td>
                                    <td class="text-start text-secondary small" style="width: 20%;">@p.FechaDesde?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary small" style="width: 10%;">@p.LibrosSellados</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>

                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}


@if (mostrarModal)
{
    <AsambleasDetalle id="@idAsamblea.ToString()" OnFinalizado="ManejarCierreModal" />
}

@code {
    [Parameter] public string id { get; set; } = "";

    private bool cargando = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private Sociedad entidadActual = new();
    private List<Autoridad> ListAutoridadGral = new();
    private List<Asamblea> ListAsambleaGral = new();
    private List<Asamblea> ListReformaGral = new();
    private List<Certificacion> ListCertificacionGral = new();
    private List<LibroSocietario> ListLibrosgral = new();

    int idAsamblea = 0;
    private bool mostrarModal = false;

    [Inject] private ISociedad repository { get; set; } = null!;
    [Inject] private IAutoridad repoAutoridad { get; set; } = null!;
    [Inject] private IAsamblea repoAsamblea { get; set; } = null!;
    [Inject] private ICertificacion repoCertificacion { get; set; } = null!;
    [Inject] private ILibroSocietario repoLibros { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        if (id != "0")
        {
            await LoadGenericDataAsync();
        }
        else
        {
            await MostrarNotificacion("No se proporcionó un ID válido", true);
        }
        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            entidadActual = await repository.GetByIdAsync(int.Parse(id));

            if(entidadActual.EstatusSociedad?.Id != 1)
            {
                await MostrarNotificacion("La sociedad seleccionada no está activa o no existe.", true);
                return;
            }

            var listAutoridad = await repoAutoridad.GetAllAsync();
            ListAutoridadGral = listAutoridad.Where(x => x.Sociedad.Id == int.Parse(id)).OrderBy(x => x.Sociedad.Empresa.Id).ToList();

            var listAsamblea = await repoAsamblea.GetAllAsync();
            ListAsambleaGral = listAsamblea.OrderBy(x => x.Sociedad?.Empresa?.Id)
                                           .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1 && x.IndicadorAsamblea == 1 && x.Sociedad.Id == int.Parse(id)).ToList();
        
            ListReformaGral = listAsamblea.OrderBy(x => x.Sociedad?.Empresa?.Id)
                                          .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1 && x.Sociedad.Id == int.Parse(id) && (x.IndicadorAsamblea == 0 || x.TipoReforma != null)).ToList();
        
        
            var listCertificaciones = await repoCertificacion.GetAllAsync();
            ListCertificacionGral = listCertificaciones.OrderBy(x => x.Sociedad.Empresa.Id)
                                    .Where(x => x.Sociedad?.EstatusSociedad?.Id == 1 && x.Sociedad.Id == int.Parse(id))
                                    .ToList();

            var listLibros = await repoLibros.GetAllAsync();
            ListLibrosgral = listLibros.OrderBy(x => x.Sociedad?.Empresa?.Id).Where(x => x.Sociedad?.EstatusSociedad?.Id == 1 && x.Sociedad.Id == int.Parse(id)).ToList();

        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos", true);
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Regresar()
    {
        navManager.NavigateTo($"/sociedades");
    }

    private void Detalle(Asamblea item)
    {
        idAsamblea = item.Id;
        mostrarModal = true;
    }

    private void ManejarCierreModal() => mostrarModal = false;

}
