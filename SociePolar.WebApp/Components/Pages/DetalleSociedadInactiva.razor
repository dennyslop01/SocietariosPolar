@page "/detallesociedadinactiva/{id}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-bezier text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            @(string.IsNullOrEmpty(entidadActual.Empresa?.Nombre) ? "Detalle Sociedad Inactiva" : entidadActual.Empresa.Nombre)
                        </h5>
                        <span class="text-secondary small fw-semibold">
                            @(string.IsNullOrEmpty(entidadActual.Empresa?.Nombre) ? "Ficha informativa" : "Detalle de Sociedad Inactiva")
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-danger btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="ExportarAPdf"
                            disabled="@cargando"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-file-earmark-pdf me-2"></i> Exportar PDF
                    </button>

                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>
                </div>
            </div>
        </div>

        @if (mostrarAlerta)
        {
            <div class="alert @claseAlerta d-flex align-items-center justify-content-between m-3 mb-0 py-2 px-3 border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi @iconoAlerta me-2 fs-5"></i>
                    <div class="small fw-semibold">
                        @mensajeAlerta
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(urlPdfGenerado))
                {
                    <a href="@urlPdfGenerado" target="_blank" class="btn btn-sm btn-outline-primary ms-3 fw-semibold">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Abrir PDF en pantalla
                    </a>
                }
            </div>
        }

        <div class="card-body">
            <!-- Navegación de Pestañas Estilizada -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill" id="talentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill active"
                            id="tab-1" data-bs-toggle="tab" data-bs-target="#panel-1"
                            type="button" role="tab">
                        <span class="fw-semibold">General</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-2" data-bs-toggle="tab" data-bs-target="#panel-2"
                            type="button" role="tab">
                        <span class="fw-semibold">Autoridades</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-3" data-bs-toggle="tab" data-bs-target="#panel-3"
                            type="button" role="tab">
                        <span class="fw-semibold">Asambleas</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-4" data-bs-toggle="tab" data-bs-target="#panel-4"
                            type="button" role="tab">
                        <span class="fw-semibold">Reformas</span>
                        <small class="d-block opacity-75"></small>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-5" data-bs-toggle="tab" data-bs-target="#panel-5"
                            type="button" role="tab">
                        <span class="fw-semibold">Certificaciones</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-6" data-bs-toggle="tab" data-bs-target="#panel-6"
                            type="button" role="tab">
                        <span class="fw-semibold">Libros Societarios</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill"
                            id="tab-7" data-bs-toggle="tab" data-bs-target="#panel-7"
                            type="button" role="tab">
                        <span class="fw-semibold">Accionistas</span>
                    </button>
                </li>
            </ul>

            <!-- Contenido de las Pestañas -->
            <div class="tab-content" id="talentTabsContent">
                <div class="tab-pane fade show active" id="panel-1" role="tabpanel">
                    <div class="table-responsive">
                        <!-- Contenedor principal centrado que limita el ancho máximo en pantallas grandes -->
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-10 col-md-12">
                                <div class="row">
                                    <!-- Región -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Región</label>
                                        <label class="form-label text-secondary small">@entidadActual.Region?.Nombre</label>
                                    </div>

                                    <!-- Unidad de Negocio -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Unidad de Negocio</label>
                                        <label class="form-label text-secondary small">@entidadActual.UnidadNegocio?.Nombre</label>
                                    </div>

                                    <!-- Nombre de Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nombre de Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.Empresa?.Nombre</label>
                                    </div>

                                    <!-- Moneda de la Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Moneda de la Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.Moneda?.Nombre</label>
                                    </div>

                                    <!-- Número SAP -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número SAP</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroSap</label>
                                    </div>

                                    <!-- Sociedad -->
                                    @* <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoSociedad?.Nombre</label>
                                    </div> *@

                                    <!-- Estatus de la Sociedad -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Estatus de la Sociedad</label>
                                        <label class="form-label text-secondary small">@entidadActual.EstatusSociedad?.Nombre</label>
                                    </div>

                                    @if (entidadActual.EstatusSociedad?.Id == 1)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary small d-block">Tipo de Sociedad Activa</label>
                                            <label class="form-label text-secondary small">@entidadActual.TipoSociedadActiva?.Nombre</label>
                                        </div>
                                    }

                                    <div class="col-12"><hr /></div>

                                    <!-- Objeto de la Sociedad (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Objeto de la Sociedad</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Objeto</label>
                                    </div>

                                    <div class="col-12"><hr /></div>

                                    <!-- Domicilio (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Domicilio</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Domicilio</label>
                                    </div>

                                    <!-- Dirección Fiscal (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Dirección Fiscal</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.DireccionFiscal</label>
                                    </div>

                                    <!-- Datos de constitución (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Datos de constitución</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.DatosConstitucion</label>
                                    </div>

                                    <!-- Fecha de Constitución -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Constitución</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaConstitucion?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Fecha de Vencimiento -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha de Vencimiento</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaVencimiento?.ToString("yyyy-MM-dd")</label>
                                    </div>

                                    <!-- Duración -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Duración</label>
                                        <label class="form-label text-secondary small">@entidadActual.Duracion</label>
                                    </div>

                                    <!-- Número Acciones -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número Acciones</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearStringMiles(entidadActual.NumeroAcciones)</label>
                                    </div>

                                    <!-- ¿Aplica Capital? -->
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">¿Aplica Capital?</label>
                                        <label class="form-label text-secondary small">@((entidadActual.AplicaCapital == 1) ? "Sí aplica" : "No aplica")</label>
                                    </div>

                                    @if (entidadActual.AplicaCapital == 1)
                                    {
                                        <!-- Capital Suscrito -->
                                        <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                            <label class="form-label fw-bold text-secondary small d-block">Capital Suscrito</label>
                                            <label class="form-label text-secondary small">@entidadActual.CapitalSuscrito</label>
                                        </div>

                                        <!-- Capital Pagado -->
                                        <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                            <label class="form-label fw-bold text-secondary small d-block">Capital Pagado</label>
                                            <label class="form-label text-secondary small">@entidadActual.CapitalPagado</label>
                                        </div>
                                    }

                                    <!-- Clase de Acciones -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Clase de Acciones</label>
                                        <label class="form-label text-secondary small">@entidadActual.ClaseAcciones</label>
                                    </div>
                                    

                                    <!-- Forma de Administración -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Forma de Administración</label>
                                        <label class="form-label text-secondary small">@entidadActual.FormaAdministracion</label>
                                    </div>

                                    <!-- Ejercicio Económico -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Ejercicio Económico</label>
                                        <label class="form-label text-secondary small">@entidadActual.EjercicioEconomico</label>
                                    </div>

                                    <!-- Número de Expediente -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número de Expediente</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroExpediente</label>
                                    </div>

                                    <!-- Observaciones (varchar max) -->
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Observaciones</label>
                                        <label class="form-label text-secondary small text-break">@entidadActual.Observaciones</label>
                                    </div>

                                    <!-- Rif -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoDocumento1?.Nombre</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearStringMiles(entidadActual.Documento1)</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoDocumento2?.Nombre</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 2</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearStringMiles(entidadActual.Documento2)</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Tipo Documento</label>
                                        <label class="form-label text-secondary small">@entidadActual.TipoDocumento3?.Nombre</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Documento de Identidad Fiscal 3</label>
                                        <label class="form-label text-secondary small">@UtilClass.FormatearStringMiles(entidadActual.Documento3)</label>
                                    </div>

                                    <!-- Nit -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nit</label>
                                        <label class="form-label text-secondary small">@entidadActual.Nit</label>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <hr />
                                        <label class="form-label fw-bold text-primary small">Datos de Publicación</label>
                                        <hr />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Año</label>
                                        <label class="form-label text-secondary small">@entidadActual.AnoPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Fecha</label>
                                        <label class="form-label text-secondary small">@entidadActual.FechaPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Número</label>
                                        <label class="form-label text-secondary small">@entidadActual.NumeroPublicacion</label>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold text-secondary small d-block">Nombre Diario</label>
                                        <label class="form-label text-secondary small">@entidadActual.NombreDiario?.Nombre</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                <!-- Panel 2: Autoridades -->
                <div class="tab-pane fade" id="panel-2" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Autoridad" Items="ListAutoridadGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 160px;">Cargo</th>
                                    <th class="text-start" style="min-width: 220px;">Nombre</th>
                                    <th class="text-start" style="min-width: 140px;">Documento</th>
                                    <th class="text-start" style="min-width: 100px;">Duración</th>
                                    <th class="polar-date" style="min-width: 110px;">Fecha creación</th>
                                    <th class="polar-date pe-3" style="min-width: 110px;">Última modificación</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start">
                                        <span class="badge bg-light text-dark border">@(p.Cargo?.Nombre ?? "-")</span>
                                    </td>
                                    <td class="text-start fw-semibold text-dark">@p.Nombre</td>
                                    <td class="text-start text-secondary">
                                        @(p.TipoDocumento1 != null ? $"{p.TipoDocumento1.Nombre}: " : "")@(p.Documento1 ?? "-")
                                    </td>
                                    <td class="text-start text-secondary">@(p.Duracion != null ? $"{p.Duracion} años" : "-")</td>
                                    <td class="polar-date text-secondary">@p.CreateDate.ToShortDateString()</td>
                                    <td class="polar-date pe-3 text-secondary">@p.UpdateDate.ToShortDateString()</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>

                <!-- Panel 3: Asambleas -->
                <div class="tab-pane fade" id="panel-3" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Asamblea" Items="ListAsambleaGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 160px;">Tipo Asamblea</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Celebración</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Registro</th>
                                    <th class="text-start" style="min-width: 200px;">Registro</th>
                                    <th class="text-start" style="min-width: 90px;">Número</th>
                                    <th class="text-start" style="min-width: 90px;">Tomo</th>
                                    <th class="text-end pe-3" style="min-width: 80px;">Acciones</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start">
                                        <span class="badge bg-light text-dark border">@(p.TipoAsamblea?.Nombre ?? "-")</span>
                                    </td>
                                    <td class="polar-date text-secondary">@p.FechaCelebracion?.ToString("dd/MM/yyyy")</td>
                                    <td class="polar-date text-secondary">@p.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary">@(p.Registro?.Nombre ?? "-")</td>
                                    <td class="text-start text-secondary">@p.NumeroRegistro</td>
                                    <td class="text-start text-secondary">@p.Tomo</td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-link btn-sm text-primary p-0"
                                                @onclick="() => Detalle(p)" title="Detalle Asamblea">
                                            <i class="bi bi-file-earmark-text fs-6"></i>
                                        </button>
                                    </td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>

                <!-- Panel 4: Reformas -->
                <div class="tab-pane fade" id="panel-4" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Asamblea" Items="ListReformaGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 160px;">Tipo Reforma</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Celebración</th>
                                    <th class="polar-date" style="min-width: 120px;">Fecha Registro</th>
                                    <th class="text-start" style="min-width: 200px;">Registro</th>
                                    <th class="text-start" style="min-width: 90px;">Número</th>
                                    <th class="text-start" style="min-width: 90px;">Tomo</th>
                                    <th class="text-end pe-3" style="min-width: 80px;">Acciones</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start">
                                        <span class="badge bg-light text-dark border">@(p.TipoReforma?.Nombre ?? "-")</span>
                                    </td>
                                    <td class="polar-date text-secondary">@p.FechaCelebracion?.ToString("dd/MM/yyyy")</td>
                                    <td class="polar-date text-secondary">@p.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start text-secondary">@(p.Registro?.Nombre ?? "-")</td>
                                    <td class="text-start text-secondary">@p.NumeroRegistro</td>
                                    <td class="text-start text-secondary">@p.Tomo</td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-link btn-sm text-primary p-0"
                                                @onclick="() => Detalle(p)" title="Detalle Reforma">
                                            <i class="bi bi-file-earmark-text fs-6"></i>
                                        </button>
                                    </td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>

                <!-- Panel 5: Certificaciones -->
                <div class="tab-pane fade" id="panel-5" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="Certificacion" Items="ListCertificacionGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 180px;">Cargo</th>
                                    <th class="text-start" style="min-width: 140px;">Ejercicio</th>
                                    <th class="polar-date" style="min-width: 110px;">Fecha</th>
                                    <th class="polar-date" style="min-width: 110px;">Fecha creación</th>
                                    <th class="polar-date pe-3" style="min-width: 110px;">Última modificación</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start">
                                        <span class="badge bg-light text-dark border">@(p.Cargo?.Nombre ?? "-")</span>
                                    </td>
                                    <td class="text-start text-secondary">@(p.Sociedad?.EjercicioEconomico ?? "-")</td>
                                    <td class="polar-date text-secondary">@p.Fecha?.ToString("dd/MM/yyyy")</td>
                                    <td class="polar-date text-secondary">@p.CreateDate.ToShortDateString()</td>
                                    <td class="polar-date pe-3 text-secondary">@p.UpdateDate.ToShortDateString()</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>

                <!-- Panel 6: Libros Societarios -->
                <div class="tab-pane fade" id="panel-6" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="LibroSocietario" Items="ListLibrosgral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 140px;">Clase</th>
                                    <th class="text-start" style="min-width: 140px;">Tipo</th>
                                    <th class="text-center" style="min-width: 90px;">Tomo en Uso</th>
                                    <th class="text-center" style="min-width: 90px;">Folio</th>
                                    <th class="polar-date" style="min-width: 120px;">Último Asiento</th>
                                    <th class="text-center pe-3" style="min-width: 110px;">Libros Sellados</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start text-secondary">@(p.ClaseLibro?.Nombre ?? "-")</td>
                                    <td class="text-start text-secondary">@(p.TipoLibro?.Nombre ?? "-")</td>
                                    <td class="text-center text-secondary">@p.TomoUso</td>
                                    <td class="text-center text-secondary">@p.Folios</td>
                                    <td class="polar-date text-secondary">@p.FechaDesde?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center pe-3">
                                        <span class="badge @(p.LibrosSellados == "Sí" || p.LibrosSellados == "SI" || p.LibrosSellados == "Si" ? "bg-success" : "bg-light text-secondary border")">
                                            @p.LibrosSellados
                                        </span>
                                    </td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>

                <!-- Panel 7: Accionistas -->
                <div class="tab-pane fade" id="panel-7" role="tabpanel">
                    <div class="table-responsive">
                        <PaginationComponent TItem="AccionistaSociedadVerDto" Items="ListAccionistasGral" DefaultPageSize="50" TableClass="polar-table-compact">
                            <ChildContentHeader>
                                <tr class="table-light border-bottom">
                                    <th class="ps-3 text-start" style="min-width: 240px;">Nombre y Apellido</th>
                                    <th class="text-start" style="min-width: 160px;">Tipo Accionista</th>
                                    <th class="polar-num" style="min-width: 130px;">Nro. Acciones</th>
                                    <th class="polar-num" style="min-width: 130px;">% Participación</th>
                                    <th class="polar-date" style="min-width: 110px;">Fecha creación</th>
                                    <th class="polar-date pe-3" style="min-width: 110px;">Última modificación</th>
                                </tr>
                            </ChildContentHeader>
                            <ChildContentRow Context="p">
                                <tr class="align-middle border-bottom">
                                    <td class="ps-3 text-start fw-semibold text-dark">@p.AccionistaNombre</td>
                                    <td class="text-start">
                                        <span class="badge bg-light text-dark border">@p.TipoAccionistaNombre</span>
                                    </td>
                                    <td class="polar-num">@UtilClass.FormatearMiles(p.NroAcciones)</td>
                                    <td class="polar-num">@((p.Participacion ?? 0).ToString("N4"))%</td>
                                    <td class="polar-date text-secondary">@p.CreateDate.ToShortDateString()</td>
                                    <td class="polar-date pe-3 text-secondary">@p.UpdateDate.ToShortDateString()</td>
                                </tr>
                            </ChildContentRow>
                        </PaginationComponent>
                    </div>
                </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}


@if (mostrarModal)
{
    <AsambleasDetalle id="@idAsamblea.ToString()" OnFinalizado="ManejarCierreModal" />
}

@code {
    [Parameter] public string id { get; set; } = "";

    private bool cargando = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string urlPdfGenerado = "";
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private Sociedad entidadActual = new();
    private List<Autoridad> ListAutoridadGral = new();
    private List<Asamblea> ListAsambleaGral = new();
    private List<Asamblea> ListReformaGral = new();
    private List<Certificacion> ListCertificacionGral = new();
    private List<LibroSocietario> ListLibrosgral = new();
    private List<AccionistaSociedadVerDto> ListAccionistasGral = new();

    int idAsamblea = 0;
    private bool mostrarModal = false;

    [Inject] private ISociedad repository { get; set; } = null!;
    [Inject] private IAutoridad repoAutoridad { get; set; } = null!;
    [Inject] private IAsamblea repoAsamblea { get; set; } = null!;
    [Inject] private ICertificacion repoCertificacion { get; set; } = null!;
    [Inject] private ILibroSocietario repoLibros { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoaccionista { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        if (id != "0")
        {
            await LoadGenericDataAsync();
        }
        else
        {
            await MostrarNotificacion("No se proporcionó un ID válido", true);
        }
        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            entidadActual = await repository.GetByIdAsync(int.Parse(id));
            
            if(entidadActual.EstatusSociedad.Id != 2)
            {
                await MostrarNotificacion("La sociedad no está inactiva o no existe", true);
                Regresar();
                return;
            }
            var listAutoridad = await repoAutoridad.GetAllAsync();
            ListAutoridadGral = listAutoridad.Where(x => x.Sociedad != null && x.Sociedad.Id == int.Parse(id)).OrderBy(x => x.Cargo?.Nombre).ToList();

            var listAsamblea = await repoAsamblea.GetAllAsync();
            ListAsambleaGral = listAsamblea.Where(x => x.Sociedad != null && x.Sociedad.Id == int.Parse(id) && x.IndicadorAsamblea == 1)
                                           .OrderByDescending(x => x.FechaCelebracion).ToList();

            ListReformaGral = listAsamblea.Where(x => x.Sociedad != null && x.Sociedad.Id == int.Parse(id) && (x.IndicadorAsamblea == 0 || x.TipoReforma != null))
                                          .OrderByDescending(x => x.FechaCelebracion).ToList();

            var listCertificaciones = await repoCertificacion.GetAllAsync();
            ListCertificacionGral = listCertificaciones.Where(x => x.Sociedad != null && x.Sociedad.Id == int.Parse(id))
                                                      .OrderByDescending(x => x.Fecha).ToList();

            var listLibros = await repoLibros.GetAllAsync();
            ListLibrosgral = listLibros.Where(x => x.Sociedad != null && x.Sociedad.Id == int.Parse(id)).ToList();

            List<AccionistaSociedadVerDto> listNewAccionista = new();

            var listAaccionista = await repoaccionista.GetBySociedadIdAsync(int.Parse(id));
            foreach (var item in listAaccionista)
            {
                Int64 nroacciones = 0;
                decimal porcparticipa = 0;
                Int64 accionesaux = 0;
                if (item.NroAcciones != null)
                {
                    accionesaux = (Int64)item.NroAcciones;
                }

                if (item.Sociedad != null && !string.IsNullOrWhiteSpace(item.Sociedad.NumeroAcciones))
                {
                    if (Int64.TryParse(item.Sociedad.NumeroAcciones, out long totalAcciones) && totalAcciones > 0)
                    {
                        porcparticipa = Math.Round((decimal)((nroacciones != 0) ? nroacciones : accionesaux) / totalAcciones * 100, 8);
                    }
                }

                AccionistaSociedadVerDto accionista = new()
                {
                    Id = item.Id,
                    SociedadNombre = item.Sociedad?.Empresa?.Nombre,
                    TipoAccionistaNombre = item.Accionista?.TipoAccionista?.Nombre,
                    AccionistaNombre = (item.Accionista?.TipoAccionista?.Id != 3) ? item.Accionista?.Nombre : (item.Accionista?.NombreSusesion?.Length > 50) ? item.Accionista.NombreSusesion.Substring(0, 50) : item.Accionista?.NombreSusesion,
                    NroAcciones = (nroacciones != 0) ? nroacciones : accionesaux,
                    Participacion = porcparticipa,
                    CreateDate = item.CreateDate,
                    UpdateDate = item.UpdateDate
                };

                listNewAccionista.Add(accionista);
            }
            ListAccionistasGral = listNewAccionista.OrderBy(x => x.SociedadNombre).ToList();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Regresar()
    {
        navManager.NavigateTo($"/sociedadesinactivas");
    }

    private void Detalle(Asamblea item)
    {
        idAsamblea = item.Id;
        mostrarModal = true;
    }

    private void ManejarCierreModal() => mostrarModal = false;

    private async Task ExportarAPdf()
    {
        try
        {
            cargando = true;
            urlPdfGenerado = "";
            StateHasChanged();

            urlPdfGenerado = await ReportService.GenerarYDescargarReporteSociedadAsync(int.Parse(id));

            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Reporte PDF generado exitosamente.");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion($"Error al exportar PDF: {ex.Message}", true);
        }
    }
}
