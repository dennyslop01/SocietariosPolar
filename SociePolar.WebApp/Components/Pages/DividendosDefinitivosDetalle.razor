@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header text-white" style="background-color: #00338D;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-calculator me-2"></i>Detalle Dividendo Definitivo
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
            </div>

            <div class="modal-body py-4">
                <div class="table-responsive">
                    <PaginationComponent TItem="DividendoDefinitivoDetalle" Items="Listgral" DefaultPageSize="50">
                        <ChildContentHeader>
                            <tr class="table-light border-bottom text-nowrap">
                                <th class="py-3 text-secondary fw-bold" style="font-size: 0.85rem;">Nombre Accionista</th>
                                <th class="py-3 text-secondary fw-bold" style="font-size: 0.85rem;">RIF</th>
                                <th class="py-3 text-secondary fw-bold" style="font-size: 0.85rem;">Tipo de Pago</th>
                                <th class="py-3 text-secondary fw-bold" style="font-size: 0.85rem;">Moneda</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Notificado</th>
                                <th class="py-3 text-secondary fw-bold" style="font-size: 0.85rem;">Fecha Notificación</th>
                                <th class="py-3 text-secondary fw-bold text-end" style="font-size: 0.85rem;">Monto Decretado</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Fecha Decreto</th>
                                <th class="py-3 text-secondary fw-bold text-end" style="font-size: 0.85rem;">Monto Retenido</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Ejercicio Fiscal</th>
                                <th class="py-3 text-secondary fw-bold text-end" style="font-size: 0.85rem;">Porción 1 Monto</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Porción 1 %</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Porción 1 Fecha Pago</th>
                                <th class="py-3 text-secondary fw-bold text-end" style="font-size: 0.85rem;">Porción 2 Monto</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Porción 2 %</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Porción 2 Fecha Pago</th>
                                <th class="py-3 text-secondary fw-bold text-end" style="font-size: 0.85rem;">Porción 3 Monto</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Porción 3 %</th>
                                <th class="py-3 text-secondary fw-bold text-center" style="font-size: 0.85rem;">Porción 3 Fecha Pago</th>
                            </tr>
                        </ChildContentHeader>
                        <ChildContentRow Context="p">
                            <tr class="align-middle border-bottom text-nowrap">
                                <td class="text-start text-dark fw-medium small">@ObtenerNombreAccionista(p)</td>
                                <td class="text-start text-secondary small">@(p.Accionista?.Documento1 ?? "-")</td>
                                <td class="text-start text-secondary small">@(string.IsNullOrEmpty(p.TipoPago) ? "-" : p.TipoPago)</td>
                                <td class="text-start text-secondary small">@(p.Moneda?.Nombre ?? p.Moneda?.Simbolo ?? "-")</td>
                                <td class="text-center small">
                                    <span class="badge @(p.Notificado ? "bg-success" : "bg-light text-secondary border")">
                                        @(p.Notificado ? "Sí" : "No")
                                    </span>
                                </td>
                                <td class="text-center text-secondary small">@(p.FechaNotificacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end text-secondary small fw-semibold">@p.MontoDecretado.ToString("N2")</td>
                                <td class="text-center text-secondary small">@(p.FechaDecreto?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end text-secondary small">@p.MontoRetenido.ToString("N2")</td>
                                <td class="text-center text-secondary small">@(string.IsNullOrEmpty(p.EjercicioFiscal) ? "-" : p.EjercicioFiscal)</td>
                                <td class="text-end text-secondary small">@p.Porcion1Monto.ToString("N2")</td>
                                <td class="text-center text-secondary small">@p.Porcion1Porcentaje.ToString("N2")%</td>
                                <td class="text-center text-secondary small">@(p.Porcion1FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end text-secondary small">@p.Porcion2Monto.ToString("N2")</td>
                                <td class="text-center text-secondary small">@p.Porcion2Porcentaje.ToString("N2")%</td>
                                <td class="text-center text-secondary small">@(p.Porcion2FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end text-secondary small">@p.Porcion3Monto.ToString("N2")</td>
                                <td class="text-center text-secondary small">@p.Porcion3Porcentaje.ToString("N2")%</td>
                                <td class="text-center text-secondary small">@(p.Porcion3FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                            </tr>
                        </ChildContentRow>
                    </PaginationComponent>
                </div>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <ModalCargando />
}

@code {
    [Parameter] public Int32 id { get; set; } = 0;

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;

    private List<DividendoDefinitivoDetalle> Listgral = new();


    [Inject] private IDividendoDefinitivo repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        await LoadGenericDataAsync();

        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            Listgral = await repository.GetDetalleByIdAsync(id);
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private string ObtenerNombreAccionista(DividendoDefinitivoDetalle p)
    {
        if (p.Accionista == null) return "-";
        if (p.Accionista.TipoAccionista?.Id != 3)
        {
            return p.Accionista.Nombre ?? "-";
        }
        var sucesion = p.Accionista.NombreSusesion ?? "";
        return sucesion.Length > 50 ? sucesion.Substring(0, 50) + "..." : (string.IsNullOrEmpty(sucesion) ? (p.Accionista.Nombre ?? "-") : sucesion);
    }
}


