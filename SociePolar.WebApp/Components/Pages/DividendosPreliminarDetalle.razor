@page "/dividendospreliminardetalle/{id:int}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-calculator text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Detalle Dividendos Preliminares
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">
                    @if (!string.IsNullOrWhiteSpace(DividendoPadre?.RutaDividendos))
                    {
                        <button type="button" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm"
                                @onclick="() => VisualizarExcelAsync(DividendoPadre.RutaDividendos, DividendoPadre.NombreDividendos)"
                                title="Abrir Excel: @DividendoPadre.NombreDividendos" style="height: 32px; font-size: 0.8rem; font-weight: 500;">
                            <i class="bi bi-file-earmark-excel"></i> Ver Excel
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(DividendoPadre?.RutaActa))
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm"
                                @onclick="() => VisualizarDocumentoAsync(DividendoPadre.RutaActa, DividendoPadre.NombreActa)"
                                title="Abrir Acta: @DividendoPadre.NombreActa" style="height: 32px; font-size: 0.8rem; font-weight: 500;">
                            <i class="bi bi-file-earmark-pdf"></i> Ver Acta
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(DividendoPadre?.RutaDocumento))
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm"
                                @onclick="() => VisualizarDocumentoAsync(DividendoPadre.RutaDocumento, DividendoPadre.NombreDocumento)"
                                title="Abrir Soporte 2: @DividendoPadre.NombreDocumento" style="height: 32px; font-size: 0.8rem; font-weight: 500;">
                            <i class="bi bi-file-earmark-pdf"></i> Ver Soporte 2
                        </button>
                    }

                    <!-- Botón Regresar -->
                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Multicriterio -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <span class="badge bg-light text-secondary border px-2 py-1 small">
                        Mostrando @Listgral.Count de @ListgralCompleta.Count accionistas
                    </span>
                </div>
                <div class="col-md-6 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por accionista, RIF, tipo de pago, ejercicio..."
                               value="@searchTerm"
                               @oninput="FiltrarBusqueda" />
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="() => { searchTerm = string.Empty; AplicarFiltro(); }">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
            <PaginationComponent TItem="DividendoPreliminarDetalle" Items="Listgral" DefaultPageSize="50" TableClass="polar-table-compact">
                <ChildContentHeader>
                    <tr class="table-light border-bottom text-nowrap">
                        <th class="polar-sticky-col-direct text-start" style="min-width: 220px; max-width: 260px;">Nombre Accionista</th>
                        <th class="text-start" style="min-width: 100px;">RIF</th>
                        <th class="text-start" style="min-width: 110px;">Tipo de Pago</th>
                        <th class="text-center" style="min-width: 80px;">Moneda</th>
                        <th class="text-center" style="min-width: 90px;">Notificado</th>
                        <th class="polar-date" style="min-width: 110px;">Fecha Notif.</th>
                        <th class="polar-num" style="min-width: 120px;">Monto Decretado</th>
                        <th class="polar-date" style="min-width: 110px;">Fecha Decreto</th>
                        <th class="polar-num" style="min-width: 120px;">Monto Retenido</th>
                        <th class="polar-date" style="min-width: 100px;">Ejercicio</th>
                        <th class="polar-num" style="min-width: 110px;">P1 Monto</th>
                        <th class="polar-date" style="min-width: 70px;">P1 %</th>
                        <th class="polar-date" style="min-width: 100px;">P1 Fecha</th>
                        <th class="polar-num" style="min-width: 110px;">P2 Monto</th>
                        <th class="polar-date" style="min-width: 70px;">P2 %</th>
                        <th class="polar-date" style="min-width: 100px;">P2 Fecha</th>
                        <th class="polar-num" style="min-width: 110px;">P3 Monto</th>
                        <th class="polar-date" style="min-width: 70px;">P3 %</th>
                        <th class="polar-date" style="min-width: 100px;">P3 Fecha</th>
                        <th class="polar-num" style="min-width: 110px;">P4 Monto</th>
                        <th class="polar-date" style="min-width: 70px;">P4 %</th>
                        <th class="polar-date" style="min-width: 100px;">P4 Fecha</th>
                        <th class="text-start" style="min-width: 150px;">Observaciones</th>
                        <th class="text-center" style="min-width: 80px;">Soporte 1</th>
                        <th class="polar-date" style="min-width: 100px;">Fecha Sop. 1</th>
                        <th class="text-center" style="min-width: 80px;">Soporte 2</th>
                        <th class="polar-date" style="min-width: 100px;">Fecha Sop. 2</th>
                        <th class="text-center" style="min-width: 80px;">Soporte 3</th>
                        <th class="polar-date" style="min-width: 100px;">Fecha Sop. 3</th>
                        <th class="text-center" style="min-width: 80px;">Soporte 4</th>
                        <th class="polar-date" style="min-width: 100px;">Fecha Sop. 4</th>
                        <th class="text-end pe-3" style="width: 80px; min-width: 80px;">Acciones</th>
                    </tr>
                </ChildContentHeader>
                    <ChildContentRow Context="p">
                    <tr class="align-middle border-bottom text-nowrap">
                        <td class="polar-sticky-col-direct text-start text-dark fw-semibold">
                            <span class="polar-truncate" style="max-width: 250px;" title="@p.NombreAccionista">
                                @p.NombreAccionista
                            </span>
                        </td>
                        <td class="text-start text-secondary small">@(string.IsNullOrEmpty(p.Rif) ? "-" : p.Rif)</td>
                        <td class="text-start text-secondary small">@(string.IsNullOrEmpty(p.TipoPago) ? "-" : p.TipoPago)</td>
                        <td class="text-center text-secondary small">@(string.IsNullOrEmpty(p.MonedaPago) ? "-" : p.MonedaPago)</td>
                        <td class="text-center small">
                            <span class="badge @(p.Notificado ? "bg-success" : "bg-light text-secondary border")">
                                @(p.Notificado ? "Sí" : "No")
                            </span>
                        </td>
                        <td class="polar-date text-secondary small">@(p.FechaNotificacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="polar-num text-dark fw-semibold">@FormatearMonto(p.MontoDecretado)</td>
                        <td class="polar-date text-secondary small">@(p.FechaDecreto?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="polar-num text-secondary small">@FormatearMonto(p.MontoRetenido)</td>
                        <td class="polar-date text-secondary small">@(string.IsNullOrEmpty(p.EjercicioFiscal) ? "-" : p.EjercicioFiscal)</td>
                        <td class="polar-num text-secondary small">@FormatearMonto(p.Porcion1Monto)</td>
                        <td class="polar-date text-secondary small">@FormatearPorcentaje(p.Porcion1Porcentaje)</td>
                        <td class="polar-date text-secondary small">@(p.Porcion1FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="polar-num text-secondary small">@FormatearMonto(p.Porcion2Monto)</td>
                        <td class="polar-date text-secondary small">@FormatearPorcentaje(p.Porcion2Porcentaje)</td>
                        <td class="polar-date text-secondary small">@(p.Porcion2FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="polar-num text-secondary small">@FormatearMonto(p.Porcion3Monto)</td>
                        <td class="polar-date text-secondary small">@FormatearPorcentaje(p.Porcion3Porcentaje)</td>
                        <td class="polar-date text-secondary small">@(p.Porcion3FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="polar-num text-secondary small">@FormatearMonto(p.Porcion4Monto)</td>
                        <td class="polar-date text-secondary small">@FormatearPorcentaje(p.Porcion4Porcentaje)</td>
                        <td class="polar-date text-secondary small">@(p.Porcion4FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="text-start text-secondary small">
                            <span class="polar-truncate" style="max-width: 150px;" title="@p.Observaciones">
                                @(string.IsNullOrEmpty(p.Observaciones) ? "-" : p.Observaciones)
                            </span>
                        </td>
                        <td class="text-center small">
                            <span class="badge @(p.SoporteEnviadoP1 ? "bg-success" : "bg-light text-secondary border")">
                                @(p.SoporteEnviadoP1 ? "Sí" : "No")
                            </span>
                        </td>
                        <td class="polar-date text-secondary small">@(p.SoporteFechaP1?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="text-center small">
                            <span class="badge @(p.SoporteEnviadoP2 ? "bg-success" : "bg-light text-secondary border")">
                                @(p.SoporteEnviadoP2 ? "Sí" : "No")
                            </span>
                        </td>
                        <td class="polar-date text-secondary small">@(p.SoporteFechaP2?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="text-center small">
                            <span class="badge @(p.SoporteEnviadoP3 ? "bg-success" : "bg-light text-secondary border")">
                                @(p.SoporteEnviadoP3 ? "Sí" : "No")
                            </span>
                        </td>
                        <td class="polar-date text-secondary small">@(p.SoporteFechaP3?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="text-center small">
                            <span class="badge @(p.SoporteEnviadoP4 ? "bg-success" : "bg-light text-secondary border")">
                                @(p.SoporteEnviadoP4 ? "Sí" : "No")
                            </span>
                        </td>
                        <td class="polar-date text-secondary small">@(p.SoporteFechaP4?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="text-end pe-3">
                            @if (idRol == 1 || idRol == 2)
                            {
                                <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)" title="Editar">
                                    <i class="bi bi-pencil-square fs-6"></i>
                                </button>
                            }
                        </td>
                    </tr>
                </ChildContentRow>
            </PaginationComponent>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}

@if(mostrarModal)
{
    <DividendosDefinitivosDetalleGuardar idDetalle="@idDetalle" OnFinalizado="ManejarCierreModal" />
}
@code {
    [Parameter] public Int32 id { get; set; } = 0;

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;
    private int idRol = 0;
    private bool mostrarModal = false;
    private int idDetalle = 0;

    private List<DividendoPreliminarDetalle> Listgral = new();
    private List<DividendoPreliminarDetalle> ListgralCompleta = new();
    private string searchTerm = "";

    [Inject] private IDividendoPreliminar repository { get; set; } = null!;

    private DividendoPreliminar? DividendoPadre;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
            {
                if (int.TryParse(userrolaux.Value, out var rolVal))
                {
                    idRol = rolVal;
                }
            }
        }
        catch
        {
            // Silencioso en prerenderizado SSR: JSInterop (SessionStorage) requiere circuito interactivo
        }
        await LoadGenericDataAsync();

        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
                {
                    if (int.TryParse(userrolaux.Value, out var rolVal) && idRol != rolVal)
                    {
                        idRol = rolVal;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error hidratando rol en AfterRender: {ex.Message}");
            }
        }
    }


    private async Task LoadGenericDataAsync()
    {
        try
        {
            DividendoPadre = await repository.GetByIdAsync(id);
            ListgralCompleta = await repository.GetDetalleByIdAsync(id) ?? new();
            Listgral = ListgralCompleta;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task VisualizarDocumentoAsync(string? rutaCompleta, string? nombreDocumento)
    {
        if (string.IsNullOrWhiteSpace(rutaCompleta)) return;
        cargando = true;
        StateHasChanged();
        try
        {
            string fileId = rutaCompleta.Split('/').Last();
            string base64Data = await DriveService.GetFileAsync(fileId);
            await jsRuntime.InvokeVoidAsync("abrirPdfBase64", base64Data, nombreDocumento ?? "Documento.pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir el Documento: {ex.Message}");
            await MostrarNotificacion("Error al abrir el documento: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task VisualizarExcelAsync(string? rutaCompleta, string? nombreDocumento)
    {
        if (string.IsNullOrWhiteSpace(rutaCompleta)) return;
        cargando = true;
        StateHasChanged();
        try
        {
            string fileId = rutaCompleta.Split('/').Last();
            string base64Data = await DriveService.GetFileAsync(fileId);
            await jsRuntime.InvokeVoidAsync("abrirExcelBase64", base64Data, nombreDocumento ?? "Archivo.xlsx");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir el Archivo: {ex.Message}");
            await MostrarNotificacion("Error al abrir el archivo Excel: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralCompleta;
        }
        else
        {
            var term = searchTerm.Trim().ToLower();
            Listgral = ListgralCompleta.Where(p =>
                (!string.IsNullOrEmpty(p.NombreAccionista) && p.NombreAccionista.ToLower().Contains(term)) ||
                (!string.IsNullOrEmpty(p.Rif) && p.Rif.ToLower().Contains(term)) ||
                (!string.IsNullOrEmpty(p.TipoPago) && p.TipoPago.ToLower().Contains(term)) ||
                (!string.IsNullOrEmpty(p.EjercicioFiscal) && p.EjercicioFiscal.ToLower().Contains(term)) ||
                (!string.IsNullOrEmpty(p.Observaciones) && p.Observaciones.ToLower().Contains(term))
            ).ToList();
        }
        StateHasChanged();
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private async Task Regresar()
    {
        await jsRuntime.InvokeVoidAsync("history.back");
    }

    private void Editar(DividendoPreliminarDetalle item)
    {
        idDetalle = item.Id;
        mostrarModal = true;
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            cargando = false; // Oculta el spinner después de todo
            StateHasChanged();
            await MostrarNotificacion($"Detalle Dividendo guardado correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    private string FormatearMonto(decimal val)
    {
        return val.ToString("N4");
    }

    private string FormatearPorcentaje(decimal val)
    {
        if (val > 0 && val <= 1.0m)
        {
            return (val * 100).ToString("N2") + "%";
        }
        return val.ToString("N2") + "%";
    }
}


