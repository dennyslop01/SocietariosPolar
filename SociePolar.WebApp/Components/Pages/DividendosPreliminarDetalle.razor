@page "/dividendospreliminardetalle/{id:int}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-calculator text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Detalle Dividendos Preliminares
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Regresar -->
                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>

                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @* @oninput="FiltrarBusqueda" *@ />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="DividendoPreliminarDetalle" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">NombreAccionista</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Rif</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">TipoPago</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">MonedaPago</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Notificado</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">FechaNotificacion</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">MontoDecretado</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">FechaDecreto</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">MontoRetenido</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">EjercicioFiscal</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion1Monto</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion1Porcentaje</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion1FechaPago</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion2Monto</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion2Porcentaje</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion2FechaPago</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion3Monto</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion3Porcentaje</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Porcion3FechaPago</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="text-start text-secondary small" style="width: 5%;">@p.NombreAccionista</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Rif</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.TipoPago</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.MonedaPago</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Notificado</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.FechaNotificacion?.ToString("dd/MM/yyyy")</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.MontoDecretado</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.FechaDecreto?.ToString("dd/MM/yyyy")</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.MontoRetenido</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.EjercicioFiscal</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion1Monto</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion1Porcentaje</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion1FechaPago?.ToString("dd/MM/yyyy")</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion2Monto</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion2Porcentaje</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion2FechaPago?.ToString("dd/MM/yyyy")</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion3Monto</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion3Porcentaje</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Porcion3FechaPago?.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}

@if(mostrarModal)
{
    <DividendosDefinitivosDetalleGuardar idDetalle="@idDetalle" OnFinalizado="ManejarCierreModal" />
}
@code {
    [Parameter] public Int32 id { get; set; } = 0;

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;
    private int idRol = 0;
    private bool mostrarModal = false;
    private int idDetalle = 0;

    private List<DividendoPreliminarDetalle> Listgral = new();


    [Inject] private IDividendoPreliminar repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }
        await LoadGenericDataAsync();

        cargando = false;
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            Listgral = await repository.GetDetalleByIdAsync(id);
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private async Task Regresar()
    {
        await jsRuntime.InvokeVoidAsync("history.back");
    }

    private void Editar(DividendoPreliminarDetalle item)
    {
        idDetalle = item.Id;
        mostrarModal = true;
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            cargando = false; // Oculta el spinner después de todo
            StateHasChanged();
            await MostrarNotificacion($"Detalle Dividendo guardado correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

}


