@rendermode InteractiveServer
@using ExcelDataReader
@inject GoogleDriveService DriveService

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnValidSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <!-- Header Polar Blue -->
                <div class="modal-header text-white" style="background-color: #00338D;">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @( (int.TryParse(id, out var parsedId) && parsedId > 0) ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @( (int.TryParse(id, out var pId) && pId > 0) ? "Modificar Dividendo Preliminar" : "Agregar Dividendo Preliminar")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4 px-4 bg-light-subtle">
                    <div class="row g-3">
                        <!-- Sociedad -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Sociedad</label>
                            <div class="dropdown">
                                <button class="form-select text-start d-flex justify-content-between align-items-center bg-white shadow-sm"
                                        type="button"
                                        style="font-size: 0.85rem;"
                                        @onclick="ToggleDropdown">
                                    <span>@(ObtenerNombreSeleccionado())</span>
                                    <i class="bi bi-chevron-down text-muted small"></i>
                                </button>

                                <ul class="dropdown-menu w-100 p-2 shadow-lg border-0 @(isDropdownOpen ? "show" : "")"
                                    style="max-height: 300px; overflow-y: auto; z-index: 1050; border-radius: 8px;">
                                    <li class="mb-2">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Buscar sociedad..."
                                                   style="font-size: 0.85rem;"
                                                   @bind="textoBusqueda"
                                                   @bind:event="oninput"
                                                   @ref="searchInputRef" />
                                        </div>
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item rounded-2 @(entidadEditando.SociedadId == 0 ? "active bg-primary text-white" : "")"
                                                style="font-size: 0.85rem;"
                                                @onclick="() => SeleccionarOpcion(0)">
                                            Seleccione ...
                                        </button>
                                    </li>

                                    @if (listSociedad != null)
                                    {
                                        @foreach (var sociedad in listSociedad.Where(s => string.IsNullOrEmpty(textoBusqueda) || s.Empresa.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item rounded-2 @(entidadEditando.SociedadId == sociedad.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.85rem;"
                                                        @onclick="() => SeleccionarOpcion(sociedad.Id)">
                                                    @sociedad.Empresa.Nombre
                                                </button>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.SociedadId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Moneda</label>
                            <select class="form-select form-select-sm" value="@entidadEditando.MonedaId" @onchange="OnMonedaChanged">
                                <option value="0">Seleccione ...</option>
                                @if (listMoneda != null)
                                {
                                    @foreach (var moneda in listMoneda)
                                    {
                                        <option value="@moneda.Id">@moneda.Nombre</option>
                                    }
                                }
                            </select>
                            <ValidationMessage For="@(() => entidadEditando.MonedaId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <!-- Explicación -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Explicación</label>
                            <input type="text" class="form-control shadow-sm"
                                   @bind="entidadEditando.Explicacion"
                                   placeholder="Ingrese explicación..."
                                   maxlength="200" />
                            <ValidationMessage For="@(() => entidadEditando.Explicacion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>

                        <!-- Archivos Soportes -->
                        <div class="col-12"><hr class="my-2 text-secondary opacity-25" /></div>

                        <!-- Archivo Excel Dividendos -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-1">Archivo Excel Dividendos</label>
                            <label for="fileInputExcel"
                                   class="btn btn-outline-success btn-sm w-100 d-flex align-items-center justify-content-center shadow-sm"
                                   style="height: 38px; cursor: @(esInvalido ? "not-allowed" : "pointer"); pointer-events: @(esInvalido ? "none" : "auto"); border-radius: 8px;">
                                <i class="bi bi-file-earmark-excel me-2 fs-6"></i> Subir Excel
                            </label>

                            <InputFile id="fileInputExcel"
                                       class="small"
                                       OnChange="@(async (InputFileChangeEventArgs args) => await UploadFile(args, 1))"
                                       accept=".xlsx,.xls"
                                       style="display:none;" />

                            <div class="mt-1 text-truncate text-secondary small fw-medium">
                                @(string.IsNullOrEmpty(fileNameDividendo) ? "Ningún archivo seleccionado" : fileNameDividendo)
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.RutaDividendos)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>

                        <!-- Archivo Acta PDF -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-1">Archivo Acta</label>
                            <label for="fileInputActa"
                                   class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center shadow-sm"
                                   style="height: 38px; cursor: @(esInvalido ? "not-allowed" : "pointer"); pointer-events: @(esInvalido ? "none" : "auto"); border-radius: 8px;">
                                <i class="bi bi-file-earmark-pdf me-2 fs-6"></i> Subir Acta (PDF)
                            </label>

                            <InputFile id="fileInputActa"
                                       class="small"
                                       OnChange="@(async (InputFileChangeEventArgs args) => await UploadFile(args, 2))"
                                       accept=".pdf"
                                       style="display:none;" />

                            <div class="mt-1 text-truncate text-secondary small fw-medium">
                                @(string.IsNullOrEmpty(fileNameActa) ? "Ningún archivo seleccionado" : fileNameActa)
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.RutaActa)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>

                        <!-- Documento Secundario PDF -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-1">Doc. Secundario (Opcional)</label>
                            <label for="fileInputDoc"
                                   class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center shadow-sm"
                                   style="height: 38px; cursor: @(esInvalido ? "not-allowed" : "pointer"); pointer-events: @(esInvalido ? "none" : "auto"); border-radius: 8px;">
                                <i class="bi bi-file-earmark me-2 fs-6"></i> Subir Soporte (PDF)
                            </label>

                            <InputFile id="fileInputDoc"
                                       class="small"
                                       OnChange="@(async (InputFileChangeEventArgs args) => await UploadFile(args, 3))"
                                       accept=".pdf"
                                       style="display:none;" />

                            <div class="mt-1 text-truncate text-secondary small fw-medium">
                                @(string.IsNullOrEmpty(fileNameDoc) ? "Ningún archivo seleccionado" : fileNameDoc)
                            </div>
                        </div>

                        <!-- Comentarios -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Comentarios</label>
                            <textarea class="form-control shadow-sm"
                                      @bind="entidadEditando.Observaciones"
                                      rows="3"
                                      maxlength="2000"
                                      placeholder="Ingrese comentarios u observaciones adicionales...">
                                </textarea>
                        </div>

                        <!-- Montos y Totales -->
                        <div class="col-12"><hr class="my-2 text-secondary opacity-25" /></div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Total pagado según Tesorería</label>
                            <div class="input-group shadow-sm">
                                <!-- <span class="input-group-text">$</span> -->
                                <input type="text" class="form-control"
                                       @bind="MontoPagadoTesoreriaTexto" placeholder="0,00" />
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.MontoPagadoTesoreria)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Total pagado según Accionistas</label>
                            <div class="input-group shadow-sm">
                                <!-- <span class="input-group-text">$</span> -->
                                <input type="text" class="form-control"
                                       @bind="MontoPagadoAccionistasTexto" placeholder="0,00" />
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.MontoPagadoAccionistas)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Diferencia Tesorería - Accionistas</label>
                            <div class="input-group shadow-sm">
                                <!-- <span class="input-group-text">$</span> -->
                                <input type="text" class="form-control bg-light fw-semibold"
                                       value="@MontoPagadoDiferenciaTexto" placeholder="0,00" readonly />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Monto Total a Repartir</label>
                            <div class="input-group shadow-sm">
                                <!-- <span class="input-group-text">$</span> -->
                                <input type="text" class="form-control fw-bold text-primary" style="color: #00338D !important;"
                                       @bind="MontoTotalRepartirTexto" placeholder="0,00" />
                            </div>
                            <ValidationMessage For="@(() => entidadEditando.MontoTotalRepartir)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>

                        @if (!string.IsNullOrEmpty(mensajeAlerta))
                        {
                            <div class="col-12">
                                <div class="alert @claseAlerta py-2 px-3 mb-0 border-0 shadow-sm d-flex align-items-center">
                                    <i class="bi @iconoAlerta me-2 fs-6"></i>
                                    <span class="small fw-semibold">@mensajeAlerta</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Footer Flotante Polar -->
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" disabled="@guardando" style="background-color: #00338D !important;">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Guardando Dividendo...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>Guardar Dividendo</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando || guardando)
{
    <ModalCargando />
}

@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = true;
    private bool guardando = false;
    bool esInvalido = false;
    private string? fileNameDividendo = null;
    private string? fileNameActa = null;
    private string? fileNameDoc = null;

    private DividendoPreliminarDto entidadEditando = new();
    private List<Sociedad> listSociedad = new();
    private List<Moneda> listMoneda = new();

    private EditContext editContext = new(new DividendoPreliminarDto());
    private ValidationMessageStore? mensajeStore;
    private Stream streamToUploadDividendo;
    private Stream streamToUploadActa;
    private Stream streamToUploadDoc;
    private Stream streamExcelread;
    private string contentTypeDividendo = string.Empty;
    private string contentTypeActa = string.Empty;
    private string contentTypeDocumento = string.Empty;

    private List<DividendoPreliminar> Listgral = new();

    [Inject] private ISociedad repoSociedades { get; set; } = null!;
    [Inject] private IDividendoPreliminar repository { get; set; } = null!;
    [Inject] private IMoneda repoMoneda { get; set; } = null!;

    private bool isDropdownOpen = false;
    private string textoBusqueda = "";
    private ElementReference searchInputRef;
    private List<DividendoPreliminarDetalle> listaDividendos = new();

    private string MontoPagadoTesoreriaTexto
    {
        get => UtilClass.FormatearNumero((decimal?)entidadEditando.MontoPagadoTesoreria!);
        set
        {
            entidadEditando.MontoPagadoTesoreria = UtilClass.LimpiarYConvertir(value);
            entidadEditando.MontoPagadoDiferencia = entidadEditando.MontoPagadoTesoreria - entidadEditando.MontoPagadoAccionistas;
        }
    }

    private string MontoPagadoAccionistasTexto
    {
        get => UtilClass.FormatearNumero((decimal?)entidadEditando.MontoPagadoAccionistas!);
        set
        {
            entidadEditando.MontoPagadoAccionistas = UtilClass.LimpiarYConvertir(value);
            entidadEditando.MontoPagadoDiferencia = entidadEditando.MontoPagadoTesoreria - entidadEditando.MontoPagadoAccionistas;
        }
    }

    private string MontoPagadoDiferenciaTexto
    {
        get
        {
            decimal diferencia = entidadEditando.MontoPagadoTesoreria - entidadEditando.MontoPagadoAccionistas;
            entidadEditando.MontoPagadoDiferencia = diferencia;
            return UtilClass.FormatearNumero(diferencia);
        }
    }

    private string MontoTotalRepartirTexto
    {
        get => UtilClass.FormatearNumero((decimal?)entidadEditando.MontoTotalRepartir!);
        set => entidadEditando.MontoTotalRepartir = UtilClass.LimpiarYConvertir(value);
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            await LoadGenericDataAsync();

            if (id == "0" || string.IsNullOrEmpty(id))
            {
                entidadEditando = new();
                entidadEditando.SociedadId = 0;
                entidadEditando.RutaDividendos = string.Empty;
                entidadEditando.CreateDate = DateTime.Now;
            }

            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar dividendo preliminar: {ex.Message}");
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LoadGenericDataAsync()
    {
        listSociedad = await repoSociedades.GetAllAsync();
        Listgral = await repository.GetAllAsync();
        listMoneda = await repoMoneda.GetAllAsync();
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task UploadFile(InputFileChangeEventArgs e, int tipo)
    {
        mensajeAlerta = string.Empty;
        mostrarAlerta = false;

        switch (tipo)
        {
            case 1:
                fileNameDividendo = string.Empty;
                entidadEditando.RutaDividendos = null;
                break;
            case 2:
                fileNameActa = string.Empty;
                entidadEditando.RutaActa = null;
                break;
            case 3:
                fileNameDoc = string.Empty;
                entidadEditando.RutaDocumento = null;
                break;
        }

        try
        {
            var file = e.File;
            if (file == null)
            {
                return;
            }

            switch (tipo)
            {
                case 1:
                    string contentTypeDaux = file.ContentType;
                    if (contentTypeDaux == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" || contentTypeDaux == "application/vnd.ms-excel")
                    {
                        var memoryStream = new MemoryStream();
                        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
                        var fileBytes = memoryStream.ToArray();
                        memoryStream.Position = 0;

                        var memoryStreamExcel = new MemoryStream(fileBytes);

                        contentTypeDividendo = file.ContentType;
                        streamToUploadDividendo = memoryStream;
                        streamExcelread = memoryStreamExcel;
                        fileNameDividendo = e.File.Name;
                        entidadEditando.RutaDividendos = e.File.Name;
                        entidadEditando.NombreDividendos = e.File.Name;

                        cargando = true;
                        StateHasChanged();

                        await CargarExcelDividendos();

                        cargando = false;
                        StateHasChanged();
                    }
                    else
                    {
                        mensajeAlerta = "Formato no soportado. Solo Excel (.xlsx, .xls).";
                        mostrarAlerta = true;
                        StateHasChanged();
                        return;
                    }
                    break;
                case 2:
                case 3:
                    string contentTypeAaux = file.ContentType;
                    if (contentTypeAaux == "application/pdf")
                    {
                        var memoryStream = new MemoryStream();
                        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
                        memoryStream.Position = 0;
                        switch (tipo)
                        {
                            case 2:
                                contentTypeActa = file.ContentType;
                                streamToUploadActa = memoryStream;
                                fileNameActa = e.File.Name;
                                entidadEditando.RutaActa = e.File.Name;
                                entidadEditando.NombreActa = e.File.Name;
                                break;
                            case 3:
                                contentTypeDocumento = file.ContentType;
                                streamToUploadDoc = memoryStream;
                                fileNameDoc = e.File.Name;
                                entidadEditando.RutaDocumento = e.File.Name;
                                entidadEditando.NombreDocumento = e.File.Name;
                                break;
                        }
                        StateHasChanged();
                    }
                    else
                    {
                        mensajeAlerta = "Formato no soportado. Solo PDF (.pdf).";
                        mostrarAlerta = true;
                        StateHasChanged();
                        return;
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            mostrarAlerta = true;
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task GuardarCambios()
    {
        if (guardando) return;
        mensajeAlerta = string.Empty;
        guardando = true;
        StateHasChanged();

        bool formularioValido = editContext.Validate();
        if (!formularioValido)
        {
            guardando = false;
            StateHasChanged();
            await MostrarNotificacion("Por favor complete los campos requeridos marcados en rojo", true);
            await jsRuntime.InvokeVoidAsync("eval", @"
                var m = document.querySelector('.modal-body') || document.querySelector('.modal');
                if (m) {
                    m.scrollTop = 0;
                    try { m.scrollTo({ top: 0, behavior: 'smooth' }); } catch(e) {}
                }
                var firstInput = document.querySelector('.modal select, .modal input');
                if (firstInput) {
                    try { firstInput.focus(); } catch(e) {}
                    firstInput.classList.remove('pulse-invalid-field');
                    void firstInput.offsetWidth;
                    firstInput.classList.add('pulse-invalid-field');
                }
            ");
            return;
        }

        // Validación previa para evitar que el stream falle
        if (streamToUploadDividendo == null)
        {
            await MostrarNotificacion("Debe seleccionar un archivo Excel válido antes de guardar.", true);
            guardando = false;
            StateHasChanged();
            return;
        }

        if (streamToUploadActa == null)
        {
            await MostrarNotificacion("Debe seleccionar un archivo PDF válido antes de guardar.", true);
            guardando = false;
            StateHasChanged();
            return;
        }

        if (listaDividendos.Count == 0)
        {
            await MostrarNotificacion("El archivo Excel no contiene datos válidos de dividendos o ocurrió un error en la carga.", true);
            guardando = false;
            StateHasChanged();
            return;
        }
        if (!await SubirDocumentosDrive(streamToUploadDividendo, contentTypeDividendo, 1))
        {
            guardando = false;
            StateHasChanged();
            return;
        }
        if (!await SubirDocumentosDrive(streamToUploadActa, contentTypeActa, 2))
        {
            guardando = false;
            StateHasChanged();
            return;
        }

        if (streamToUploadDoc != null)
        {
            if (!await SubirDocumentosDrive(streamToUploadDoc, contentTypeDocumento, 3))
            {
                guardando = false;
                StateHasChanged();
                return;
            }
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (useridaux.Success && !string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);
                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    Int32 idNew = await repository.AddAsync(entidadEditando);
                    listaDividendos.ForEach(x => x.DividendoPreliminarId = idNew);

                    await repository.AddDetalleAsync(listaDividendos);

                    await streamToUploadDividendo.DisposeAsync();
                    await streamExcelread.DisposeAsync();
                    await streamToUploadActa.DisposeAsync();
                    if (streamToUploadDoc != null)
                        await streamToUploadDoc.DisposeAsync();

                    await OnFinalizado.InvokeAsync(true);
                }
            }
            else
            {
                await MostrarNotificacion("Error: No se pudo identificar la sesión del usuario.", true);
                guardando = false;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            guardando = false;
            StateHasChanged();
            Console.WriteLine($"Error en Base de Datos: {ex.Message}");
            await MostrarNotificacion("Error al guardar en la base de datos: " + ex.Message, true);
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task CargarExcelDividendos()
    {
        listaDividendos.Clear();
        if (streamExcelread.CanSeek)
        {
            streamExcelread.Position = 0;
        }
        var useridaux = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(useridaux.Value))
        {
            int userid = int.Parse(useridaux.Value);
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);

            using (var reader = ExcelReaderFactory.CreateReader(streamExcelread))
            {
                bool esPrimeraFila = true;
                int fila = 1;
                int vacios = 0;
                try
                {
                    while (reader.Read())
                    {
                        if (fila < 4)
                        {
                            fila++;
                            continue;
                        }

                        if (esPrimeraFila)
                        {
                            fila++;
                            esPrimeraFila = false;
                            continue;
                        }

                        if (vacios > 5) return;

                        if (reader.GetValue(1) == null)
                        {
                            vacios++;
                            continue;
                        }

                        var nuevoDividendo = new DividendoPreliminarDetalle()
                        {
                            DividendoPreliminarId = 0,
                            NombreAccionista = GetString(reader.GetValue(1)),
                            Rif = GetString(reader.GetValue(2)),
                            TipoPago = GetString(reader.GetValue(3)),
                            MonedaPago = GetString(reader.GetValue(4)),
                            Notificado = GetBool(reader.GetValue(5)),
                            FechaNotificacion = GetDateTime(reader.GetValue(6)),
                            MontoDecretado = GetDecimal(reader.GetValue(7)),
                            FechaDecreto = GetDateTime(reader.GetValue(8)),
                            MontoRetenido = GetDecimal(reader.GetValue(9)),
                            EjercicioFiscal = GetString(reader.GetValue(10)),

                            Porcion1Monto = GetDecimal(reader.GetValue(11)),
                            Porcion1Porcentaje = GetDecimal(reader.GetValue(12)),
                            Porcion1FechaPago = GetDateTime(reader.GetValue(13)),

                            Porcion2Monto = GetDecimal(reader.GetValue(14)),
                            Porcion2Porcentaje = GetDecimal(reader.GetValue(15)),
                            Porcion2FechaPago = GetDateTime(reader.GetValue(16)),

                            Porcion3Monto = GetDecimal(reader.GetValue(17)),
                            Porcion3Porcentaje = GetDecimal(reader.GetValue(18)),
                            Porcion3FechaPago = GetDateTime(reader.GetValue(19)),

                            Porcion4Monto = GetDecimal(reader.GetValue(20)),
                            Porcion4Porcentaje = GetDecimal(reader.GetValue(21)),
                            Porcion4FechaPago = GetDateTime(reader.GetValue(22)),

                            Observaciones = GetString(reader.GetValue(23)),

                            SoporteEnviadoP1 = GetBool(reader.GetValue(24)),
                            SoporteFechaP1 = GetDateTime(reader.GetValue(25)),
                            SoporteEnviadoP2 = GetBool(reader.GetValue(26)),
                            SoporteFechaP2 = GetDateTime(reader.GetValue(27)),
                            SoporteEnviadoP3 = GetBool(reader.GetValue(28)),
                            SoporteFechaP3 = GetDateTime(reader.GetValue(29)),
                            SoporteEnviadoP4 = GetBool(reader.GetValue(30)),
                            SoporteFechaP4 = GetDateTime(reader.GetValue(31)),
                            CreateDate = DateTime.Now,
                            CreateUserId = userid,
                        };

                        listaDividendos.Add(nuevoDividendo);
                        fila++;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error al cargar el archivo Excel: {ex.Message}");
                    await MostrarNotificacion($"Error al cargar el archivo Excel en la Fila {fila}: {ex.Message}", true);
                    listaDividendos.Clear();
                }
            }
        }
    }

    private async Task<bool> SubirDocumentosDrive(Stream streamToUpload, string tipodoc, int opcion)
    {
        try
        {
            string folderName = $"Dividendos_Sociedad_ID_{entidadEditando.SociedadId}";
            string nombreLimpio = string.Empty;
            switch (opcion)
            {
                case 1:
                    nombreLimpio = entidadEditando.NombreDividendos.Replace(" ", "_").Replace("/", "_").Replace("\\", "_");
                    entidadEditando.NombreDividendos = nombreLimpio;
                    break;
                case 2:
                    nombreLimpio = entidadEditando.NombreActa.Replace(" ", "_").Replace("/", "_").Replace("\\", "_");
                    if (!nombreLimpio.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        nombreLimpio = nombreLimpio + $"_{DateTime.Now:yyyyMMdd}.pdf";
                    }
                    entidadEditando.NombreActa = nombreLimpio;
                    break;
                case 3:
                    nombreLimpio = entidadEditando.NombreDocumento.Replace(" ", "_").Replace("/", "_").Replace("\\", "_");
                    if (!nombreLimpio.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        nombreLimpio = nombreLimpio + $"_{DateTime.Now:yyyyMMdd}.pdf";
                    }
                    entidadEditando.NombreDocumento = nombreLimpio;
                    break;
            }

            if (!string.IsNullOrEmpty(folderName))
            {
                string folderId = await DriveService.CreateFolderAsync(folderName);
                string fileIdResult = await DriveService.UploadFileAsync(streamToUpload, nombreLimpio, tipodoc, folderId);
                switch (opcion)
                {
                    case 1:
                        entidadEditando.RutaDividendos = $"{folderId}/{fileIdResult}";
                        break;
                    case 2:
                        entidadEditando.RutaActa = $"{folderId}/{fileIdResult}";
                        break;
                    case 3:
                        entidadEditando.RutaDocumento = $"{folderId}/{fileIdResult}";
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Error al subir a Google Drive: " + ex.Message, true);
            return false;
        }

        switch (opcion)
        {
            case 1:
                if (string.IsNullOrEmpty(entidadEditando.RutaDividendos))
                {
                    await MostrarNotificacion("No se pudo obtener la ruta de Google Drive para el archivo de Dividendos.", true);
                    cargando = false;
                    StateHasChanged();
                    return false;
                }
                break;
            case 2:
                if (string.IsNullOrEmpty(entidadEditando.RutaActa))
                {
                    await MostrarNotificacion("No se pudo obtener la ruta de Google Drive para el archivo de Acta.", true);
                    cargando = false;
                    StateHasChanged();
                    return false;
                }
                break;
            case 3:
                if (string.IsNullOrEmpty(entidadEditando.RutaDocumento))
                {
                    await MostrarNotificacion("No se pudo obtener la ruta de Google Drive para el archivo de Documento.", true);
                    cargando = false;
                    StateHasChanged();
                    return false;
                }
                break;
        }

        return true;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
        if (!isDropdownOpen)
        {
            textoBusqueda = "";
        }
    }

    private string ObtenerNombreSeleccionado()
    {
        if (entidadEditando?.SociedadId == 0 || listSociedad == null)
        {
            return "Seleccione ...";
        }

        var seleccionado = listSociedad.FirstOrDefault(s => s.Id == entidadEditando.SociedadId);
        return seleccionado?.Empresa?.Nombre ?? "Seleccione ...";
    }

    private void SeleccionarOpcion(int id)
    {
        entidadEditando.SociedadId = id;
        isDropdownOpen = false;
        textoBusqueda = "";
    }

    static string GetString(object val)
    {
        var texto = val?.ToString()?.Trim();
        return (texto == "-" || string.IsNullOrEmpty(texto)) ? string.Empty : texto;
    }

    static long GetLong(object val)
    {
        var texto = val?.ToString()?.Trim();
        if (texto == "-" || string.IsNullOrEmpty(texto)) return 0;

        return long.TryParse(texto, out long res) ? res : 0;
    }

    static decimal GetDecimal(object val)
    {
        var texto = val?.ToString()?.Trim();
        if (texto == "-" || string.IsNullOrEmpty(texto)) return 0.0m;

        return decimal.TryParse(texto, out decimal res) ? res : 0.0m;
    }

    static bool GetBool(object val)
    {
        var texto = val?.ToString()?.Trim().ToLower();
        if (texto == "-" || string.IsNullOrEmpty(texto)) return false;

        return texto == "sí" || texto == "si" || texto == "s\u00ed" || texto == "s";
    }

    static DateTime? GetDateTime(object val)
    {
        var texto = val?.ToString()?.Trim();
        if (texto == "-" || string.IsNullOrEmpty(texto)) return null;

        return DateTime.TryParse(texto, out DateTime res) ? res : (DateTime?)null;
    }

    private void OnMonedaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idSeleccionado))
        {
            entidadEditando.MonedaId = idSeleccionado;
        }
    }
