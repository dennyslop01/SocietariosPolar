@page "/dividendospreliminares"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-calculator text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Dividendos Preliminares
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>

                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="DividendoPreliminar" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Explicación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Nombre Dividendos</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Ruta Acta</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 15%; font-size: 0.85rem;">Observaciones</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Id</td>
                            <td class="text-start text-secondary small" style="width: 20%;">@p.Explicacion</td>
                            <td class="text-start text-secondary align-middle" style="width: 10%;">
                                <button type="button"
                                        class="btn btn-link text-primary small text-decoration-underline p-0 border-0 bg-transparent text-start"
                                        style="font-size: 0.999em;"
                                        @onclick="() => VisualizarExcelAsync(p.RutaDividendos, p.NombreDividendos)"
                                        @onclick:preventDefault>
                                    @(p.NombreDividendos?.Length > 25 ? $"{p.NombreDividendos.Substring(0, 25)}..." : p.NombreDividendos)
                                </button>
                            </td>
                            <td class="text-start text-secondary align-middle" style="width: 10%;">
                                <button type="button"
                                        class="btn btn-link text-primary small text-decoration-underline p-0 border-0 bg-transparent text-start"
                                        style="font-size: 0.999em;"
                                        @onclick="() => VisualizarDocumentoAsync(p.RutaActa, p.NombreActa)"
                                        @onclick:preventDefault>
                                    @(p.NombreActa?.Length > 25 ? $"{p.NombreActa.Substring(0, 25)}..." : p.NombreActa)
                                </button>
                            </td>
                            <td class="text-start text-secondary small" style="width: 15%;">@(p.Observaciones?.Length > 25 ? $"{p.Observaciones.Substring(0, 25)}..." : p.Observaciones)</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-secondary p-0 ms-1"
                                            @onclick="() => VerificarCerrar(p)" title="Cerrar Proceso">
                                        <i class="bi bi-check2-circle fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-secondary p-0 ms-1"
                                            @onclick="() => Detalle(p)" title="Detalle Archivo">
                                        <i class="bi bi-file-earmark-text fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}


@if (mostrarModal)
{
    <DividendosPreliminarGuardar id="0" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Explicacion</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalActivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-secondary fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a cerrar este proceso, <strong>@entidadParaEliminar?.Explicacion</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalActivar">Cancelar</button>
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="ConfirmarActivar">Procesar</button>
                </div>
            </div>
        </div>
    </div>
}

@* @if(mostrarDetalle)
{
    <DividendosPreliminarDetalle id="@idDividendo" OnFinalizado="() => mostrarDetalle = false" />
} *@

@code {

    private List<DividendoPreliminar> Listgral = new();
    private List<DividendoPreliminar> ListgralBuscar = new();
    private string searchTerm = ""; private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private DividendoPreliminar? entidadParaEliminar;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private int idRol = 0;
    // private bool mostrarDetalle = false;
    private Int32 idDividendo = 0;
    private bool mostrarModalActivar = false;

    [Inject] private IDividendoPreliminar repository { get; set; } = null!;
    [Inject] private IDividendoDefinitivo repodefinitivo { get; set; } = null!;
    [Inject] private IAccionista repoaccionista { get; set; } = null!;
    [Inject] private IMoneda repomoneda { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            Listgral = await repository.GetAllAsync();
            Listgral = Listgral.OrderBy(x => x.Sociedad?.Empresa?.Nombre).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        mostrarModal = true;
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Explicacion != null && b.Explicacion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void VerificarEliminar(DividendoPreliminar item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        StateHasChanged();
        try
        {
            string oldFileId = entidadParaEliminar.RutaDividendos!.Split('/').Last();
            await DriveService.TrashPdfFileByIdAsync(oldFileId);

            oldFileId = entidadParaEliminar.RutaActa!.Split('/').Last();
            await DriveService.TrashPdfFileByIdAsync(oldFileId);

            if (!string.IsNullOrEmpty(entidadParaEliminar.NombreDividendos))
            {
                oldFileId = entidadParaEliminar.RutaDividendos!.Split('/').Last();
                await DriveService.TrashPdfFileByIdAsync(oldFileId);
            }
            if(!string.IsNullOrEmpty(entidadParaEliminar.NombreActa))
            {
                oldFileId = entidadParaEliminar.RutaActa!.Split('/').Last();
                await DriveService.TrashPdfFileByIdAsync(oldFileId);
            }
            if (!string.IsNullOrEmpty(entidadParaEliminar.NombreDocumento))
            {
                oldFileId = entidadParaEliminar.RutaDocumento!.Split('/').Last();
                await DriveService.TrashPdfFileByIdAsync(oldFileId);
            }

            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Dividendo Preliminar eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Dividendo Preliminar guardado correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    // Método para obtener el enlace de Google Drive
    private async Task VisualizarDocumentoAsync(string rutaCompleta, string nombreDocumento)
    {
        cargando = true;
        StateHasChanged();
        try
        {
            // 1. Extraer el fileId real desde tu string (ej. "carpetaId/archivoId")
            string fileId = rutaCompleta.Split('/').Last();

            // 2. Consumir tu rutina existente para obtener el Base64
            string base64Data = await DriveService.GetFileAsync(fileId);

            // 3. Invocar al JavaScript para procesar el Blob y abrir la pestaña
            await jsRuntime.InvokeVoidAsync("abrirPdfBase64", base64Data, nombreDocumento);
        }
        catch (Exception ex)
        {
            // Manejo local de errores si la descarga falla o el ID no existe
            Console.WriteLine($"Error al abrir el Archivo: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task VisualizarExcelAsync(string rutaCompleta, string nombreDocumento)
    {
        cargando = true;
        StateHasChanged();
        try
        {
            // 1. Extraer el fileId real desde tu string (ej. "carpetaId/archivoId")
            string fileId = rutaCompleta.Split('/').Last();

            // 2. Consumir tu rutina existente para obtener el Base64
            string base64Data = await DriveService.GetFileAsync(fileId);

            // 3. Invocar al JavaScript para procesar el Blob y abrir la pestaña
            await jsRuntime.InvokeVoidAsync("abrirExcelBase64", base64Data, nombreDocumento);
        }
        catch (Exception ex)
        {
            // Manejo local de errores si la descarga falla o el ID no existe
            Console.WriteLine($"Error al abrir el Archivo: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task Detalle(DividendoPreliminar item)
    {
        idDividendo = item.Id;
        // mostrarDetalle = true;
        navManager.NavigateTo($"/dividendospreliminardetalle/{idDividendo}");
    }

    private void VerificarCerrar(DividendoPreliminar item)
    {
        entidadParaEliminar = item;
        mostrarModalActivar = true;
    }

    private void VerificarActivar(DividendoPreliminar item)
    {
        entidadParaEliminar = item;
        mostrarModalActivar = true;
    }

    private void CerrarModalActivar() => mostrarModalActivar = false;

    private async Task ConfirmarActivar()
    {
        string mensaje = "";
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                var listAaccionista = await repoaccionista.GetAllAsync();
                var listMoneda = await repomoneda.GetAllAsync();

                List<DividendoPreliminarDetalle> dividendodetalle = await repository.GetDetalleByIdAsync(entidadParaEliminar.Id);

                List<DividendoDefinitivoDetalle> listadetalle = new();
                foreach (DividendoPreliminarDetalle item in dividendodetalle)
                {
                    Moneda moneda = listMoneda.FirstOrDefault(x => x.Simbolo == item.MonedaPago);
                    if (moneda == null)
                    {
                        mensaje += $"No se encontró la moneda {item.MonedaPago} para el accionista {item.NombreAccionista}.";
                    }
                    else
                    {
                        string[] documento = item.Rif.Split('-');
                        Accionista accionista = listAaccionista.FirstOrDefault(x => x.TipoDocumento1?.Nombre == documento[0] && x.Documento1 == documento[1].Replace(".", "").Replace(",", ","));
                        if (accionista == null)
                        {
                            mensaje += $"No se encontró el accionista con cédula {item.Rif}.";
                        }
                        else
                        {                            
                            listadetalle.Add(new DividendoDefinitivoDetalle
                            {
                                Accionista = accionista,
                                Moneda = moneda,
                                DividendoDefinitivoId = 0,
                                TipoPago = item.TipoPago,
                                Notificado = item.Notificado,
                                FechaNotificacion = item.FechaNotificacion,
                                MontoDecretado = item.MontoDecretado,
                                FechaDecreto = item.FechaDecreto,
                                MontoRetenido = item.MontoRetenido,
                                EjercicioFiscal = item.EjercicioFiscal,
                                Porcion1Monto = item.Porcion1Monto,
                                Porcion1Porcentaje = item.Porcion1Porcentaje,
                                Porcion1FechaPago = item.Porcion1FechaPago,
                                Porcion2Monto = item.Porcion2Monto,
                                Porcion2Porcentaje = item.Porcion2Porcentaje,
                                Porcion2FechaPago = item.Porcion2FechaPago,
                                Porcion3Monto = item.Porcion3Monto,
                                Porcion3Porcentaje = item.Porcion3Porcentaje,
                                Porcion3FechaPago = item.Porcion3FechaPago,
                                Porcion4Monto = item.Porcion4Monto,
                                Porcion4Porcentaje = item.Porcion4Porcentaje,
                                Porcion4FechaPago = item.Porcion4FechaPago,
                                Observaciones = item.Observaciones,
                                SoporteEnviadoP1 = item.SoporteEnviadoP1,
                                SoporteFechaP1 = item.SoporteFechaP1,
                                SoporteEnviadoP2 = item.SoporteEnviadoP2,
                                SoporteFechaP2 = item.SoporteFechaP2,
                                SoporteEnviadoP3 = item.SoporteEnviadoP3,
                                SoporteFechaP3 = item.SoporteFechaP3,
                                SoporteEnviadoP4 = item.SoporteEnviadoP4,
                                SoporteFechaP4 = item.SoporteFechaP4,
                                CreateDate = DateTime.Now,
                                CreateUserId = int.Parse(useridaux.Value)
                            });
                        }
                    }
                }

                if (!string.IsNullOrEmpty(mensaje))
                {
                    cargando = false;
                    StateHasChanged();
                    await MostrarNotificacion(mensaje, true);
                    return;
                }

                int userid = int.Parse(useridaux.Value);
                DividendoDefinitivo entidad = new();
                entidad.Sociedad = entidadParaEliminar.Sociedad;
                entidad.Explicacion = entidadParaEliminar.Explicacion;
                entidad.CreateDate = DateTime.Now;
                entidad.CreateUserId = userid;
                entidad.MontoPagadoAccionistas = entidadParaEliminar.MontoPagadoAccionistas;
                entidad.MontoPagadoTesoreria = entidadParaEliminar.MontoPagadoTesoreria;
                entidad.NombreActa = entidadParaEliminar.NombreActa;
                entidad.NombreDividendos = entidadParaEliminar.NombreDividendos;
                entidad.NombreDocumento = entidadParaEliminar.NombreDocumento;
                entidad.Observaciones = entidadParaEliminar.Observaciones;
                entidad.RutaActa = entidadParaEliminar.RutaActa;
                entidad.RutaDividendos = entidadParaEliminar.RutaDividendos;
                entidad.RutaDocumento = entidadParaEliminar.RutaDocumento;

                int newId = await repodefinitivo.CreateAsync(entidad);
                listadetalle.ForEach(x => x.DividendoDefinitivoId = newId);
                await repodefinitivo.CreateDetalleAsync(listadetalle);

                repository.Delete(entidadParaEliminar.Id);

                mostrarModalActivar = false;
                await MostrarNotificacion($"");
                await LoadGenericDataAsync();
                await MostrarNotificacion($"Proceso cerrado correctamente");
            }
            else
            {
                cargando = false;
                StateHasChanged();
                await MostrarNotificacion("No se pudo procesar el registro", true);
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al activar: {ex.Message}");
            await MostrarNotificacion("No se pudo procesar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }
}