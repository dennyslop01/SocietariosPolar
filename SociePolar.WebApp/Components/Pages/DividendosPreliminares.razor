@page "/dividendospreliminares"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-calculator text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Dividendos Preliminares
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>

                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Barra de Filtros Rápidos, Búsqueda y Conteo -->
            <div class="row g-2 align-items-center mb-3">
                <!-- Filtro por Sociedad -->
                <div class="col-md-3">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-building"></i>
                        </span>
                        <select class="form-select border-start-0" @bind="filtroSociedadId" @bind:after="AplicarFiltrosYOrden">
                            <option value="0">Todas las Sociedades (@listaSociedadesFiltro.Count)</option>
                            @foreach (var soc in listaSociedadesFiltro)
                            {
                                <option value="@soc.Id">@soc.Empresa?.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Filtro por Año -->
                <div class="col-md-2">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-calendar3"></i>
                        </span>
                        <select class="form-select border-start-0" @bind="filtroAno" @bind:after="AplicarFiltrosYOrden">
                            <option value="0">Todos los Años</option>
                            @foreach (var ano in listaAnosFiltro)
                            {
                                <option value="@ano">Año @ano</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Buscador Multicriterio -->
                <div class="col-md-4">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por sociedad, explicación, año..."
                               value="@searchTerm"
                               @oninput="FiltrarBusqueda" />
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="() => { searchTerm = string.Empty; AplicarFiltrosYOrden(); }">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Botón Limpiar y Conteo -->
                <div class="col-md-3 text-end d-flex align-items-center justify-content-end gap-2">
                    @if (filtroSociedadId > 0 || filtroAno > 0 || !string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" @onclick="LimpiarFiltros" title="Restablecer filtros">
                            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
                        </button>
                    }
                    <span class="badge bg-light text-dark border px-2 py-1 small">
                        @Listgral.Count de @ListgralBuscar.Count decretos
                    </span>
                </div>
            </div>

            <PaginationComponent TItem="DividendoPreliminar" Items="Listgral" DefaultPageSize="50" TableClass="polar-table-compact">
                <ChildContentHeader>
                    <tr class="table-light border-bottom text-nowrap">
                        <th class="polar-sticky-col-1 text-center user-select-none" style="width: 50px; min-width: 50px; cursor: pointer;" @onclick='() => OrdenarPor("Id")' title="Ordenar por #">
                            <div class="d-flex align-items-center justify-content-center gap-1">
                                <span>#</span>
                                <i class="bi @(columnaOrden == "Id" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="polar-sticky-col-2 text-start user-select-none" style="min-width: 250px; max-width: 290px; cursor: pointer;" @onclick='() => OrdenarPor("Sociedad")' title="Ordenar por Sociedad">
                            <div class="d-flex align-items-center justify-content-between">
                                <span>Sociedad</span>
                                <i class="bi @(columnaOrden == "Sociedad" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="text-center" style="min-width: 80px;">Moneda</th>
                        <th class="text-start" style="min-width: 180px;">Explicación</th>
                        <th class="text-start" style="min-width: 160px;">Nombre Dividendos</th>
                        <th class="text-start" style="min-width: 160px;">Ruta Acta</th>
                        <th class="text-start" style="min-width: 160px;">Doc. Secundario</th>
                        <th class="text-start" style="min-width: 150px;">Observaciones</th>
                        <th class="polar-num user-select-none" style="min-width: 130px; cursor: pointer;" @onclick='() => OrdenarPor("Tesoreria")' title="Ordenar por Tesorería">
                            <div class="d-flex align-items-center justify-content-end gap-1">
                                <span>Tesorería</span>
                                <i class="bi @(columnaOrden == "Tesoreria" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="polar-num user-select-none" style="min-width: 130px; cursor: pointer;" @onclick='() => OrdenarPor("Accionistas")' title="Ordenar por Accionistas">
                            <div class="d-flex align-items-center justify-content-end gap-1">
                                <span>Accionistas</span>
                                <i class="bi @(columnaOrden == "Accionistas" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="polar-num user-select-none" style="min-width: 130px; cursor: pointer;" @onclick='() => OrdenarPor("Diferencia")' title="Ordenar por Diferencia">
                            <div class="d-flex align-items-center justify-content-end gap-1">
                                <span>Diferencia</span>
                                <i class="bi @(columnaOrden == "Diferencia" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="polar-num user-select-none" style="min-width: 140px; cursor: pointer;" @onclick='() => OrdenarPor("TotalRepartir")' title="Ordenar por Total a Repartir">
                            <div class="d-flex align-items-center justify-content-end gap-1">
                                <span>Total a Repartir</span>
                                <i class="bi @(columnaOrden == "TotalRepartir" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="polar-date user-select-none" style="min-width: 110px; cursor: pointer;" @onclick='() => OrdenarPor("Fecha")' title="Ordenar por Fecha">
                            <div class="d-flex align-items-center justify-content-center gap-1">
                                <span>Fecha</span>
                                <i class="bi @(columnaOrden == "Fecha" ? (ordenAscendente ? "bi-arrow-up text-primary fw-bold" : "bi-arrow-down text-primary fw-bold") : "bi-arrow-down-up opacity-25")"></i>
                            </div>
                        </th>
                        <th class="text-end pe-3" style="width: 110px; min-width: 110px;">Acciones</th>
                    </tr>
                </ChildContentHeader>
                <ChildContentRow Context="p">
                    <tr class="align-middle border-bottom">
                        <td class="polar-sticky-col-1 text-center fw-semibold text-secondary">@p.Id</td>
                        <td class="polar-sticky-col-2 text-start fw-semibold text-dark">
                            <div class="d-flex align-items-center gap-1">
                                <span class="polar-truncate" style="max-width: 185px;" title="@p.Sociedad?.Empresa?.Nombre">
                                    @p.Sociedad?.Empresa?.Nombre
                                </span>
                                <span class="badge bg-light text-secondary border small px-1 py-0" style="font-size: 0.72rem;" title="Año del Decreto: @p.CreateDate.Year">
                                    @p.CreateDate.Year
                                </span>
                            </div>
                        </td>
                        <td class="text-center text-secondary small">@(p.Moneda?.Nombre ?? p.Moneda?.Simbolo ?? "-")</td>
                        <td class="text-start text-secondary">
                            <span class="polar-truncate" style="max-width: 220px;" title="@p.Explicacion">
                                @p.Explicacion
                            </span>
                        </td>
                        <td class="text-start align-middle">
                            @if (!string.IsNullOrWhiteSpace(p.RutaDividendos))
                            {
                                <button type="button"
                                        class="btn btn-link text-primary small p-0 border-0 bg-transparent text-start d-inline-flex align-items-center gap-1"
                                        @onclick="() => VisualizarExcelAsync(p.RutaDividendos, p.NombreDividendos)"
                                        @onclick:preventDefault
                                        title="Abrir archivo: @p.NombreDividendos">
                                    <i class="bi bi-file-earmark-excel text-success"></i>
                                    <span class="polar-truncate text-decoration-underline" style="max-width: 140px;">
                                        @p.NombreDividendos
                                    </span>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small polar-truncate" style="max-width: 150px;" title="@p.NombreDividendos">
                                    @(string.IsNullOrWhiteSpace(p.NombreDividendos) ? "-" : p.NombreDividendos)
                                </span>
                            }
                        </td>
                        <td class="text-start align-middle">
                            @if (!string.IsNullOrWhiteSpace(p.RutaActa))
                            {
                                <button type="button"
                                        class="btn btn-link text-primary small p-0 border-0 bg-transparent text-start d-inline-flex align-items-center gap-1"
                                        @onclick="() => VisualizarDocumentoAsync(p.RutaActa, p.NombreActa)"
                                        @onclick:preventDefault
                                        title="Abrir acta: @p.NombreActa">
                                    <i class="bi bi-file-earmark-pdf text-danger"></i>
                                    <span class="polar-truncate text-decoration-underline" style="max-width: 140px;">
                                        @p.NombreActa
                                    </span>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small polar-truncate" style="max-width: 150px;" title="@p.NombreActa">
                                    @(string.IsNullOrWhiteSpace(p.NombreActa) ? "-" : p.NombreActa)
                                </span>
                            }
                        </td>
                        <td class="text-start align-middle">
                            @if (!string.IsNullOrWhiteSpace(p.RutaDocumento))
                            {
                                <button type="button"
                                        class="btn btn-link text-primary small p-0 border-0 bg-transparent text-start d-inline-flex align-items-center gap-1"
                                        @onclick="() => VisualizarDocumentoAsync(p.RutaDocumento, p.NombreDocumento)"
                                        @onclick:preventDefault
                                        title="Abrir soporte: @p.NombreDocumento">
                                    <i class="bi bi-file-earmark-pdf text-danger"></i>
                                    <span class="polar-truncate text-decoration-underline" style="max-width: 140px;">
                                        @p.NombreDocumento
                                    </span>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small polar-truncate" style="max-width: 150px;" title="@p.NombreDocumento">
                                    @(string.IsNullOrWhiteSpace(p.NombreDocumento) ? "-" : p.NombreDocumento)
                                </span>
                            }
                        </td>
                        <td class="text-start text-secondary">
                            <span class="polar-truncate" style="max-width: 160px;" title="@p.Observaciones">
                                @(string.IsNullOrWhiteSpace(p.Observaciones) ? "-" : p.Observaciones)
                            </span>
                        </td>
                        <td class="polar-num text-secondary">@((p.MontoPagadoTesoreria ?? 0).ToString("N2"))</td>
                        <td class="polar-num text-secondary">@((p.MontoPagadoAccionistas ?? 0).ToString("N2"))</td>
                        <td class="polar-num fw-semibold @(((p.MontoPagadoTesoreria ?? 0) - (p.MontoPagadoAccionistas ?? 0)) != 0 ? "text-danger" : "text-muted")">
                            @(((p.MontoPagadoTesoreria ?? 0) - (p.MontoPagadoAccionistas ?? 0)).ToString("N2"))
                        </td>
                        <td class="polar-num text-dark fw-bold">@((p.MontoTotalRepartir ?? 0).ToString("N2"))</td>
                        <td class="polar-date text-secondary">@p.CreateDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end pe-3 text-nowrap">
                            @if (idRol == 1 || idRol == 2)
                            {
                                <button class="btn btn-link btn-sm text-success p-0 me-2"
                                        @onclick="() => VerificarCerrar(p)" title="Cerrar Proceso">
                                    <i class="bi bi-check2-circle fs-6"></i>
                                </button>
                                <button class="btn btn-link btn-sm text-secondary p-0 me-2"
                                        @onclick="() => Detalle(p)" title="Detalle Archivo">
                                    <i class="bi bi-file-earmark-text fs-6"></i>
                                </button>
                                <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                    <i class="bi bi-trash3 fs-6"></i>
                                </button>
                            }
                        </td>
                    </tr>
                </ChildContentRow>
            </PaginationComponent>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}


@if (mostrarModal)
{
    <DividendosPreliminarGuardar id="0" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Explicacion</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalActivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-secondary fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a cerrar este proceso, <strong>@entidadParaEliminar?.Explicacion</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalActivar">Cancelar</button>
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="ConfirmarActivar">Procesar</button>
                </div>
            </div>
        </div>
    </div>
}

@* @if(mostrarDetalle)
{
    <DividendosPreliminarDetalle id="@idDividendo" OnFinalizado="() => mostrarDetalle = false" />
} *@

@code {

    private List<DividendoPreliminar> Listgral = new();
    private List<DividendoPreliminar> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private DividendoPreliminar? entidadParaEliminar;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private int idRol = 0;
    // private bool mostrarDetalle = false;
    private Int32 idDividendo = 0;
    private bool mostrarModalActivar = false;

    // Estados para Filtros y Ordenamiento
    private int filtroSociedadId = 0;
    private int filtroAno = 0;
    private string columnaOrden = "Fecha";
    private bool ordenAscendente = false; // Más recientes primero por defecto
    private List<Sociedad> listaSociedadesFiltro = new();
    private List<int> listaAnosFiltro = new();

    [Inject] private IDividendoPreliminar repository { get; set; } = null!;
    [Inject] private IDividendoDefinitivo repodefinitivo { get; set; } = null!;
    [Inject] private IAccionista repoaccionista { get; set; } = null!;
    [Inject] private IMoneda repomoneda { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
            {
                if (int.TryParse(userrolaux.Value, out var rolVal))
                {
                    idRol = rolVal;
                }
            }
        }
        catch
        {
            // Silencioso en prerenderizado SSR: JSInterop (SessionStorage) requiere circuito interactivo
        }
        await LoadGenericDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
                {
                    if (int.TryParse(userrolaux.Value, out var rolVal) && idRol != rolVal)
                    {
                        idRol = rolVal;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error hidratando rol en AfterRender: {ex.Message}");
            }
        }
    }


    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var data = await repository.GetAllAsync();
            ListgralBuscar = data;

            // Extraer sociedades únicas para el dropdown
            listaSociedadesFiltro = data
                .Where(x => x.Sociedad?.Empresa != null)
                .Select(x => x.Sociedad!)
                .GroupBy(s => s.Id)
                .Select(g => g.First())
                .OrderBy(s => s.Empresa?.Nombre)
                .ToList();

            // Extraer años únicos para el dropdown
            listaAnosFiltro = data
                .Select(x => x.CreateDate.Year)
                .Where(y => y > 1900)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();

            AplicarFiltrosYOrden();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarFiltrosYOrden()
    {
        IEnumerable<DividendoPreliminar> consulta = ListgralBuscar;

        // 1. Filtro por Sociedad
        if (filtroSociedadId > 0)
        {
            consulta = consulta.Where(x => x.Sociedad?.Id == filtroSociedadId);
        }

        // 2. Filtro por Año
        if (filtroAno > 0)
        {
            consulta = consulta.Where(x => x.CreateDate.Year == filtroAno);
        }

        // 3. Buscador Multicriterio
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            consulta = consulta.Where(x =>
                (x.Sociedad?.Empresa?.Nombre != null && x.Sociedad.Empresa.Nombre.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (x.Explicacion != null && x.Explicacion.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (x.NombreDividendos != null && x.NombreDividendos.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (x.Observaciones != null && x.Observaciones.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                x.CreateDate.ToString("yyyy").Contains(term) ||
                x.CreateDate.ToString("dd/MM/yyyy").Contains(term) ||
                x.Id.ToString().Contains(term)
            );
        }

        // 4. Ordenamiento por Columna
        consulta = (columnaOrden, ordenAscendente) switch
        {
            ("Id", true) => consulta.OrderBy(x => x.Id),
            ("Id", false) => consulta.OrderByDescending(x => x.Id),
            ("Sociedad", true) => consulta.OrderBy(x => x.Sociedad?.Empresa?.Nombre).ThenByDescending(x => x.CreateDate),
            ("Sociedad", false) => consulta.OrderByDescending(x => x.Sociedad?.Empresa?.Nombre).ThenByDescending(x => x.CreateDate),
            ("Fecha", true) => consulta.OrderBy(x => x.CreateDate),
            ("Fecha", false) => consulta.OrderByDescending(x => x.CreateDate),
            ("TotalRepartir", true) => consulta.OrderBy(x => x.MontoTotalRepartir ?? 0),
            ("TotalRepartir", false) => consulta.OrderByDescending(x => x.MontoTotalRepartir ?? 0),
            ("Tesoreria", true) => consulta.OrderBy(x => x.MontoPagadoTesoreria ?? 0),
            ("Tesoreria", false) => consulta.OrderByDescending(x => x.MontoPagadoTesoreria ?? 0),
            ("Accionistas", true) => consulta.OrderBy(x => x.MontoPagadoAccionistas ?? 0),
            ("Accionistas", false) => consulta.OrderByDescending(x => x.MontoPagadoAccionistas ?? 0),
            ("Diferencia", true) => consulta.OrderBy(x => (x.MontoPagadoTesoreria ?? 0) - (x.MontoPagadoAccionistas ?? 0)),
            ("Diferencia", false) => consulta.OrderByDescending(x => (x.MontoPagadoTesoreria ?? 0) - (x.MontoPagadoAccionistas ?? 0)),
            _ => consulta.OrderByDescending(x => x.CreateDate)
        };

        Listgral = consulta.ToList();
        StateHasChanged();
    }

    private void AbrirModalNuevo()
    {
        mostrarModal = true;
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        AplicarFiltrosYOrden();
    }

    private void OrdenarPor(string columna)
    {
        if (columnaOrden == columna)
        {
            ordenAscendente = !ordenAscendente;
        }
        else
        {
            columnaOrden = columna;
            ordenAscendente = (columna == "Sociedad" || columna == "Id");
        }
        AplicarFiltrosYOrden();
    }

    private void LimpiarFiltros()
    {
        filtroSociedadId = 0;
        filtroAno = 0;
        searchTerm = "";
        columnaOrden = "Fecha";
        ordenAscendente = false;
        AplicarFiltrosYOrden();
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void VerificarEliminar(DividendoPreliminar item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        StateHasChanged();
        try
        {
            string oldFileId = entidadParaEliminar.RutaDividendos!.Split('/').Last();
            await DriveService.TrashPdfFileByIdAsync(oldFileId);

            oldFileId = entidadParaEliminar.RutaActa!.Split('/').Last();
            await DriveService.TrashPdfFileByIdAsync(oldFileId);

            if (!string.IsNullOrEmpty(entidadParaEliminar.NombreDividendos))
            {
                oldFileId = entidadParaEliminar.RutaDividendos!.Split('/').Last();
                await DriveService.TrashPdfFileByIdAsync(oldFileId);
            }
            if(!string.IsNullOrEmpty(entidadParaEliminar.NombreActa))
            {
                oldFileId = entidadParaEliminar.RutaActa!.Split('/').Last();
                await DriveService.TrashPdfFileByIdAsync(oldFileId);
            }
            if (!string.IsNullOrEmpty(entidadParaEliminar.NombreDocumento))
            {
                oldFileId = entidadParaEliminar.RutaDocumento!.Split('/').Last();
                await DriveService.TrashPdfFileByIdAsync(oldFileId);
            }

            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Dividendo Preliminar eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Dividendo Preliminar guardado correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    // Método para obtener el enlace de Google Drive
    private async Task VisualizarDocumentoAsync(string rutaCompleta, string nombreDocumento)
    {
        cargando = true;
        StateHasChanged();
        try
        {
            // 1. Extraer el fileId real desde tu string (ej. "carpetaId/archivoId")
            string fileId = rutaCompleta.Split('/').Last();

            // 2. Consumir tu rutina existente para obtener el Base64
            string base64Data = await DriveService.GetFileAsync(fileId);

            // 3. Invocar al JavaScript para procesar el Blob y abrir la pestaña
            await jsRuntime.InvokeVoidAsync("abrirPdfBase64", base64Data, nombreDocumento);
        }
        catch (Exception ex)
        {
            // Manejo local de errores si la descarga falla o el ID no existe
            Console.WriteLine($"Error al abrir el Archivo: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

