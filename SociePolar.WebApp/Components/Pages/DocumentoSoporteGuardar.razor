<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnValidSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @( (int.TryParse(id, out var parsedId) && parsedId > 0) ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @( (int.TryParse(id, out var pId) && pId > 0) ? "Modificar Documento Soporte" : "Agregar Documento Soporte")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Iniciamos la grilla de filas y columnas -->
                    <div class="row">
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tipo Documento</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="@entidadEditando.TipoDocumentoSoporteId">
                                <option value="0">Seleccione ...</option>
                                @if (listTipoDocs != null)
                                {
                                    @foreach (var tipo in listTipoDocs)
                                    {
                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => entidadEditando.TipoDocumentoSoporteId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <label for="fileInput"
                                   class="form-label fw-bold btn btn-primary btn-sm"
                                   style="font-size: 12px; cursor: @(esInvalido ? "not-allowed" : "pointer"); pointer-events: @(esInvalido ? "none" : "auto");">
                                Seleccionar archivo PDF
                            </label>

                            <InputFile id="fileInput"
                                       class="small"
                                       OnChange="UploadFile"
                                       accept=".pdf"
                                       capture="camera"
                                       style="display:none;"
                                       disabled="@esInvalido" />

                            <label class="form-label fw-bold text-secondary small">@fileName</label>
                            <ValidationMessage For="@(() => entidadEditando.RutaGoogle)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Nombre Documento</label>
                            <input type="text" class="form-control form-control-sm small"
                                   @bind="entidadEditando.NombreDocumento"
                                   placeholder="Ingrese nombre del documento..."
                                   maxlength="100" />
                            <ValidationMessage For="@(() => entidadEditando.NombreDocumento)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Comentarios</label>
                            <textarea class="form-control form-control-sm small"
                                      @bind="entidadEditando.Comentarios"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Ingrese los comentarios (máximo 2,000 caracteres)...">
                                </textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(mensajeAlerta))
                        {
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-danger small">@mensajeAlerta</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>Guardar</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando || guardando)
{
    <ModalCargando />
}

@code {
    [Parameter] public string id { get; set; } = "";
    [Parameter] public string ModuloId { get; set; } = "";
    [Parameter] public string ReferenciaId { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = true;
    private bool guardando = false;
    bool esInvalido = false;
    private string? fileName = null;

    private DocumentoModuloDto entidadEditando = new();
    private List<TipoDocumentoSoporte> listTipoDocs = new();
    private List<DocumentoModulo> Listgral = new();

    private EditContext editContext = new(new DocumentoModuloDto());
    private ValidationMessageStore? mensajeStore;
    Stream streamToUpload;

    [Inject] private ITipoDocumentoSoporte repositoryTipoDocs { get; set; } = null!;
    [Inject] private IDocumentoModulo repository { get; set; } = null!;

    public class Modulos
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    public List<Modulos> ListModulos = new List<Modulos>
    {
        new Modulos { Id = 1, Nombre = "Sociedades" },
        new Modulos { Id = 2, Nombre = "Autoridades" },
        new Modulos { Id = 3, Nombre = "Asambleas" },
        new Modulos { Id = 4, Nombre = "Reformas" },
        new Modulos { Id = 5, Nombre = "Certificaciones" },
        new Modulos { Id = 6, Nombre = "Libros" },
        new Modulos { Id = 7, Nombre = "Accionistas" },
        new Modulos { Id = 8, Nombre = "Títulos" },
    };

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            await LoadGenericDataAsync();

            if (id == "0" || string.IsNullOrEmpty(id))
            {
                entidadEditando = new()
                {
                    ReferenciaId = int.TryParse(ReferenciaId, out var refId) ? refId : 0,
                    TipoDocumentoSoporteId = 0,
                    CreateDate = DateTime.Now
                };
            }

            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar documento soporte: {ex.Message}");
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LoadGenericDataAsync()
    {
        int modId = int.TryParse(ModuloId, out var mId) ? mId : 0;
        int entityId = int.TryParse(id, out var eId) ? eId : 0;

        Listgral = await repository.GetByModuloIdAsync(modId, entityId);

        listTipoDocs = await repositoryTipoDocs.GetAllAsync();
        listTipoDocs = listTipoDocs.Where(x => x.ModuloId == modId).OrderBy(x => x.Nombre).ToList();
        listTipoDocs = listTipoDocs.Where(x => !Listgral.Any(d => d.TipoDocumentoSoporte?.Id == x.Id)).ToList();
        listTipoDocs = listTipoDocs.OrderBy(x => x.Nombre).ToList();
    }

    private string ObtenerModulo(int idmodulo)
    {
        return ListModulos.Where(m => m.Id == idmodulo).Select(m => m.Nombre).FirstOrDefault() ?? "Desconocido";
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task UploadFile(InputFileChangeEventArgs e) // Cambiado a UploadFile
    {
        fileName = string.Empty;
        entidadEditando.RutaGoogle = null; // Limpiamos la ruta anterior si se selecciona un nuevo archivo
        mensajeAlerta = string.Empty;
        mostrarAlerta = false;

        var file = e.File;
        if (file == null) return;

        try
        {
            string contentType = file.ContentType;
            if (contentType == "application/pdf")
            {
                var memoryStream = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
                memoryStream.Position = 0;
                streamToUpload = memoryStream;
                fileName = e.File.Name;
                entidadEditando.RutaGoogle = e.File.Name;
                StateHasChanged();
            }
            else
            {
                mensajeAlerta = "Formato no soportado. Solo pdf.";/* imágenes y  */
                mostrarAlerta = true;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            mostrarAlerta = true;
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task GuardarCambios()
    {
        if (guardando) return;
        mensajeAlerta = string.Empty;
        guardando = true;
        StateHasChanged();

        bool formularioValido = editContext.Validate();
        if (!formularioValido)
        {
            guardando = false;
            StateHasChanged();
            await MostrarNotificacion("Por favor complete los campos requeridos marcados en rojo", true);
            await jsRuntime.InvokeVoidAsync("eval", @"
                var m = document.querySelector('.modal-body') || document.querySelector('.modal');
                if (m) {
                    m.scrollTop = 0;
                    try { m.scrollTo({ top: 0, behavior: 'smooth' }); } catch(e) {}
                }
                var firstInput = document.querySelector('.modal select, .modal input');
                if (firstInput) {
                    try { firstInput.focus(); } catch(e) {}
                    firstInput.classList.remove('pulse-invalid-field');
                    void firstInput.offsetWidth;
                    firstInput.classList.add('pulse-invalid-field');
                }
            ");
            return;
        }

        // Validación previa para evitar que el stream falle
        if (streamToUpload == null)
        {
            await MostrarNotificacion("Debe seleccionar un archivo PDF válido antes de guardar.", true);
            guardando = false;
            StateHasChanged();
            return;
        }

        try
        {
            string folderName = $"{ObtenerModulo(int.Parse(ModuloId))}_ID_{ReferenciaId}";

            // Formateamos el nombre de manera segura sin alterar destructivamente la propiedad original permanentemente si falla
            string nombreLimpio = entidadEditando.NombreDocumento.Replace(" ", "_").Replace("/", "_").Replace("\\", "_");

            // Evitamos concatenar ".pdf" múltiples veces si ya lo tiene
            if (!nombreLimpio.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                nombreLimpio = nombreLimpio + $"_{DateTime.Now:yyyyMMdd}.pdf";
            }

            if (!string.IsNullOrEmpty(folderName))
            {
                string folderId = await DriveService.CreateFolderAsync(folderName);

                // IMPORTANTE: NO uses 'using(streamToUpload)'. Deja que Blazor maneje el ciclo de vida
                // o ciérralo manualmente AL FINAL de todo el proceso exitoso.
                string fileIdResult = await DriveService.UploadFileAsync(streamToUpload, nombreLimpio, "application/pdf", folderId);
                entidadEditando.RutaGoogle = $"{folderId}/{fileIdResult}";
            }
        }
        catch (Exception ex)
        {
            guardando = false;
            StateHasChanged();
            await MostrarNotificacion("Error al subir a Google Drive: " + ex.Message, true);
            return;
        }

        if (string.IsNullOrEmpty(entidadEditando.RutaGoogle))
        {
            await MostrarNotificacion("No se pudo obtener la ruta de Google Drive.", true);
            guardando = false;
            StateHasChanged();
            return;
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (useridaux.Success && !string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);
                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    // Liberar el stream de forma segura ahora que el proceso completo terminó bien
                    await streamToUpload.DisposeAsync();

                    await OnFinalizado.InvokeAsync(true);
                }
            }
            else
            {
                // Corrección: Si no encuentra el usuario, debe apagar el cargando para no congelar la pantalla
                await MostrarNotificacion("Error: No se pudo identificar la sesión del usuario.", true);
                guardando = false;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            guardando = false;
            StateHasChanged();
            Console.WriteLine($"Error en Base de Datos: {ex.Message}");
            await MostrarNotificacion("Error al guardar en la base de datos: " + ex.Message, true);
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

}

