@page "/documentossoporte/{idModulo}/{id}"

@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-file-earmark-pdf text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Documentos Requeridos para Soporte (@ObtenerModulo(int.Parse(idModulo)))
                    </h5>
                </div>

                <!-- Botón Agregar -->
                <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="AbrirModalNuevo"
                        style="height: 32px; font-weight: 500;">
                    <i class="bi bi-plus-lg me-2"></i> Agregar
                </button>

                <!-- Botón Regresar -->
                <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="Regresar"
                        style="height: 32px; font-weight: 500;">
                    <i class="bi bi-arrow-return-left me-2"></i> Regresar
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="DocumentoModulo" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Nombre Documento</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Ruta Documento</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 20%; font-size: 0.85rem;">Comentarios</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 5%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="text-start text-secondary small" style="width: 5%;">@p.Id</td>
                            <td class="text-start text-secondary small" style="width: 20%;">@p.TipoDocumentoSoporte!.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.RutaGoogle</td>
                            <td class="text-start text-secondary small" style="width: 20%;">@p.Comentarios</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 5%;">
                                @* <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                    <i class="bi bi-pencil-square fs-6"></i>
                                </button> *@
                                <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                    <i class="bi bi-trash3 fs-6"></i>
                                </button>
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}


@if (mostrarModal)
{
    <DocumentoSoporteGuardar ModuloId="@idModulo" ReferenciaId="@id" id="0" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.TipoDocumentoSoporte!.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}



@code {
    [Parameter] public string idModulo { get; set; } = "";
    [Parameter] public string id { get; set; } = "";

    private List<DocumentoModulo> Listgral = new();
    private List<DocumentoModulo> ListgralBuscar = new();
    private string searchTerm = ""; private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private bool mostrarModalEliminar = false;
    private DocumentoModulo? entidadParaEliminar;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";

    [Inject] private IDocumentoModulo repository { get; set; } = null!;

    public class Modulos
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    public List<Modulos> ListModulos = new List<Modulos>
    {
        new Modulos { Id = 1, Nombre = "Sociedades" },
        new Modulos { Id = 2, Nombre = "Autoridades" },
        new Modulos { Id = 3, Nombre = "Asambleas" },
        new Modulos { Id = 4, Nombre = "Reformas" },
        new Modulos { Id = 5, Nombre = "Certificaciones" },
        new Modulos { Id = 6, Nombre = "Libros" },
        new Modulos { Id = 7, Nombre = "Accionistas" },
        new Modulos { Id = 8, Nombre = "Títulos" },
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            Listgral = await repository.GetByModuloIdAsync(int.Parse(idModulo), int.Parse(id));
            Listgral = Listgral.OrderBy(x => x.TipoDocumentoSoporte!.Nombre).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        mostrarModal = true;
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.TipoDocumentoSoporte!.Nombre != null && b.TipoDocumentoSoporte!.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void VerificarEliminar(DocumentoModulo item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Documento Soporte eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Documento Soporte guardado correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    private string ObtenerModulo(int idmodulo)
    {
        return ListModulos.Where(m => m.Id == idmodulo).Select(m => m.Nombre).FirstOrDefault() ?? "Desconocido";
    }

    private async Task Regresar()
    {
        await jsRuntime.InvokeVoidAsync("history.back");
    }

}