@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
        <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                        @(entidadEditando.Id == 0 ? "Agregar Libro Societario" : "Modificar Libro Societario")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body py-4">
                    <!-- Iniciamos la grilla de filas y columnas -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Sociedad</label>
                            <div class="dropdown">
                                <!-- Removido -sm para igualar el tamaño estándar del label -->
                                <button class="form-select text-start d-flex justify-content-between align-items-center"
                                        type="button"
                                        style="font-size: 0.8rem;"
                                        @onclick="ToggleDropdown">
                                    <span>@(ObtenerNombreSeleccionado())</span>
                                </button>

                                <ul class="dropdown-menu w-100 p-2 @(isDropdownOpen ? "show" : "")"
                                    style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                    <li class="mb-2">
                                        <!-- Cambiado a form-control normal para que la fuente de "Buscar..." coincida en tamaño -->
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Buscar..."
                                               style="font-size: 0.8rem;"
                                               @bind="textoBusqueda"
                                               @bind:event="oninput"
                                               @ref="searchInputRef" />
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item @(entidadEditando.SociedadId == 0 ? "active bg-primary text-white" : "")"
                                                style="font-size: 0.8rem;"
                                                @onclick="() => SeleccionarOpción(0)">
                                            Seleccione ...
                                        </button>
                                    </li>

                                    <!-- Opciones filtradas dinámicamente -->
                                    @if (listSociedad != null)
                                    {
                                        @foreach (var sociedad in listSociedad.Where(s => string.IsNullOrEmpty(textoBusqueda) || s.Empresa.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <li>
                                                <!-- Se reemplazó 'small' por 'style="font-size: 0.8rem;"' para forzar la letra más pequeña -->
                                                <button type="button"
                                                        class="dropdown-item @(entidadEditando.SociedadId == sociedad.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarOpción(sociedad.Id)">
                                                    @sociedad.Empresa.Nombre
                                                </button>
                                            </li>
                                        }
                                    }

                                </ul>
                            </div>

                            <ValidationMessage For="@(() => entidadEditando.SociedadId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Clase Libro</label>
                            <select class="form-select form-select-sm" value="@entidadEditando.ClaseLibroId" @onchange="OnClaseLibroChanged">
                                <option value="0">Seleccione ...</option>
                                @if (listClaseLibro != null)
                                {
                                    @foreach (var claselibro in listClaseLibro)
                                    {
                                        <option value="@claselibro.Id">@claselibro.Nombre</option>
                                    }
                                }
                            </select>
                            <ValidationMessage For="@(() => entidadEditando.ClaseLibroId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tipo Libro</label>
                            <select class="form-select form-select-sm" value="@entidadEditando.TipoLibroId" @onchange="OnTipoLibroChanged">
                                <option value="0">Seleccione ...</option>
                                @if (listTipoLibro != null)
                                {
                                    @foreach (var tipolibro in listTipoLibro)
                                    {
                                        <option value="@tipolibro.Id">@tipolibro.Nombre</option>
                                    }
                                }
                            </select>
                            <ValidationMessage For="@(() => entidadEditando.TipoLibroId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Tomo</label>
                            <input type="text" class="form-control form-control-sm small"
                                   @bind="entidadEditando.TomoUso"
                                   placeholder="Ingrese el tomo de uso..."
                                   maxlength="3"
                                   inputmode="numeric"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                            <ValidationMessage For="@(() => entidadEditando.TomoUso)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Folio</label>
                            <input type="text" class="form-control form-control-sm small"
                                   @bind="entidadEditando.Folios"
                                   placeholder="Ingrese el folio..."
                                   maxlength="3"
                                   inputmode="numeric"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                            <ValidationMessage For="@(() => entidadEditando.Folios)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Fecha Desde</label>
                            <input type="date" class="form-control form-control-sm small"
                                   @bind="entidadEditando.FechaDesde" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Fecha Hasta</label>
                            <input type="date" class="form-control form-control-sm small"
                                   @bind="entidadEditando.FechaHasta" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold text-secondary small d-block">¿Esta Sellado?</label>

                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       name="aplicaReformaGroup"
                                       id="reformaSi"
                                       class="form-check-input"
                                       value="1"
                                       checked="@(entidadEditando.LibrosSellados == 1)"
                                       @onchange="() => ActualizarSello(1)" />
                                <label class="form-check-label small text-secondary" for="reformaSi">Sí</label>
                            </div>

                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       name="aplicaReformaGroup"
                                       id="reformaNo
                                       class="form-check-input"
                                       value="0"
                                       checked="@(entidadEditando.LibrosSellados == 0)"
                                       @onchange="() => ActualizarSello(0)" />
                                <label class="form-check-label small text-secondary" for="reformaNo">No</label>
                            </div>
                        </div>
                        @if (entidadEditando.LibrosSellados == 1)
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha de Sello</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.FechaSello" @bind:format="yyyy-MM-dd" />
                            </div>
                        }
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold text-secondary small d-block">¿Esta Vacío?</label>

                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       name="aplicaVacioGroup"
                                       id="vacioSi"
                                       class="form-check-input"
                                       value="1"
                                       checked="@(entidadEditando.Vacio == 1)"
                                       @onchange="() => ActualizarVacio(1)" />
                                <label class="form-check-label small text-secondary" for="vacioSi">Sí</label>
                            </div>

                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       name="aplicaVacioGroup"
                                       id="vacioNo"
                                       class="form-check-input"
                                       value="0"
                                       checked="@(entidadEditando.Vacio == 0)"
                                       @onchange="() => ActualizarVacio(0)" />
                                <label class="form-check-label small text-secondary" for="vacioNo">No</label>
                            </div>
                        </div>
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Ubicación</label>
                            <textarea class="form-control form-control-sm small"
                                      @bind="entidadEditando.Ubicacion"
                                      @bind:event="oninput"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Ingrese la ubicación (máximo 2,000 caracteres)...">
                                    </textarea>
                            <ValidationMessage For="@(() => entidadEditando.Ubicacion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                        <div class="col-md-10 mb-3">
                            <label class="form-label fw-bold text-secondary small">Observaciones</label>
                            <textarea class="form-control form-control-sm small"
                                      @bind="entidadEditando.Observaciones"
                                      @bind:event="oninput"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Ingrese las observaciones (máximo 2,000 caracteres)...">
                                    </textarea>
                            <ValidationMessage For="@(() => entidadEditando.Observaciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = false;

    private LibroSocietarioDto entidadEditando = new();

    private List<Sociedad> listSociedad = new();

    private List<IBaseEntity> listTipoLibro = new();
    private List<IBaseEntity> listClaseLibro = new();

    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    [Inject] private ISociedad reposociedad { get; set; } = null!;
    [Inject] private ILibroSocietario repository { get; set; } = null!;

    private bool isDropdownOpen = false;
    private string textoBusqueda = "";
    private ElementReference searchInputRef;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }

        await LoadGenericDataAsync();

        if (id == "0")
        {
            entidadEditando = new();
            entidadEditando.SociedadId = 0;
            entidadEditando.ClaseLibroId = 0;
            entidadEditando.TipoLibroId = 0;
            entidadEditando.LibrosSellados = 0;
            entidadEditando.Vacio = 0;
            entidadEditando.CreateDate = DateTime.Now;
            entidadEditando.UpdateDate = DateTime.Now;
            editContext = new EditContext(entidadEditando);
        }
        else
        {
            try
            {
                var item = await repository.GetByIdAsync(int.Parse(id));
                LibroSocietarioDto dto = new()
                {
                    Id = item.Id,
                    SociedadId = item.Sociedad.Id,
                    ClaseLibroId = item.ClaseLibro.Id,
                    TipoLibroId = item.TipoLibro.Id,
                    TomoUso = item.TomoUso,
                    Folios = item.Folios,
                    LibrosSellados = int.Parse(item.LibrosSellados ?? "0"),
                    Observaciones = item.Observaciones,
                    CreateDate = item.CreateDate,
                    CreateUserId = item.CreateUserId,
                    UpdateDate = item.UpdateDate,
                    UpdateUserId = item.UpdateUserId,
                    FechaDesde = item.FechaDesde,
                    FechaHasta = item.FechaHasta,
                    FechaSello = item.FechaSello,
                    Vacio = item.Vacio,
                    Ubicacion = item.Ubicacion
                };

                entidadEditando = dto;
                editContext = new EditContext(entidadEditando);
            }
            catch (Exception ex)
            {
                await MostrarNotificacion("No se pudieron cargar los datos", true);
            }
        }
        cargando = false;
    }

    public async Task<List<IBaseEntity>> GetEntityListAsync(string entityName)
    {
        var repo = RepoFactory.GetRepository(entityName);
        var method = repo.GetType().GetMethod("GetAllAsync");

        if (method == null) return new List<IBaseEntity>();

        // Invocamos el método asíncrono
        var task = (Task)method.Invoke(repo, null)!;
        await task;

        // Obtenemos el resultado de la Task dinámica
        var resultProperty = task.GetType().GetProperty("Result");
        var result = (IEnumerable<IBaseEntity>)resultProperty!.GetValue(task)!;

        return result.ToList();
    }

    private async Task LoadGenericDataAsync()
    {
        try
        {
            listClaseLibro = await GetEntityListAsync("claselibros");
            listTipoLibro = await GetEntityListAsync("tipolibros");

            var listSociedades = await reposociedad.GetAllAsync();
            listSociedad = listSociedades.OrderBy(x=> x.Empresa.Nombre).Where(x => x.EstatusSociedad.Id == 1).ToList();
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos", true);
        }
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task GuardarCambios()
    {
        mensajeAlerta = string.Empty;

        bool formularioValido = editContext.Validate();

        if (!formularioValido)
        {
            StateHasChanged();
            cargando = false;
            return;
        }

        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    cargando = true;
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Libro Societario guardado correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
                else
                {
                    cargando = true;
                    repository.Update(entidadEditando);

                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Libro Societario actualizado correctamente");
                    await OnFinalizado.InvokeAsync(true);
                }
            }
        }
        catch (Exception ex)
        {
            // Si hay error en base de datos (ej. nombre duplicado)
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        cargando = false;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void OnSociedadChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idSeleccionado))
        {
            entidadEditando.SociedadId = idSeleccionado;
        }
    }

    private void OnTipoLibroChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idSeleccionado))
        {
            entidadEditando.TipoLibroId = idSeleccionado;
        }
    }

    private void OnClaseLibroChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idSeleccionado))
        {
            entidadEditando.ClaseLibroId = idSeleccionado;
        }
    }

    private void ActualizarSello(int aplica)
    {
        entidadEditando.LibrosSellados = aplica;

        if (aplica == 0)
        {
            entidadEditando.FechaSello = null;
        }

        StateHasChanged();
    }

    private void ActualizarVacio(int aplica)
    {
        entidadEditando.Vacio = aplica;
        StateHasChanged();
    }

    // Alternar la apertura del menú desplegable
    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
        if (!isDropdownOpen)
        {
            textoBusqueda = ""; // Limpia la búsqueda al cerrar
        }
    }

    // Devuelve el texto del elemento seleccionado en el botón principal
    private string ObtenerNombreSeleccionado()
    {
        if (entidadEditando?.SociedadId == 0 || listSociedad == null)
        {
            return "Seleccione ...";
        }

        var seleccionado = listSociedad.FirstOrDefault(s => s.Id == entidadEditando.SociedadId);
        return seleccionado?.Empresa?.Nombre ?? "Seleccione ...";
    }

    // Asigna el ID real a tu modelo y cierra el menú
    private void SeleccionarOpción(int id)
    {
        entidadEditando.SociedadId = id;
        isDropdownOpen = false;
        textoBusqueda = ""; // Reinicia el filtro
    }
}

