@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-file-earmark-x text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Documentos Vencidos o por Vencer
                    </h5>
                </div>

            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="DocumentosVencidos" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Módulo</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Documento</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nro. Documento</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Nombre</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Fecha Vencimiento</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="ps-3" style="width: 5%;"><span class="text-muted small">@p.Id</span></td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Modulo</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Documento</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.NroDocumento</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.FechaVencimiento?.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                @* <button class="btn btn-link btn-sm text-secondary p-0 ms-2"
                                        @onclick="() => Detalle(p)" title="Detalle Sociedad">
                                    <i class="bi bi-file-earmark-text fs-6"></i>
                                </button> *@
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}

@code {
    private List<DocumentosVencidos> Listgral = new();
    private List<DocumentosVencidos> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";

    [Inject] private ISociedad repoSociedad { get; set; } = null!;
    [Inject] private IAccionista repoAccionista { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var listSociedades = await repoSociedad.GetAllAsync();
            listSociedades = listSociedades.OrderBy(x => x.Empresa.Nombre).Where(x => x.FechaVencimiento < DateTime.Now.AddDays(30)).ToList();            
            foreach (var item in listSociedades)
            {
                Listgral.Add(new DocumentosVencidos
                {
                    Id = item.Id,
                    Modulo = "Sociedades",
                    Documento = item.TipoDocumento1.Nombre,
                    NroDocumento = item.Documento1,
                    FechaVencimiento = item.FechaVencimiento,
                    Nombre = item.Empresa.Nombre
                });
            }

            var listAccionista = await repoAccionista.GetAllAsync();
            foreach (var item in listAccionista)
            {
                string documento = string.Empty;
                string nrodocumento = string.Empty;
                string nombreper = string.Empty;
                DateTime fechavencimiento =  DateTime.Now;

                if (item.FechaVencimiento1 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.Documento1;
                    nombreper = item.Nombre;
                    fechavencimiento = (DateTime)item.FechaVencimiento1;
                }
                if (item.FechaVencimiento2 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.Documento2;
                    fechavencimiento = (DateTime)item.FechaVencimiento2;
                    nombreper = item.Nombre;
                }
                if (item.FechaVencimiento3 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.Documento3;
                    nombreper = item.Nombre;
                    fechavencimiento = (DateTime)item.FechaVencimiento3;
                }
                if (item.FechaVencimiento4 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.Documento4;
                    nombreper = item.Nombre;
                    fechavencimiento = (DateTime)item.FechaVencimiento4;
                }
                if (item.FechaVencimientoApoderado1 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.DocumentoApoderado1;
                    nombreper = item.NombreApoderado;
                    fechavencimiento = (DateTime)item.FechaVencimientoApoderado1;
                }
                if (item.FechaVencimientoApoderado2 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.DocumentoApoderado2;
                    nombreper = item.NombreApoderado;
                    fechavencimiento = (DateTime)item.FechaVencimientoApoderado2;
                }
                if (item.FechaVencimientoApoderado3 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.DocumentoApoderado3;
                    nombreper = item.NombreApoderado;
                    fechavencimiento = (DateTime)item.FechaVencimientoApoderado3;
                }
                if (item.FechaVencimientoConyuge1 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.DocumentoConyuge1;
                    nombreper = item.NombreConyuge;
                    fechavencimiento = (DateTime)item.FechaVencimientoConyuge1;
                }
                if (item.FechaVencimientoConyuge2 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.DocumentoConyuge2;
                    nombreper = item.NombreConyuge;
                    fechavencimiento = (DateTime)item.FechaVencimientoConyuge2;
                }
                if (item.FechaVencimientoConyuge3 < DateTime.Now.AddDays(30))
                {
                    documento = "Cédula";
                    nrodocumento = item.DocumentoConyuge3;
                    nombreper = item.NombreConyuge;
                    fechavencimiento = (DateTime)item.FechaVencimientoConyuge3;
                }
                if (!string.IsNullOrEmpty(documento))
                {
                    Listgral.Add(new DocumentosVencidos
                        {
                            Id = item.Id,
                            Modulo = "Accionistas",
                            Documento = documento,
                            NroDocumento = nrodocumento,
                        FechaVencimiento = (DateTime)fechavencimiento,
                            Nombre = nombreper
                        });
                }
            }

            Listgral = Listgral.OrderBy(x => x.FechaVencimiento).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
        StateHasChanged();
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Nombre != null && b.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Detalle(Sociedad item)
    {
        //navManager.NavigateTo($"/detallesociedad/{item.Id}");
    }
}
