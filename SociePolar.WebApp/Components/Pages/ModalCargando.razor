@rendermode InteractiveServer

<div class="modal fade show d-flex align-items-center justify-content-center" tabindex="-1"
     style="background: rgba(15, 23, 42, 0.35); backdrop-filter: blur(3px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

    <div class="card border-0 shadow-lg px-4 py-3 bg-white text-center rounded-4" style="min-width: 150px; max-width: 200px;">
        <div class="d-flex flex-column align-items-center justify-content-center py-1">
            <div class="spinner-border text-primary mb-2" role="status" style="width: 2.25rem; height: 2.25rem; border-width: 0.22em;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="fw-semibold text-primary small" style="font-size: 0.825rem; letter-spacing: 0.3px;">
                Procesando...
            </span>
        </div>
    </div>
</div>