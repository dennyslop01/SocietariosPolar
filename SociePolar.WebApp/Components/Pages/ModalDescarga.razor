            return sb.ToString();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Error " + ex.Message.ToString(), true);
        }
        return null;
    }

    private async Task<string> GenerarTituloCsv(string separador)
    {
        try
        {
            // Lógica para construir la cadena CSV
            var sb = new StringBuilder();

            int i = 0;
            string encabezado = string.Empty;

            var listaGral = await repotitulo.GetAllAsync();
            List<Titulo> Listgral = listaGral.OrderBy(x => x.AccionistaSociedad?.Sociedad?.Empresa?.Nombre).Where(x => x.AccionistaSociedad?.Sociedad?.EstatusSociedad?.Id == int.Parse(idEstado)).ToList();

            encabezado += $"Id{separador}AccionistaSociedad{separador}Numero{separador}Acciones{separador}Preferente{separador}Ubicacion{separador}Anulado{separador}Endosado{separador}Fecha{separador}Observaciones{separador}";
            encabezado += $"CreateDate{separador}UpdateDate";

            sb.AppendLine(encabezado); // Encabezados

            string linea = string.Empty;
            foreach (var item in Listgral)
            {
                linea = $"{item.Id}{separador}{item.AccionistaSociedad?.Sociedad?.Empresa?.Nombre}{separador}{item.Numero}{separador}{item.Acciones}{separador}{item.Preferente}{separador}{item.Ubicacion}{separador}{item.Anulado}{separador}{item.Endosado}{separador}{item.Fecha}{separador}{item.Observaciones}{separador}";
                linea += $"{item.CreateDate}{separador}{item.UpdateDate}";

                sb.AppendLine(linea);
            }
            return sb.ToString();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Error " + ex.Message.ToString(), true);
        }
        return null;
    }


    private async Task Cancelar()
    {
        await OnFinalizado.InvokeAsync(false);
    }

    private async Task CerrarModal()
    {
        await OnFinalizado.InvokeAsync(false);
    }
}

<script>
    function downloadFileFromStream(fileName, content) {
        // Añadimos el BOM ( \ufeff ) al inicio del contenido
        const blob = new Blob(["\ufeff", content], { type: "text/csv;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = fileName;
        a.click();
        URL.revokeObjectURL(url);
    }
</script>
