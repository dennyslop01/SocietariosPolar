    private static string SanearNombreArchivo(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "Sociedad";
        var invalidChars = Path.GetInvalidFileNameChars();
        string limpio = new string(nombre.Where(c => !invalidChars.Contains(c)).ToArray());
        return limpio.Replace(" ", "_").Replace(".", "").Replace(",", "").Trim();
    }

    private async Task<bool> ExportarAccionistasSociedadCsv(string separador)
    {
        string estadoTexto = idEstado == "2" ? "Inactivos" : "Activos";
        string nombreLimpio = SanearNombreArchivo(nombreSociedad);

        bool exportarDirectos = (tipoExportacionAccionistas == 1 || tipoExportacionAccionistas == 3 || !tieneCustodia);
        bool exportarCustodia = (tieneCustodia && (tipoExportacionAccionistas == 2 || tipoExportacionAccionistas == 3));

        bool descargoAlMenosUno = false;

        if (exportarDirectos)
        {
            string csvDirectos = await GenerarAccionistasDirectosSociedadCsv(separador);
            if (!string.IsNullOrWhiteSpace(csvDirectos))
            {
                string fileName = $"Accionistas-{nombreLimpio}-{estadoTexto}.csv";
                await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csvDirectos);
                descargoAlMenosUno = true;
            }
        }

        if (exportarCustodia)
        {
            if (descargoAlMenosUno)
            {
                await Task.Delay(500); // Pausa breve para permitir la descarga ordenada de ambos archivos
            }

            string csvCustodia = await GenerarAccionistasCustodiaSociedadCsv(separador);
            if (!string.IsNullOrWhiteSpace(csvCustodia))
            {
                string fileName = $"Accionistas-Custodia-CVV-{nombreLimpio}-{estadoTexto}.csv";
                await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csvCustodia);
                descargoAlMenosUno = true;
            }
        }

        if (!descargoAlMenosUno)
        {
            await MostrarNotificacion("No se encontraron registros de accionistas para exportar en esta sociedad", true);
            return false;
        }

        return true;
    }

    private async Task<string> GenerarAccionistasDirectosSociedadCsv(string separador)
    {
        var sb = new StringBuilder();
        int.TryParse(idEstado, out int targetEstado);
        if (targetEstado == 0) targetEstado = 1;

        var todos = await repoaccionistasociedad.GetBySociedadIdAsync(idSociedad);
        var directos = todos
            .Where(x => x.EstatusAccionista?.Id == targetEstado && x.CustodioId == null)
            .OrderByDescending(x => x.NroAcciones ?? 0)
            .ToList();

        if (!directos.Any())
        {
            return string.Empty;
        }

        var custodiosIds = await repoaccionistasociedad.GetCustodiosIdBySociedadAsync(idSociedad, targetEstado);
        var custodiosSet = new HashSet<int>(custodiosIds);

        var soc = await repository.GetByIdAsync(idSociedad);
        long totalAccionesSociedad = 0;
        if (!string.IsNullOrEmpty(soc?.NumeroAcciones) && long.TryParse(soc.NumeroAcciones.Replace(".", "").Replace(",", "").Trim(), out long numParsed))
        {
            totalAccionesSociedad = numParsed;
        }

        string encabezado = string.Join(separador, new string[] {
            "Sociedad", "TipoDocumento", "NroDocumento", "NombreAccionista", "TipoAccionista",
            "NroAcciones", "PorcentajeParticipacion", "EsCustodio", "FechaIngreso", "UltimaModificacion"
        });
        sb.AppendLine(encabezado);

        foreach (var item in directos)
        {
            long nroAcciones = item.NroAcciones ?? 0;
            decimal porc = 0;
            if (totalAccionesSociedad > 0)
            {
                porc = Math.Round((decimal)nroAcciones / totalAccionesSociedad * 100, 6);
            }

            string nombreFinal = (item.Accionista?.TipoAccionista?.Id != 3)
                ? (item.Accionista?.Nombre ?? string.Empty)
                : (item.Accionista?.NombreSusesion ?? item.Accionista?.Nombre ?? string.Empty);

            string linea = string.Join(separador, new string[] {
                EscaparCsv(nombreSociedad, separador),
                EscaparCsv(item.Accionista?.TipoDocumento1?.Nombre ?? "-", separador),
                EscaparCsv(item.Accionista?.Documento1 ?? "-", separador),
                EscaparCsv(nombreFinal, separador),
                EscaparCsv(item.Accionista?.TipoAccionista?.Nombre ?? "-", separador),
                EscaparCsv(nroAcciones, separador),
                EscaparCsv(FormatearPorcentajeCsv(porc, separador), separador),
                EscaparCsv(custodiosSet.Contains(item.Id) ? "Si" : "No", separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd"), separador)
            });
            sb.AppendLine(linea);
        }

        return sb.ToString();
    }

    private async Task<string> GenerarAccionistasCustodiaSociedadCsv(string separador)
    {
        var sb = new StringBuilder();
        int.TryParse(idEstado, out int targetEstado);
        if (targetEstado == 0) targetEstado = 1;

        var todos = await repoaccionistasociedad.GetBySociedadIdAsync(idSociedad);
        var custodiosIds = await repoaccionistasociedad.GetCustodiosIdBySociedadAsync(idSociedad, targetEstado);
        var custodiosRows = todos.Where(x => custodiosIds.Contains(x.Id)).ToList();

        if (!custodiosRows.Any())
        {
            return string.Empty;
        }

        var soc = await repository.GetByIdAsync(idSociedad);
        long totalAccionesSociedad = 0;
        if (!string.IsNullOrEmpty(soc?.NumeroAcciones) && long.TryParse(soc.NumeroAcciones.Replace(".", "").Replace(",", "").Trim(), out long numParsed))
        {
            totalAccionesSociedad = numParsed;
        }

        string encabezado = string.Join(separador, new string[] {
            "Sociedad", "Custodio", "TipoDocumento", "NroDocumento", "NombreAccionista",
            "TipoAccionista", "NroAcciones", "PorcentajeSobreSociedad", "FechaIngreso", "UltimaModificacion"
        });
        sb.AppendLine(encabezado);

        bool tieneSubcuentas = false;

        foreach (var cust in custodiosRows)
        {
            string nombreCustodio = cust.Accionista?.Nombre ?? "Caja Venezolana de Valores";
            var subcuentas = await repoaccionistasociedad.GetCustodiadosAsync(idSociedad, cust.Id, targetEstado);

            foreach (var sub in subcuentas.OrderByDescending(x => x.NroAcciones ?? 0))
            {
                tieneSubcuentas = true;
                long nroAcciones = sub.NroAcciones ?? 0;
                decimal porc = 0;
                if (totalAccionesSociedad > 0)
                {
                    porc = Math.Round((decimal)nroAcciones / totalAccionesSociedad * 100, 6);
                }

                string nombreFinal = (sub.Accionista?.TipoAccionista?.Id != 3)
                    ? (sub.Accionista?.Nombre ?? string.Empty)
                    : (sub.Accionista?.NombreSusesion ?? sub.Accionista?.Nombre ?? string.Empty);

                string linea = string.Join(separador, new string[] {
                    EscaparCsv(nombreSociedad, separador),
                    EscaparCsv(nombreCustodio, separador),
                    EscaparCsv(sub.Accionista?.TipoDocumento1?.Nombre ?? "-", separador),
                    EscaparCsv(sub.Accionista?.Documento1 ?? "-", separador),
                    EscaparCsv(nombreFinal, separador),
                    EscaparCsv(sub.Accionista?.TipoAccionista?.Nombre ?? "-", separador),
                    EscaparCsv(nroAcciones, separador),
                    EscaparCsv(FormatearPorcentajeCsv(porc, separador), separador),
                    EscaparCsv(sub.CreateDate.ToString("yyyy-MM-dd"), separador),
                    EscaparCsv(sub.UpdateDate.ToString("yyyy-MM-dd"), separador)
                });
                sb.AppendLine(linea);
            }
        }

        return tieneSubcuentas ? sb.ToString() : string.Empty;
    }

    private static string FormatearPorcentajeCsv(decimal porc, string separador)
    {
        if (separador == ";")
        {
            // Para Excel en español (separador ';'), la coma ',' es el separador decimal estándar.
            // Si se exporta con punto '.', Excel lo confunde con separador de miles cuando la parte entera es >= 1,
            // eliminándolo y convirtiendo por ejemplo 44.4444% en 444444%.
            return porc.ToString("0.0000", new System.Globalization.CultureInfo("es-VE")) + "%";
        }
        else
        {
            return porc.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture) + "%";
        }
    }

