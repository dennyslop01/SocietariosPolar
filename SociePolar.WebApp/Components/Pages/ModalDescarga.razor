    private async Task<string> GenerarTituloCsv(string separador)
    {
        var sb = new StringBuilder();
        var listaGral = await repotitulo.GetAllAsync();
        int.TryParse(idEstado, out int targetId);

        var listGral = listaGral
            .Where(x => x.AccionistaSociedad?.Id == targetId)
            .OrderBy(x => x.AccionistaSociedad?.Sociedad?.Empresa?.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "AccionistaSociedad", "Numero", "Acciones", "Preferente", "Ubicacion",
            "Anulado", "Endosado", "Fecha", "Observaciones", "CreateDate", "UpdateDate"
        });
        sb.AppendLine(encabezado);

        foreach (var item in listGral)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Id, separador),
                EscaparCsv(item.AccionistaSociedad?.Sociedad?.Empresa?.Nombre, separador),
                EscaparCsv(item.Numero, separador),
                EscaparCsv(item.Acciones, separador),
                EscaparCsv(item.Preferente, separador),
                EscaparCsv(item.Ubicacion, separador),
                EscaparCsv(item.Anulado, separador),
                EscaparCsv(item.Endosado, separador),
                EscaparCsv(item.Fecha?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.Observaciones, separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador)
            });
            sb.AppendLine(linea);
        }
        return sb.ToString();
    }

