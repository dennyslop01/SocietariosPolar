@using System.Text
@using System.IO
@using SociePolar.Domain.Models
@using SociePolar.Domain.Entities
@using SociePolar.Application.Interfaces
@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px; margin: auto;">
        <EditForm EditContext="editContext" OnSubmit="GuardarEntidad">
            <DataAnnotationsValidator />

            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fs-6 fw-bold mb-0">
                        <i class="bi bi-filetype-csv me-2"></i> @(idModulo == "9" ? "Descargar Accionistas" : "Descargar Datos")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                @if (mostrarAlerta)
                {
                    <div class="alert @claseAlerta d-flex align-items-center m-3 mb-0 py-2 px-3 border-0 shadow-sm" role="alert">
                        <i class="bi @iconoAlerta me-2 fs-5"></i>
                        <div class="small fw-semibold">
                            @mensajeAlerta
                        </div>
                    </div>
                }

                <div class="modal-body py-4">
                    @if (cargando)
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <span class="text-secondary fw-semibold small">Generando archivo de descarga...</span>
                        </div>
                    }
                    else
                    {
                        @if (idModulo == "9" && !string.IsNullOrEmpty(nombreSociedad))
                        {
                            <div class="alert alert-light border d-flex align-items-center mb-3 py-2 px-3 rounded-3 shadow-xs">
                                <i class="bi bi-building me-2 fs-5 text-primary"></i>
                                <div>
                                    <span class="text-muted small d-block" style="font-size: 0.75rem;">Sociedad:</span>
                                    <strong class="text-dark small">@nombreSociedad</strong>
                                </div>
                            </div>

                            @if (tieneCustodia)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary small">Contenido a Descargar</label>
                                    <div class="d-flex flex-column gap-2 p-2 border rounded-3 bg-light-subtle">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="tipoExp" id="expDirectos" value="1" 
                                                   checked="@(tipoExportacionAccionistas == 1)" 
                                                   @onchange="@(() => tipoExportacionAccionistas = 1)">
                                            <label class="form-check-label small fw-medium text-dark" for="expDirectos" style="cursor: pointer;">
                                                Accionistas de la Sociedad <span class="text-muted" style="font-size: 0.8rem;">(Directos + Bloque Custodio)</span>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="tipoExp" id="expCustodia" value="2" 
                                                   checked="@(tipoExportacionAccionistas == 2)" 
                                                   @onchange="@(() => tipoExportacionAccionistas = 2)">
                                            <label class="form-check-label small fw-medium text-dark" for="expCustodia" style="cursor: pointer;">
                                                Accionistas en Custodia <span class="text-muted" style="font-size: 0.8rem;">(Desglose Sub-Cuentas C.V.V.)</span>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="tipoExp" id="expAmbos" value="3" 
                                                   checked="@(tipoExportacionAccionistas == 3)" 
                                                   @onchange="@(() => tipoExportacionAccionistas = 3)">
                                            <label class="form-check-label small fw-medium text-dark" for="expAmbos" style="cursor: pointer;">
                                                Ambos archivos <span class="text-muted" style="font-size: 0.8rem;">(Descargar los 2 por separado)</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <div class="mb-2">
                            <label class="form-label fw-bold text-secondary small">Formato del Separador</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="entidadActual.TipoSeparador">
                                <option value="-1">-- Seleccione uno --</option>
                                <option value="2">Punto y Coma (;) - Recomendado para Excel</option>
                                <option value="1">Coma (,)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => entidadActual.TipoSeparador)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@cargando">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" disabled="@cargando">
                        <i class="bi bi-download me-1"></i> Descargar
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public string idModulo { get; set; } = "";
    [Parameter] public string idEstado { get; set; } = "";
    [Parameter] public int idSociedad { get; set; } = 0;
    [Parameter] public string nombreSociedad { get; set; } = "";
    [Parameter] public bool tieneCustodia { get; set; } = false;
    [Parameter] public EventCallback<bool> OnFinalizado { get; set; }

    private int tipoExportacionAccionistas = 1;

    private MatrizCSV entidadActual = new();
    private bool cargando = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success";
    private string iconoAlerta = "bi-check-circle-fill";

    private EditContext? editContext;

    public class Modulos
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    public List<Modulos> ListModulos = new List<Modulos>
    {
        new Modulos { Id = 1, Nombre = "Sociedades" },
        new Modulos { Id = 2, Nombre = "Autoridades" },
        new Modulos { Id = 3, Nombre = "Asambleas" },
        new Modulos { Id = 4, Nombre = "Reformas" },
        new Modulos { Id = 5, Nombre = "Certificaciones" },
        new Modulos { Id = 6, Nombre = "Libros" },
        new Modulos { Id = 7, Nombre = "Accionistas" },
        new Modulos { Id = 8, Nombre = "Titulos" },
        new Modulos { Id = 9, Nombre = "AccionistasSociedad" },
    };

    [Inject] private ISociedad repository { get; set; } = null!;
    [Inject] private IAutoridad repoautoridad { get; set; } = null!;
    [Inject] private IAsamblea repoasamblea { get; set; } = null!;
    [Inject] private ICertificacion repocertificacion { get; set; } = null!;
    [Inject] private ILibroSocietario repolibros { get; set; } = null!;
    [Inject] private IAccionista repoaccionista { get; set; } = null!;
    [Inject] private ITitulo repotitulo { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoaccionistasociedad { get; set; } = null!;

    protected override void OnInitialized()
    {
        entidadActual.TipoSeparador = 2; // Por defecto Punto y Coma para Excel en español
        editContext = new EditContext(entidadActual);
    }

    private static string EscaparCsv(object? valor, string separador)
    {
        if (valor == null) return string.Empty;
        string texto = valor.ToString() ?? string.Empty;
        texto = texto.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ").Trim();
        if (texto.Contains(separador) || texto.Contains('"'))
        {
            string escapado = texto.Replace("\"", "\"\"");
            return "\"" + escapado + "\"";
        }
        return texto;
    }

    private async Task GuardarEntidad()
    {
        bool formularioValido = editContext?.Validate() ?? false;
        if (!formularioValido)
        {
            await MostrarNotificacion("Por favor seleccione un separador válido", true);
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            string separador = entidadActual.TipoSeparador switch
            {
                1 => ",",
                2 => ";",
                3 => "\t",
                _ => ";"
            };

            bool exito = await ExportarCsv(separador);
            cargando = false;
            StateHasChanged();

            if (exito)
            {
                await OnFinalizado.InvokeAsync(true);
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("Error al generar descarga: " + ex.Message, true);
        }
    }

    private async Task<bool> ExportarCsv(string separador)
    {
        if (idModulo == "9")
        {
            return await ExportarAccionistasSociedadCsv(separador);
        }

        string modulo = ListModulos.FirstOrDefault(m => m.Id == int.Parse(idModulo))?.Nombre ?? "Datos";
        string csvString = idModulo switch
        {
            "1" => await GenerarSociedadCsv(separador),
            "2" => await GenerarAutoridadCsv(separador),
            "3" => await GenerarAsambleaCsv(separador, 0),
            "4" => await GenerarAsambleaCsv(separador, 1),
            "5" => await GenerarCertificacionCsv(separador),
            "6" => await GenerarLibrosCsv(separador),
            "7" => await GenerarAccionistaCsv(separador),
            "8" => await GenerarTituloCsv(separador),
            _ => string.Empty
        };

        if (string.IsNullOrWhiteSpace(csvString))
        {
            await MostrarNotificacion("No se encontraron registros para exportar en este módulo", true);
            return false;
        }

        string sufijo = idModulo == "8" ? $"Accionista-{idEstado}" : (idEstado == "1" ? "Activo" : "Inactivo");
        string fileName = $"Data-{modulo}-{sufijo}.csv";

        await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csvString);
        return true;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }

    private async Task<string> GenerarSociedadCsv(string separador)
    {
        var sb = new StringBuilder();
        var listSociedades = await repository.GetAllAsync();
        int.TryParse(idEstado, out int targetEstado);

        var listGral = listSociedades
            .Where(x => x.EstatusSociedad?.Id == targetEstado)
            .OrderBy(x => x.Empresa?.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "Region", "UnidadNegocio", "Empresa", "NumeroSap", "EstatusSociedad",
            "TipoSociedadActiva", "Objeto", "Domicilio", "DireccionFiscal", "DatosConstitucion",
            "FechaConstitucion", "FechaVencimiento", "Duracion", "NumeroAcciones", "AplicaCapital",
            "Moneda", "CapitalSuscrito", "CapitalPagado", "ClaseAcciones", "FormaAdministracion",
            "EjercicioEconomico", "NumeroExpediente", "Observaciones", "Documento1", "Nit",
            "CreateDate", "UpdateDate", "ValorAccion", "AnoPublicacion", "NumeroPublicacion",
            "FechaPublicacion", "NombreDiario", "ValorPatrimonial", "Documento2", "Documento3",
            "TipoDocumento1", "TipoDocumento2", "TipoDocumento3"
        });
        sb.AppendLine(encabezado);

        foreach (var item in listGral)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Id, separador),
                EscaparCsv(item.Region?.Nombre, separador),
                EscaparCsv(item.UnidadNegocio?.Nombre, separador),
                EscaparCsv(item.Empresa?.Nombre, separador),
                EscaparCsv(item.NumeroSap, separador),
                EscaparCsv(item.EstatusSociedad?.Nombre, separador),
                EscaparCsv(item.TipoSociedadActiva?.Nombre ?? item.TipoSociedadInactiva?.Nombre, separador),
                EscaparCsv(item.Objeto, separador),
                EscaparCsv(item.Domicilio, separador),
                EscaparCsv(item.DireccionFiscal, separador),
                EscaparCsv(item.DatosConstitucion, separador),
                EscaparCsv(item.FechaConstitucion?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.FechaVencimiento?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.Duracion, separador),
                EscaparCsv(item.NumeroAcciones, separador),
                EscaparCsv(item.AplicaCapital, separador),
                EscaparCsv(item.Moneda?.Nombre, separador),
                EscaparCsv(item.CapitalSuscrito, separador),
                EscaparCsv(item.CapitalPagado, separador),
                EscaparCsv(item.ClaseAcciones, separador),
                EscaparCsv(item.FormaAdministracion, separador),
                EscaparCsv(item.EjercicioEconomico, separador),
                EscaparCsv(item.NumeroExpediente, separador),
                EscaparCsv(item.Observaciones, separador),
                EscaparCsv(item.Documento1, separador),
                EscaparCsv(item.Nit, separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.ValorAccion, separador),
                EscaparCsv(item.AnoPublicacion, separador),
                EscaparCsv(item.NumeroPublicacion, separador),
                EscaparCsv(item.FechaPublicacion?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.NombreDiario?.Nombre, separador),
                EscaparCsv(item.ValorPatrimonial, separador),
                EscaparCsv(item.Documento2, separador),
                EscaparCsv(item.Documento3, separador),
                EscaparCsv(item.TipoDocumento1?.Nombre, separador),
                EscaparCsv(item.TipoDocumento2?.Nombre, separador),
                EscaparCsv(item.TipoDocumento3?.Nombre, separador)
            });
            sb.AppendLine(linea);
        }

        return sb.ToString();
    }

    private async Task<string> GenerarAutoridadCsv(string separador)
    {
        var sb = new StringBuilder();
        var listaGral = await repoautoridad.GetAllAsync();
        int.TryParse(idEstado, out int targetEstado);

        var listGral = listaGral
            .Where(x => x.Sociedad?.EstatusSociedad?.Id == targetEstado)
            .OrderBy(x => x.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "Sociedad", "Cargo", "Nombre", "TipoDocumento1", "TipoDocumento2",
            "Documento1", "Documento2", "Duracion", "CreateDate", "UpdateDate"
        });
        sb.AppendLine(encabezado);

        foreach (var item in listGral)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Id, separador),
                EscaparCsv(item.Sociedad?.Empresa?.Nombre, separador),
                EscaparCsv(item.Cargo?.Nombre, separador),
                EscaparCsv(item.Nombre, separador),
                EscaparCsv(item.TipoDocumento1?.Nombre, separador),
                EscaparCsv(item.TipoDocumento2?.Nombre, separador),
                EscaparCsv(item.Documento1, separador),
                EscaparCsv(item.Documento2, separador),
                EscaparCsv(item.Duracion, separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador)
            });
            sb.AppendLine(linea);
        }
        return sb.ToString();
    }

    private async Task<string> GenerarAsambleaCsv(string separador, int reforma)
    {
        var sb = new StringBuilder();
        var listaGral = await repoasamblea.GetAllAsync();
        int.TryParse(idEstado, out int targetEstado);

        var listGral = listaGral
            .Where(x => x.Sociedad?.EstatusSociedad?.Id == targetEstado &&
                        (x.IndicadorAsamblea == 0 ||
                         ((reforma == 1 && x.TipoReforma != null) || (reforma != 1 && x.TipoReforma == null))))
            .OrderBy(x => x.Sociedad?.Empresa?.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "Sociedad", "TipoAsamblea", "FechaCelebracion", "NumeroActa", "FechaRegistro",
            "Registro", "NumeroRegistro", "Tomo", "AnoPublicacion", "FechaPublicacion",
            "NumeroPublicacion", "NombreDiario", "IndicadorAsamblea", "AplicaReforma",
            "TipoReforma", "CreateDate", "UpdateDate", "Observacion"
        });
        sb.AppendLine(encabezado);

        foreach (var item in listGral)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Id, separador),
                EscaparCsv(item.Sociedad?.Empresa?.Nombre, separador),
                EscaparCsv(item.TipoAsamblea?.Nombre, separador),
                EscaparCsv(item.FechaCelebracion?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.NumeroActa, separador),
                EscaparCsv(item.FechaRegistro?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.Registro?.Nombre, separador),
                EscaparCsv(item.NumeroRegistro, separador),
                EscaparCsv(item.Tomo, separador),
                EscaparCsv(item.AnoPublicacion, separador),
                EscaparCsv(item.FechaPublicacion?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.NumeroPublicacion, separador),
                EscaparCsv(item.NombreDiario?.Nombre, separador),
                EscaparCsv(item.IndicadorAsamblea, separador),
                EscaparCsv(item.AplicaReforma, separador),
                EscaparCsv(item.TipoReforma?.Nombre, separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.Observacion, separador)
            });
            sb.AppendLine(linea);
        }
        return sb.ToString();
    }

    private async Task<string> GenerarCertificacionCsv(string separador)
    {
        var sb = new StringBuilder();
        var listaGral = await repocertificacion.GetAllAsync();
        int.TryParse(idEstado, out int targetEstado);

        var listGral = listaGral
            .Where(x => x.Sociedad?.EstatusSociedad?.Id == targetEstado)
            .OrderBy(x => x.Sociedad?.Empresa?.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] { "Id", "Sociedad", "Cargo", "Fecha", "CreateDate", "UpdateDate" });
        sb.AppendLine(encabezado);

        foreach (var item in listGral)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Id, separador),
                EscaparCsv(item.Sociedad?.Empresa?.Nombre, separador),
                EscaparCsv(item.Cargo?.Nombre, separador),
                EscaparCsv(item.Fecha?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador)
            });
            sb.AppendLine(linea);
        }
        return sb.ToString();
    }

    private async Task<string> GenerarLibrosCsv(string separador)
    {
        var sb = new StringBuilder();
        var listaGral = await repolibros.GetAllAsync();
        int.TryParse(idEstado, out int targetEstado);

        var listGral = listaGral
            .Where(x => x.Sociedad?.EstatusSociedad?.Id == targetEstado)
            .OrderBy(x => x.Sociedad?.Empresa?.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "Sociedad", "ClaseLibro", "TipoLibro", "TomoUso", "Folios",
            "LibrosSellados", "Observaciones", "CreateDate", "UpdateDate",
            "FechaDesde", "FechaHasta", "FechaSello", "Vacio", "Ubicacion"
        });
        sb.AppendLine(encabezado);

        foreach (var item in listGral)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Id, separador),
                EscaparCsv(item.Sociedad?.Empresa?.Nombre, separador),
                EscaparCsv(item.ClaseLibro?.Nombre, separador),
                EscaparCsv(item.TipoLibro?.Nombre, separador),
                EscaparCsv(item.TomoUso, separador),
                EscaparCsv(item.Folios, separador),
                EscaparCsv(item.LibrosSellados, separador),
                EscaparCsv(item.Observaciones, separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd HH:mm:ss"), separador),
                EscaparCsv(item.FechaDesde?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.FechaHasta?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.FechaSello?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.Vacio, separador),
                EscaparCsv(item.Ubicacion, separador)
            });
            sb.AppendLine(linea);
        }
        return sb.ToString();
    }

    private async Task<string> GenerarAccionistaCsv(string separador)
    {
        var sb = new StringBuilder();
        var listaGral = await repoaccionista.GetAllAsync();
        var listGral = listaGral.OrderBy(x => x.Nombre ?? string.Empty).ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "TipoAccionista", "Nombre", "TipoDocumento1", "TipoDocumento2", "TipoDocumento3", "TipoDocumento4",
            "Documento1", "Documento2", "Documento3", "Documento4", "FechaEmision1", "FechaVencimiento1",
            "FechaEmision2", "FechaVencimiento2", "FechaEmision3", "FechaVencimiento3", "FechaEmision4", "FechaVencimiento4",
            "DirigidoA", "EstadoCivil", "NombreConyuge", "TipoDocumentoConyugeId1", "TipoDocumentoConyugeId2",
            "TipoDocumentoConyugeId3", "DocumentoConyuge1", "FechaEmisionConyuge1", "FechaVencimientoConyuge1",
            "DocumentoConyuge2", "FechaEmisionConyuge2", "FechaVencimientoConyuge2", "DocumentoConyuge3",
            "FechaEmisionConyuge3", "FechaVencimientoConyuge3", "SeparacionBienes", "FechaNacimiento", "FechaIngreso",
            "Email1", "Email2", "Email3", "TelefonoMovil", "Telefono1", "Telefono2", "Telefono3", "Telefono4",
            "Direccion1", "Direccion2", "GrupoFamiliar", "Nacionalidad", "DomiciliadoEn", "Banco", "NumeroCuenta",
            "TipoCuenta", "NombreTitularCuenta", "UltimaActualizacion", "AnoActualizacion", "FaltaActualizar",
            "TieneApoderado", "NombreApoderado", "DatosPoder", "TipoDocumentoApoderadoId1", "TipoDocumentoApoderadoId2",
            "TipoDocumentoApoderadoId3", "DocumentoApoderado1", "FechaEmisionApoderado1", "FechaVencimientoApoderado1",
            "DocumentoApoderado2", "FechaEmisionApoderado2", "FechaVencimientoApoderado2", "DocumentoApoderado3",
            "FechaEmisionApoderado3", "FechaVencimientoApoderado3", "NombreContacto", "TelefonoContacto", "EmailContacto",
