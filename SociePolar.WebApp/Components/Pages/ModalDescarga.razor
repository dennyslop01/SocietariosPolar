            .Where(x => x.Sociedad?.EstatusSociedad?.Id == targetEstado &&
                        (x.IndicadorAsamblea == 0 ||
                         ((reforma == 1 && x.TipoReforma != null) || (reforma != 1 && x.TipoReforma == null))))
            .OrderBy(x => x.Sociedad?.Empresa?.Nombre ?? string.Empty)
            .ToList();

        string encabezado = string.Join(separador, new string[] {
            "Id", "Sociedad", "TipoAsamblea", "FechaCelebracion", "NumeroActa", "FechaRegistro",
