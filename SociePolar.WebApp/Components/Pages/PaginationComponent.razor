@typeparam TItem

<div class="polar-table-container d-flex flex-column" style="min-height: 0; @ContainerStyle">
    <div class="table-responsive flex-grow-1" style="overflow: auto; min-height: 0;">
        <table class="table table-hover align-middle mb-0 @TableClass">
            <thead class="table-light sticky-top" style="position: sticky; top: 0; z-index: 5; background-color: #F8FAFC;">
                @ChildContentHeader
            </thead>
            <tbody>
                @foreach (var item in PaginatedData)
                {
                    @ChildContentRow(item)
                }
            </tbody>
        </table>
    </div>

    <div class="polar-pagination-bar d-flex flex-column flex-sm-row align-items-center justify-content-between p-3 gap-3 bg-white border-top flex-shrink-0" style="position: sticky; bottom: 0; z-index: 10;">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <!-- Selector de Tamaño -->
            <label class="me-2 text-muted small fw-semibold">Filas por página:</label>
            <select @bind="PageSize" class="form-select form-select-sm polar-pagination-select">
                @foreach (var size in PageSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>

            <!-- Botones de Navegación -->
            <div class="ms-3 d-flex align-items-center gap-1 flex-wrap">
                <button class="polar-page-btn"
                        @onclick="PreviousPage"
                        disabled="@IsPreviousDisabled"
                        title="Página anterior">
                    <i class="bi bi-chevron-left"></i>
                </button>

                @foreach (var pageNumber in GetVisiblePages())
                {
                    if (pageNumber == -1)
                    {
                        <span class="px-2 text-muted small">...</span>
                    }
                    else
                    {
                        <button @onclick="() => GoToPage(pageNumber)"
                                class="polar-page-btn @(CurrentPage == pageNumber ? "active" : "")">
                            @pageNumber
                        </button>
                    }
                }

                <button class="polar-page-btn"
                        @onclick="NextPage"
                        disabled="@IsNextDisabled"
                        title="Página siguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

        <!-- Info de Registros -->
        <div class="text-muted small">
            Mostrando <span class="fw-semibold text-dark">@RecordStart</span> a
            <span class="fw-semibold text-dark">@RecordEnd</span> de
            <span class="fw-semibold text-dark">@TotalItems</span> registros
        </div>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();
    [Parameter] public int DefaultPageSize { get; set; } = 15;
    [Parameter] public RenderFragment ChildContentHeader { get; set; }
    [Parameter] public RenderFragment<TItem> ChildContentRow { get; set; }
    [Parameter] public string TableClass { get; set; } = "";
    [Parameter] public string ContainerStyle { get; set; } = "max-height: calc(100vh - 250px);";
    [Parameter] public bool ServerSide { get; set; } = false;
    [Parameter] public int TotalServerItems { get; set; } = 0;
    [Parameter] public int ServerCurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    private int CurrentPage { get; set; } = 1;
    private readonly int[] PageSizes = new[] { 10, 15, 25, 50, 100 };
    private int _pageSize;
    private int PageSize
    {
        get => _pageSize;
        set
        {
            if (_pageSize != value)
            {
                _pageSize = value;
                CurrentPage = 1; // Reiniciar a página 1 si cambian el tamaño
                if (ServerSide && OnPageSizeChanged.HasDelegate)
                {
                    OnPageSizeChanged.InvokeAsync(value);
                }
            }
        }
    }

    // Lógica de datos paginados
    private List<TItem> PaginatedData => ServerSide
        ? (Items?.ToList() ?? new List<TItem>())
        : (Items?.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList() ?? new List<TItem>());

    // Propiedades de conteo
    private int TotalItems => ServerSide ? TotalServerItems : (Items?.Count() ?? 0);
    private int TotalPages => TotalItems > 0 ? (int)Math.Ceiling(TotalItems / (double)PageSize) : 1;
    private int RecordStart => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int RecordEnd => Math.Min(CurrentPage * PageSize, TotalItems);

    protected override void OnInitialized()
    {
        PageSize = DefaultPageSize;
        if (ServerSide && ServerCurrentPage > 0)
        {
            CurrentPage = ServerCurrentPage;
        }
    }

    protected override void OnParametersSet()
    {
        if (ServerSide && ServerCurrentPage > 0 && ServerCurrentPage != CurrentPage)
        {
            CurrentPage = ServerCurrentPage;
        }
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            if (ServerSide && OnPageChanged.HasDelegate)
            {
                await OnPageChanged.InvokeAsync(CurrentPage);
            }
        }
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            if (ServerSide && OnPageChanged.HasDelegate)
            {
                await OnPageChanged.InvokeAsync(CurrentPage);
            }
        }
    }

    private async Task GoToPage(int pageNumber)
    {
        CurrentPage = pageNumber;
        if (ServerSide && OnPageChanged.HasDelegate)
        {
            await OnPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private bool IsPreviousDisabled => CurrentPage == 1;
    private bool IsNextDisabled => CurrentPage >= TotalPages;

    private IEnumerable<int> GetVisiblePages()
    {
        var pages = new List<int>();
        if (TotalPages <= 7)
        {
            for (int i = 1; i <= TotalPages; i++) pages.Add(i);
        }
        else
        {
            if (CurrentPage <= 4)
            {
                for (int i = 1; i <= 5; i++) pages.Add(i);
                pages.Add(-1);
                pages.Add(TotalPages);
            }
            else if (CurrentPage >= TotalPages - 3)
            {
                pages.Add(1);
                pages.Add(-1);
                for (int i = TotalPages - 4; i <= TotalPages; i++) pages.Add(i);
            }
            else
            {
                pages.Add(1);
                pages.Add(-1);
                pages.Add(CurrentPage - 1);
                pages.Add(CurrentPage);
                pages.Add(CurrentPage + 1);
                pages.Add(-1);
                pages.Add(TotalPages);
            }
        }
        return pages;
    }
}

<style>
    .polar-table-container {
        border-radius: 8px;
        overflow: hidden;
    }

        .polar-table-container thead th {
            background-color: #F8FAFC !important;
            position: sticky;
            top: 0;
            z-index: 5;
            border-bottom: 2px solid #E2E8F0 !important;
        }

    /* Columna Congelada 1 (Ej. ID) */
    .polar-sticky-col-1 {
        position: sticky !important;
        left: 0 !important;
        z-index: 8 !important;
        background-color: #FFFFFF !important;
    }

    thead .polar-sticky-col-1 {
        position: sticky !important;
        top: 0 !important;
        left: 0 !important;
        z-index: 15 !important;
        background-color: #F8FAFC !important;
    }

    /* Columna Congelada 2 (Ej. Sociedad tras ID) */
    .polar-sticky-col-2 {
        position: sticky !important;
        left: 45px !important;
        z-index: 8 !important;
        background-color: #FFFFFF !important;
        box-shadow: 3px 0 5px -2px rgba(0, 0, 0, 0.12) !important;
    }

    thead .polar-sticky-col-2 {
        position: sticky !important;
        top: 0 !important;
        left: 45px !important;
        z-index: 15 !important;
        background-color: #F8FAFC !important;
        box-shadow: 3px 0 5px -2px rgba(0, 0, 0, 0.12) !important;
    }

    /* Columna Congelada Directa en el borde izquierdo (Ej. Nombre Accionista en Detalle) */
    .polar-sticky-col-direct {
        position: sticky !important;
        left: 0 !important;
        z-index: 8 !important;
        background-color: #FFFFFF !important;
        box-shadow: 3px 0 5px -2px rgba(0, 0, 0, 0.12) !important;
    }

    thead .polar-sticky-col-direct {
        position: sticky !important;
        top: 0 !important;
        left: 0 !important;
        z-index: 15 !important;
        background-color: #F8FAFC !important;
        box-shadow: 3px 0 5px -2px rgba(0, 0, 0, 0.12) !important;
    }

    /* Columna Congelada Flotante a la Derecha (Acciones) */
    .polar-sticky-col-actions {
        position: sticky !important;
        right: 0 !important;
        z-index: 8 !important;
        background-color: #FFFFFF !important;
        box-shadow: -4px 0 6px -2px rgba(0, 0, 0, 0.08) !important;
    }

    thead .polar-sticky-col-actions {
        position: sticky !important;
        top: 0 !important;
        right: 0 !important;
        z-index: 15 !important;
        background-color: #F8FAFC !important;
        box-shadow: -4px 0 6px -2px rgba(0, 0, 0, 0.08) !important;
    }

    /* Mantiene el fondo sincronizado al hacer hover sobre filas con columnas congeladas */
    tr:hover td.polar-sticky-col-direct,
    tr:hover td.polar-sticky-col-1,
    tr:hover td.polar-sticky-col-2,
    tr:hover td.polar-sticky-col-actions {
        background-color: #F1F5F9 !important;
    }

    /* Modo Compacto / Densidad Optimizada */
    .polar-table-compact th {
        padding: 0.45rem 0.5rem !important;
        font-size: 0.80rem !important;
        font-weight: 600 !important;
        white-space: nowrap !important;
        vertical-align: middle !important;
    }

    .polar-table-compact td {
        padding: 0.35rem 0.5rem !important;
        font-size: 0.81rem !important;
        vertical-align: middle !important;
    }

    .polar-num {
        font-variant-numeric: tabular-nums !important;
        text-align: right !important;
        white-space: nowrap !important;
    }

    .polar-date {
        white-space: nowrap !important;
        text-align: center !important;
    }

    .polar-truncate {
        display: inline-block !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: middle !important;
    }

    .polar-pagination-select {
        width: 70px !important;
        height: 32px !important;
        font-size: 0.8rem !important;
        border-radius: 6px !important;
        border: 1px solid #CBD5E1 !important;
        background-color: #FFFFFF !important;
        padding: 2px 8px !important;
        cursor: pointer;
    }

        .polar-pagination-select:focus {
            border-color: #004B87 !important;
            box-shadow: 0 0 0 2px rgba(0, 75, 135, 0.12) !important;
        }

    .polar-page-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 6px;
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background-color: transparent;
        border: 1px solid transparent;
        color: #475569;
        transition: all 0.15s ease;
        cursor: pointer;
    }

        .polar-page-btn:hover:not(:disabled):not(.active) {
            background-color: #F1F5F9;
            color: #0F172A;
        }

        .polar-page-btn.active {
            background-color: #004B87;
            color: #FFFFFF;
            font-weight: 600;
            box-shadow: 0 1px 2px rgba(0, 75, 135, 0.2);
        }

        .polar-page-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }
</style>
