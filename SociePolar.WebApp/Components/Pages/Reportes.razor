    private async Task GenerarReporte()
    {
        // 1. Validación de Tipo de Formato (aplica a todos los reportes)
        errorTipoFormato = string.IsNullOrWhiteSpace(tipoFormatoSeleccionado);
        if (errorTipoFormato)
        {
            await MostrarNotificacion("Debe seleccionar el Tipo de Formato (CSV o PDF).", true);
            return;
        }

        // 2. Procesamiento específico para Sociedades
        if (tipoReporteSeleccionado == 1)
        {
            await GenerarReporteSociedadesAsync();
            return;
        }

        // 3. Procesamiento específico para Accionistas (Sociedad + Estatus)
        if (tipoReporteSeleccionado == 2)
        {
            await GenerarReporteAccionistasAsync();
            return;
        }

        // 3.1. Procesamiento específico para Certificaciones (Sociedad Activa + TipoAccionista + Accionista)
        if (tipoReporteSeleccionado == 6)
        {
            errorSociedadCertificacion = sociedadCertificacionSeleccionada <= 0;
            errorTipoAccionistaCertificacion = tipoAccionistaCertificacionSeleccionado <= 0;
            errorAccionistaCertificacion = accionistaCertificacionSeleccionado <= 0;

            if (errorSociedadCertificacion || errorTipoAccionistaCertificacion || errorAccionistaCertificacion)
            {
                await MostrarNotificacion("Debe seleccionar la Sociedad Activa, el Tipo de Accionista y el Accionista.", true);
                return;
            }

            await GenerarReporteCertificacionesAsync();
            return;
        }

        // 4. Validación específica para otros módulos (requieren fechas)
        errorFechaDesde = !fechaDesde.HasValue;
        errorFechaHasta = !fechaHasta.HasValue;

        if (errorFechaDesde || errorFechaHasta)
        {
            await MostrarNotificacion("Debe ingresar tanto la Fecha Desde como la Fecha Hasta.", true);
            return;
        }

        if (fechaDesde > fechaHasta)
        {
            await MostrarNotificacion("La Fecha Desde no puede ser mayor que la Fecha Hasta.", true);
            return;
        }

        // 5. Procesamiento específico para Dividendos (Sociedad + Rango de Fechas + Formato)
        if (tipoReporteSeleccionado == 3)
        {
            errorSociedadDividendo = sociedadDividendoSeleccionada <= 0;
            if (errorSociedadDividendo)
            {
                await MostrarNotificacion("Debe seleccionar una sociedad con procesos de dividendos.", true);
                return;
            }

            await GenerarReporteDividendosAsync();
            return;
        }

        // 6. Procesamiento específico para Listados de Accionistas
        if (tipoReporteSeleccionado == 4)
        {
            errorSociedadAccionista = sociedadAccionistaSeleccionada <= 0;
            if (errorSociedadAccionista)
            {
                await MostrarNotificacion("Debe seleccionar una sociedad.", true);
                return;
            }

            await GenerarReporteListadosAccionistasAsync();
            return;
        }

        // 7. Procesamiento específico para Conciliaciones (Sociedad + Rango de Fechas + Formato)
        if (tipoReporteSeleccionado == 5)
        {
            errorSociedadConciliacion = sociedadConciliacionSeleccionada <= 0;
            if (errorSociedadConciliacion)
            {
                await MostrarNotificacion("Debe seleccionar una sociedad con procesos de conciliación.", true);
                return;
            }

            await GenerarReporteConciliacionesAsync();
            return;
        }

        var modulo = ListModulos.FirstOrDefault(m => m.Id == tipoReporteSeleccionado);
        string nombreReporte = modulo?.Nombre ?? "Reporte";

        await MostrarNotificacion($"Parámetros listos para generar el reporte de {nombreReporte} ({fechaDesde:dd/MM/yyyy} - {fechaHasta:dd/MM/yyyy}) en formato {tipoFormatoSeleccionado}.");
    }

    private async Task GenerarReporteSociedadesAsync()
    {
        errorFiltroSociedad = string.IsNullOrWhiteSpace(filtroSociedadSeleccionado);
        if (errorFiltroSociedad)
        {
            await MostrarNotificacion("Debe seleccionar un criterio para Sociedades.", true);
            return;
        }

        if (RequiereTerceraLista)
        {
            errorValorTercerNivel = valorTercerNivel <= 0;
            if (errorValorTercerNivel)
            {
                await MostrarNotificacion($"Debe seleccionar una opción válida de {TituloTerceraLista}.", true);
                return;
            }
        }

        procesandoReporte = true;
        StateHasChanged();

        try
        {
            // Consultar datos usando el repositorio de Sociedades
            var todas = await repoSociedad.GetAllAsync();

            IEnumerable<Sociedad> filtradas = filtroSociedadSeleccionado switch
            {
                "activas" => todas.Where(x => x.EstatusSociedad?.Id == 1),
                "inactivas" => todas.Where(x => x.EstatusSociedad?.Id == 2),
                "region" => todas.Where(x => (x.Region?.Id == valorTercerNivel) || (x.UnidadNegocio?.Region?.Id == valorTercerNivel)),
                "unidad_negocio" => todas.Where(x => x.UnidadNegocio?.Id == valorTercerNivel),
                "tipo_sociedad" => todas.Where(x => (x.TipoSociedadActiva?.Id == valorTercerNivel) ||
                                                    (x.TipoSociedadInactiva?.Id == valorTercerNivel) ||
                                                    (x.TipoSociedad?.Id == valorTercerNivel)),
                _ => todas
            };

            var listaFinal = filtradas
                .OrderBy(x => x.Empresa?.Nombre ?? string.Empty)
                .ToList();

            if (!listaFinal.Any())
            {
                await MostrarNotificacion("No se encontraron sociedades con el criterio seleccionado.", true);
                return;
            }

            string nombreOpcion = "";
            if (RequiereTerceraLista)
            {
                nombreOpcion = listaTercerNivel.FirstOrDefault(x => x.Id == valorTercerNivel)?.Nombre ?? "";
            }

            string detalleCriterio = filtroSociedadSeleccionado switch
            {
                "activas" => "Activas",
                "inactivas" => "Inactivas",
                "region" => $"Región: {nombreOpcion}",
                "unidad_negocio" => $"Unidad de Negocio: {nombreOpcion}",
                "tipo_sociedad" => $"Tipo de Sociedad: {nombreOpcion}",
                _ => "General"
            };

            string sufijoArchivo = filtroSociedadSeleccionado switch
            {
                "activas" => "Activas",
                "inactivas" => "Inactivas",
                _ => $"{filtroSociedadSeleccionado}_{nombreOpcion}".Replace(" ", "_")
            };

            if (tipoFormatoSeleccionado.Equals("CSV", StringComparison.OrdinalIgnoreCase))
            {
                string csv = GenerarCsvSociedades(listaFinal, ";");
                string fileName = $"Data-Sociedades-{sufijoArchivo}.csv";
                await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csv);
                await MostrarNotificacion($"Archivo CSV descargado con {listaFinal.Count} registros.");
            }
            else if (tipoFormatoSeleccionado.Equals("PDF", StringComparison.OrdinalIgnoreCase))
            {
                var columnas = new string[] { "Sociedad", "Tipo Doc.", "Documento", "Ejercicio Económico", "Duración", "Objeto" };
                var anchos = new float[] { 3.5f, 1.2f, 1.8f, 2.5f, 1.2f, 4.0f };
                var filas = listaFinal.Select(p => new string[]
                {
                    p.Empresa?.Nombre ?? "-",
                    p.TipoDocumento1?.Nombre ?? "-",
                    UtilClass.ObtenerNumeroDocumentoLimpio(p.TipoDocumento1?.Nombre, p.Documento1),
                    p.EjercicioEconomico ?? "-",
                    p.Duracion != null ? $"{p.Duracion}" : "-",
                    p.Objeto ?? "-"
                }).ToList();

                string tituloPdf = $"LISTA DE SOCIEDADES ({detalleCriterio.ToUpper()})";
                string baseFileName = $"Lista_Sociedades_{sufijoArchivo}";

                await ReportService.GenerarYDescargarReporteListaAsync(
                    titulo: tituloPdf,
                    columnas: columnas,
                    filas: filas,
                    nombreArchivoBase: baseFileName,
                    anchosRelativos: anchos,
                    subtitulo: $"Criterio aplicado: {detalleCriterio}"
                );

                await MostrarNotificacion($"Reporte PDF generado exitosamente con {listaFinal.Count} registros.");
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al generar el reporte: " + ex.Message, true);
        }
        finally
        {
            procesandoReporte = false;
            StateHasChanged();
        }
    }

    private static string EscaparCsv(object? valor, string separador)
    {
        if (valor == null) return string.Empty;
        string texto = valor.ToString() ?? string.Empty;
        texto = texto.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ").Trim();
        if (texto.Contains(separador) || texto.Contains('"'))
        {
            string escapado = texto.Replace("\"", "\"\"");
            return "\"" + escapado + "\"";
        }
        return texto;
    }

    private string GenerarCsvSociedades(List<Sociedad> lista, string separador)
    {
        var sb = new StringBuilder();

        string encabezado = string.Join(separador, new string[] {
            "Region", "UnidadNegocio", "Empresa", "NumeroSap", "EstatusSociedad",
            "TipoSociedadActiva", "Objeto", "Domicilio", "DireccionFiscal", "DatosConstitucion",
            "FechaConstitucion", "FechaVencimiento", "Duracion", "NumeroAcciones", "AplicaCapital",
            "Moneda", "CapitalSuscrito", "CapitalPagado", "ClaseAcciones", "FormaAdministracion",
            "EjercicioEconomico", "NumeroExpediente", "Observaciones", "Documento1", "Nit",
            "ValorAccion", "AnoPublicacion", "NumeroPublicacion", "FechaPublicacion", "NombreDiario",
            "ValorPatrimonial", "Documento2", "Documento3", "TipoDocumento1", "TipoDocumento2", "TipoDocumento3"
        });
        sb.AppendLine(encabezado);

        foreach (var item in lista)
        {
            string linea = string.Join(separador, new string[] {
                EscaparCsv(item.Region?.Nombre, separador),
                EscaparCsv(item.UnidadNegocio?.Nombre, separador),
                EscaparCsv(item.Empresa?.Nombre, separador),
                EscaparCsv(item.NumeroSap, separador),
                EscaparCsv(item.EstatusSociedad?.Nombre, separador),
                EscaparCsv(item.TipoSociedadActiva?.Nombre ?? item.TipoSociedadInactiva?.Nombre ?? item.TipoSociedad?.Nombre, separador),
                EscaparCsv(item.Objeto, separador),
                EscaparCsv(item.Domicilio, separador),
                EscaparCsv(item.DireccionFiscal, separador),
                EscaparCsv(item.DatosConstitucion, separador),
                EscaparCsv(item.FechaConstitucion?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.FechaVencimiento?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.Duracion, separador),
                EscaparCsv(item.NumeroAcciones, separador),
                EscaparCsv(item.AplicaCapital, separador),
                EscaparCsv(item.Moneda?.Nombre, separador),
                EscaparCsv(item.CapitalSuscrito, separador),
                EscaparCsv(item.CapitalPagado, separador),
                EscaparCsv(item.ClaseAcciones, separador),
                EscaparCsv(item.FormaAdministracion, separador),
                EscaparCsv(item.EjercicioEconomico, separador),
                EscaparCsv(item.NumeroExpediente, separador),
                EscaparCsv(item.Observaciones, separador),
                EscaparCsv(item.Documento1, separador),
                EscaparCsv(item.Nit, separador),
                EscaparCsv(item.ValorAccion, separador),
                EscaparCsv(item.AnoPublicacion, separador),
                EscaparCsv(item.NumeroPublicacion, separador),
                EscaparCsv(item.FechaPublicacion?.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.NombreDiario?.Nombre, separador),
                EscaparCsv(item.ValorPatrimonial, separador),
                EscaparCsv(item.Documento2, separador),
                EscaparCsv(item.Documento3, separador),
                EscaparCsv(item.TipoDocumento1?.Nombre, separador),
                EscaparCsv(item.TipoDocumento2?.Nombre, separador),
                EscaparCsv(item.TipoDocumento3?.Nombre, separador)
            });
            sb.AppendLine(linea);
        }

        return sb.ToString();
    }

    private async Task GenerarReporteAccionistasAsync()
    {
        errorSociedadAccionista = sociedadAccionistaSeleccionada <= 0;
        errorEstatusAccionista = string.IsNullOrWhiteSpace(estatusAccionistaSeleccionado);

        if (errorSociedadAccionista || errorEstatusAccionista)
        {
            await MostrarNotificacion("Debe seleccionar una Sociedad y un Estatus (Activos / Inactivos).", true);
            return;
        }

        procesandoReporte = true;
        StateHasChanged();

        try
        {
            int estatusId = estatusAccionistaSeleccionado == "activos" ? 1 : 2;
            string estatusTexto = estatusAccionistaSeleccionado == "activos" ? "Activos" : "Inactivos";

            var sociedad = await repoSociedad.GetByIdAsync(sociedadAccionistaSeleccionada);
            string nombreSociedad = sociedad?.Empresa?.Nombre ?? $"Sociedad_{sociedadAccionistaSeleccionada}";

            long totalAccionesSociedad = 0;
            if (!string.IsNullOrEmpty(sociedad?.NumeroAcciones) &&
                long.TryParse(sociedad.NumeroAcciones.Replace(".", "").Replace(",", "").Trim(), out long numParsed))
            {
                totalAccionesSociedad = numParsed;
            }

            var todosAccionistas = await repoAccionistaSociedad.GetBySociedadIdAsync(sociedadAccionistaSeleccionada);
            var directos = todosAccionistas
                .Where(x => x.EstatusAccionista?.Id == estatusId && x.CustodioId == null)
                .OrderByDescending(x => x.NroAcciones ?? 0)
                .ToList();

            if (!directos.Any())
            {
                await MostrarNotificacion($"No se encontraron accionistas {estatusTexto.ToLower()} para la sociedad {nombreSociedad}.", true);
                return;
            }

            var custodiosIds = await repoAccionistaSociedad.GetCustodiosIdBySociedadAsync(sociedadAccionistaSeleccionada, estatusId);
            var custodiosSet = new HashSet<int>(custodiosIds);

            string nombreLimpioSociedad = System.Text.RegularExpressions.Regex.Replace(nombreSociedad, @"[^\w\s-]", "").Replace(" ", "_").Trim();

            if (tipoFormatoSeleccionado.Equals("CSV", StringComparison.OrdinalIgnoreCase))
            {
                string csv = GenerarCsvAccionistasSociedad(directos, nombreSociedad, totalAccionesSociedad, custodiosSet, ";");
                string fileName = $"Accionistas-{nombreLimpioSociedad}-{estatusTexto}.csv";
                await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csv);
                await MostrarNotificacion($"Archivo CSV descargado con {directos.Count} accionistas de {nombreSociedad}.");
            }
            else if (tipoFormatoSeleccionado.Equals("PDF", StringComparison.OrdinalIgnoreCase))
            {
                var columnas = new string[] { "Accionista", "Tipo Accionista", "Documento", "Nro. Acciones", "% Participación" };
                var anchos = new float[] { 4.0f, 2.5f, 2.0f, 2.0f, 2.0f };

                var filas = directos.Select(p =>
                {
                    long nro = p.NroAcciones ?? 0;
                    decimal porc = (totalAccionesSociedad > 0 && nro > 0)
                        ? Math.Round((decimal)nro / totalAccionesSociedad * 100, 4)
                        : 0;

                    string nombreAccionista = (p.Accionista?.TipoAccionista?.Id == 3)
                        ? (p.Accionista?.NombreSusesion ?? p.Accionista?.Nombre ?? "-")
                        : (p.Accionista?.Nombre ?? "-");

                    return new string[]
                    {
                        nombreAccionista,
                        p.Accionista?.TipoAccionista?.Nombre ?? "-",
                        p.Accionista?.Documento1 ?? "-",
                        nro.ToString("N0"),
                        $"{porc:N4} %"
                    };
                }).ToList();

                string tituloPdf = $"NÓMINA DE ACCIONISTAS ({estatusTexto.ToUpper()})";
                string baseFileName = $"Nomina_{nombreLimpioSociedad}_{estatusTexto}";

                await ReportService.GenerarYDescargarReporteListaAsync(
                    titulo: tituloPdf,
                    columnas: columnas,
                    filas: filas,
                    nombreArchivoBase: baseFileName,
                    anchosRelativos: anchos,
                    subtitulo: $"Sociedad: {nombreSociedad}"
                );

                await MostrarNotificacion($"Reporte PDF generado exitosamente con {directos.Count} accionistas.");
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al generar el reporte de accionistas: " + ex.Message, true);
        }
        finally
        {
            procesandoReporte = false;
            StateHasChanged();
        }
    }

    private string GenerarCsvAccionistasSociedad(List<AccionistaSociedad> directos, string nombreSociedad, long totalAccionesSociedad, HashSet<int> custodiosSet, string separador)
    {
        var sb = new StringBuilder();

        string encabezado = string.Join(separador, new string[] {
            "Sociedad", "TipoDocumento", "NroDocumento", "NombreAccionista", "TipoAccionista",
            "NroAcciones", "PorcentajeParticipacion", "EsCustodio"
        });
        sb.AppendLine(encabezado);

        foreach (var item in directos)
        {
            long nroAcciones = item.NroAcciones ?? 0;
            decimal porc = 0;
            if (totalAccionesSociedad > 0 && nroAcciones > 0)
            {
                porc = Math.Round((decimal)nroAcciones / totalAccionesSociedad * 100, 4);
            }

            string nombreFinal = (item.Accionista?.TipoAccionista?.Id == 3)
                ? (item.Accionista?.NombreSusesion ?? item.Accionista?.Nombre ?? string.Empty)
                : (item.Accionista?.Nombre ?? string.Empty);

            string linea = string.Join(separador, new string[] {
                EscaparCsv(nombreSociedad, separador),
                EscaparCsv(item.Accionista?.TipoDocumento1?.Nombre ?? "-", separador),
                EscaparCsv(item.Accionista?.Documento1 ?? "-", separador),
                EscaparCsv(nombreFinal, separador),
                EscaparCsv(item.Accionista?.TipoAccionista?.Nombre ?? "-", separador),
                EscaparCsv(nroAcciones, separador),
                EscaparCsv(porc.ToString("0.0000", new System.Globalization.CultureInfo("es-VE")) + "%", separador),
                EscaparCsv(custodiosSet.Contains(item.Id) ? "Si" : "No", separador)
            });
            sb.AppendLine(linea);
        }

        return sb.ToString();
    }

    private async Task GenerarReporteListadosAccionistasAsync()
    {
        procesandoReporte = true;
        StateHasChanged();

        try
        {
            var sociedad = await repoSociedad.GetByIdAsync(sociedadAccionistaSeleccionada);
            string nombreSociedad = sociedad?.Empresa?.Nombre ?? $"Sociedad_{sociedadAccionistaSeleccionada}";
            string nombreLimpioSociedad = System.Text.RegularExpressions.Regex.Replace(nombreSociedad, @"[^\w\s-]", "").Replace(" ", "_").Trim();

            long totalAccionesSociedad = 0;
            if (!string.IsNullOrEmpty(sociedad?.NumeroAcciones))
            {
                string soloNum = System.Text.RegularExpressions.Regex.Replace(sociedad.NumeroAcciones, @"[^\d]", "");
                if (long.TryParse(soloNum, out long numParsed))
                {
                    totalAccionesSociedad = numParsed;
                }
            }

            // Obtener listado de accionistas al corte de fechaHasta reconciliando AccionistasSociedades y AccionistasSociedadesHistoricoNroAcciones (solo estatus activo = 1)
            var listadoCompleto = await repoAccionistaSociedad.GetListadoAccionistasAlCorteAsync(sociedadAccionistaSeleccionada, fechaHasta!.Value, 1);
            var listado = listadoCompleto.Where(x => x.EstatusId == null || x.EstatusId == 1).ToList();

            if (!listado.Any())
            {
                await MostrarNotificacion($"No se encontraron accionistas para {nombreSociedad} a la fecha de corte {fechaHasta:dd/MM/yyyy}.", true);
                return;
            }

            decimal? capitalSocial = sociedad?.CapitalPagado ?? sociedad?.CapitalSuscrito;
            decimal? valorNominal = sociedad?.ValorAccion;
            if ((valorNominal == null || valorNominal == 0) && capitalSocial.HasValue && totalAccionesSociedad > 0)
            {
                valorNominal = Math.Round(capitalSocial.Value / (decimal)totalAccionesSociedad, 3);
            }

            var encabezado = new SociedadEncabezadoReporteDto
            {
                SociedadId = sociedadAccionistaSeleccionada,
                NombreEmpresa = nombreSociedad,
                CapitalSocial = capitalSocial,
                TotalAcciones = totalAccionesSociedad > 0 ? totalAccionesSociedad : listado.Sum(x => x.NroAcciones),
                ValorNominal = valorNominal,
                Moneda = sociedad?.Moneda?.Simbolo ?? "Bs."
            };

            if (tipoFormatoSeleccionado.Equals("CSV", StringComparison.OrdinalIgnoreCase))
            {
                string csv = GenerarCsvListadoAccionistasAlCorte(encabezado, fechaHasta.Value, listado, ";");
                string fileName = $"Listado-Accionistas-{nombreLimpioSociedad}-al-{fechaHasta:yyyyMMdd}.csv";
                await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csv);
                await MostrarNotificacion($"Archivo CSV generado con {listado.Count} accionistas de {nombreSociedad}.");
            }
            else if (tipoFormatoSeleccionado.Equals("PDF", StringComparison.OrdinalIgnoreCase))
            {
                string baseFileName = $"Listado_Accionistas_{nombreLimpioSociedad}_al_{fechaHasta:yyyyMMdd}";
                await ReportService.GenerarYDescargarReporteListadoAccionistasCorteAsync(
                    encabezado,
                    fechaHasta.Value,
                    listado,
                    baseFileName
                );

                await MostrarNotificacion($"Reporte PDF generado exitosamente con {listado.Count} accionistas de {nombreSociedad}.");
            }
        }
        catch (Exception ex)
        {
            string errorDetallado = ex.InnerException != null ? $"{ex.Message} -> {ex.InnerException.Message}" : ex.Message;
            await MostrarNotificacion("Error al generar el listado de accionistas: " + errorDetallado, true);
        }
        finally
        {
            procesandoReporte = false;
            StateHasChanged();
        }
    }

