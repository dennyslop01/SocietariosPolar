        // Fila Totalizadora
        decimal totalDecretado = detalles.Sum(x => x.MontoDecretado);
        decimal totalRetenido = detalles.Sum(x => x.MontoRetenido);
        decimal totalNeto = detalles.Sum(x => x.MontoNetoPagado);
