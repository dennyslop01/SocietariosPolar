    private async Task OnTipoAccionistaCertificacionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            tipoAccionistaCertificacionSeleccionado = id;
        }
        else
        {
            tipoAccionistaCertificacionSeleccionado = 0;
        }
        errorTipoAccionistaCertificacion = false;

        await CargarAccionistasCertificacionesAsync();
    }

    private async Task CargarAccionistasCertificacionesAsync()
    {
        accionistaCertificacionSeleccionado = 0;
        listaAccionistasCertificaciones.Clear();

        if (sociedadCertificacionSeleccionada <= 0 || tipoAccionistaCertificacionSeleccionado <= 0)
        {
            return;
        }

        cargandoAccionistasCertificaciones = true;
        textoBusquedaAccionistaCertificacion = "";
        isDropdownOpenAccionistaCertificacion = false;
        StateHasChanged();

        try
        {
            var accionistasSoc = await repoAccionistaSociedad.GetBySociedadIdAsync(sociedadCertificacionSeleccionada);

            var filtrados = accionistasSoc
                .Where(x => x.Accionista != null &&
                            x.Accionista.TipoAccionista != null &&
                            x.Accionista.TipoAccionista.Id == tipoAccionistaCertificacionSeleccionado &&
                            (x.EstatusAccionista == null || x.EstatusAccionista.Id == 1) &&
                            x.CustodioId == null)
                .ToList();

            listaAccionistasCertificaciones = filtrados
                .GroupBy(x => x.Accionista!.Id)
                .Select(g => {
                    var x = g.First();
                    var acc = x.Accionista!;
                    string nombre = (acc.TipoAccionista?.Id == 3 && !string.IsNullOrWhiteSpace(acc.NombreSusesion))
                        ? acc.NombreSusesion.Trim()
                        : (acc.Nombre?.Trim() ?? "Sin Nombre");

                    string documento = (acc.TipoAccionista?.Id == 3 && !string.IsNullOrWhiteSpace(acc.CedulaSusesion))
                        ? acc.CedulaSusesion.Trim()
                        : (acc.Documento1?.Trim() ?? "");

                    string tipoDoc = acc.TipoDocumento1?.Nombre ?? "";
                    string docFormateado;
                    if (acc.TipoAccionista?.Id == 1)
                    {
                        docFormateado = UtilClass.FormatearDocumentoPersonaNatural(tipoDoc, documento);
                    }
                    else
                    {
                        docFormateado = !string.IsNullOrEmpty(tipoDoc) && !string.IsNullOrEmpty(documento) && !documento.StartsWith(tipoDoc)
                            ? $"{tipoDoc}-{documento}"
                            : documento;
                    }

                    return new ItemAccionistaCertificacion
                    {
                        AccionistaId = acc.Id,
                        AccionistaSociedadId = x.Id,
                        Nombre = nombre,
                        Documento = docFormateado,
                        NroAcciones = g.Sum(s => s.NroAcciones ?? 0)
                    };
                })
                .OrderBy(x => x.Nombre)
                .ToList();
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error cargando accionistas: " + ex.Message, true);
        }
        finally
        {
            cargandoAccionistasCertificaciones = false;
            StateHasChanged();
        }
    }

    private void ToggleDropdownAccionistaCertificacion()
    {
        isDropdownOpenAccionistaCertificacion = !isDropdownOpenAccionistaCertificacion;
        if (!isDropdownOpenAccionistaCertificacion)
