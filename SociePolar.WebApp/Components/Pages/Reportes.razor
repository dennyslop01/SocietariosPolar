    private async Task GenerarReporteConciliacionesAsync()
    {
        procesandoReporte = true;
        StateHasChanged();

        try
        {
            var sociedad = await repoSociedad.GetByIdAsync(sociedadConciliacionSeleccionada);
            string nombreSociedad = sociedad?.Empresa?.Nombre ?? $"Sociedad_{sociedadConciliacionSeleccionada}";
            string nombreLimpioSociedad = System.Text.RegularExpressions.Regex.Replace(nombreSociedad, @"[^\w\s-]", "").Replace(" ", "_").Trim();

            var detalles = await repoConciliacion.GetConciliacionesReporteAsync(sociedadConciliacionSeleccionada, fechaDesde!.Value, fechaHasta!.Value);

            if (!detalles.Any())
            {
                await MostrarNotificacion($"No se encontraron procesos de conciliación para {nombreSociedad} en el rango seleccionado ({fechaDesde:dd/MM/yyyy} al {fechaHasta:dd/MM/yyyy}).", true);
                return;
            }

            var ingresaron = detalles.Where(x => x.CategoriaMovimiento == "Ingreso").ToList();
            var compraron = detalles.Where(x => x.CategoriaMovimiento == "Compra").ToList();
            var vendieron = detalles.Where(x => x.CategoriaMovimiento == "Venta").ToList();
            var egresaron = detalles.Where(x => x.CategoriaMovimiento == "Egreso").ToList();
            var sinVariacion = detalles.Where(x => x.CategoriaMovimiento == "Sin Variación").ToList();

            var encabezado = new ConciliacionEncabezadoReporteDto
            {
                SociedadId = sociedadConciliacionSeleccionada,
                NombreEmpresa = nombreSociedad,
                FechaDesde = fechaDesde.Value,
                FechaHasta = fechaHasta.Value,
                TotalProcesosConciliacion = detalles.Select(d => d.ConciliacionId).Distinct().Count(),
                CantidadTotalAcciones = detalles.Where(x => !string.Equals(x.Accion, "Inactivado", StringComparison.OrdinalIgnoreCase)).Sum(x => x.SaldoNuevo),
                TotalAccionistasConciliados = detalles.Where(x => !string.Equals(x.Accion, "Inactivado", StringComparison.OrdinalIgnoreCase)).Select(x => x.CedulaRif).Distinct().Count(),
                TotalNuevos = ingresaron.Count,
                TotalActualizados = compraron.Count + vendieron.Count + sinVariacion.Count,
                TotalInactivados = egresaron.Count,
                TotalSaldoAnterior = detalles.Sum(x => x.SaldoAnterior),
                TotalSaldoNuevo = detalles.Sum(x => x.SaldoNuevo),
                TotalVariacion = detalles.Sum(x => x.Variacion),

                TotalIngresaron = ingresaron.Count,
                AccionesIngresadas = ingresaron.Sum(x => x.Variacion),
                TotalCompraron = compraron.Count,
                AccionesCompradas = compraron.Sum(x => x.Variacion),
                TotalVendieron = vendieron.Count,
                AccionesVendidas = Math.Abs(vendieron.Sum(x => x.Variacion)),
                TotalEgresaron = egresaron.Count,
                AccionesEgresadas = Math.Abs(egresaron.Sum(x => x.Variacion)),
                TotalSinVariacion = sinVariacion.Count,
                AccionesSinVariacion = sinVariacion.Sum(x => x.SaldoNuevo)
            };

            if (tipoFormatoSeleccionado.Equals("CSV", StringComparison.OrdinalIgnoreCase))
            {
                string csv = GenerarCsvReporteConciliaciones(encabezado, detalles, ";");
                string fileName = $"Reporte-Conciliaciones-{nombreLimpioSociedad}-{fechaDesde:yyyyMMdd}-{fechaHasta:yyyyMMdd}.csv";
                await jsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, csv);
                await MostrarNotificacion($"Archivo CSV generado con {detalles.Count} movimientos de conciliación de {nombreSociedad}.");
            }
            else if (tipoFormatoSeleccionado.Equals("PDF", StringComparison.OrdinalIgnoreCase))
            {
                string baseFileName = $"Reporte_Conciliaciones_{nombreLimpioSociedad}_{fechaDesde:yyyyMMdd}_{fechaHasta:yyyyMMdd}";
                await ReportService.GenerarYDescargarReporteConciliacionesAsync(
                    encabezado,
                    detalles,
                    baseFileName
                );

                await MostrarNotificacion($"Reporte PDF generado exitosamente con {detalles.Count} movimientos de conciliación.");
            }
        }
        catch (Exception ex)
        {
            string errorDetallado = ex.InnerException != null ? $"{ex.Message} -> {ex.InnerException.Message}" : ex.Message;
            await MostrarNotificacion("Error al generar el reporte de conciliaciones: " + errorDetallado, true);
        }
        finally
        {
            procesandoReporte = false;
            StateHasChanged();
        }
    }

    private string GenerarCsvReporteConciliaciones(ConciliacionEncabezadoReporteDto enc, List<ConciliacionListadoReporteDto> detalles, string separador)
    {
        var sb = new StringBuilder();
        var cultura = new System.Globalization.CultureInfo("es-VE");

        // Fila 1: Nombre de la Empresa en Columna C
        string lineaEmpresa = string.Join(separador, new string[] {
            "", "", EscaparCsv(enc.NombreEmpresa ?? "", separador), "", "", "", "", "", ""
        });
        sb.AppendLine(lineaEmpresa);

        // Fila 2: PERÍODO en Columna C
        string lineaPeriodo = string.Join(separador, new string[] {
            "", "", "PERÍODO:", $"{enc.FechaDesde:dd/MM/yyyy} al {enc.FechaHasta:dd/MM/yyyy}", "", "", "", "", ""
        });
        sb.AppendLine(lineaPeriodo);

        // Fila 3: CANTIDAD TOTAL DE ACCIONES
        string lineaTotalAcciones = string.Join(separador, new string[] {
            "", "", "CANTIDAD TOTAL DE ACCIONES:", enc.CantidadTotalAcciones.ToString("N0", cultura), "", "", "", "", ""
        });
        sb.AppendLine(lineaTotalAcciones);

        // Fila 4: TOTAL ACCIONISTAS CONCILIADOS
        string lineaTotalAccionistas = string.Join(separador, new string[] {
            "", "", "TOTAL ACCIONISTAS CONCILIADOS:", enc.TotalAccionistasConciliados.ToString("N0", cultura), "", "", "", "", ""
        });
        sb.AppendLine(lineaTotalAccionistas);

        // Fila 5: RESUMEN ESPECÍFICO DE MOVIMIENTOS
        string lineaMovimientos = string.Join(separador, new string[] {
            "", "", "RESUMEN DE MOVIMIENTOS:",
            $"Ingresaron: {enc.TotalIngresaron:N0} (+{enc.AccionesIngresadas:N0} acc.)",
            $"Compraron: {enc.TotalCompraron:N0} (+{enc.AccionesCompradas:N0} acc.)",
            $"Vendieron: {enc.TotalVendieron:N0} (-{enc.AccionesVendidas:N0} acc.)",
            $"Egresaron: {enc.TotalEgresaron:N0} (-{enc.AccionesEgresadas:N0} acc.)",
            $"Sin Variación: {enc.TotalSinVariacion:N0}",
            ""
        });
        sb.AppendLine(lineaMovimientos);

        // Fila 6: En blanco
        sb.AppendLine();

        // Fila 7: Título del Reporte
        string lineaTitulo = string.Join(separador, new string[] {
            $"REPORTE DE CONCILIACIÓN DE ACCIONES ({enc.FechaDesde:dd.MM.yyyy} AL {enc.FechaHasta:dd.MM.yyyy})"
        });
        sb.AppendLine(lineaTitulo);
        sb.AppendLine();

        // Método auxiliar para escribir secciones
        void EscribirSeccion(string tituloSeccion, List<ConciliacionListadoReporteDto> grupo, string etiquetaSubtotal)
        {
            if (!grupo.Any()) return;

            sb.AppendLine(tituloSeccion);
            string encabezadoTabla = string.Join(separador, new string[] {
                "#", "FECHA", "ACCIÓN", "TIPO DOC.", "CÉDULAS O R.I.F.", "ACCIONISTAS", "SALDO ANTERIOR", "SALDO NUEVO", "VARIACIÓN"
            });
            sb.AppendLine(encabezadoTabla);

            int secCorrelativo = 1;
            foreach (var item in grupo)
            {
                string variacionStr = item.Variacion > 0
                    ? $"+{item.Variacion.ToString("N0", cultura)}"
                    : item.Variacion.ToString("N0", cultura);

                string linea = string.Join(separador, new string[] {
                    (secCorrelativo++).ToString(),
                    item.FechaConciliacion?.ToString("dd/MM/yyyy") ?? "-",
                    EscaparCsv(item.Accion ?? "", separador),
                    EscaparCsv(item.TipoDocumento ?? "", separador),
                    EscaparCsv(item.CedulaRif ?? "", separador),
                    EscaparCsv(item.NombreAccionista ?? "", separador),
                    item.SaldoAnterior.ToString("N0", cultura),
                    item.SaldoNuevo.ToString("N0", cultura),
                    variacionStr
                });
                sb.AppendLine(linea);
            }

            long subSaldoAnt = grupo.Sum(x => x.SaldoAnterior);
            long subSaldoNue = grupo.Sum(x => x.SaldoNuevo);
            long subVar = grupo.Sum(x => x.Variacion);
            string subVarStr = subVar > 0 ? $"+{subVar.ToString("N0", cultura)}" : subVar.ToString("N0", cultura);

            string filaSubtotal = string.Join(separador, new string[] {
                etiquetaSubtotal, "", "", "", "", "",
                subSaldoAnt.ToString("N0", cultura),
                subSaldoNue.ToString("N0", cultura),
                subVarStr
            });
            sb.AppendLine(filaSubtotal);
            sb.AppendLine();
        }

        var ingresaron = detalles.Where(x => x.CategoriaMovimiento == "Ingreso").ToList();
        var compraron = detalles.Where(x => x.CategoriaMovimiento == "Compra").ToList();
        var vendieron = detalles.Where(x => x.CategoriaMovimiento == "Venta").ToList();
        var egresaron = detalles.Where(x => x.CategoriaMovimiento == "Egreso").ToList();
        var sinVariacion = detalles.Where(x => x.CategoriaMovimiento == "Sin Variación").ToList();

        EscribirSeccion("1. ACCIONISTAS QUE INGRESARON", ingresaron, "SUBTOTAL INGRESARON");
        EscribirSeccion("2. ACCIONISTAS QUE COMPRARON", compraron, "SUBTOTAL COMPRARON");
        EscribirSeccion("3. ACCIONISTAS QUE VENDIERON", vendieron, "SUBTOTAL VENDIERON");
        EscribirSeccion("4. ACCIONISTAS QUE EGRESARON", egresaron, "SUBTOTAL EGRESARON");
        if (sinVariacion.Any())
        {
            EscribirSeccion("5. ACCIONISTAS SIN VARIACIÓN", sinVariacion, "SUBTOTAL SIN VARIACIÓN");
        }

        // Fila Totalizadora General
        long totalSaldoAnterior = detalles.Sum(x => x.SaldoAnterior);
        long totalSaldoNuevo = detalles.Sum(x => x.SaldoNuevo);
        long totalVariacion = detalles.Sum(x => x.Variacion);

        string totalVarStr = totalVariacion > 0
            ? $"+{totalVariacion.ToString("N0", cultura)}"
            : totalVariacion.ToString("N0", cultura);

        string filaTotalesGeneral = string.Join(separador, new string[] {
            "TOTAL GENERAL CONCILIACIÓN", "", "", "", "", "",
            totalSaldoAnterior.ToString("N0", cultura),
            totalSaldoNuevo.ToString("N0", cultura),
            totalVarStr
        });
        sb.AppendLine(filaTotalesGeneral);

        return sb.ToString();
    }

    private string GenerarCsvListadoAccionistasAlCorte(SociedadEncabezadoReporteDto enc, DateTime fechaCorte, List<AccionistaListadoCorteDto> listado, string separador)
    {
        var sb = new StringBuilder();
        var cultura = new System.Globalization.CultureInfo("es-VE");

        // Fila 1: Nombre de la Empresa en Columna C
        string lineaEmpresa = string.Join(separador, new string[] {
            "", "", EscaparCsv(enc.NombreEmpresa ?? "", separador), "", ""
        });
        sb.AppendLine(lineaEmpresa);

        // Fila 2: CAPITAL SOCIAL en Columna C, Bs. en Columna D, Monto en Columna E
        string capSocialStr = enc.CapitalSocial.HasValue ? enc.CapitalSocial.Value.ToString("N2", cultura) : "0,00";
        string lineaCapital = string.Join(separador, new string[] {
            "", "", "CAPITAL SOCIAL:", "Bs.", capSocialStr
        });
        sb.AppendLine(lineaCapital);

        // Fila 3: TOTAL ACCIONES en Columna C, Total en Columna E
        string lineaTotalAcciones = string.Join(separador, new string[] {
            "", "", "TOTAL ACCIONES:", "", enc.TotalAcciones.ToString("N0", cultura)
        });
        sb.AppendLine(lineaTotalAcciones);

        // Fila 4: VALOR NOMINAL en Columna C, Bs. en Columna D, Monto en Columna E
        string valNomStr = enc.ValorNominal.HasValue ? enc.ValorNominal.Value.ToString("0.000", cultura) : "0,000";
        string lineaValorNominal = string.Join(separador, new string[] {
            "", "", "VALOR NOMINAL:", "Bs.", valNomStr
        });
        sb.AppendLine(lineaValorNominal);

        // Fila 5: En blanco
        sb.AppendLine();

        // Fila 6: Título del Listado iniciando en Columna A
        string lineaTitulo = string.Join(separador, new string[] {
            $"LISTADO ACCIONISTAS AL {fechaCorte:dd.MM.yyyy}", "", "", "", ""
        });
        sb.AppendLine(lineaTitulo);

        // Fila 7: Encabezados de Columna (iniciando en Columna A)
        string encabezado = string.Join(separador, new string[] {
            "#", "Cédulas o R.I.F.", "ACCIONISTAS", "ACCIONES", "PORCENTAJES"
        });
        sb.AppendLine(encabezado);

        // Filas de Detalle (iniciando en Columna A)
        foreach (var item in listado)
        {
            string linea = string.Join(separador, new string[] {
                item.Numero.ToString(),
                EscaparCsv(item.CedulaRif ?? "", separador),
                EscaparCsv(item.NombreAccionista ?? "", separador),
                item.NroAcciones.ToString("N0", cultura),
                item.PorcentajeParticipacion.ToString("0.000000", cultura)
            });
            sb.AppendLine(linea);
        }

        // Fila Totalizadora: TOTAL ACCIONES en Columna C, Total en D, Porcentaje en E
        long totalAcciones = listado.Sum(x => x.NroAcciones);
        string lineaTotal = string.Join(separador, new string[] {
            "",
            "",
            "TOTAL ACCIONES",
            totalAcciones.ToString("N0", cultura),
            "100,000000"
        });
        sb.AppendLine(lineaTotal);

        return sb.ToString();
    }

    private string GenerarCsvListadoAccionistasSociedad(List<AccionistaSociedad> lista, string nombreSociedad, long totalAccionesSociedad, string separador)
    {
        var sb = new StringBuilder();

        string encabezado = string.Join(separador, new string[] {
            "Sociedad", "NombreAccionista", "TipoAccionista", "TipoDocumento", "Documento",
            "NroAcciones", "PorcentajeParticipacion", "EstatusAccionista", "Email", "Telefono",
            "FechaIngreso", "FechaRegistro", "UltimaModificacion"
        });
        sb.AppendLine(encabezado);

        foreach (var item in lista)
        {
            long nroAcciones = item.NroAcciones ?? 0;
            decimal porc = 0;
            if (totalAccionesSociedad > 0 && nroAcciones > 0)
            {
                porc = Math.Round((decimal)nroAcciones / totalAccionesSociedad * 100, 4);
            }

            string nombreFinal = (item.Accionista?.TipoAccionista?.Id == 3)
                ? (item.Accionista?.NombreSusesion ?? item.Accionista?.Nombre ?? string.Empty)
                : (item.Accionista?.Nombre ?? string.Empty);

            string telefono = !string.IsNullOrWhiteSpace(item.Accionista?.Telefono1) ? item.Accionista.Telefono1 : (!string.IsNullOrWhiteSpace(item.Accionista?.TelefonoMovil) ? item.Accionista.TelefonoMovil : "-");

            string linea = string.Join(separador, new string[] {
                EscaparCsv(nombreSociedad, separador),
                EscaparCsv(nombreFinal, separador),
                EscaparCsv(item.Accionista?.TipoAccionista?.Nombre ?? "-", separador),
                EscaparCsv(item.Accionista?.TipoDocumento1?.Nombre ?? "-", separador),
                EscaparCsv(item.Accionista?.Documento1 ?? "-", separador),
                EscaparCsv(nroAcciones, separador),
                EscaparCsv(porc.ToString("0.0000", new System.Globalization.CultureInfo("es-VE")) + "%", separador),
                EscaparCsv(item.EstatusAccionista?.Nombre ?? "-", separador),
                EscaparCsv(item.Accionista?.Email1 ?? "-", separador),
                EscaparCsv(telefono, separador),
                EscaparCsv(item.Accionista?.FechaIngreso?.ToString("yyyy-MM-dd") ?? "-", separador),
                EscaparCsv(item.CreateDate.ToString("yyyy-MM-dd"), separador),
                EscaparCsv(item.UpdateDate.ToString("yyyy-MM-dd"), separador)
            });
            sb.AppendLine(linea);
        }

        return sb.ToString();
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }
}
