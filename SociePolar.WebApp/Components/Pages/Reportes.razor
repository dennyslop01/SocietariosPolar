        if (accionistaCertificacionSeleccionado == 0 || listaAccionistasCertificaciones == null)
        {
            return "Seleccione...";
        }
        var acc = listaAccionistasCertificaciones.FirstOrDefault(a => a.AccionistaId == accionistaCertificacionSeleccionado);
        return acc != null ? acc.DisplayText : "Seleccione...";
    }

    private void SeleccionarAccionistaCertificacion(int id)
    {
        accionistaCertificacionSeleccionado = id;
        errorAccionistaCertificacion = false;
        isDropdownOpenAccionistaCertificacion = false;
        textoBusquedaAccionistaCertificacion = "";
    }

    private async Task GenerarReporteCertificacionesAsync()
    {
        if (sociedadCertificacionSeleccionada <= 0 ||
            tipoAccionistaCertificacionSeleccionado <= 0 ||
            accionistaCertificacionSeleccionado <= 0)
        {
            await MostrarNotificacion("Debe seleccionar la Sociedad, el Tipo de Accionista y el Accionista.");
            return;
        }

        try
        {
            procesandoReporte = true;
            StateHasChanged();

            int socId = sociedadCertificacionSeleccionada;
            int tipoId = tipoAccionistaCertificacionSeleccionado;
            int accId = accionistaCertificacionSeleccionado;

            // 1. Obtener la Sociedad completa
            var sociedad = await repoSociedad.GetByIdAsync(socId);
            if (sociedad == null)
            {
                await MostrarNotificacion("No se encontró la información de la sociedad seleccionada.");
                return;
            }

            // 2. Obtener el Accionista completo
            var accionista = await repoAccionista.GetByIdAsync(accId);
            if (accionista == null)
            {
                await MostrarNotificacion("No se encontró la información del accionista seleccionado.");
                return;
            }

            // 3. Obtener el registro de AccionistaSociedad (para número de acciones)
            var accSoc = await repoAccionistaSociedad.GetBySociedadIdAccionistaIdCustodioIdAsync(socId, accId, null);
            long nroAcciones = accSoc?.NroAcciones ?? 0;

            if (nroAcciones == 0)
            {
                var itemLista = listaAccionistasCertificaciones.FirstOrDefault(x => x.AccionistaId == accId);
                if (itemLista != null)
                {
                    nroAcciones = itemLista.NroAcciones;
                }
            }

            // 4. Obtener total de acciones de la sociedad para calcular porcentaje (Sucesión)
            long totalAccionesSoc = await repoAccionistaSociedad.GetTotalAccionesBySociedadIdAsync(socId, 1);
            decimal porcentaje = 0m;
            if (totalAccionesSoc > 0 && nroAcciones > 0)
            {
                porcentaje = ((decimal)nroAcciones / totalAccionesSoc) * 100m;
            }

            // 5. Secretario (Patricia Hernández R. por defecto o de Autoridades si existe)
            string secNombre = "Patricia Hernández R.";
            string secNac = "venezolana";
            string secCed = "V-10.533.569";
            string secCargo = "Secretario de la Junta Directiva";

            if (repoAutoridad != null)
            {
                var autoridades = await repoAutoridad.GetBySociedadIdAsync(socId);
                var sec = autoridades.FirstOrDefault(a => (a.Cargo?.Nombre ?? "").Contains("Secretari", StringComparison.OrdinalIgnoreCase));
                if (sec != null && !string.IsNullOrWhiteSpace(sec.Nombre))
                {
                    secNombre = sec.Nombre.Trim();
                    string doc = UtilClass.ObtenerDocumentoCompleto(sec.TipoDocumento1?.Nombre, sec.Documento1);
                    if (!string.IsNullOrWhiteSpace(doc) && doc != "-")
                    {
                        secCed = doc;
                    }
                }
            }

            // 6. RIF Sociedad
            string rifSoc = UtilClass.ObtenerDocumentoCompleto(sociedad.TipoDocumento1?.Nombre, sociedad.Documento1);
            if (string.IsNullOrWhiteSpace(rifSoc) || rifSoc == "-")
            {
                rifSoc = sociedad.Documento1 ?? "";
            }

            // 7. Nombre y Documento Accionista
            string docAcc;
            if (tipoId == 1) // Persona Natural con formato de miles y millones (.)
            {
                docAcc = UtilClass.FormatearDocumentoPersonaNatural(accionista.TipoDocumento1?.Nombre, accionista.Documento1);
            }
            else
            {
                docAcc = UtilClass.ObtenerDocumentoCompleto(accionista.TipoDocumento1?.Nombre, accionista.Documento1);
                if (string.IsNullOrWhiteSpace(docAcc) || docAcc == "-")
                {
                    docAcc = accionista.Documento1 ?? "";
                }
            }

            string nombreAcc = accionista.Nombre ?? "";
            if (tipoId == 3 && !string.IsNullOrWhiteSpace(accionista.NombreSusesion))
            {
                nombreAcc = accionista.NombreSusesion.Trim();
            }

            // 8. Expediente y RIF Sucesión
            string expSucesion = "150443";
            if (!string.IsNullOrWhiteSpace(accionista.Declaracion)) expSucesion = accionista.Declaracion.Trim();
            else if (!string.IsNullOrWhiteSpace(accionista.DatosDeclaracion)) expSucesion = accionista.DatosDeclaracion.Trim();
            else if (!string.IsNullOrWhiteSpace(accionista.DocumentosRelacionados)) expSucesion = accionista.DocumentosRelacionados.Trim();

            string rifSucesion = !string.IsNullOrWhiteSpace(accionista.CedulaSusesion)
                ? accionista.CedulaSusesion.Trim()
                : docAcc;

            // 9. Valores y Fechas
            DateTime fechaHoy = DateTime.Now;
            decimal valorNominal = sociedad.ValorAccion ?? 0.001m;
            decimal valorPatrimonial = sociedad.ValorPatrimonial ?? 6.27m;

            string fechaBalance = !string.IsNullOrWhiteSpace(sociedad.EjercicioEconomico)
                ? (sociedad.EjercicioEconomico.Contains("30 de septiembre", StringComparison.OrdinalIgnoreCase)
                    ? sociedad.EjercicioEconomico
                    : $"30 de septiembre de {fechaHoy.Year - 1}")
                : $"30 de septiembre de {fechaHoy.Year - 1}";

            // Registro Accionista (Persona Jurídica)
            string regAcc = accionista.InscritoEn ?? accionista.DatosDocumentoConstitutivo ?? "";

            var dto = new CertificacionReportDto
            {
                TipoAccionistaId = tipoId,

                // Sociedad
                SociedadId = socId,
                SociedadNombre = sociedad.Empresa?.Nombre ?? "Sociedad",
                SociedadNombreCorto = sociedad.Empresa?.Nombre ?? "Sociedad",
                SociedadRif = rifSoc,
                SociedadDomicilio = !string.IsNullOrWhiteSpace(sociedad.Domicilio) ? sociedad.Domicilio : "Caracas",
                SociedadDatosConstitucion = sociedad.DatosConstitucion ?? "",

                // Secretario
                SecretarioNombre = secNombre,
                SecretarioNacionalidad = secNac,
                SecretarioCedula = secCed,
                SecretarioCargo = secCargo,

                // Accionista
                AccionistaId = accId,
                AccionistaNombre = nombreAcc,
                AccionistaNacionalidad = !string.IsNullOrWhiteSpace(accionista.Nacionalidad) ? accionista.Nacionalidad : "venezolano",
                AccionistaDocumento = docAcc,
                AccionistaDomicilio = !string.IsNullOrWhiteSpace(accionista.DomiciliadoEn) ? accionista.DomiciliadoEn : "Caracas",
                AccionistaRegistro = regAcc,

                // Sucesión
                ExpedienteSucesion = expSucesion,
                RifSucesion = rifSucesion,

                // Acciones y valores
                NroAcciones = nroAcciones,
                NroAccionesEnLetras = NumeroALetrasHelper.ConvertirAcciones(nroAcciones),
                ValorNominal = valorNominal,
                ValorNominalEnLetras = NumeroALetrasHelper.ConvertirValorNominal(valorNominal),
                PorcentajeAcciones = porcentaje,
                FechaBalance = fechaBalance,
                ValorPatrimonial = valorPatrimonial,
                ValorPatrimonialEnLetras = NumeroALetrasHelper.ConvertirMontoBolivares(valorPatrimonial),

                // Emisión
                FechaEmision = fechaHoy,
                Dia = fechaHoy.Day,
                DiaEnLetras = NumeroALetrasHelper.ConvertirDia(fechaHoy.Day),
                MesNombre = NumeroALetrasHelper.ObtenerMesNombre(fechaHoy.Month),
                Ano = fechaHoy.Year,
                AnoEnLetras = NumeroALetrasHelper.ConvertirAno(fechaHoy.Year)
            };

            string tipoNombre = tipoId == 1 ? "Natural" : (tipoId == 2 ? "Juridico" : "Sucesion");
            string baseFilename = $"Certificacion_{tipoNombre}_{sociedad.Empresa?.Nombre}_{nombreAcc}";

            await ReportService.GenerarYDescargarCertificacionCartaAsync(dto, baseFilename);
        }
        catch (Exception ex)
        {
            await MostrarNotificacion($"Error generando la certificación: {ex.Message}");
        }
        finally
        {
            procesandoReporte = false;
            StateHasChanged();
        }
    }

