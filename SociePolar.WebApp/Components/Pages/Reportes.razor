@page "/reportes"
@rendermode InteractiveServer
@using System.Text
@using SociePolar.Domain.Models
@using SociePolar.Domain.Entities
@using SociePolar.Application.Interfaces
@using SociePolar.WebApp.Services
@using SociePolar.WebApp.Utilities

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0" style="min-height: 580px;">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="p-2 rounded-3 me-3 shadow-sm" style="background-color: #00338D !important;">
                        <i class="bi bi-clipboard-data-fill text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            Generación de Reportes
                        </h5>
                        <small class="text-muted">Seleccione el tipo de reporte y los parámetros de consulta</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4 d-flex flex-column">
            @if (procesandoReporte)
            {
                <div class="d-flex flex-column justify-content-center align-items-center my-auto py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Generando...</span>
                    </div>
                    <span class="text-secondary fw-semibold">Generando reporte, por favor espere...</span>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <!-- Selector de Tipo de Reporte (Nivel 1) -->
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label fw-bold text-secondary small">
                            Tipo de Reporte <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm shadow-sm" value="@tipoReporteSeleccionado" @onchange="OnTipoReporteChanged">
                            <option value="0">Seleccione...</option>
                            @foreach (var modulo in ListModulos)
                            {
                                <option value="@modulo.Id">@modulo.Nombre</option>
                            }
                        </select>
                    </div>

                    @if (tipoReporteSeleccionado == 1)
                    {
                        <!-- Selector de Criterio para Sociedades (Nivel 2) -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Criterio de Sociedades <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm shadow-sm @(errorFiltroSociedad ? "is-invalid" : "")"
                                    value="@filtroSociedadSeleccionado"
                                    @onchange="OnFiltroSociedadChanged">
                                <option value="">Seleccione...</option>
                                <option value="activas">Activas</option>
                                <option value="inactivas">Inactivas</option>
                                <option value="region">Región</option>
                                <option value="unidad_negocio">Unidad de Negocio</option>
                                <option value="tipo_sociedad">Tipo de Sociedad</option>
                            </select>
                            @if (errorFiltroSociedad)
                            {
                                <div class="invalid-feedback small">Debe seleccionar un criterio.</div>
                            }
                        </div>

                        @if (RequiereTerceraLista)
                        {
                            <!-- Selector de Tabla Básica (Nivel 3) -->
                            <div class="col-md-6 col-lg-4">
                                <label class="form-label fw-bold text-secondary small">
                                    @TituloTerceraLista <span class="text-danger">*</span>
                                </label>
                                @if (cargandoCatalogo)
                                {
                                    <div class="d-flex align-items-center mt-1">
                                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                        <span class="text-muted small">Cargando datos...</span>
                                    </div>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm shadow-sm @(errorValorTercerNivel ? "is-invalid" : "")"
                                            @bind="valorTercerNivel">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var item in listaTercerNivel)
                                        {
                                            <option value="@item.Id">@item.Nombre</option>
                                        }
                                    </select>
                                    @if (errorValorTercerNivel)
                                    {
                                        <div class="invalid-feedback small">Debe seleccionar una opción de @TituloTerceraLista.</div>
                                    }
                                }
                            </div>
                        }
                    }

                    @if (tipoReporteSeleccionado == 3)
                    {
                        <!-- Selector de Sociedad para Dividendos con buscador integrado (Solo sociedades con dividendos definitivos cerrados) -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Sociedad <span class="text-danger">*</span>
                            </label>
                            @if (cargandoSociedadesDividendos)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="text-muted small">Cargando sociedades con dividendos...</span>
                                </div>
                            }
                            else
                            {
                                @if (isDropdownOpenSociedadDividendo)
                                {
                                    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1055;"
                                         @onclick="() => isDropdownOpenSociedadDividendo = false"></div>
                                }
                                <div class="dropdown position-relative" style="z-index: 1060;">
                                    <button class="form-select form-select-sm text-start d-flex justify-content-between align-items-center shadow-sm @(errorSociedadDividendo ? "is-invalid" : "")"
                                            type="button"
                                            @onclick="ToggleDropdownSociedadDividendo">
                                        <span class="text-truncate me-2">@ObtenerNombreSociedadDividendoSeleccionada()</span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-2 shadow-lg @(isDropdownOpenSociedadDividendo ? "show" : "")"
                                        style="max-height: 320px; overflow-y: auto; z-index: 1060;">
                                        <li class="mb-2">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white border-end-0 text-muted">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text"
                                                       class="form-control border-start-0"
                                                       placeholder="Buscar sociedad..."
                                                       style="font-size: 0.8rem;"
                                                       @bind="textoBusquedaSociedadDividendo"
                                                       @bind:event="oninput" />
                                            </div>
                                        </li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item py-1 @(sociedadDividendoSeleccionada == 0 ? "active bg-primary text-white" : "")"
                                                    style="font-size: 0.8rem;"
                                                    @onclick="() => SeleccionarSociedadDividendo(0)">
                                                Seleccione...
                                            </button>
                                        </li>

                                        @foreach (var soc in listaSociedadesDividendos.Where(s => string.IsNullOrEmpty(textoBusquedaSociedadDividendo) || (s.Empresa?.Nombre?.Contains(textoBusquedaSociedadDividendo, StringComparison.OrdinalIgnoreCase) ?? false)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item py-1 @(sociedadDividendoSeleccionada == soc.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarSociedadDividendo(soc.Id)">
                                                    @soc.Empresa?.Nombre
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                @if (errorSociedadDividendo)
                                {
                                    <div class="invalid-feedback d-block small">Debe seleccionar una sociedad.</div>
                                }
                            }
                        </div>
                    }

                    @if (tipoReporteSeleccionado == 5)
                    {
                        <!-- Selector de Sociedad para Conciliaciones con buscador integrado (Solo sociedades que tienen procesos de conciliación) -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Sociedad <span class="text-danger">*</span>
                            </label>
                            @if (cargandoSociedadesConciliacion)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="text-muted small">Cargando sociedades con conciliaciones...</span>
                                </div>
                            }
                            else
                            {
                                @if (isDropdownOpenSociedadConciliacion)
                                {
                                    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1055;"
                                         @onclick="() => isDropdownOpenSociedadConciliacion = false"></div>
                                }
                                <div class="dropdown position-relative" style="z-index: 1060;">
                                    <button class="form-select form-select-sm text-start d-flex justify-content-between align-items-center shadow-sm @(errorSociedadConciliacion ? "is-invalid" : "")"
                                            type="button"
                                            @onclick="ToggleDropdownSociedadConciliacion">
                                        <span class="text-truncate me-2">@ObtenerNombreSociedadConciliacionSeleccionada()</span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-2 shadow-lg @(isDropdownOpenSociedadConciliacion ? "show" : "")"
                                        style="max-height: 320px; overflow-y: auto; z-index: 1060;">
                                        <li class="mb-2">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white border-end-0 text-muted">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text"
                                                       class="form-control border-start-0"
                                                       placeholder="Buscar sociedad..."
                                                       style="font-size: 0.8rem;"
                                                       @bind="textoBusquedaSociedadConciliacion"
                                                       @bind:event="oninput" />
                                            </div>
                                        </li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item py-1 @(sociedadConciliacionSeleccionada == 0 ? "active bg-primary text-white" : "")"
                                                    style="font-size: 0.8rem;"
                                                    @onclick="() => SeleccionarSociedadConciliacion(0)">
                                                Seleccione...
                                            </button>
                                        </li>

                                        @foreach (var soc in listaSociedadesConciliacion.Where(s => string.IsNullOrEmpty(textoBusquedaSociedadConciliacion) || (s.Empresa?.Nombre?.Contains(textoBusquedaSociedadConciliacion, StringComparison.OrdinalIgnoreCase) ?? false)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item py-1 @(sociedadConciliacionSeleccionada == soc.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarSociedadConciliacion(soc.Id)">
                                                    @soc.Empresa?.Nombre
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                @if (errorSociedadConciliacion)
                                {
                                    <div class="invalid-feedback d-block small">Debe seleccionar una sociedad.</div>
                                }
                            }
                        </div>
                    }

                    @if (tipoReporteSeleccionado == 6)
                    {
                        <!-- 1. Selector de Sociedad (Sociedades Activas) con buscador integrado para Certificaciones -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Sociedad Activa <span class="text-danger">*</span>
                            </label>
                            @if (cargandoSociedadesCertificaciones)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="text-muted small">Cargando sociedades activas...</span>
                                </div>
                            }
                            else
                            {
                                @if (isDropdownOpenSociedadCertificacion)
                                {
                                    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1055;"
                                         @onclick="() => isDropdownOpenSociedadCertificacion = false"></div>
                                }
                                <div class="dropdown position-relative" style="z-index: 1060;">
                                    <button class="form-select form-select-sm text-start d-flex justify-content-between align-items-center shadow-sm @(errorSociedadCertificacion ? "is-invalid" : "")"
                                            type="button"
                                            @onclick="ToggleDropdownSociedadCertificacion">
                                        <span class="text-truncate me-2">@ObtenerNombreSociedadCertificacionSeleccionada()</span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-2 shadow-lg @(isDropdownOpenSociedadCertificacion ? "show" : "")"
                                        style="max-height: 320px; overflow-y: auto; z-index: 1060;">
                                        <li class="mb-2">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white border-end-0 text-muted">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text"
                                                       class="form-control border-start-0"
                                                       placeholder="Buscar sociedad activa..."
                                                       style="font-size: 0.8rem;"
                                                       @bind="textoBusquedaSociedadCertificacion"
                                                       @bind:event="oninput" />
                                            </div>
                                        </li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item py-1 @(sociedadCertificacionSeleccionada == 0 ? "active bg-primary text-white" : "")"
                                                    style="font-size: 0.8rem;"
                                                    @onclick="() => SeleccionarSociedadCertificacion(0)">
                                                Seleccione...
                                            </button>
                                        </li>

                                        @foreach (var soc in listaSociedadesCertificaciones.Where(s => string.IsNullOrEmpty(textoBusquedaSociedadCertificacion) || (s.Empresa?.Nombre?.Contains(textoBusquedaSociedadCertificacion, StringComparison.OrdinalIgnoreCase) ?? false)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item py-1 @(sociedadCertificacionSeleccionada == soc.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarSociedadCertificacion(soc.Id)">
                                                    @soc.Empresa?.Nombre
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                @if (errorSociedadCertificacion)
                                {
                                    <div class="invalid-feedback d-block small">Debe seleccionar una sociedad activa.</div>
                                }
                            }
                        </div>

                        <!-- 2. Selector de Tipo de Accionista (Natural, Jurídico, Sucesión) -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Tipo de Accionista <span class="text-danger">*</span>
                            </label>
                            @if (cargandoTiposAccionistaCertificaciones)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="text-muted small">Cargando tipos de accionista...</span>
                                </div>
                            }
                            else
                            {
                                <select class="form-select form-select-sm shadow-sm @(errorTipoAccionistaCertificacion ? "is-invalid" : "")"
                                        value="@tipoAccionistaCertificacionSeleccionado"
                                        @onchange="OnTipoAccionistaCertificacionChanged">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var tipo in listaTiposAccionistaCertificaciones)
                                    {
                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                    }
                                </select>
                                @if (errorTipoAccionistaCertificacion)
                                {
                                    <div class="invalid-feedback small">Debe seleccionar un tipo de accionista.</div>
                                }
                            }
                        </div>
                    }

                    @if (tipoReporteSeleccionado == 2 || tipoReporteSeleccionado == 4)
                    {
                        <!-- Selector de Sociedad para Accionistas (Nivel 2) con buscador integrado -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Sociedad <span class="text-danger">*</span>
                            </label>
                            @if (cargandoSociedades)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="text-muted small">Cargando sociedades...</span>
                                </div>
                            }
                            else
                            {
                                @if (isDropdownOpenSociedad)
                                {
                                    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1055;"
                                         @onclick="() => isDropdownOpenSociedad = false"></div>
                                }
                                <div class="dropdown position-relative" style="z-index: 1060;">
                                    <button class="form-select form-select-sm text-start d-flex justify-content-between align-items-center shadow-sm @(errorSociedadAccionista ? "is-invalid" : "")"
                                            type="button"
                                            @onclick="ToggleDropdownSociedad">
                                        <span class="text-truncate me-2">@ObtenerNombreSociedadSeleccionada()</span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-2 shadow-lg @(isDropdownOpenSociedad ? "show" : "")"
                                        style="max-height: 320px; overflow-y: auto; z-index: 1060;">
                                        <li class="mb-2">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white border-end-0 text-muted">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text"
                                                       class="form-control border-start-0"
                                                       placeholder="Buscar sociedad..."
                                                       style="font-size: 0.8rem;"
                                                       @bind="textoBusquedaSociedad"
                                                       @bind:event="oninput" />
                                            </div>
                                        </li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item py-1 @(sociedadAccionistaSeleccionada == 0 ? "active bg-primary text-white" : "")"
                                                    style="font-size: 0.8rem;"
                                                    @onclick="() => SeleccionarSociedad(0)">
                                                Seleccione...
                                            </button>
                                        </li>

                                        @foreach (var soc in listaSociedadesAccionista.Where(s => string.IsNullOrEmpty(textoBusquedaSociedad) || (s.Empresa?.Nombre?.Contains(textoBusquedaSociedad, StringComparison.OrdinalIgnoreCase) ?? false)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item py-1 @(sociedadAccionistaSeleccionada == soc.Id ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarSociedad(soc.Id)">
                                                    @soc.Empresa?.Nombre
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                @if (errorSociedadAccionista)
                                {
                                    <div class="invalid-feedback d-block small">Debe seleccionar una sociedad.</div>
                                }
                            }
                        </div>

                        @if (tipoReporteSeleccionado == 2)
                        {
                            <!-- Selector de Estatus de Accionistas (Nivel 3) -->
                            <div class="col-md-6 col-lg-4">
                                <label class="form-label fw-bold text-secondary small">
                                    Estatus Accionistas <span class="text-danger">*</span>
                                </label>
                                <select class="form-select form-select-sm shadow-sm @(errorEstatusAccionista ? "is-invalid" : "")"
                                        @bind="estatusAccionistaSeleccionado">
                                    <option value="">Seleccione...</option>
                                    <option value="activos">Activos</option>
                                    <option value="inactivos">Inactivos</option>
                                </select>
                                @if (errorEstatusAccionista)
                                {
                                    <div class="invalid-feedback small">Debe seleccionar un estatus.</div>
                                }
                            </div>
                        }
                    }
                </div>

                <!-- Fila de formato para Sociedades cuando se ha seleccionado un criterio -->
                @if (tipoReporteSeleccionado == 1 && !string.IsNullOrWhiteSpace(filtroSociedadSeleccionado))
                {
                    <div class="row g-3 mt-1">
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Tipo de Formato <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm shadow-sm @(errorTipoFormato ? "is-invalid" : "")"
                                    @bind="tipoFormatoSeleccionado">
                                <option value="">Seleccione...</option>
                                <option value="CSV">CSV</option>
                                <option value="PDF">PDF</option>
                            </select>
                            @if (errorTipoFormato)
                            {
                                <div class="invalid-feedback small">El Tipo de Formato es obligatorio.</div>
                            }
                        </div>
                    </div>
                }

                <!-- Fila de formato para Accionistas cuando se ha seleccionado Sociedad y Estatus -->
                @if (tipoReporteSeleccionado == 2)
                {
                    <div class="row g-3 mt-1">
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-bold text-secondary small">
                                Tipo de Formato <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm shadow-sm @(errorTipoFormato ? "is-invalid" : "")"
                                    @bind="tipoFormatoSeleccionado">
                                <option value="">Seleccione...</option>
                                <option value="CSV">CSV</option>
                                <option value="PDF">PDF</option>
                            </select>
                            @if (errorTipoFormato)
                            {
                                <div class="invalid-feedback small">El Tipo de Formato es obligatorio.</div>
                            }
                        </div>
                    </div>
                }

                <!-- Controles de Fechas y Formato para los otros módulos (Dividendos, Listados de accionistas, Conciliaciones, etc.) -->
                @if (tipoReporteSeleccionado == 3 || tipoReporteSeleccionado == 4 || tipoReporteSeleccionado == 5)
                {
                    <div class="row g-3 mt-1">
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-bold text-secondary small">
                                Fecha Desde <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   class="form-control form-control-sm shadow-sm @(errorFechaDesde ? "is-invalid" : "")"
                                   @bind="fechaDesde" />
                            @if (errorFechaDesde)
                            {
                                <div class="invalid-feedback small">La Fecha Desde es obligatoria.</div>
                            }
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-bold text-secondary small">
                                Fecha Hasta <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   class="form-control form-control-sm shadow-sm @(errorFechaHasta ? "is-invalid" : "")"
                                   @bind="fechaHasta" />
                            @if (errorFechaHasta)
                            {
                                <div class="invalid-feedback small">La Fecha Hasta es obligatoria.</div>
                            }
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-bold text-secondary small">
                                Tipo de Formato <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm shadow-sm @(errorTipoFormato ? "is-invalid" : "")"
                                    @bind="tipoFormatoSeleccionado">
                                <option value="">Seleccione...</option>
                                <option value="CSV">CSV</option>
                                <option value="PDF">PDF</option>
                            </select>
                            @if (errorTipoFormato)
                            {
                                <div class="invalid-feedback small">El Tipo de Formato es obligatorio.</div>
                            }
                        </div>
                    </div>
                }

                <!-- Fila de Accionista para Certificaciones (dependiente de Sociedad + Tipo de Accionista) -->
                @if (tipoReporteSeleccionado == 6)
                {
                    <div class="row g-3 mt-1">
                        <div class="col-md-8 col-lg-6">
                            <label class="form-label fw-bold text-secondary small">
                                Accionista <span class="text-danger">*</span>
                            </label>
                            @if (sociedadCertificacionSeleccionada == 0 || tipoAccionistaCertificacionSeleccionado == 0)
                            {
                                <div class="form-control form-control-sm bg-light text-muted small d-flex align-items-center">
                                    <i class="bi bi-info-circle me-2 text-primary"></i>
                                    Seleccione primero la Sociedad Activa y el Tipo de Accionista para cargar los accionistas.
                                </div>
                            }
                            else if (cargandoAccionistasCertificaciones)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="text-muted small">Cargando accionistas de la sociedad seleccionada...</span>
                                </div>
                            }
                            else if (!listaAccionistasCertificaciones.Any())
                            {
                                <div class="form-control form-control-sm bg-light text-danger small d-flex align-items-center border-warning">
                                    <i class="bi bi-exclamation-triangle me-2 text-warning"></i>
                                    No se encontraron accionistas activos de este tipo para la sociedad seleccionada.
                                </div>
                            }
                            else
                            {
                                @if (isDropdownOpenAccionistaCertificacion)
                                {
                                    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1055;"
                                         @onclick="() => isDropdownOpenAccionistaCertificacion = false"></div>
                                }
                                <div class="dropdown position-relative" style="z-index: 1056;">
                                    <button class="form-select form-select-sm text-start d-flex justify-content-between align-items-center shadow-sm @(errorAccionistaCertificacion ? "is-invalid" : "")"
                                            type="button"
                                            @onclick="ToggleDropdownAccionistaCertificacion">
                                        <span class="text-truncate me-2">@ObtenerNombreAccionistaCertificacionSeleccionado()</span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-2 shadow-lg @(isDropdownOpenAccionistaCertificacion ? "show" : "")"
                                        style="max-height: 320px; overflow-y: auto; z-index: 1060;">
                                        <li class="mb-2">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white border-end-0 text-muted">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text"
                                                       class="form-control border-start-0"
                                                       placeholder="Buscar por nombre o documento..."
                                                       style="font-size: 0.8rem;"
                                                       @bind="textoBusquedaAccionistaCertificacion"
                                                       @bind:event="oninput" />
                                            </div>
                                        </li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item py-1 @(accionistaCertificacionSeleccionado == 0 ? "active bg-primary text-white" : "")"
                                                    style="font-size: 0.8rem;"
                                                    @onclick="() => SeleccionarAccionistaCertificacion(0)">
                                                Seleccione...
                                            </button>
                                        </li>

                                        @foreach (var acc in listaAccionistasCertificaciones.Where(a => string.IsNullOrEmpty(textoBusquedaAccionistaCertificacion) || a.Nombre.Contains(textoBusquedaAccionistaCertificacion, StringComparison.OrdinalIgnoreCase) || a.Documento.Contains(textoBusquedaAccionistaCertificacion, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item py-1 @(accionistaCertificacionSeleccionado == acc.AccionistaId ? "active bg-primary text-white" : "")"
                                                        style="font-size: 0.8rem;"
                                                        @onclick="() => SeleccionarAccionistaCertificacion(acc.AccionistaId)">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-medium">@acc.Nombre</span>
                                                        @if (!string.IsNullOrEmpty(acc.Documento))
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary ms-2 small">@acc.Documento</span>
                                                        }
                                                    </div>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                @if (errorAccionistaCertificacion)
                                {
                                    <div class="invalid-feedback d-block small">Debe seleccionar un accionista.</div>
                                }
                            }
                        </div>
                    </div>
                }

                <!-- Botonera -->
                <div class="d-flex gap-2 justify-content-end mt-auto pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4 shadow-sm" @onclick="Cancelar">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    @if (MostrarBotonGenerar)
                    {
                        <button type="button" class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="GenerarReporte">
                            <i class="bi bi-file-earmark-check me-1"></i> Generar
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (mostrarAlerta)
{
    <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
        <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
            <i class="bi @iconoAlerta me-2 fs-5"></i>
            <div class="fw-bold">@mensajeAlerta</div>
        </div>
    </div>
}

