@page "/sociedades"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-bezier text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Sociedades Activas
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>

                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="MostrarDescarga"
                            style="height: 32px; font-weight: 500;" title="Generar csv">
                        <i class="bi bi-filetype-csv me-2"></i> Descargar
                    </button>

                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="Sociedad" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            @* <th class="py-3 ps-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th> *@
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Sociedad</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Tipo Documento</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Documento</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Ejercicio</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Duración</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Objeto</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 5%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 5%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 15%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            @* <td class="ps-3" style="width: 5%;"><span class="text-muted small">@p.Id</span></td> *@
                            <td class="text-start text-secondary small" style="width: 10%;">@p.Empresa?.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.TipoDocumento1?.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.Documento1</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.EjercicioEconomico</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@(p.Duracion != null ? $"{p.Duracion} años" : "")</td>
                            <td class="text-start text-secondary small" style="width: 15%;">
                                @(p.Objeto?.Length > 25 ? $"{p.Objeto.Substring(0, 25)}..." : p.Objeto)
                            </td>
                            <td class="text-center text-secondary small" style="width: 5%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 5%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 15%;">
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-primary p-0 me-1" @onclick="() => Editar(p)">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0  ms-1"
                                    @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                }
                                <button class="btn btn-link btn-sm text-secondary p-0 ms-1"
                                        @onclick="() => Detalle(p)" title="Detalle Sociedad">
                                    <i class="bi bi-file-earmark-text fs-6"></i>
                                </button>
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-danger p-0  ms-1"
                                        @onclick="() => VerificarInactivar(p)" title="Inactivar">
                                            <i class="bi bi-x-circle fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-secondary p-0  ms-1"
                                        @onclick="() => AdminDocumentos(p)" title="Documentos Soporte">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}



@if (mostrarModal)
{
    <SociedadesGuardarPpal id="@idSociedad.ToString()" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Empresa.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}


@if (mostrarModalInactivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a inactivar <strong>@entidadParaEliminar?.Empresa.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalInactivar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarInactivar">Inactivar</button>
                </div>
            </div>
        </div>
    </div>
}


@if(descarga)
{
    <ModalDescarga idModulo="1" idEstado="1" OnFinalizado="ManejarCierreDescarga" />
}

@code {
    private List<Sociedad> Listgral = new();
    private List<Sociedad> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private bool mostrarModalInactivar = false;
    private Sociedad? entidadParaEliminar;

    private int idSociedad = 0;
    private int idRol = 0;
    private bool descarga = false;

    [Inject] private ISociedad repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }

        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var listSociedades = await repository.GetAllAsync();
            Listgral = listSociedades.OrderBy(x => x.Empresa.Nombre).Where(x => x.EstatusSociedad.Id == 1).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
        StateHasChanged();
    }

    private void AbrirModalNuevo()
    {
        idSociedad = 0;
        mostrarModal = true;
    }

    private void Editar(Sociedad item)
    {
        idSociedad = item.Id;
        mostrarModal = true;
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Empresa.Nombre != null && b.Empresa.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void VerificarEliminar(Sociedad item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Sociedad eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private void VerificarInactivar(Sociedad item)
    {
        entidadParaEliminar = item;
        mostrarModalInactivar = true;
    }

    private void CerrarModalInactivar() => mostrarModalInactivar = false;

    private async Task ConfirmarInactivar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Activar(entidadParaEliminar.Id, 2); // 2 para inactivar
            mostrarModalInactivar = false;
            await MostrarNotificacion($"");
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Sociedad inactivada correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al inactivar: {ex.Message}");
            await MostrarNotificacion("No se pudo inactivar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Detalle(Sociedad item)
    {
        navManager.NavigateTo($"/detallesociedad/{item.Id}");
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Sociedad guardada correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    private void AdminDocumentos(Sociedad item)
    {
        navManager.NavigateTo($"/documentossoporte/1/{item.Id}");
    }

    private void MostrarDescarga()
    {
        descarga = true;
    }

    private async Task ManejarCierreDescarga(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        descarga = false;
        cargando = false; // Oculta el spinner después de todo

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await MostrarNotificacion($"Archivo generado exitosamente");
        }
    }
}