    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            await LoadGenericDataAsync();

            if (id == "0" || string.IsNullOrEmpty(id))
            {
                entidadEditando = new();
                entidadEditando.RegionId ??= 0;
                entidadEditando.EstatusSociedadId ??= 1;
                entidadEditando.TipoSociedadActivaId ??= 0;
                entidadEditando.UnidadNegocioId ??= 0;
                entidadEditando.EmpresaId ??= 0;
                entidadEditando.MonedaId ??= 0;
                entidadEditando.NombreDiarioId ??= 0;
                entidadEditando.CreateDate = DateTime.Now;
                entidadEditando.UpdateDate = DateTime.Now;
            }
            else
            {
                var item = await repository.GetByIdAsync(int.Parse(id));
                if (item != null)
                {
                    SociedadDto dto = new()
                    {
                        Id = item.Id,
                        NumeroSap = item.NumeroSap,
                        EmpresaId = item.Empresa?.Id,
                        UnidadNegocioId = item.UnidadNegocio?.Id,
                        RegionId = item.UnidadNegocio?.Region?.Id,
                        TipoSociedadActivaId = item.TipoSociedadActiva?.Id ?? 0,
                        Objeto = item.Objeto,
                        Domicilio = item.Domicilio,
                        DireccionFiscal = item.DireccionFiscal,
                        DatosConstitucion = item.DatosConstitucion,
                        FechaConstitucion = item.FechaConstitucion,
                        FechaVencimiento = item.FechaVencimiento,
                        Duracion = item.Duracion,
                        NumeroAcciones = item.NumeroAcciones,
                        AplicaCapital = item.AplicaCapital,
                        CapitalPagado = item.CapitalPagado,
                        CapitalSuscrito = item.CapitalSuscrito,
                        NumeroExpediente = item.NumeroExpediente,
                        ClaseAcciones = item.ClaseAcciones,
                        EjercicioEconomico = item.EjercicioEconomico,
                        FormaAdministracion = item.FormaAdministracion,
                        EstatusSociedadId = item.EstatusSociedad?.Id,
                        MonedaId = item.Moneda?.Id,
                        Nit = item.Nit,
                        TipoDocumento1Id = item.TipoDocumento1?.Id,
                        TipoDocumento2Id = item.TipoDocumento2?.Id,
                        TipoDocumento3Id = item.TipoDocumento3?.Id,
                        Documento1 = item.Documento1,
                        Documento2 = item.Documento2,
                        Documento3 = item.Documento3,
                        Observaciones = item.Observaciones,
                        CreateDate = item.CreateDate,
                        CreateUserId = item.CreateUserId,
                        UpdateDate = item.UpdateDate,
                        UpdateUserId = item.UpdateUserId,
                        AnoPublicacion = item.AnoPublicacion,
                        FechaPublicacion = item.FechaPublicacion,
                        NumeroPublicacion = item.NumeroPublicacion,
                        NombreDiarioId = item.NombreDiario?.Id,
                        ValorAccion = item.ValorAccion,
                        ValorPatrimonial = item.ValorPatrimonial,
                        VencimientoDocumento1 = item.VencimientoDocumento1,
                        VencimientoDocumento2 = item.VencimientoDocumento2,
                        VencimientoDocumento3 = item.VencimientoDocumento3
                    };

                    if (dto.RegionId > 0)
                    {
                        listUnidadFiltrado = listUnidad.Where(u => u.Region != null && u.Region.Id == dto.RegionId).ToList();
                        dto.UnidadNegocioId = item.UnidadNegocio?.Id;
                    }
                    else
                    {
                        listUnidadFiltrado = new List<UnidadNegocio>();
                        dto.UnidadNegocioId = 0;
                    }
                    entidadEditando = dto;
                    entidadEditandoAux = JsonSerializer.Deserialize<SociedadDto>(JsonSerializer.Serialize(entidadEditando)) ?? new();
                }
            }

            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar sociedad: {ex.Message}");
            await MostrarNotificacion("No se pudieron cargar los datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    public async Task<List<IBaseEntity>> GetEntityListAsync(string entityName)
    {
        var repo = RepoFactory.GetRepository(entityName);
        var method = repo.GetType().GetMethod("GetAllAsync");

        if (method == null) return new List<IBaseEntity>();

        var task = (Task)method.Invoke(repo, null)!;
        await task;

        var resultProperty = task.GetType().GetProperty("Result");
        var result = (IEnumerable<IBaseEntity>)resultProperty!.GetValue(task)!;

        return result.ToList();
    }

    private async Task LoadGenericDataAsync()
    {
        listRegiones = await GetEntityListAsync("regiones");
        listEmpresas = await GetEntityListAsync("empresas");
        listTipoSociedad = await GetEntityListAsync("tiposociedad");
        listEstatusSociedad = await GetEntityListAsync("estatussociedad");
        listTipoSociedadActiva = await GetEntityListAsync("tiposociedadactiva");
        listNombreDiario = await GetEntityListAsync("nombrediarios");
        listTipoDoc = await GetEntityListAsync("tipodocumento");

        listMoneda = await repoMoneda.GetAllAsync();
        listUnidad = await repoUnidadNegocio.GetAllAsync();
    }

    private async Task CerrarModal()
    {
