@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
            <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
                <DataAnnotationsValidator />

                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="bi @( (int.TryParse(id, out var parsedId) && parsedId > 0) ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                            @( (int.TryParse(id, out var pId) && pId > 0) ? "Modificar Sociedad" : "Agregar Sociedad")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body py-4">
                        <!-- Iniciamos la grilla de filas y columnas -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Empresa</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.EmpresaId" @onchange="OnEmpresaChanged">
                                    <option value="0">Seleccione ...</option>
                                    @if (listEmpresas != null)
                                    {
                                        @foreach (var empresa in listEmpresas)
                                        {
                                            <option value="@empresa.Id">@empresa.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.EmpresaId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Moneda</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.MonedaId" @onchange="OnMonedaChanged">
                                    <option value="0">Seleccione ...</option>
                                    @if (listMoneda != null)
                                    {
                                        @foreach (var moneda in listMoneda)
                                        {
                                            <option value="@moneda.Id">@moneda.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.MonedaId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Región</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.RegionId" @onchange="OnRegionChanged">
                                    <option value="0">Seleccione ...</option>
                                    @if (listRegiones != null)
                                    {
                                        @foreach (var region in listRegiones)
                                        {
                                            <option value="@region.Id">@region.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.RegionId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Unidad de Negocio</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.UnidadNegocioId" @onchange="OnUnidadNegocioChanged">
                                    <option value="0">Seleccione ...</option>
                                    @if (listUnidadFiltrado != null)
                                    {
                                        @foreach (var unidad in listUnidadFiltrado)
                                        {
                                            <option value="@unidad.Id">@unidad.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.UnidadNegocioId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Número Sap</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.NumeroSap"
                                       placeholder="Ingrese el número sap..."
                                       maxlength="10"
                                       inputmode="text" />
                                <ValidationMessage For="@(() => entidadEditando.NumeroSap)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Estatus de la Sociedad</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.EstatusSociedadId" @onchange="OnEstatusSociedadChanged">
                                    <option value="0">Seleccione ...</option>
                                    @if (listEstatusSociedad != null)
                                    {
                                        @foreach (var estatusSociedad in listEstatusSociedad)
                                        {
                                            <option value="@estatusSociedad.Id">@estatusSociedad.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.EstatusSociedadId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Tipo Sociedad Activa</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.TipoSociedadActivaId" @onchange="OnTipoSociedadActivaChanged">
                                    <option value="0">Seleccione ...</option>
                                    @if (listTipoSociedadActiva != null)
                                    {
                                        @foreach (var tipoSociedadActiva in listTipoSociedadActiva)
                                        {
                                            <option value="@tipoSociedadActiva.Id">@tipoSociedadActiva.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.TipoSociedadActivaId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-secondary small">Objeto</label>
                                <textarea class="form-control form-control-sm small"
                                          @bind="entidadEditando.Objeto"
                                          @bind:event="oninput"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Ingrese el objeto (máximo 2,000 caracteres)...">
                                </textarea>
                                <ValidationMessage For="@(() => entidadEditando.Objeto)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-secondary small">Domicilio</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Domicilio"
                                       placeholder="Ingrese el domicilio..."
                                       maxlength="250" />
                                <ValidationMessage For="@(() => entidadEditando.Domicilio)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-secondary small">Dirección Fiscal</label>
                                <textarea class="form-control form-control-sm small"
                                          @bind="entidadEditando.DireccionFiscal"
                                          @bind:event="oninput"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Ingrese la dirección fiscal (máximo 2,000 caracteres)...">
                                </textarea>
                                <ValidationMessage For="@(() => entidadEditando.DireccionFiscal)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-secondary small">Datos de Constitución</label>
                                <textarea class="form-control form-control-sm small"
                                          @bind="entidadEditando.DatosConstitucion"
                                          @bind:event="oninput"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Ingrese los datos de constitución (máximo 2,000 caracteres)...">
                                </textarea>
                                <ValidationMessage For="@(() => entidadEditando.DatosConstitucion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha de Constitución</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.FechaConstitucion" @bind:format="yyyy-MM-dd" />
                                <ValidationMessage For="@(() => entidadEditando.FechaConstitucion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.FechaVencimiento" @bind:format="yyyy-MM-dd" />
                                <ValidationMessage For="@(() => entidadEditando.FechaVencimiento)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Duración</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Duracion"
                                       placeholder="Ingrese la duración..."
                                       maxlength="250" />
                                <ValidationMessage For="@(() => entidadEditando.Duracion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Número de Acciones</label>
                                 <input type="text" class="form-control form-control-sm small"
                                       @bind="NumeroAccionesTexto"
                                       placeholder="Ingrese el número de acciones..."
                                       maxlength="25"
                                       inputmode="numeric" />
                                <ValidationMessage For="@(() => entidadEditando.NumeroAcciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold text-secondary small d-block">¿Aplica Capital?</label>

                                <div class="form-check form-check-inline">
                                    <input type="radio"
                                           name="aplicaCapitalGroup"
                                           id="capitalSi"
                                           class="form-check-input"
                                           value="1"
                                           checked="@(entidadEditando.AplicaCapital == 1)"
                                           @onchange="() => ActualizarAplicaCapital(1)" />
                                    <label class="form-check-label small text-secondary" for="capitalSi">Sí</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input type="radio"
                                           name="aplicaCapitalGroup"
                                           id="capitalNo"
                                           class="form-check-input"
                                           value="0"
                                           checked="@(entidadEditando.AplicaCapital == 0)"
                                           @onchange="() => ActualizarAplicaCapital(0)" />
                                    <label class="form-check-label small text-secondary" for="capitalNo">No</label>
                                </div>

                                <ValidationMessage For="@(() => entidadEditando.AplicaCapital)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            @if (entidadEditando.AplicaCapital == 1)
                            {
                                <!-- Columna: Capital Suscrito -->
                                <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                    <label class="form-label fw-bold text-secondary small">Capital Suscrito</label>
                                    <div class="input-group input-group-sm">
                                    <!-- <span class="input-group-text">$</span> -->
                                        <input type="text" class="form-control form-control-sm small"
                                               @bind="CapitalSuscritoTexto" placeholder="0,00" />
                                    </div>
                                </div>

                                <!-- Columna: Capital Pagado -->
                                <div class="col-md-6 mb-3 animate__animated animate__fadeIn">
                                    <label class="form-label fw-bold text-secondary small">Capital Pagado</label>
                                    <div class="input-group input-group-sm">
                                        <!-- <span class="input-group-text">$</span> -->
                                        <input type="text" class="form-control form-control-sm small"
                                               @bind="CapitalPagadoTexto" placeholder="0,00" />
                                    </div>
                                </div>
                            }

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Clase de Acciones</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.ClaseAcciones"
                                       placeholder="Ingrese la clase de acciones..."
                                       maxlength="250" />
                                <ValidationMessage For="@(() => entidadEditando.ClaseAcciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Valor Nominal</label>
                                <input type="text" class="form-control form-control-sm small" @bind="ValorAccionTexto" placeholder="0.0000000000" step="0.0000000001" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Valor Patrimonial</label>
                                <input type="text" class="form-control form-control-sm small" @bind="ValorPatrimonialTexto" placeholder="0.0000000000" step="0.0000000001" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Forma de Administración</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.FormaAdministracion"
                                       placeholder="Ingrese la forma de administración..."
                                       maxlength="250" />
                                <ValidationMessage For="@(() => entidadEditando.FormaAdministracion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Ejercicio Económico</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.EjercicioEconomico"
                                       placeholder="Ingrese el ejercicio económico..."
                                       maxlength="250" />
                                <ValidationMessage For="@(() => entidadEditando.EjercicioEconomico)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Número de Expediente</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.NumeroExpediente"
                                       placeholder="Ingrese el número de expediente..."
                                       maxlength="250" />
                                <ValidationMessage For="@(() => entidadEditando.NumeroExpediente)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-secondary small">Observaciones</label>
                                <textarea class="form-control form-control-sm small"
                                          @bind="entidadEditando.Observaciones"
                                          @bind:event="oninput"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Ingrese las observaciones (máximo 2,000 caracteres)...">
                                </textarea>
                                <ValidationMessage For="@(() => entidadEditando.Observaciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Tipo Documento de Identidad Fiscal 1</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.TipoDocumento1Id" @onchange="OnTipoDocumento1Changed">
                                    <option value="0">Seleccione ...</option>
                                    @if (listTipoDoc != null)
                                    {
                                        @foreach (var tipoDoc in listTipoDoc)
                                        {
                                            <option value="@tipoDoc.Id">@tipoDoc.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Documento de Identidad Fiscal 1</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Documento1"
                                       placeholder="Ingrese número de documento..."
                                       maxlength="20"
                                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9.-]/g, '');" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento 1</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.VencimientoDocumento1" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Tipo Documento de Identidad Fiscal 2</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.TipoDocumento2Id" @onchange="OnTipoDocumento2Changed">
                                    <option value="0">Seleccione ...</option>
                                    @if (listTipoDoc != null)
                                    {
                                        @foreach (var tipoDoc in listTipoDoc)
                                        {
                                            <option value="@tipoDoc.Id">@tipoDoc.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Documento de Identidad Fiscal 2</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Documento2"
                                       placeholder="Ingrese número de documento..."
                                       maxlength="20"
                                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9.-]/g, '');" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento 2</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.VencimientoDocumento2" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Tipo Documento de Identidad Fiscal 3</label>
                                <select class="form-select form-select-sm" value="@entidadEditando.TipoDocumento3Id" @onchange="OnTipoDocumento3Changed">
                                    <option value="0">Seleccione ...</option>
                                    @if (listTipoDoc != null)
                                    {
                                        @foreach (var tipoDoc in listTipoDoc)
                                        {
                                            <option value="@tipoDoc.Id">@tipoDoc.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Documento de Identidad Fiscal 3</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Documento3"
                                       placeholder="Ingrese número de documento..."
                                       maxlength="20"
                                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9.-]/g, '');" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha de Vencimiento 3</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.VencimientoDocumento3" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Nit</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Nit"
                                       placeholder="Ingrese el nit..."
                                       maxlength="20"
                                       inputmode="text" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <hr />
                                <label class="form-label fw-bold text-primary small">Datos de Publicación</label>
                                <hr />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Año</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.AnoPublicacion"
                                       placeholder="Ingrese el año..."
                                       maxlength="4"
                                       inputmode="numeric"
                                       oninput="this.value = this.value.replace(/[^0-9+()-]/g, '');" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.FechaPublicacion" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Número</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.NumeroPublicacion"
                                       placeholder="Ingrese el número..."
                                       maxlength="12"
                                       inputmode="numeric"
                                       oninput="this.value = this.value.replace(/[^0-9+()-]/g, '');" />
                            </div>
                             <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Nombre Diario</label>
                                <select class="form-select form-select-sm" @bind="entidadEditando.NombreDiarioId">
                                    <option value="0" selected>Seleccione ...</option>
                                    @if (listNombreDiario != null)
                                    {
                                        @foreach (var nombre in listNombreDiario)
                                        {
                                            <option value="@nombre.Id">@nombre.Nombre</option>
                                        }
                                    }
                                </select>
                                <ValidationMessage For="@(() => entidadEditando.NombreDiarioId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-1"></i>
                                <span>Guardar</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

@if (cargando || guardando)
{
    <ModalCargando />
}
@code {
    [Parameter] public string id { get; set; } = "";

    [Parameter]
    public EventCallback<bool> OnFinalizado { get; set; }

    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; 
    private string iconoAlerta = "bi-check-circle-fill";
    private bool cargando = true;
    private bool guardando = false;

    private SociedadDto entidadEditando = new();
    private SociedadDto entidadEditandoAux = new();
    private List<IBaseEntity> listRegiones = new();
    private List<IBaseEntity> listEmpresas = new();
    private List<IBaseEntity> listTipoSociedad = new();
    private List<IBaseEntity> listNombreDiario = new();
    private List<IBaseEntity> listEstatusSociedad = new();
    private List<IBaseEntity> listTipoSociedadActiva = new();
    private List<IBaseEntity> listTipoDoc = new();

    private List<Moneda> listMoneda = new();
    private List<UnidadNegocio> listUnidad = new();
    private List<UnidadNegocio> listUnidadFiltrado = new();

    private EditContext editContext = new(new SociedadDto());
    private ValidationMessageStore? mensajeStore;

    [Inject] private IMoneda repoMoneda { get; set; } = null!;
    [Inject] private IUnidadNegocio repoUnidadNegocio { get; set; } = null!;
    [Inject] private ISociedad repository { get; set; } = null!;

    private string NumeroAccionesTexto
    {
        get => UtilClass.FormatearStringMiles(entidadEditando?.NumeroAcciones);
        set => entidadEditando.NumeroAcciones = UtilClass.LimpiarYConvertirStringMiles(value);
    }

    private string CapitalSuscritoTexto
    {
        get => UtilClass.FormatearNumero((decimal?)entidadEditando.CapitalSuscrito!);
