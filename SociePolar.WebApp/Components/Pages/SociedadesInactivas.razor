@page "/sociedadesinactivas"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-bezier text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Sociedades Inactivas
                    </h5>
                </div>
            </div>
        </div>


        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="Sociedad" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Sociedad</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 10%; font-size: 0.85rem;">Rif</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Ejercicio</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">Duración</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 20%; font-size: 0.85rem;">Objeto</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 5%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 5%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="ps-3" style="width: 5%;"><span class="text-muted small">@p.Id</span></td>
                            <td class="text-start text-secondary small" style="width: 20%;">@p.Empresa.Nombre</td>
                            <td class="text-start text-secondary small" style="width: 10%;">@p.Rif</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.EjercicioEconomico</td>
                            <td class="text-start text-secondary small" style="width: 5%;">@(p.Duracion != null ? $"{p.Duracion} años" : "")</td>
                            <td class="text-start text-secondary small" style="width: 20%;">
                                @(p.Objeto?.Length > 25 ? $"{p.Objeto.Substring(0, 25)}..." : p.Objeto)
                            </td>
                            <td class="text-center text-secondary small" style="width: 5%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 5%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                <button class="btn btn-link btn-sm text-secondary p-0 ms-2"
                                        @onclick="() => Detalle(p)" title="Detalle Sociedad">
                                    <i class="bi bi-eye fs-6"></i>
                                </button>
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Sociedad> Listgral = new();
    private List<Sociedad> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private Sociedad entidadEditando = default!;
    private Sociedad? entidadParaEliminar;
    private string nombreRegion = "";
    private Region regionEntity = new();

    [Inject] private ISociedad repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var repo = RepoFactory.GetRepository("regiones");
            var method = repo.GetType().GetMethod("GetByIdAsync");
            var task = (Task)method!.Invoke(repo, new object[] { 0 })!;
            await task;

            dynamic resultRegiones = task.GetType().GetProperty("Result")?.GetValue(task)!;
            regionEntity = resultRegiones != null ? new Region
            {
                Id = resultRegiones.Id,
                Nombre = resultRegiones.Nombre
            } : new Region();

            nombreRegion = regionEntity?.Nombre ?? "Región desconocida";

            var listSociedades = await repository.GetAllAsync();
            Listgral = listSociedades.Where(x => x.EstatusSociedad.Id == 2).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Empresa.Nombre != null && b.Empresa.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Detalle(Sociedad item)
    {
        navManager.NavigateTo($"/detallesociedadinactiva/{item.Id}");
    }
}
