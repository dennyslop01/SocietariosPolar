@page "/sociedadesinactivas"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-building-dash text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Sociedades Inactivas
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">
                    @if (idRol == 1 || idRol == 2 || idRol == 3)
                    {
                        <!-- Botón Agregar -->
                        <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="AbrirModalNuevo"
                        style="height: 32px; font-weight: 500;">
                            <i class="bi bi-plus-lg me-2"></i> Agregar
                        </button>

                        <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                        @onclick="MostrarDescarga"
                        style="height: 32px; font-weight: 500;" title="Generar csv">
                            <i class="bi bi-filetype-csv me-2"></i> Descargar
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="Sociedad" Items="Listgral" DefaultPageSize="50" TableClass="polar-table-compact" ContainerStyle="max-height: calc(100vh - 280px);">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom text-nowrap">
                            <!-- Columna Sociedad Fija (Sticky) con sombra divisoria -->
                            <th class="polar-sticky-col-direct text-start" style="min-width: 240px; max-width: 280px;">Sociedad</th>
                            <th class="text-center" style="width: 85px; min-width: 85px;">Tipo Doc.</th>
                            <th class="text-start" style="min-width: 125px;">Documento</th>
                            <th class="text-start" style="min-width: 220px; max-width: 260px;">Ejercicio Económico</th>
                            <th class="text-center" style="width: 90px; min-width: 90px;">Duración</th>
                            <th class="text-start" style="min-width: 220px; max-width: 300px;">Objeto</th>
                            <th class="polar-date" style="width: 110px; min-width: 110px;">Fecha Creación</th>
                            <th class="polar-date" style="width: 110px; min-width: 110px;">Últ. Modificación</th>
                            <th class="text-end pe-3" style="width: 140px; min-width: 140px;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom text-nowrap">
                            <td class="polar-sticky-col-direct text-start text-dark fw-semibold">
                                <span class="polar-truncate" style="max-width: 260px;" title="@p.Empresa?.Nombre">
                                    @p.Empresa?.Nombre
                                </span>
                            </td>
                            <td class="text-center text-secondary small">
                                <span class="badge bg-light text-secondary border px-2 py-1">
                                    @(string.IsNullOrEmpty(p.TipoDocumento1?.Nombre) ? "-" : p.TipoDocumento1.Nombre)
                                </span>
                            </td>
                            <td class="text-start text-secondary small fw-semibold text-nowrap">
                                @(string.IsNullOrEmpty(p.Documento1) ? "-" : p.Documento1)
                            </td>
                            <td class="text-start text-secondary small">
                                <span class="polar-truncate" style="max-width: 200px;" title="@p.EjercicioEconomico">
                                    @(p.EjercicioEconomico?.Length > 30 ? $"{p.EjercicioEconomico.Substring(0, 30)}..." : (string.IsNullOrEmpty(p.EjercicioEconomico) ? "-" : p.EjercicioEconomico))
                                </span>
                            </td>
                            <td class="text-center text-secondary small text-nowrap">
                                @(p.Duracion != null ? $"{p.Duracion} " : "-")
                            </td>
                            <td class="text-start text-secondary small">
                                <span class="polar-truncate" style="max-width: 220px;" title="@p.Objeto">
                                    @(p.Objeto?.Length > 30 ? $"{p.Objeto.Substring(0, 30)}..." : (string.IsNullOrEmpty(p.Objeto) ? "-" : p.Objeto))
                                </span>
                            </td>
                            <td class="polar-date text-secondary small">@p.CreateDate.ToString("dd/MM/yyyy")</td>
                            <td class="polar-date text-secondary small">@p.UpdateDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-3 text-nowrap">
                                @if (idRol == 1 || idRol == 2 || idRol == 3)
                                {
                                    <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)" title="Editar">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                }
                                <button class="btn btn-link btn-sm text-secondary p-0 me-2" @onclick="() => Detalle(p)" title="Detalle Sociedad">
                                    <i class="bi bi-file-earmark-text fs-6"></i>
                                </button>
                                @if (idRol == 1 || idRol == 2 || idRol == 3)
                                {
                                    <button class="btn btn-link btn-sm text-success p-0 me-2" @onclick="() => VerificarActivar(p)" title="Activar Sociedad">
                                        <i class="bi bi-check2-circle fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-secondary p-0" @onclick="() => AdminDocumentos(p)" title="Documentos Soporte">
                                        <i class="bi bi-file-earmark-pdf fs-6"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }

</div>

@if (cargando)
{
    <ModalCargando />
}



@if (mostrarModal)
{
    <SociedadesGuardarInactivas id="@idSociedad.ToString()" OnFinalizado="ManejarCierreModal" />
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Empresa.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalActivar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-secondary fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a activar <strong>@entidadParaEliminar?.Empresa.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalActivar">Cancelar</button>
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="ConfirmarActivar">Activar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (descarga)
{
    <ModalDescarga idModulo="1" idEstado="2" OnFinalizado="ManejarCierreDescarga" />
}

@code {
    private List<Sociedad> Listgral = new();
    private List<Sociedad> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private bool mostrarModalActivar = false;
    private Sociedad? entidadParaEliminar;

    private int idSociedad = 0;
    private int idRol = 0;
    private bool descarga = false;

    [Inject] private ISociedad repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
            {
                if (int.TryParse(userrolaux.Value, out var rolVal))
                {
                    idRol = rolVal;
                }
            }
        }
        catch
        {
            // Silencioso en prerenderizado SSR: JSInterop (SessionStorage) requiere circuito interactivo
        }
        await LoadGenericDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
                {
                    if (int.TryParse(userrolaux.Value, out var rolVal) && idRol != rolVal)
                    {
                        idRol = rolVal;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error hidratando rol en AfterRender: {ex.Message}");
            }
        }
    }


    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var listSociedades = await repository.GetAllAsync();
            Listgral = listSociedades.OrderBy(x => x.Empresa.Nombre).Where(x => x.EstatusSociedad.Id == 2).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
        StateHasChanged();
    }

    private void AbrirModalNuevo()
    {
        idSociedad = 0;
        mostrarModal = true;
    }

    private void Editar(Sociedad item)
    {
        idSociedad = item.Id;
        mostrarModal = true;
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Empresa.Nombre != null && b.Empresa.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void VerificarEliminar(Sociedad item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Sociedad eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private void VerificarActivar(Sociedad item)
    {
        entidadParaEliminar = item;
        mostrarModalActivar = true;
    }

    private void CerrarModalActivar() => mostrarModalActivar = false;

    private async Task ConfirmarActivar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Activar(entidadParaEliminar.Id, 1); // 1 para activar
            mostrarModalActivar = false;
            await MostrarNotificacion($"");
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Sociedad activada correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al activar: {ex.Message}");
            await MostrarNotificacion("No se pudo activar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Detalle(Sociedad item)
    {
        navManager.NavigateTo($"/detallesociedadinactiva/{item.Id}");
    }

    private async Task ManejarCierreModal(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        mostrarModal = false;

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await LoadGenericDataAsync(); // Tu método que llena 'Listgral' de nuevo
            await MostrarNotificacion($"Sociedad guardada correctamente");
        }

        cargando = false; // Oculta el spinner después de todo
    }

    private void AdminDocumentos(Sociedad item)
    {
        navManager.NavigateTo($"/documentossoporte/1/{item.Id}");
    }

    private void MostrarDescarga()
    {
        descarga = true;
    }

    private async Task ManejarCierreDescarga(bool guardadoExitoso)
    {
        cargando = true; // Opcional: muestra el spinner mientras se refrescan los datos
        // 1. Cierra el modal en cualquier caso (true o false)
        descarga = false;
        cargando = false; // Oculta el spinner después de todo

        // 2. Si se guardó con éxito, refresca los datos
        if (guardadoExitoso)
        {
            await MostrarNotificacion($"Archivo generado exitosamente");
        }
    }
}

