@page "/tipodocumentosoporte"

@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-file-medical text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Tipos Documentos Soporte
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>
                </div>
            </div>
        </div>


        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="TipoDocumentoSoporte" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <!-- Columna 1: Sociedad -->
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Modulo</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 30%; font-size: 0.85rem;">Nombre</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        @{
                            var index = Listgral.IndexOf(p);
                            bool esNuevaModulo = index == 0 ||
                                                   Listgral[index - 1].ModuloId != p.ModuloId;
                        }

                        @if (esNuevaModulo)
                        {
                            <!-- Fila divisoria de Sociedad (Abarca las 8 columnas completas) -->
                            <tr class="table-secondary fw-bold text-primary border-bottom">
                                <td colspan="8" class="ps-3 py-2 bg-light text-uppercase font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                    @ObtenerModulo(p.ModuloId)
                                </td>
                            </tr>
                        }

                        <tr class="align-middle border-bottom">
                            <td class="text-muted small ps-3" style="width: 15%;">-</td>
                            <td class="text-start text-secondary small" style="width: 30%;">@p.Nombre</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>
    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <ModalCargando />
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
            <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
                <DataAnnotationsValidator />

                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                            @(entidadEditando.Id == 0 ? "Agregar Tipo Documento Soporte" : "Modificar Tipo Documento Soporte")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="row">
                            <div class="col-md-11 mb-3">
                                <label class="form-label fw-bold text-secondary small">Módulo Sistema</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="entidadEditando.ModuloId">
                                    <option value="0">Seleccione ...</option>
                                    @if (ListModulos != null)
                                    {
                                        @foreach (var modulo in ListModulos)
                                        {
                                            <option value="@modulo.Id">@modulo.Nombre</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => entidadEditando.ModuloId)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-11 mb-3">
                                <label class="form-label fw-bold text-secondary small">Nombre</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Nombre"
                                       placeholder="Ingrese el nombre del tipo documento..."
                                       maxlength="150" />
                                <ValidationMessage For="@(() => entidadEditando.Nombre)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                            </div>
                            <div class="col-md-12 mb-3">
                            </div>
                            <div class="col-md-12 mb-3">
                            </div>
                            <div class="col-md-12 mb-3">
                            </div>
                            <div class="col-md-12 mb-3">
                            </div>
                            <div class="col-md-12 mb-3">
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar
                        </button>
                    </div>
                </div>
            </EditForm>

        </div>
    </div>
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string id { get; set; } = "";

    private List<TipoDocumentoSoporte> Listgral = new();
    private List<TipoDocumentoSoporte> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private TipoDocumentoSoporte entidadEditando = default!;
    private TipoDocumentoSoporte? entidadParaEliminar;
    private string nombreComplemento = "";
    private int Estado = 0;
    private int idRol = 0;

    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    [Inject] private ITipoDocumentoSoporte repository { get; set; } = null!;

    public class Modulos
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    public List<Modulos> ListModulos = new List<Modulos>
    {
        new Modulos { Id = 1, Nombre = "Sociedades" },
        new Modulos { Id = 2, Nombre = "Autoridades" },
        new Modulos { Id = 3, Nombre = "Asambleas" },
        new Modulos { Id = 4, Nombre = "Reformas" },
        new Modulos { Id = 5, Nombre = "Certificaciones" },
        new Modulos { Id = 6, Nombre = "Libros" },
        new Modulos { Id = 7, Nombre = "Accionistas" },
        new Modulos { Id = 8, Nombre = "Títulos" },
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrolaux.Value))
            {
                idRol = int.Parse(userrolaux.Value);
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error al cargar los datos del usuario: " + ex.Message, true);
        }
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;

        try
        {
            Listgral = await repository.GetAllAsync();
            Listgral = Listgral.OrderBy(x => x.ModuloId).ThenBy(x => x.Nombre).ToList();
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerModulo(int idmodulo)
    {
        return ListModulos.Where(m => m.Id == idmodulo).Select(m => m.Nombre).FirstOrDefault() ?? "Desconocido";
    }

    private async Task AbrirModalNuevo()
    {
        entidadEditando = new();
        entidadEditando.ModuloId = 0;
        entidadEditando.CreateDate = DateTime.Now;
        entidadEditando.UpdateDate = DateTime.Now;
        editContext = new EditContext(entidadEditando);

        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }
        mostrarModal = true;
    }

    private async Task Editar(TipoDocumentoSoporte item)
    {
        entidadEditando = new();
        entidadEditando.Id = item.Id;
        entidadEditando.ModuloId = item.ModuloId;
        entidadEditando.Nombre = item.Nombre;
        entidadEditando.CreateDate = item.CreateDate;
        entidadEditando.CreateUserId = item.CreateUserId;
        entidadEditando.UpdateDate = item.UpdateDate;
        entidadEditando.UpdateUserId = item.UpdateUserId;
        editContext = new EditContext(entidadEditando);

        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }

        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarCambios()
    {
        bool formularioValido = editContext.Validate();

        if (!formularioValido)
        {
            StateHasChanged();
            cargando = false;
            return;
        }

        cargando = true;
        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Tipo Documento Soporte guardada correctamente");
                }
                else
                {
                    repository.Update(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Tipo Documento Soporte actualizado correctamente");
                }
            }
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            // Si hay error en base de datos (ej. nombre duplicado)
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        finally
        {
            StateHasChanged();
            cargando = false;
        }
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Nombre != null && b.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void VerificarEliminar(TipoDocumentoSoporte item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Tipo Documento Soporte eliminado correctamente");
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Regresar()
    {
        if (Estado == 1)
            navManager.NavigateTo("/accionistassociedad");

        if (Estado == 2)
            navManager.NavigateTo("/accionistassociedadinactivas");
    }
}