@page "/unidadesnegocio/{id}"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-gear-fill text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Unidades de Negocio - Region: @nombreRegion
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>

                    <!-- Botón Regresar -->
                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>

                </div>
            </div>
        </div>


        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="UnidadNegocio" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Región</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 30%; font-size: 0.85rem;">Descripción</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 15%; font-size: 0.85rem;">Fecha de creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 15%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="ps-3" style="width: 5%;"><span class="text-muted small">@p.Id</span></td>
                            <td class="fw-medium" style="width: 15%;">@p.Region.Nombre</td>
                            <td class="fw-medium" style="width: 30%;">@p.Nombre</td>
                            <td class="text-center text-secondary small" style="width: 15%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 15%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                    <i class="bi bi-pencil-square fs-6"></i>
                                </button>
                                <button class="btn btn-link btn-sm text-danger p-0"
                                        @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                    <i class="bi bi-trash3 fs-6"></i>
                                </button>
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>
    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                        @(entidadEditando.Id == 0 ? "Agregar Unidad de Negocio" : "Modificar Unidad de Negocio")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Nombre</label>
                        <input type="text" class="form-control" @bind="entidadEditando.Nombre"
                               placeholder="Ingrese el nombre aquí..." />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="GuardarCambios">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Nombre</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string id { get; set; } = "";

    private List<UnidadNegocio> Listgral = new();
    private List<UnidadNegocio> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private UnidadNegocio entidadEditando = default!;
    private UnidadNegocio? entidadParaEliminar;
    private string nombreRegion = "";
    private Region regionEntity = new();

    [Inject] private IUnidadNegocio repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            var repo = RepoFactory.GetRepository("regiones");
            var method = repo.GetType().GetMethod("GetByIdAsync");
            var task = (Task)method!.Invoke(repo, new object[] { int.Parse(id) })!;
            await task;

            dynamic resultRegiones = task.GetType().GetProperty("Result")?.GetValue(task)!;
            regionEntity = resultRegiones != null ? new Region
            {
                Id = resultRegiones.Id,
                Nombre = resultRegiones.Nombre
            } : new Region();

            nombreRegion = regionEntity?.Nombre ?? "Región desconocida";

            Listgral = await repository.GetByIdRegionAllAsync(int.Parse(id));
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        entidadEditando = new ();
        entidadEditando.Region = regionEntity;
        entidadEditando.CreateDate = DateTime.Now;
        entidadEditando.UpdateDate = DateTime.Now;

        mostrarModal = true;
    }

    private void Editar(UnidadNegocio item)
    {
        entidadEditando = item;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarCambios()
    {
        if (string.IsNullOrWhiteSpace(entidadEditando.Nombre))
        {
            await MostrarNotificacion("El nombre es obligatorio", true);
            return;
        }

        cargando = true;
        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Unidad de negocio guardada correctamente");
                }
                else
                {
                    repository.Update(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Unidad de negocio actualizado correctamente");
                }
            }
        }
        catch (Exception ex)
        {
            // Si hay error en base de datos (ej. nombre duplicado)
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Nombre != null && b.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void VerificarEliminar(UnidadNegocio item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Unidad de negocio eliminado correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Regresar()
    {
        navManager.NavigateTo("/administrar/regiones");
    }
}
