@page "/vertitulos/{id}"

@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-file-medical text-white fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">
                        Títulos : @nombreComplemento
                    </h5>
                </div>

                <!-- Contenedor flex para alinear los botones en línea -->
                <div class="d-flex gap-2 align-items-center">

                    <!-- Botón Agregar -->
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>

                    <!-- Botón Regresar -->
                    <button class="btn btn-secondary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="Regresar"
                            style="height: 32px; font-weight: 500;">
                        <i class="bi bi-arrow-return-left me-2"></i> Regresar
                    </button>

                </div>
            </div>
        </div>


        <div class="card-body">
            <!-- Buscador Global por Nombre -->
            <div class="row mb-3">
                <div class="col-md-4 ms-auto">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..."
                               @oninput="FiltrarBusqueda" />
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <PaginationComponent TItem="Titulo" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 5%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Número</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Acciones</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Preferente</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 15%; font-size: 0.85rem;">Ubicación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 15%; font-size: 0.85rem;">Fecha de creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 15%; font-size: 0.85rem;">Última modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 10%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="ps-3" style="width: 5%;"><span class="text-muted small">@p.Id</span></td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Numero</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@FormatearMiles(p.Acciones)</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Preferente</td>
                            <td class="text-start text-secondary small" style="width: 15%;">@p.Ubicacion</td>
                            <td class="text-center text-secondary small" style="width: 15%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 15%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 10%;">
                                <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)">
                                    <i class="bi bi-pencil-square fs-6"></i>
                                </button>
                                <button class="btn btn-link btn-sm text-danger p-0"
                                        @onclick="() => VerificarEliminar(p)" title="Eliminar">
                                    <i class="bi bi-trash3 fs-6"></i>
                                </button>
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>
    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <!-- SOLUCIÓN: position: fixed, pantalla completa y z-index alto -->
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999;">

        <div class="modal-dialog modal-dialog-centered justify-content-center h-100 m-0" style="max-width: 100%;">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div class="modal-body text-center">
                    @* Spinner más fino y con el color principal de tu app *@
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 fw-bold text-primary animate__animated animate__pulse animate__infinite">
                        Procesando
                    </h6>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); display: flex !important; align-items: center; justify-content: center; padding-top: 40px;">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-height: 90vh; margin: auto;">
            <EditForm EditContext="editContext" OnSubmit="GuardarCambios">
                <DataAnnotationsValidator />

                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                            @(entidadEditando.Id == 0 ? "Agregar Título" : "Modificar Título")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Número</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Numero"
                                       placeholder="Ingrese el número del título..."
                                       maxlength="30" />
                                <ValidationMessage For="@(() => entidadEditando.Numero)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Número de Acciones</label>
                                <input type="text"
                                       class="form-control form-control-sm small"
                                       value="@FormatearMiles(entidadEditando.Acciones)"
                                       @oninput="ProcesarEntradaAcciones"
                                       placeholder="Ingrese número de acciones..."
                                       maxlength="26"
                                       inputmode="numeric" />
                                <ValidationMessage For="@(() => entidadEditando.Acciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Preferente</label>
                                <input type="text" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Preferente"
                                       placeholder="Ingrese el preferente..."
                                       maxlength="50" />
                                <ValidationMessage For="@(() => entidadEditando.Preferente)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Ubicación</label>
                                <textarea class="form-control form-control-sm small"
                                          @bind="entidadEditando.Ubicacion"
                                          @bind:event="oninput"
                                          rows="4"
                                          maxlength="200"
                                          placeholder="Ingrese la ubicación (máximo 200 caracteres)...">
                                </textarea>
                                <ValidationMessage For="@(() => entidadEditando.Ubicacion)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />                                
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold text-secondary small d-block">¿Anulado?</label>

                                <div class="form-check form-check-inline">
                                    <input type="radio"
                                           name="anuladoGroup"
                                           id="anuladoSi"
                                           class="form-check-input"
                                           value="1"
                                           checked="@(entidadEditando.Anulado == 1)" />
                                    <label class="form-check-label small text-secondary" for="anuladoSi">Sí</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input type="radio"
                                           name="anuladoGroup"
                                           id="anuladoNo"
                                           class="form-check-input"
                                           value="0"
                                           checked="@(entidadEditando.Anulado == 0)" />
                                    <label class="form-check-label small text-secondary" for="anuladoNo">No</label>
                                </div>
                                <ValidationMessage For="@(() => entidadEditando.Anulado)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold text-secondary small d-block">¿Endosado?</label>

                                <div class="form-check form-check-inline">
                                    <input type="radio"
                                           name="endosadoGroup"
                                           id="endosadoSi"
                                           class="form-check-input"
                                           value="1"
                                           checked="@(entidadEditando.Endosado == 1)" />
                                    <label class="form-check-label small text-secondary" for="endosadoSi">Sí</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input type="radio"
                                           name="endosadoGroup"
                                           id="endosadoNo"
                                           class="form-check-input"
                                           value="0"
                                           checked="@(entidadEditando.Endosado == 0)" />
                                    <label class="form-check-label small text-secondary" for="endosadoNo">No</label>
                                </div>
                                <ValidationMessage For="@(() => entidadEditando.Endosado)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary small">Fecha Título</label>
                                <input type="date" class="form-control form-control-sm small"
                                       @bind="entidadEditando.Fecha" @bind:format="yyyy-MM-dd" />
                                <ValidationMessage For="@(() => entidadEditando.Fecha)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold text-secondary small">Observaciones</label>
                                <textarea class="form-control form-control-sm small"
                                          @bind="entidadEditando.Observaciones"
                                          @bind:event="oninput"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Ingrese las observaciones (máximo 2,000 caracteres)...">
                                </textarea>
                                <ValidationMessage For="@(() => entidadEditando.Observaciones)" class="text-danger mt-1" style="font-size: 11px; font-weight: 500;" />
                            </div>
                        </div>                        
                    </div>
                    
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar
                        </button>
                    </div>
                </div>
            </EditForm>
            
        </div>
    </div>
}


@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">¿Estás seguro?</h5>
                    <p class="text-secondary small">
                        Vas a eliminar <strong>@entidadParaEliminar?.Numero</strong>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4">
                    <button class="btn btn-outline-secondary btn-sm px-4 me-2" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string id { get; set; } = "";

    private List<Titulo> Listgral = new();
    private List<Titulo> ListgralBuscar = new();
    private string searchTerm = "";
    private bool cargando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private TituloDto entidadEditando = default!;
    private Titulo? entidadParaEliminar;
    private string nombreComplemento = "";
    private int Estado = 0;

    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    [Inject] private ITitulo repository { get; set; } = null!;
    [Inject] private IAccionistaSociedad repoaccionista { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGenericDataAsync();
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;

        try
        {
            var accionistaEntity = await repoaccionista.GetByIdAsync(int.Parse(id));

            if (accionistaEntity == null)
            {
                await MostrarNotificacion("No se encontró el accionista", true);
                return;
            }

            if(accionistaEntity.Accionista.TipoAccionista.Id == 3)
            {
                nombreComplemento = accionistaEntity.Accionista?.NombreSusesion;
                nombreComplemento = (nombreComplemento.Length > 20) ? nombreComplemento.Substring(0, 20) + "..." : nombreComplemento + " -- ";
            }
            else
                nombreComplemento = accionistaEntity.Accionista?.Nombre + " -- ";

            nombreComplemento += accionistaEntity.Sociedad?.Empresa?.Nombre;

            Estado = accionistaEntity.EstatusAccionista.Id;

            Listgral = await repository.GetByAccionistaSociedadIdAsync(int.Parse(id));
            ListgralBuscar = Listgral;
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AbrirModalNuevo()
    {
        entidadEditando = new();
        entidadEditando.AccionistaSociedadId = int.Parse(id);
        entidadEditando.CreateDate = DateTime.Now;
        entidadEditando.UpdateDate = DateTime.Now;
        editContext = new EditContext(entidadEditando);
        
        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }
        mostrarModal = true;
    }

    private async Task Editar(Titulo item)
    {
        entidadEditando = new();
        entidadEditando.Id = item.Id;
        entidadEditando.AccionistaSociedadId = int.Parse(id);
        entidadEditando.Numero = item.Numero;
        entidadEditando.Acciones = item.Acciones;
        entidadEditando.Preferente = item.Preferente;
        entidadEditando.Ubicacion = item.Ubicacion;
        entidadEditando.Anulado = item.Anulado;
        entidadEditando.Endosado = item.Endosado;
        entidadEditando.Fecha = item.Fecha;
        entidadEditando.Observaciones = item.Observaciones;
        entidadEditando.CreateDate = item.CreateDate;
        entidadEditando.CreateUserId = item.CreateUserId;
        entidadEditando.UpdateDate = item.UpdateDate;
        entidadEditando.UpdateUserId = item.UpdateUserId;
        editContext = new EditContext(entidadEditando);

        try
        {
            editContext = new EditContext(entidadEditando);
            mensajeStore = new ValidationMessageStore(editContext);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar el formulario: {ex.Message}");
            await MostrarNotificacion("Error al preparar el formulario", true);
        }

        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarCambios()
    {
        bool formularioValido = editContext.Validate();

        if (!formularioValido)
        {
            StateHasChanged();
            cargando = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(entidadEditando.Numero))
        {
            await MostrarNotificacion("El número es obligatorio", true);
            return;
        }

        cargando = true;
        try
        {
            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;
                entidadEditando.UpdateUserId = userid;

                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;
                    entidadEditando.CreateUserId = userid;

                    await repository.AddAsync(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Título guardada correctamente");
                }
                else
                {
                    repository.Update(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Título actualizado correctamente");
                }
            }
        }
        catch (Exception ex)
        {
            // Si hay error en base de datos (ej. nombre duplicado)
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        finally
        {
            StateHasChanged();
            cargando = false;
        }
    }

    private void FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Listgral = ListgralBuscar;
        }
        else
        {
            Listgral = ListgralBuscar
                .Where(b => b.Numero != null && b.Numero.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void VerificarEliminar(Titulo item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null) return;

        cargando = true;
        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Título eliminado correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            cargando = false;
            entidadParaEliminar = null;
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000); // 4 segundos para errores es mejor
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Regresar()
    {
        if (Estado == 1)
            navManager.NavigateTo("/accionistassociedad");
        
        if (Estado == 2)
            navManager.NavigateTo("/accionistassociedadinactivas");
    }

    // Reemplaza 'int' por 'long' o 'decimal' según sea el tipo de tu propiedad
    private void ProcesarEntradaAcciones(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";

        // 1. Elimina todo lo que no sea un dígito numérico
        string soloNumeros = System.Text.RegularExpressions.Regex.Replace(input, @"[^\d]", "");

        // 2. Asigna el valor numérico limpio a tu propiedad de Blazor
        if (int.TryParse(soloNumeros, out int resultado))
        {
            entidadEditando.Acciones = resultado;
        }
        else
        {
            entidadEditando.Acciones = 0; // O el valor por defecto que manejes
        }
    }

    private string FormatearMiles(int? valor)
    {
        if (valor == null || valor == 0) return string.Empty;

        // Formatea con separador de miles según la cultura local (ej: 1.000 o 1,000)
        return valor.Value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);
    }
}
